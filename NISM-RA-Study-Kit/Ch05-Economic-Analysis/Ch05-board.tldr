on": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-5i", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aHtkf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-i", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Policy makers aim for three things: "}, {"type": "text", "text": "low unemployment", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "stable prices", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (low inflation) and "}, {"type": "text", "text": "steady growth", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Even so, economies go through booms and busts, because no one controls every variable."}]}]}}, "index": "a4RJU", "typeName": "shape"}, {"meta": {}, "id": "binding:ghnA3ofSQdJlNBHhIYD_e", "type": "arrow", "fromId": "shape:ch05-1e", "toId": "shape:ch05-1a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 697.25, "y": 532, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1f", "type": "arrow", "parentId": "shape:ch05-13", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 278.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aAg7j", "typeName": "shape"}, {"x": 273.68421052631584, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2g", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 786.3157894736843, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What it is", "marks": [{"type": "bold"}]}]}]}}, "index": "a6nNQ", "typeName": "shape"}, {"x": 56, "y": 601, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3h", "type": "text", "parentId": "shape:ch05-34", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If the economy is shrinking, the "}, {"type": "text", "text": "inflation rate", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shows whether the central bank has room to cut rates, and the "}, {"type": "text", "text": "fiscal deficit", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shows whether the government has room to spend more."}]}]}}, "index": "aBQDn", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4i", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Micro: individuals and firms, \"theory of the firm\". Macro: the whole economy."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4ehI", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-5j", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aIq2U", "typeName": "shape"}]}