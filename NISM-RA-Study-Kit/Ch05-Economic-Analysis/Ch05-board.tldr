{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.group": 0, "com.tldraw.shape.text": 4, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.geo": 12, "com.tldraw.shape.note": 13, "com.tldraw.shape.line": 5, "com.tldraw.shape.frame": 1, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.embed": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"name": "", "color": "#F04F88", "imageUrl": "", "meta": {}, "id": "user:I5Y9hmMK0Xt4RjzWg-ajj", "typeName": "user"}, {"x": 1084, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-j", "type": "note", "parentId": "shape:ch05-e", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "In 2011, 2012 and 2013, the RBI raised interest rates to bring down high inflation. It did not work as hoped, because "}, {"type": "text", "text": "food prices", "marks": [{"type": "bold"}]}, {"type": "text", "text": " stayed high."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 120, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a5B5M", "typeName": "shape"}, {"x": 1084, "y": 400, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1g", "type": "note", "parentId": "shape:ch05-13", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Savings are "}, {"type": "text", "text": "not", "marks": [{"type": "bold"}]}, {"type": "text", "text": " the same as investment. Savings become investment only when they flow into productive use through instruments like shares, bonds and government securities. Governments and central banks build efficient financial markets to help this happen. Higher savings, and more of them turned into investment, are good for the economy."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 432, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aBHNf", "typeName": "shape"}, {"x": 56, "y": 397, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2h", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 209.6842105263158, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Repo rate", "marks": [{"type": "bold"}]}]}]}}, "index": "a7EoU", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3i", "type": "frame", "props": {"w": 1400, "h": 3201.9999999999854, "name": "5.5 Three kinds of trend", "color": "black"}, "parentId": "page:page", "index": "a7z6R", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4j", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Two major policy influencers: government (fiscal) and central bank (monetary)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5kJz", "typeName": "shape"}, {"x": 56, "y": 678, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-k", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.1 National income"}]}]}}, "index": "a6jSE", "typeName": "shape"}, {"x": 56, "y": 1261.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1h", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.3 Inflation and interest rates"}]}]}}, "index": "aCtEz", "typeName": "shape"}, {"x": 273.68421052631584, "y": 397, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2i", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 786.3157894736843, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rate at which the central bank "}, {"type": "text", "text": "lends", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to financial institutions for a very short term, against approved securities (it buys them with a promise to resell)"}]}]}}, "index": "a8X66", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3j", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.5", "marks": [{"type": "bold"}]}]}]}}, "index": "a19UD", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4k", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Keynes wrote \"General Theory of Employment, Interest and Money\"."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6civ", "typeName": "shape"}, {"meta": {}, "id": "binding:9qZWGaH0XzMnJfO0mNEh2", "type": "arrow", "fromId": "shape:ch05-3e", "toId": "shape:ch05-3b", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"meta": {}, "id": "binding:DDJb6v5r3gNtUgDB_nInJ", "type": "arrow", "fromId": "shape:ch05-3f", "toId": "shape:ch05-3c", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 767, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-l", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "GDP versus GNP"}]}]}}, "index": "a7GLv", "typeName": "shape"}, {"x": 56, "y": 1336.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1i", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is a general rise in prices that erodes what money can buy. Rs 1,000 kept in a drawer is still Rs 1,000 a year later, but it buys less."}]}]}}, "index": "aDRsI", "typeName": "shape"}, {"x": 56, "y": 507, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2j", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 209.6842105263158, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reverse repo rate", "marks": [{"type": "bold"}]}]}]}}, "index": "a9qpf", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3k", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three kinds of trend"}]}]}}, "index": "a2hnn", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4l", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " GDP: produced within borders. GNP: produced by residents anywhere. GNP = GDP + NFIA."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7xrv", "typeName": "shape"}, {"x": 56, "y": 842, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-m", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Where it is produced, or who produces it"}]}]}}, "index": "a8TrA", "typeName": "shape"}, {"x": 56, "y": 1426.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1j", "type": "geo", "parentId": "shape:ch05-13", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Demand-pull inflation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Demand is more than supply, so prices rise."}]}]}}, "index": "aEPYM", "typeName": "shape"}, {"x": 273.68421052631584, "y": 507, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2k", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 786.3157894736843, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rate at which the central bank "}, {"type": "text", "text": "borrows", "marks": [{"type": "bold"}]}, {"type": "text", "text": " money against securities"}]}]}}, "index": "aAu56", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3l", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5 of 15"}]}]}}, "index": "a3XEb", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4m", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Three GDP methods: product, income, expenditure. Product method counts final goods only."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8Rzk", "typeName": "shape"}, {"x": 56, "y": 900, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-n", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "GDP", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Gross Domestic Product", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market value of goods and services produced "}, {"type": "text", "text": "within the country's borders", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", whoever owns the producer."}]}]}}, "index": "a9hUJ", "typeName": "shape"}, {"x": 712, "y": 1426.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1k", "type": "geo", "parentId": "shape:ch05-13", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cost-push inflation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Input costs rise, so prices rise."}]}]}}, "index": "aFvdv", "typeName": "shape"}, {"x": 56, "y": 593, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2l", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 209.6842105263158, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bank rate", "marks": [{"type": "bold"}]}]}]}}, "index": "aBFFM", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3m", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Secular, cyclical, seasonal"}]}]}}, "index": "a4olj", "typeName": "shape"}, {"x": 384, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4n", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Per capita income, not national income, is the better measure of living standards."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9obM", "typeName": "shape"}, {"x": 712, "y": 900, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-o", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "GNP", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Gross National Product", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market value of goods and services produced by the country's "}, {"type": "text", "text": "residents", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", wherever in the world they are."}]}]}}, "index": "aAgfz", "typeName": "shape"}, {"x": 56, "y": 1566.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1l", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation is measured at the wholesale level by the "}, {"type": "text", "text": "WPI", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (Wholesale Price Index) and at the retail level by the "}, {"type": "text", "text": "CPI", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (Consumer Price Index). Both price a basket of commonly used goods."}]}]}}, "index": "aGD6z", "typeName": "shape"}, {"x": 273.68421052631584, "y": 593, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2m", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 786.3157894736843, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rate at which the central bank lends to commercial banks "}, {"type": "text", "text": "without collateral", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", for medium to long term or emergency needs"}]}]}}, "index": "aC1nQ", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3n", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How long they last, and what they change"}]}]}}, "index": "a5Lwr", "typeName": "shape"}, {"x": 712, "y": 1643.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-50", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Boom: rates and inflation rise. Recession: rates and inflation fall."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMnrv", "typeName": "shape"}, {"x": 712, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4o", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Services are 60% of India's GDP at factor cost (as per the book)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAnI2", "typeName": "shape"}, {"x": 56, "y": 1100, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-p", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 356, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "GDP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Inside the borders"}]}]}}, "index": "aBj8j", "typeName": "shape"}, {"x": 56, "y": 1656.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1m", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation and interest rates are linked. Higher inflation needs higher rates to persuade people to save. Higher rates then:"}]}]}}, "index": "aHO0U", "typeName": "shape"}, {"x": 56, "y": 703, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2n", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 209.6842105263158, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "CRR", "marks": [{"type": "bold"}]}]}]}}, "index": "aDO3b", "typeName": "shape"}, {"x": 56, "y": 1949.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-40", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3. The inventory cycle.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Short cycles within a commodity cycle, caused by buyers and producers adjusting their stocks. Buyers with big stocks pause orders, so supplier stocks pile up and prices fall. When demand picks up slightly, buyers with thin stocks rush to buy, so prices rise."}]}]}}, "index": "aIiCM", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3o", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 413.3333333333333, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Secular", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Long-term shift", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Once in 7 to 10 years", "marks": [{"type": "highlight"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Changes "}, {"type": "text", "text": "what", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is consumed or "}, {"type": "text", "text": "how", "marks": [{"type": "bold"}]}, {"type": "text", "text": " it is made. Driven by technology, culture, demography, tastes. Example: digital offices use less paper and ink. More in 6.5."}]}]}}, "index": "a6n22", "typeName": "shape"}, {"x": 1040, "y": 1643.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-51", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Seasonal businesses are compared year over year."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aNKOQ", "typeName": "shape"}, {"x": 1040, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4p", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " National saving = personal + corporate + public. Private = personal + corporate. Savings are not investment."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBp3M", "typeName": "shape"}, {"meta": {}, "id": "binding:E4IFOjVqQMuJfWlAasINl", "type": "arrow", "fromId": "shape:ch05-s", "toId": "shape:ch05-q", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 522, "y": 1100, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-q", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 356, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "+ NFIA", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Net factor income from abroad: income received by residents minus income paid to non-residents"}]}]}}, "index": "aCojA", "typeName": "shape"}, {"x": 56, "y": 1746.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1n", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "cut consumption (people save more),"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "cut investment (capital costs more),"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "hit "}, {"type": "text", "text": "real estate", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "autos", "marks": [{"type": "bold"}]}, {"type": "text", "text": " hardest, because middle-class buyers borrow to buy them."}]}]}]}]}}, "index": "aILVb", "typeName": "shape"}, {"x": 56, "y": 2472.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-30", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.9 Globalisation"}]}]}}, "index": "aQQx6", "typeName": "shape"}, {"x": 273.68421052631584, "y": 703, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2o", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 786.3157894736843, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cash Reserve Ratio: minimum % of deposits banks must keep as "}, {"type": "text", "text": "cash with the central bank", "marks": [{"type": "bold"}]}]}]}}, "index": "aEAzH", "typeName": "shape"}, {"x": 1084, "y": 1949.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-41", "type": "note", "parentId": "shape:ch05-3i", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "In April 2020, a huge crude oil inventory in Oklahoma pushed futures to around "}, {"type": "text", "text": "USD 20", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a barrel, and briefly below zero. As inventory eased, futures traded around "}, {"type": "text", "text": "USD 40", "marks": [{"type": "bold"}]}, {"type": "text", "text": " by June 2020. The inventory cycle helps forecast near-term demand and prices."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 288, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aJcqv", "typeName": "shape"}, {"x": 493.3333333333333, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3p", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 413.3333333333333, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cyclical", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Medium-term swing", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cycle of 2 to 6 years", "marks": [{"type": "highlight"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Changes "}, {"type": "text", "text": "how much", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is consumed. Reverses, then returns. Not permanent."}]}]}}, "index": "a7v42", "typeName": "shape"}, {"x": 56, "y": 1971.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-52", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sources: government sites, regulators (SEBI, RBI, MOF), research reports, Economic Survey."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aOGJM", "typeName": "shape"}, {"x": 56, "y": 914.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4q", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Demand-pull: demand exceeds supply. Cost-push: input costs rise. WPI is wholesale, CPI is retail."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCYBX", "typeName": "shape"}, {"meta": {}, "id": "binding:2i-XfT8jpIACbTDBVVBeM", "type": "arrow", "fromId": "shape:ch05-3g", "toId": "shape:ch05-3d", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 988, "y": 1100, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-r", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 356, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "= GNP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "By the nation's people"}]}]}}, "index": "aDhW2", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-20", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fiscal policy", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the government's decisions on its income (mainly taxes) and spending (education, health, police, defence, interest, welfare). Changing either one moves demand, supply, savings and investment."}]}]}}, "index": "a4qzF", "typeName": "shape"}, {"x": 56, "y": 1868.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1o", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "High inflation also shrinks people's spare income, cutting demand everywhere."}]}]}}, "index": "aJzTc", "typeName": "shape"}, {"x": 56, "y": 2547.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-31", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The freedom of people and firms to make anything anywhere and sell anywhere, with people and capital flowing to where they earn the best return. No country is forced into it; each decides for itself."}]}]}}, "index": "aRvcQ", "typeName": "shape"}, {"x": 56, "y": 813, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2p", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 209.6842105263158, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SLR", "marks": [{"type": "bold"}]}]}]}}, "index": "aF6rI", "typeName": "shape"}, {"x": 56, "y": 2623.7999999999884, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-42", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Handling seasonality"}]}]}}, "index": "aK2UJ", "typeName": "shape"}, {"x": 930.6666666666666, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3q", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 413.3333333333333, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Seasonal", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Yearly pattern", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Every year", "marks": [{"type": "highlight"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Highly predictable, following weather or farming seasons. Example: farm GDP is higher around harvest."}]}]}}, "index": "a8LdE", "typeName": "shape"}, {"x": 6160, "y": 3260.0400000000022, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-53", "type": "frame", "props": {"w": 1400, "h": 910, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "aA0N2", "typeName": "shape"}, {"x": 384, "y": 914.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4r", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Higher rates hurt real estate and autos most."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDidU", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3", "type": "frame", "props": {"w": 1400, "h": 1252.5999999999985, "name": "5.1 and 5.2 Micro and macro", "color": "black"}, "parentId": "page:page", "index": "a1VGX", "typeName": "shape"}, {"x": 234, "y": 1202, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-s", "type": "arrow", "parentId": "shape:ch05-e", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aCwd5O", "typeName": "shape"}, {"x": 1084, "y": 1566, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-10", "type": "note", "parentId": "shape:ch05-e", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A cake is baked, sold and eaten. You can measure its value by what the baker made (product), what the baker and helpers earned (income), or what the customers paid (spending). Done carefully, all three give about the same number."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aL8aU", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-21", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fiscal deficit", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = the budgeted excess of government spending over revenue in a year, usually stated as a "}, {"type": "text", "text": "% of GDP", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". It is bridged by "}, {"type": "text", "text": "market borrowings", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", both short and long term. A large deficit means heavy government borrowing, which pushes up interest rates and makes it harder for companies to borrow."}]}]}}, "index": "a5c0Q", "typeName": "shape"}, {"x": 56, "y": 1940.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1p", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.4 Unemployment rate"}]}]}}, "index": "aKg3M", "typeName": "shape"}, {"x": 56, "y": 2637.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-32", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 632, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Positives", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Resources flow to where they produce and earn best"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Developing countries link with the developed world: learning, products, technology"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Global competition drives innovation and keeps prices in check"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "More choice of art, films, music, food, clothing"}]}]}]}]}}, "index": "aSx1v", "typeName": "shape"}, {"x": 273.68421052631584, "y": 813, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2q", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 786.3157894736843, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Statutory Liquidity Ratio: minimum % of deposits banks must keep in "}, {"type": "text", "text": "cash equivalents", "marks": [{"type": "bold"}]}, {"type": "text", "text": " such as gold and government securities"}]}]}}, "index": "aGNYM", "typeName": "shape"}, {"x": 56, "y": 2698.7999999999884, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-43", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Economists use "}, {"type": "text", "text": "seasonally adjusted", "marks": [{"type": "bold"}]}, {"type": "text", "text": " growth rates. A simpler tool is "}, {"type": "text", "text": "year-over-year (YoY) growth", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": compare a quarter with the "}, {"type": "text", "text": "same quarter last year", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not with the previous quarter, so the season is the same on both sides."}]}]}}, "index": "aL0zB", "typeName": "shape"}, {"x": 56, "y": 703, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3r", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three cycles inside \"cyclical\""}]}]}}, "index": "a9XE2", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-54", "type": "geo", "parentId": "shape:ch05-53", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a1wKj", "typeName": "shape"}, {"x": 712, "y": 914.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4s", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Unemployment rises in a slowdown, falls in an expansion."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEybj", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4", "type": "geo", "parentId": "shape:ch05-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1rpI", "typeName": "shape"}, {"x": 700, "y": 1202, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-t", "type": "arrow", "parentId": "shape:ch05-e", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aEkHn", "typeName": "shape"}, {"x": 56, "y": 2146.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-11", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why national income matters"}]}]}}, "index": "aMsCr", "typeName": "shape"}, {"x": 56, "y": 434, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-22", "type": "geo", "parentId": "shape:ch05-1w", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How the government funds spending", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Recurring revenue:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " direct and indirect taxes, interest on its loans, dividends from public sector companies"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capital transactions:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " borrowing in rupees and foreign currency, and selling assets (disinvestment in PSUs)"}]}]}]}]}}, "index": "a64P6", "typeName": "shape"}, {"x": 56, "y": 2015.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1q", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The share of people who are able and willing to work but have no job. It "}, {"type": "text", "text": "rises", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in a slowdown and "}, {"type": "text", "text": "falls", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in an expansion. More jobs mean more income, more spending and more growth."}]}]}}, "index": "aLzfP", "typeName": "shape"}, {"x": 712, "y": 2637.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-33", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 632, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Negatives", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Survival of the fittest: jobs move to the most competitive countries"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Problems spread: the "}, {"type": "text", "text": "2008 US credit crisis", "marks": [{"type": "bold"}]}, {"type": "text", "text": " hit the whole world"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Developed countries gain first and negotiate hard; developing ones need strong political will"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Old traditions may erode. ESG shows cultural issues can become business issues"}]}]}]}]}}, "index": "aTLA6", "typeName": "shape"}, {"x": 1084, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2r", "type": "note", "parentId": "shape:ch05-2a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Repo = central bank "}, {"type": "text", "text": "lends", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Reverse repo = central bank "}, {"type": "text", "text": "borrows", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Bank rate = lending "}, {"type": "text", "text": "without", "marks": [{"type": "bold"}]}, {"type": "text", "text": " collateral. CRR is held as cash with the central bank; SLR is held in gold and government securities."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aHtUJ", "typeName": "shape"}, {"x": 1084, "y": 2698.7999999999884, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-44", "type": "note", "parentId": "shape:ch05-3i", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Comparing a harvest quarter with the quarter just before it would show a big jump that is only the season. That is why YoY comparison is used when a business is seasonal."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aMQbn", "typeName": "shape"}, {"x": 56, "y": 778, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3s", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. The economic cycle.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " The length of each phase is unpredictable. Knowing the phase helps an analyst form a medium-term view of an industry's volumes and prices."}]}]}}, "index": "aAA4X", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-55", "type": "text", "parentId": "shape:ch05-53", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a25zT", "typeName": "shape"}, {"x": 1040, "y": 914.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4t", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " FDI: active, long term, stable. FPI: passive, \"hot money\"."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aF43f", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-5", "type": "text", "parentId": "shape:ch05-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Micro and macro"}]}]}}, "index": "a2eGf", "typeName": "shape"}, {"x": 56, "y": 1344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-u", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three ways to measure GDP"}]}]}}, "index": "aFzZ7", "typeName": "shape"}, {"x": 56, "y": 2221.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-12", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Welfare and growth.Per capita income", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = national income ÷ population. It is a "}, {"type": "text", "text": "better", "marks": [{"type": "bold"}]}, {"type": "text", "text": " measure of the standard of living than national income, because if population grows faster than income, each person is worse off."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Who gets what.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " The income method shows how income is shared. The product method shows which sector contributes most. The book: services are "}, {"type": "text", "text": "60%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " of India's GDP at factor cost."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Guide to policy.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Savings, consumption and investment figures help policy makers act."}]}]}]}]}}, "index": "aNC1A", "typeName": "shape"}, {"x": 712, "y": 434, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-23", "type": "geo", "parentId": "shape:ch05-1w", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Current account", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recurring receipts from abroad (exports, interest, dividends) minus payments (imports and so on). Surplus if receipts are larger, deficit if payments are larger. A high "}, {"type": "text", "text": "current account deficit (CAD)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " weakens the currency, makes imports dearer and raises the cost of foreign borrowing. A weaker currency helps exports, and strong FDI and FPI inflows can offset the CAD."}]}]}}, "index": "a7knr", "typeName": "shape"}, {"x": 56, "y": 2119.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1r", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.5 Foreign money: FDI and FPI"}]}]}}, "index": "aMzPq", "typeName": "shape"}, {"x": 3080, "y": 3945.8000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-34", "type": "frame", "props": {"w": 1400, "h": 721, "name": "5.4 Why analysts care", "color": "black"}, "parentId": "page:page", "index": "a6GVn", "typeName": "shape"}, {"x": 1084, "y": 846.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2s", "type": "note", "parentId": "shape:ch05-2a", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No sure-shot formula", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The same policy can have different results in different economies. A fix for one problem can create another: stimulating a stagnant economy with more money, more spending or lower taxes risks raising inflation. Cooling an overheated one with higher taxes or lower spending risks a slow economy and high unemployment."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 432, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aInWU", "typeName": "shape"}, {"x": 4620, "y": 4130.599999999986, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-45", "type": "frame", "props": {"w": 1400, "h": 590, "name": "5.6 Where to find data", "color": "black"}, "parentId": "page:page", "index": "a8OKz", "typeName": "shape"}, {"x": 56, "y": 882, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3t", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The four phases of the economic cycle"}]}]}}, "index": "aB5zs", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-56", "type": "text", "parentId": "shape:ch05-53", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3VXv", "typeName": "shape"}, {"x": 56, "y": 1242.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4u", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Fiscal deficit is stated as % of GDP and bridged by market borrowings. A large deficit pushes rates up."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGL2E", "typeName": "shape"}, {"meta": {}, "id": "binding:b1FClu6-zlg1z5o8ezOb4", "type": "arrow", "fromId": "shape:ch05-1d", "toId": "shape:ch05-1a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-6", "type": "text", "parentId": "shape:ch05-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5 of 15"}]}]}}, "index": "a3fqX", "typeName": "shape"}, {"x": 56, "y": 1433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-v", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three methods, similar answers"}]}]}}, "index": "aGye6", "typeName": "shape"}, {"x": 1540, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-13", "type": "frame", "props": {"w": 1400, "h": 2662, "name": "5.3 The big numbers (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a38NQ", "typeName": "shape"}, {"x": 56, "y": 768, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-24", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three fiscal stances"}]}]}}, "index": "a8mKf", "typeName": "shape"}, {"x": 56, "y": 2208.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1s", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two ways foreign money comes in"}]}]}}, "index": "aNB32", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-35", "type": "geo", "parentId": "shape:ch05-34", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.4", "marks": [{"type": "bold"}]}]}]}}, "index": "a1SlM", "typeName": "shape"}, {"x": 56, "y": 1708.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2t", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.8 International trade and the balance of payments"}]}]}}, "index": "aJQMQ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-46", "type": "geo", "parentId": "shape:ch05-45", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1GpU", "typeName": "shape"}, {"x": 56, "y": 957, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3u", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Expansion or boom", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Higher income, "}, {"type": "text", "text": "low rates", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", strong confidence. Production and jobs rise. Firms expand capacity, consumers buy long-term assets. Borrowing rises, so "}, {"type": "text", "text": "rates rise", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Inflation is high at the peak."}]}]}}, "index": "aCLGr", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-57", "type": "note", "parentId": "shape:ch05-53", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Which phase of the economic cycle do you think India is in right now? What data would you check?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4BMU", "typeName": "shape"}, {"x": 384, "y": 1242.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4v", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Expansionary fiscal policy leads to a deficit; contractionary to a surplus."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHssA", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-7", "type": "text", "parentId": "shape:ch05-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Economics", "marks": [{"type": "bold"}]}, {"type": "text", "text": " studies how people make choices when resources are scarce. It assumes people are "}, {"type": "text", "text": "rational", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": they have clear goals and try their best to reach them. Choosing one thing usually means giving up another. That is a "}, {"type": "text", "text": "trade-off", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a4ojf", "typeName": "shape"}, {"x": 56, "y": 1508, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-w", "type": "text", "parentId": "shape:ch05-e", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Small differences come from things like errors in statistics"}]}]}}, "index": "aHdoQ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-14", "type": "geo", "parentId": "shape:ch05-13", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a196f", "typeName": "shape"}, {"x": 56, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-25", "type": "geo", "parentId": "shape:ch05-1w", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Neutral", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Balanced", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Income and spending are in balance. No big changes needed."}]}]}}, "index": "a9zYUV", "typeName": "shape"}, {"x": 56, "y": 2283.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1t", "type": "geo", "parentId": "shape:ch05-13", "props": {"w": 490, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Active", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "FDI: Foreign Direct Investment", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Investors take part in decisions and run the business. "}, {"type": "text", "text": "Long term and stable.", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Brings: jobs, new technology, new managerial skills, new products and services."}]}]}}, "index": "aOycX", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-36", "type": "text", "parentId": "shape:ch05-34", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why analysts care"}]}]}}, "index": "a2cBU", "typeName": "shape"}, {"x": 56, "y": 1783.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2u", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The "}, {"type": "text", "text": "balance of payments (BoP)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " records all of a country's transactions with the rest of the world."}]}]}}, "index": "aKviM", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-47", "type": "text", "parentId": "shape:ch05-45", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Where to find data"}]}]}}, "index": "a2uxz", "typeName": "shape"}, {"x": 712, "y": 957, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3v", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Slowdown", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "High prices and rates discourage buying. Central banks tighten. Consumption still grows, but more slowly. New capacity sits under-used."}]}]}}, "index": "aDZFA", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-58", "type": "note", "parentId": "shape:ch05-53", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why might raising interest rates fail to control inflation, as in 2011 to 2013?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a51MA", "typeName": "shape"}, {"x": 712, "y": 1242.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4w", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Repo: central bank lends. Reverse repo: it borrows. Bank rate: no collateral. CRR: cash with central bank. SLR: gold and G-secs."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aIDbU", "typeName": "shape"}, {"meta": {}, "id": "binding:zGjSUG7Vw-Od6ust-gZLa", "type": "arrow", "fromId": "shape:ch05-t", "toId": "shape:ch05-r", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-8", "type": "text", "parentId": "shape:ch05-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two lenses on the same economy"}]}]}}, "index": "a5dQ2", "typeName": "shape"}, {"x": 56, "y": 1566, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-x", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Product method", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Count what is made", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value of all "}, {"type": "text", "text": "final", "marks": [{"type": "bold"}]}, {"type": "text", "text": " goods and services, sector by sector: agriculture, industry, services. Intermediate goods, used to make other goods, are left out."}]}]}}, "index": "aI0uE", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-15", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The big numbers"}]}]}}, "index": "a2Gzc", "typeName": "shape"}, {"x": 493.3333333333333, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-26", "type": "geo", "parentId": "shape:ch05-1w", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Expansionary", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Spend more, tax less", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Used in recessions or a slow economy. Leaves more money with people and firms. Results in a "}, {"type": "text", "text": "fiscal deficit", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aAlJv", "typeName": "shape"}, {"x": 570, "y": 2283.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1u", "type": "geo", "parentId": "shape:ch05-13", "props": {"w": 490, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Passive", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "FPI: Foreign Portfolio Investment", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Buys shares or bonds in the market. No part in management. There are limits on how much FPIs can hold in Indian companies."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Called "}, {"type": "text", "text": "\"hot money\"", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": it can leave at any time, which can create systemic risk."}]}]}}, "index": "aP35E", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-37", "type": "text", "parentId": "shape:ch05-34", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5 of 15"}]}]}}, "index": "a3fyI", "typeName": "shape"}, {"x": 56, "y": 1855.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2v", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Balance of payments: old and new layout"}]}]}}, "index": "aLYyr", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-48", "type": "text", "parentId": "shape:ch05-45", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5 of 15"}]}]}}, "index": "a3WnA", "typeName": "shape"}, {"x": 56, "y": 1215, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3w", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recession", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Expansion plans cut, layoffs. Unemployment up, income and spending down. People save instead of borrowing, so "}, {"type": "text", "text": "rates fall", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". "}, {"type": "text", "text": "Inflation falls", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aEnkI", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-59", "type": "note", "parentId": "shape:ch05-53", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Is FPI \"hot money\" good or bad for Indian markets? Give one reason each way."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6TPE", "typeName": "shape"}, {"x": 1040, "y": 1242.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4x", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A high current account deficit weakens the currency."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJgSU", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-9", "type": "geo", "parentId": "shape:ch05-3", "props": {"w": 490, "h": 384, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Microeconomics: the small picture", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Individuals and firms: what they buy and consume at current prices"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Belief: prices and production are driven by "}, {"type": "text", "text": "consumer demand", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Includes the "}, {"type": "text", "text": "\"theory of the firm\"", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": how firms set inputs, outputs and prices to raise profit"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Explains how prices are set and how goods are shared among people"}]}]}]}]}}, "index": "a6prz", "typeName": "shape"}, {"x": 398.6666666666667, "y": 1566, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-y", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Income method", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Count what is earned", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Wages and salaries of "}, {"type": "text", "text": "employees", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", fees of "}, {"type": "text", "text": "professionals", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", profits of "}, {"type": "text", "text": "entrepreneurs", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", returns and rent of "}, {"type": "text", "text": "investors", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". (The book borrows these four groups from author Robert Kiyosaki.)"}]}]}}, "index": "aJypI", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-16", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3mdz", "typeName": "shape"}, {"x": 930.6666666666666, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-27", "type": "geo", "parentId": "shape:ch05-1w", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Contractionary", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Spend less, tax more", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Used when inflation or debt has overheated the economy. Cools it down. Results in a "}, {"type": "text", "text": "fiscal surplus", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aBoH2", "typeName": "shape"}, {"x": 1084, "y": 2283.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1v", "type": "note", "parentId": "shape:ch05-13", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "FDI is a family that buys a house and moves in. FPI is a guest in a hotel room: welcome, but able to check out tonight."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aQD8j", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-38", "type": "text", "parentId": "shape:ch05-34", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How much a business grows depends partly on its management and partly on the world outside. Economic analysis reads that outside world."}]}]}}, "index": "a4342", "typeName": "shape"}, {"x": 56, "y": 1930.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2w", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book describes both"}]}]}}, "index": "aMKUW", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-49", "type": "geo", "parentId": "shape:ch05-45", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Government websites", "marks": [{"type": "bold"}]}]}]}}, "index": "a42Iv", "typeName": "shape"}, {"x": 712, "y": 1215, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3x", "type": "geo", "parentId": "shape:ch05-3i", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recovery", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Low inflation lets the central bank loosen policy. Money is easier, prices lower, buying resumes. Leads back to expansion."}]}]}}, "index": "aFBEv", "typeName": "shape"}, {"x": 56, "y": 1643.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4y", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Under BPM6, FDI and portfolio flows sit in the financial account, not the capital account."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKZrz", "typeName": "shape"}, {"x": 741.3333333333334, "y": 1566, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-z", "type": "geo", "parentId": "shape:ch05-e", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Expenditure method", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Count what is spent", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Private consumption + government spending + gross capital formation + "}, {"type": "text", "text": "net exports", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Spenders: individuals, companies, government."}]}]}}, "index": "aKPQQ", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-17", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.2 Savings and investments"}]}]}}, "index": "a45jX", "typeName": "shape"}, {"x": 56, "y": 1117, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-28", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.7 Monetary policy"}]}]}}, "index": "aC72X", "typeName": "shape"}, {"x": 1540, "y": 3590.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1w", "type": "frame", "props": {"w": 1400, "h": 1344, "name": "5.3.6 Fiscal policy (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a4LRA", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-39", "type": "text", "parentId": "shape:ch05-34", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What each number tells the analyst"}]}]}}, "index": "a5wav", "typeName": "shape"}, {"x": 56, "y": 1988.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2x", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 632, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Old structure", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Two accounts", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Current account:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " imports and exports of goods and services. Imports above exports = deficit."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capital account:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " capital flows like FDI, FII, loans and grants."}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Ideally the two offset each other. They seldom do."}]}]}}, "index": "aNA2A", "typeName": "shape"}, {"x": 56, "y": 1445, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3y", "type": "text", "parentId": "shape:ch05-3i", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2. The commodity cycle.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Hard commodity prices rise and fall, usually following the economic cycle, though sometimes on their own. High prices lead suppliers to add capacity. Too much capacity pushes prices down. High-cost suppliers shut down. Supply falls and prices rise again."}]}]}}, "index": "aGzUcV", "typeName": "shape"}, {"x": 384, "y": 1643.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4z", "type": "note", "parentId": "shape:ch05-4e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Secular: 7 to 10 years. Cyclical: 2 to 6 years. Seasonal: yearly."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLHLr", "typeName": "shape"}, {"x": 56, "y": 325, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-18", "type": "text", "parentId": "shape:ch05-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How national saving adds up"}]}]}}, "index": "a5vmE", "typeName": "shape"}, {"x": 56, "y": 1192, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-29", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Run by the "}, {"type": "text", "text": "central bank", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". It manages money supply, inflation and interest rates to support growth while keeping prices stable. Like fiscal policy, it is either "}, {"type": "text", "text": "expansionary", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (more money, lower rates, to push the economy up) or "}, {"type": "text", "text": "contractionary", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (less money or slower growth of money, higher rates, to cool it)."}]}]}}, "index": "aDnsf", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1x", "type": "geo", "parentId": "shape:ch05-1w", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.3.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1iFA", "typeName": "shape"}, {"x": 712, "y": 1988.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2y", "type": "geo", "parentId": "shape:ch05-2a", "props": {"w": 632, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "IMF BPM6 (in use now)", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Three accounts", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Current account:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " almost unchanged."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capital account:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " non-produced, non-financial assets (patents, rights, land, natural resources) and capital grants and transfers."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Financial account:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " FDI, portfolio flows, derivatives, long-term debt flows, and reserve assets."}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Current + capital + financial + errors and omissions = change in reserves."}]}]}}, "index": "aOk0n", "typeName": "shape"}, {"x": 1084, "y": 1445, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-3z", "type": "note", "parentId": "shape:ch05-3i", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Everyone plants tomatoes after a year of high tomato prices. Next year there are too many tomatoes, prices crash, and many farmers switch crops. The year after, tomatoes are scarce and dear again."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 168, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aH7lQ", "typeName": "shape"}, {"meta": {}, "id": "binding:z0SI-5oPpCmTUl6htTtlW", "type": "arrow", "fromId": "shape:ch05-3f", "toId": "shape:ch05-3b", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 400, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-19", "type": "geo", "parentId": "shape:ch05-13", "props": {"w": 168.5, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Personal savings", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Individuals"}]}]}}, "index": "a63LA", "typeName": "shape"}, {"meta": {}, "id": "binding:9tPGays3R6gi4CR4Orqrl", "type": "arrow", "fromId": "shape:ch05-t", "toId": "shape:ch05-q", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1y", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fiscal policy"}]}]}}, "index": "a29nz", "typeName": "shape"}, {"x": 56, "y": 2368.2000000000116, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-2z", "type": "text", "parentId": "shape:ch05-2a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A country with a continuing current account deficit needs capital inflows to pay for it, or it uses up its foreign currency reserves. Either way, market confidence can fall and the currency may weaken sooner."}]}]}}, "index": "aPhrr", "typeName": "shape"}, {"meta": {}, "id": "binding:SEIeyGZR58O9E82LVvjju", "type": "arrow", "fromId": "shape:ch05-3g", "toId": "shape:ch05-3c", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-1z", "type": "text", "parentId": "shape:ch05-1w", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5 of 15  ·  Part 1 of 2"}]}]}}, "index": "a3Aj6", "typeName": "shape"}, {"meta": {}, "id": "binding:R8G0LYAOcBWHLp3_3e2C8", "type": "arrow", "fromId": "shape:ch05-1d", "toId": "shape:ch05-19", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-5a", "type": "note", "parentId": "shape:ch05-53", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Name one secular trend you have seen in your own life. Which industry lost value because of it?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a76k6", "typeName": "shape"}, {"meta": {}, "id": "binding:TmHehg78PQJA2vyLO-eZC", "type": "arrow", "fromId": "shape:ch05-3e", "toId": "shape:ch05-3a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 570, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-a", "type": "geo", "parentId": "shape:ch05-3", "props": {"w": 490, "h": 384, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Macroeconomics: the big picture", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The whole economy: aggregate supply and demand"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "GDP, unemployment, price levels, inflation, savings, investment"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Shaped by public policy: "}, {"type": "text", "text": "government", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (fiscal policy) and "}, {"type": "text", "text": "central bank", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (monetary policy)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Covers trade, balance of payments, exchange rates, links between economies"}]}]}]}]}}, "index": "a7yFU", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-4a", "type": "geo", "parentId": "shape:ch05-45", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulators' websites", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "SEBI, RBI, Ministry of Finance"}]}]}}, "index": "a5yNX", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch05-5b", "type": "note", "parent