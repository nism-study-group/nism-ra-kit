019, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Research, plus custom reports on request (competition, mergers and acquisitions)"}]}]}}, "index": "ad3Cn", "typeName": "shape"}, {"x": 56, "y": 1547.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-29", "type": "geo", "parentId": "shape:ch01-1z", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "During", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Independence and neutrality", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Stay unbiased. Base views on facts, not personal leanings. Tell management "}, {"type": "text", "text": "not to reveal information that is not public", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aABK2", "typeName": "shape"}, {"x": 570, "y": 1912.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1x", "type": "geo", "parentId": "shape:ch01-1d", "props": {"w": 490, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Quantitative", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Things captured as numbers", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Balance sheet, profit and loss, cash flows"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Assets and liabilities"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Also non-financial numbers: production, capacity utilisation, employee productivity, geographic spread, market share"}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Chapter 8"}]}]}}, "index": "aJ7Dz", "typeName": "shape"}, {"x": 4620, "y": 1727.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2y", "type": "frame", "props": {"w": 1400, "h": 1383.9199999999983, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "a5PIz", "typeName": "shape"}, {"x": 56, "y": 1533.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-c", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four levels, each with its own sources"}]}]}}, "index": "a9vlU", "typeName": "shape"}, {"x": 1084, "y": 2584.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-19", "type": "note", "parentId": "shape:ch01-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Picture three food critics. The "}, {"type": "text", "text": "sell-side", "marks": [{"type": "bold"}]}, {"type": "text", "text": " analyst writes a newspaper review anyone can read. The "}, {"type": "text", "text": "buy-side", "marks": [{"type": "bold"}]}, {"type": "text", "text": " analyst is the head chef's own taster, and only the kitchen hears the verdict. The "}, {"type": "text", "text": "independent", "marks": [{"type": "bold"}]}, {"type": "text", "text": " analyst runs a paid food newsletter."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 264, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aery2", "typeName": "shape"}, {"x": 1084, "y": 1912.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1y", "type": "note", "parentId": "shape:ch01-1d", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market share", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "capacity utilisation", "marks": [{"type": "bold"}]}, {"type": "text", "text": " are not money figures, but they are still "}, {"type": "text", "text": "quantitative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Brand power and management quality are "}, {"type": "text", "text": "qualitative", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 120, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aKswX", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2z", "type": "geo", "parentId": "shape:ch01-2y", "props": {"w": 128, "h": 12