"}]}]}}, "index": "aHEdM", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3h", "type": "note", "parentId": "shape:ch01-3c", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A sell-side analyst's firm also runs that company's IPO. What could go wrong? How do the client-writing rules help?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5FuE", "typeName": "shape"}, {"meta": {}, "id": "binding:-KlIE7urh2G5A1mor96Ro", "type": "arrow", "fromId": "shape:ch01-n", "toId": "shape:ch01-j", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 2379.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-q", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analysts are sorted by "}, {"type": "text", "text": "who they work for", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "who reads their work", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aLGDQ", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1g", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 1 of 15"}]}]}}, "index": "a366Q", "typeName": "shape"}, {"x": 930.6666666666666, "y": 2064.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2h", "type": "geo", "parentId": "shape:ch01-1z", "props": {"w": 413.3333333333333, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Record with consent", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recording devices are fine for meetings and client calls, but "}, {"type": "text", "text": "only after taking consent", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aIvDQ", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3i", "type": "note", "parentId": "shape:ch01-3c", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Name one qualitative and one quantitative factor for a company you know. Swap and check each other."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6Pvb", "typeName": "shape"}, {"x": 56, "y": 2451.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-r", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sell-side, buy-side, independent"}]}]}}, "index": "aMROA", "typeName": "shape"}, {"meta": {}, "id": "binding:OHGLf9kcdVxIcfk3MU6kn", "type": "arrow", "fromId": "shape:ch01-1n", "toId": "shape:ch01-1l", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1h", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analysts work "}, {"type": "text", "text": "top down", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". First the economy, then the industry, then the single company. Each layer sets the stage for the next."}]}]}}, "index": "a43t6", "typeName": "shape"}, {"x": 56, "y": 2264.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2i", "type": "text", "parentId": "shape:ch01-1z", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The overall expectation: work with sincerity, honesty and ethics, without bias, and follow SEBI rules "}, {"type": "text", "text": "in letter and in spirit", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aJPAf", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3j", "type": "note", "parentId": "shape:ch01-3c", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Management tells you sales will double next year. List three people outside the company you would call to check."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7kj6", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3", "type": "frame", "props": {"w": 1400, "h": 3619.2000000000007, "name": "1.1 What does an analyst do?", "color": "black"}, "parentId": "page:page", "index": "a1kFr", "typeName": "shape"}, {"x": 56, "y": 2526.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-s", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The key difference: who gets to read the report"}]}]}}, "index": "aNTnE", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1i", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The top-down funnel"}]}]}}, "index": "a5E6f", "typeName": "shape"}, {"x": 1084, "y": 2264.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2j", "type": "note", "parentId": "shape:ch01-1z", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Conflict of interest is disclosed "}, {"type": "text", "text": "before", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not after. Recording needs "}, {"type": "text", "text": "consent", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The key contact is not always a top manager."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aKadA", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3k", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 1: The research analyst profession"}]}]}}, "index": "a7LUJ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-4", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1XcI", "typeName": "shape"}, {"x": 56, "y": 2584.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-t", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 103.29380764163373, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "fo