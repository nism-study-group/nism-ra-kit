 "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analyse: qualitative", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Efficiency, competitiveness, business plans, management ethics"}]}]}}, "index": "aGGcM", "typeName": "shape"}, {"x": 712, "y": 1547.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2a", "type": "geo", "parentId": "shape:ch01-1z", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Around", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Network", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Talk to experts, competitors, suppliers, distributors, retailers and customers. The best contact is the person who knows the "}, {"type": "text", "text": "heartbeat", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the company. That may "}, {"type": "text", "text": "not", "marks": [{"type": "bold"}]}, {"type": "text", "text": " be top management."}]}]}}, "index": "aBUgk", "typeName": "shape"}, {"x": 384, "y": 1023.9199999999983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3b", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Disclose conflicts beforehand. Record only with consent."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDFVI", "typeName": "shape"}, {"x": 755, "y": 2060.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-k", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analyse: quantitative", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Revenue, costs, profit, and the risks to these numbers"}]}]}}, "index": "aH51M", "typeName": "shape"}, {"meta": {}, "id": "binding:GyrhSjsMhvw_kWS6PBfXt", "type": "arrow", "fromId": "shape:ch01-m", "toId": "shape:ch01-i", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 3214, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1a", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Besides these three, "}, {"type": "text", "text": "newspapers, media and information consolidators", "marks": [{"type": "bold"}]}, {"type": "text", "text": " also publish research."}]}]}}, "index": "afxRb", "typeName": "shape"}, {"x": 56, "y": 1821.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2b", "type": "text", "parentId": "shape:ch01-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Five rules for writing to clients"}]}]}}, "index": "aCplv", "typeName": "shape"}, {"x": 6160, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3c", "type": "frame", "props": {"w": 1400, "h": 618.4799999999959, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "a6iL6", "typeName": "shape"}, {"x": 1104.5, "y": 2060.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-l", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Decide", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Buy, hold or sell"}]}]}}, "index": "aIMLM", "typeName": "shape"}, {"x": 56, "y": 3272, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1b", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book sums up the role in one word: the analyst is a "}, {"type": "text", "text": "selector", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". They study the company's past, judge its future, and recommend."}]}]}}, "index": "agN4b", "typeName": "shape"}, {"x": 56, "y": 1896.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2c", "type": "geo", "parentI