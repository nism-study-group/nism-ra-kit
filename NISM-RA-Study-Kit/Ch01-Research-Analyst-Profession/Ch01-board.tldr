le": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What does an analyst do?"}]}]}}, "index": "a2NV6", "typeName": "shape"}, {"x": 167.29380764163375, "y": 2584.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-u", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 236.28458498023718, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sell-side", "marks": [{"type": "bold"}]}]}]}}, "index": "aPbeU", "typeName": "shape"}, {"x": 56, "y": 459, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1k", "type": "geo", "parentId": "shape:ch01-1d", "props": {"w": 356, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Economy", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "National income, inflation, interest rates, unemployment. Fiscal and monetary policy. FDI and FPI flows. Savings and investment. Global trade effects on GDP."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Chapter 5"}]}]}}, "index": "a7puE", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2l", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "