: 1, "meta": {}, "id": "shape:ch01-1l", "type": "geo", "parentId": "shape:ch01-1d", "props": {"w": 356, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Industry", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Regulation, business models, competition, operating factors, how demand reacts to price, consumer behaviour."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Chapter 6"}]}]}}, "index": "a8F9n", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2m", "type": "text", "parentId": "shape:ch01-2k", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What makes a good one?"}]}]}}, "index": "a2Yaj", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3n", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aA8gf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-7", "type": "note", "parentId": "shape:ch01-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "You want a new phone. You fix a budget, shortlist brands, compare battery and camera, and pick one. That is research and analysis. An analyst does the same thing for shares and bonds, on behalf of clients."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a4scE", "typeName": "shape"}, {"x": 686.8511198945982, "y": 2584.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-w", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 373.1488801054019, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Independent", "marks": [{"type": "bold"}]}]}]}}, "index": "aRl2X", "typeName": "shape"}, {"x": 988, "y": 459, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1m", "type": "geo", "parentId": "shape:ch01-1d", "props": {"w": 356, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Qualitative side and quantitative side."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Chapters 7 and 8"}]}]}}, "index": "a9sg2", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2n", "type": "text", "parentId": "shape:ch01-2k", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 1 of 15"}]}]}}, "index": "a3bxb", "typeName": "shape"}, {"x": 6160, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3o", "type": "note", "parentId": "page:page", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An everyday picture of the idea"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aBzPN", "typeName": "shape"}, {"x": 56, "y": 757.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-8", "type": "text", "parentId": "shape:ch01-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The job has two halves."}]}]}}, "index": "a5eS6", "typeName": "shape"}, {"x": 56, "y": 2670.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-x", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 103.29380764163373, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor