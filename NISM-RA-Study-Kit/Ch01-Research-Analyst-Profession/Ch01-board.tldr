 "index": "a8ONE", "typeName": "shape"}, {"x": 56, "y": 1837.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1v", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two ways to look at a company"}]}]}}, "index": "aHwWI", "typeName": "shape"}, {"x": 712, "y": 659.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-38", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Always cross-verify management claims. Management may exaggerate."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAwLj", "typeName": "shape"}, {"x": 712, "y": 539, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2w", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Written and verbal communication", "marks": [{"type": "bold"}]}]}]}}, "index": "aCP6b", "typeName": "shape"}, {"x": 1084, "y": 815.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-a", "type": "note", "parentId": "shape:ch01-3", "props": {"color": "light-blue", "richText": {"type": "doc", 