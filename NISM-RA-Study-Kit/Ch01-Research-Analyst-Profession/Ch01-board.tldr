ype": "paragraph", "content": [{"type": "text", "text": "The seven qualities listed in the book"}]}]}}, "index": "a5Xtz", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3q", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aDdLj", "typeName": "shape"}, {"x": 411.57839262187093, "y": 2670.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-z", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 267.27272727272725, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mutual funds, hedge funds, pension funds, AIFs, FPIs, portfolio managers"}]}]}}, "index": "aUPAb", "typeName": "shape"}, {"x": 686.8511198945982, "y": 2670.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-10", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 373.1488801054019, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Boutique research firms, separate from full-service firms"}]}]}}, "index": "aVKy6", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-21", "type": "text", "parentId": "shape:ch01-1z", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How do they talk to people?"}]}]}}, "index": "a2gAb", "typeName": "shape"}, {"x": 56, "y": 793, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1p", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why the economy first?"}]}]}}, "index": "aBeVM", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-32", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " The role of an analyst is to help clients take "}, {"type": "text", "text": "informed decisions", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Financial planning is a different job (investment adviser)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4I6f", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2q", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Good with numbers", "marks": [{"type": "bold"}]}]}]}}, "index": "a63pI", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-3r", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aENfQ", "typeName": "shape"}, {"x": 56, "y": 2804.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-11", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 103.29380764163373, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Who reads it", "marks": [{"type": "bold"}]}]}]}}, "index": "aWgOb", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-22", "type": "text", "parentId": "shape:ch01-1z", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 1 of 15"}]}]}}, "index": "a3nqn", "typeName": "shape"}, {"x": 56, "y": 868, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1q", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company growth depends on the economy around it. The book quotes "}, {"type": "text", "text": "John Maynard Keynes", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (1883 to 1946): governments can change economic performance by adjusting "}, {"type": "text", "text": "tax rates", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "government spending", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aC2NQ", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-33", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " The SEBI definition says "}, {"type": "text", "text": "for consideration", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "includes part-time", "marks": [{"type": "bold"}]}, {"type": "text", "text": " analysts."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5ytv", "typeName": "shape"}, {"x": 384, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2r", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Excel and data tools", "marks": [{"type": "bold"}]}]}]}}, "index": "a7a0X", "typeName": "shape"}, {"meta": {}, "id": "binding:QTcgQU8eHA9tBAqcKDBQh", "type": "arrow", "fromId": "shape:ch01-o", "toId": "shape:ch01-k", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 167.29380764163375, "y": 2804.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-12", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 236.28458498023718, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The public.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Reports are published."}]}]}}, "index": "aXr8b", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-23", "type": "text", "parentId": "shape:ch01-1z", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The internet gives a lot of data. It still cannot replace talking to the company directly. But there is a catch."}]}]}}, "index": "a4pjn", "typeName": "shape"}, {"x": 56, "y": 972, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1r", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why the industry next?"}]}]}}, "index": "aDm0n", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-34", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sell-side: public reports with a price target. Buy-side: internal only. Independent: sold by subscription."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a61ff", "typeName": "shape"}, {"x": 712, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2s", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Clear on finance concepts", "marks": [{"type": "bold"}]}]}]}}, "index": "a8P9A", "typeName": "shape"}, {"meta": {}, "id": "binding:awH7HDwd-BJTY_evVSGGE", "type": "arrow", "fromId": "shape:ch01-1o", "toId": "shape:ch01-1l", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 411.57839262187093, "y": 2804.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-13", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 267.27272727272725, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Only insiders.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Fund managers and top management."}]}]}}, "index": "aYF1Q", "typeName": "shape"}, {"x": 1084, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-24", "type": "note", "parentId": "shape:ch01-1z", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why cross-check?", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Management may paint a "}, {"type": "text", "text": "rosy picture", "marks": [{"type": "bold"}]}, {"type": "text", "text": " so analysts write positive reports and push the share price up. So the analyst must "}, {"type": "text", "text": "cross-verify management's claims", "marks": [{"type": "bold"}]}, {"type": "text", "text": " before recommending."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 168, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a5t4j", "typeName": "shape"}, {"x": 56, "y": 1047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1s", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Each industry has different problems and different growth drivers. A bank and a cement maker live by different rules."}]}]}}, "index": "aEqH6", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-35", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Economic data: government and RBI. Global data: IMF, ADB, World Bank."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7pjE", "typeName": "shape"}, {"x": 1040, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2t", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reads financial statements", "marks": [{"type": "bold"}]}]}]}}, "index": "a9jen", "typeName": "shape"}, {"meta": {}, "id": "binding:TymnqnAP8rt_TEOOZGpgq", "type": "arrow", "fromId": "shape:ch01-1n", "toId": "shape:ch01-1k", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 686.8511198945982, "y": 2804.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-14", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 373.1488801054019, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Paying subscribers.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Investors, institutions, investment bankers, regulators, exchanges, fund managers."}]}]}}, "index": "aZ52n", "typeName": "shape"}, {"x": 1084, "y": 726.4000000000015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-25", "type": "note", "parentId": "shape:ch01-1z", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Meeting management is like interviewing a job candidate. You read the CV first, you bring prepared questions, you call references, and you do not believe everything you hear."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 168, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a6JYE", "typeName": "shape"}, {"x": 56, "y": 1119, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1t", "type": "text", "parentId": "shape:ch01-1d", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why each company separately?"}]}]}}, "index": "aFXzu", "typeName": "shape"}, {"x": 56, "y": 659.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-36", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Keynes: governments change performance through "}, {"type": "text", "text": "tax rates and government spending", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8cQM", "typeName": "shape"}, {"x": 56, "y": 539, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2u", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Asks pertinent questions", "marks": [{"type": "bold"}]}]}]}}, "index": "aAfxU", "typeName": "shape"}, {"x": 56, "y": 2938.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-15", "type": "geo", "parentId": "shape:ch01-3", "props": {"w": 103.29380764163373, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What it contains", "marks": [{"type": "bold"}]}]}]}}, "index": "aaZ4I", "typeName": "shape"}, {"x": 56, "y": 1244.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-26", "type": "text", "parentId": "shape:ch01-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four rules for meeting a company"}]}]}}, "index": "a7UVzV", "typeName": "shape"}, {"x": 56, "y": 1194, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-1u", "type": "note", "parentId": "shape:ch01-1d", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Rahul Dravid and Virender Sehwag were both great batsmen. One was defensive, one was aggressive. Who does better depends on the pitch and the bowlers, and even then only as a probability. Companies in the same industry also play very differently."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 264, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aGE5j", "typeName": "shape"}, {"x": 384, "y": 659.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-37", "type": "note", "parentId": "shape:ch01-2y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Market share and capacity utilisation are quantitative, even though they are not money figures."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9cmn", "typeName": "shape"}, {"x": 384, "y": 539, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch01-2v", "type": "geo", "parentId": "shape:ch01-2k", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flip