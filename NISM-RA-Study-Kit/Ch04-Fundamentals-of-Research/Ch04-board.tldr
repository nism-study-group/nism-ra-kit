 "a7aun", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2k", "type": "text", "parentId": "shape:ch04-2i", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Commodity research"}]}]}}, "index": "a2qOj", "typeName": "shape"}, {"x": 56, "y": 2000, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3l", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What pushes the price up or down"}]}]}}, "index": "aTt4M", "typeName": "shape"}, {"x": 912.9917355371902, "y": 3103, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4m", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 431.0082644628099, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Hurricanes in the Gulf of Mexico"}]}]}}, "index": "b04kOA", "typeName": "shape"}, {"x": 1040, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5n", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A trend without volume support may be weak. A break on strong volume signals a stronger trend."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBv1I", "typeName": "shape"}, {"x": 238.44444444444446, "y": 727, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1k", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 259.4861111111111, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Less suited to long-term investing"}]}]}}, "index": "aQrrU", "typeName": "shape"}, {"x": 56, "y": 581, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-p", "type": "text", "parentId": "shape:ch04-h", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.2.1. One is forbidden, the other is good research."}]}]}}, "index": "a8tUq", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2l", "type": "text", "parentId": "shape:ch04-2i", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 4 of 15"}]}]}}, "index": "a3YBn", "typeName": "shape"}, {"x": 56, "y": 2075, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3m", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "From the book's two tables. Watch the rows that differ."}]}]}}, "index": "aUBiM", "typeName": "shape"}, {"x": 56, "y": 3207, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4n", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "grey", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Blank cells: the book lists that factor for only one of the two. Highlighted cells: the two commodities move opposite ways."}]}]}}, "index": "b05Mlv", "typeName": "shape"}, {"x": 6160, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-60", "type": "frame", "props": {"w": 1400, "h": 1128.8800000000047, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "a9f2A", "typeName": "shape"}, {"x": 56, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5o", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Fundamental analysis is long term and contradicts the Efficient Market Hypothesis."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCdtA", "typeName": "shape"}, {"meta": {}, "id": "binding:hUULw6j8pck6tWaM3zazy", "type": "arrow", "fromId": "shape:ch04-20", "toId": "shape:ch04-1x", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"meta": {}, "id": "binding:78MeZOkt6EtfHzblybKer", "type": "arrow", "fromId": "shape:ch04-28", "toId": "shape:ch04-25", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 505.93055555555554, "y": 727, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1l", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 303.09722222222223, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Hard to estimate fair value"}]}]}}, "index": "aRv22", "typeName": "shape"}, {"x": 56, "y": 639, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-q", "type": "geo", "parentId": "shape:ch04-h", "props": {"w": 490, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Not allowed", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Insider information", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Material, non-public, price-sensitive information. Known only to a few people close to the company (or their relatives). Once published, it would immediately affect decisions to buy or sell."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Book example:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " the CEO talks about an "}, {"type": "text", "text": "unpublished acquisition proposal", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a9xU1", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2m", "type": "text", "parentId": "shape:ch04-2i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Commodity fundamental analysis studies the economic, political and natural factors that move "}, {"type": "text", "text": "supply and demand", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and so the price. It covers seasonality, macro conditions, news, currency moves, interest rates, weather, inventory levels and government action."}]}]}}, "index": "a4qyU", "typeName": "shape"}, {"x": 56, "y": 2133, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3n", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Factor", "marks": [{"type": "bold"}]}]}]}}, "index": "aV7z7", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-50", "type": "geo", "parentId": "shape:ch04-4z", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.10", "marks": [{"type": "bold"}]}]}]}}, "index": "a1IFQ", "typeName": "shape"}, {"x": 1084, "y": 3207, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4o", "type": "note", "parentId": "shape:ch04-2s", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "weak", "marks": [{"type": "bold"}]}, {"type": "text", "text": " economy and a "}, {"type": "text", "text": "falling", "marks": [{"type": "bold"}]}, {"type": "text", "text": " stock market push gold "}, {"type": "text", "text": "up", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (safe haven). The same conditions push crude "}, {"type": "text", "text": "down", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (less demand). A weaker dollar helps "}, {"type": "text", "text": "both", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "b06rxv", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-61", "type": "geo", "parentId": "shape:ch04-60", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a1jX6", "typeName": "shape"}, {"x": 384, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5p", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Fundamental analysis has three baskets: economy, industry, company."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDxTn", "typeName": "shape"}, {"meta": {}, "id": "binding:2tgvz5iR6YDc3ji6bvovr", "type": "arrow", "fromId": "shape:ch04-1z", "toId": "shape:ch04-1x", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 817.0277777777778, "y": 727, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1m", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 307.4583333333333, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Past data loses meaning when accounting or business models change"}]}]}}, "index": "aSl2j", "typeName": "shape"}, {"meta": {}, "id": "binding:T7irfieB2t5s0GZihxzLp", "type": "arrow", "fromId": "shape:ch04-5a", "toId": "shape:ch04-58", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 570, "y": 639, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-r", "type": "geo", "parentId": "shape:ch04-h", "props": {"w": 490, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Allowed", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Mosaic analysis", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Joining many small pieces, each not significant alone, with other public or non-public information, to reach a useful insight."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Book example:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " an employee mentions a "}, {"type": "text", "text": "heavier workload in the purchase department", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", which may hint at more business."}]}]}}, "index": "aAywn", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2n", "type": "text", "parentId": "shape:ch04-2i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What moves commodity prices"}]}]}}, "index": "a5lRA", "typeName": "shape"}, {"x": 484.4958677685951, "y": 2477, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-40", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unstable"}]}]}}, "index": "ai2EA", "typeName": "shape"}, {"x": 484.4958677685951, "y": 2133, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3o", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Gold goes up when...", "marks": [{"type": "bold"}]}]}]}}, "index": "aWO1b", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-51", "type": "text", "parentId": "shape:ch04-4z", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How commodities move shares"}]}]}}, "index": "a2hUJ", "typeName": "shape"}, {"x": 1084, "y": 3617.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4p", "type": "note", "parentId": "shape:ch04-2s", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Gold is an umbrella: people reach for it when the weather turns bad. Crude oil is fuel for the car: people buy more of it when business is busy and everyone is on the move."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 120, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "b07gyM", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-62", "type": "text", "parentId": "shape:ch04-60", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a2fcX", "typeName": "shape"}, {"x": 712, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5q", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Pure quantitative analysis is limited by changing accounting standards and business models."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aE8cj", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3", "type": "frame", "props": {"w": 1400, "h": 1694.7999999999993, "name": "4.1 What is investing?", "color": "black"}, "parentId": "page:page", "index": "a1Uva", "typeName": "shape"}, {"x": 1132.486111111111, "y": 727, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1n", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 211.51388888888889, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Biases are hard to measure"}]}]}}, "index": "aTkFj", "typeName": "shape"}, {"x": 56, "y": 580, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-30", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 853.3333333333334, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sector", "marks": [{"type": "bold"}]}]}]}}, "index": "a8bvn", "typeName": "shape"}, {"x": 1084, "y": 639, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-s", "type": "note", "parentId": "shape:ch04-h", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How to tell them apart", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Not every non-public fact is insider information. The book says it depends on three things: the "}, {"type": "text", "text": "source", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (how reliable), the "}, {"type": "text", "text": "impact", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and the "}, {"type": "text", "text": "certainty", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the information. Analysts must check whether an insight came from their own mosaic or from being told a specific price-sensitive secret."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 360, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aBnI2", "typeName": "shape"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2o", "type": "text", "parentId": "shape:ch04-2i", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "au