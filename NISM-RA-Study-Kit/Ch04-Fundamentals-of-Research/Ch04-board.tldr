": "bold"}]}, {"type": "text", "text": ": a level with a lot of buying interest. "}, {"type": "text", "text": "Resistance", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": a level with a lot of selling interest. Near resistance, a holder may book profits, since prices tend to pull back."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A break of support or resistance on "}, {"type": "text", "text": "strong volume", "marks": [{"type": "bold"}]}, {"type": "text", "text": " may mean the trend has sped up. A trend without volume support may be weak."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Charts used: "}, {"type": "text", "text": "line, bar and candlestick", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Moving averages", "marks": [{"type": "bold"}]}, {"type": "text", "text": " smooth out day-to-day price swings so the trend is easier to see."}]}]}]}]}}, "index": "aYv7A", "typeName": "shape"}, {"x": 917.3333333333334, "y": 752, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-35", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 426.6666666666667, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "24%"}]}]}}, "index": "aDWCX", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-x", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scal