{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.group": 0, "com.tldraw.shape.text": 4, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.geo": 12, "com.tldraw.shape.note": 13, "com.tldraw.shape.line": 5, "com.tldraw.shape.frame": 1, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.embed": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"name": "", "color": "#F04F88", "imageUrl": "", "meta": {}, "id": "user:I5Y9hmMK0Xt4RjzWg-ajj", "typeName": "user"}, {"x": 238.44444444444446, "y": 641, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1f", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 259.4861111111111, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Short term"}]}]}}, "index": "aLpPb", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-k", "type": "text", "parentId": "shape:ch04-h", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 4 of 15"}]}]}}, "index": "a3fWn", "typeName": "shape"}, {"x": 56, "y": 4151.799999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2g", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Decisions should follow the evidence, but they are often bent by the decision maker's biases, leading to poor choices. This approach assumes that prices move away from fair value, up or down, because of the "}, {"type": "text", "text": "fear and greed", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of market participants."}]}]}}, "index": "aupHz", "typeName": "shape"}, {"x": 712, "y": 1526, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3h", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Brent", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Brent", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Benchmark for crude from "}, {"type": "text", "text": "Europe and Africa", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", from the North Sea (UK). API 38°, sulphur 0.4%. Trades on "}, {"type": "text", "text": "ICE", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aPoQr", "typeName": "shape"}, {"x": 484.4958677685951, "y": 3017, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4i", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower bond yields"}]}]}}, "index": "b00zbzV", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5j", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Research = gathering information. Analysis = processing it into a conclusion."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7fDU", "typeName": "shape"}, {"x": 505.93055555555554, "y": 641, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1g", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 303.09722222222223, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Long term"}]}]}}, "index": "aMygE", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-l", "type": "text", "parentId": "shape:ch04-h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A fundamental analyst's job has two parts. "}, {"type": "text", "text": "Research", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is getting all the information needed to answer a question. "}, {"type": "text", "text": "Analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is working through that information to reach a conclusion."}]}]}}, "index": "a4Gef", "typeName": "shape"}, {"x": 56, "y": 4273.799999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2h", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book says the biases are covered \"in Chapter 11\". In this edition they appear in Chapter 12 (Fundamentals of Risk and Return)."}]}]}}, "index": "av2Iv", "typeName": "shape"}, {"x": 56, "y": 1724, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3i", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Top producers", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "USA, Russia, Saudi Arabia, Canada, China"}]}]}}, "index": "aQX2z", "typeName": "shape"}, {"x": 912.9917355371902, "y": 3017, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4j", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 431.0082644628099, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "b01DLI", "typeName": "shape"}, {"x": 56, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5k", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Mosaic analysis is allowed. Insider information (material, non-public, price-sensitive) is not."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a81bv", "typeName": "shape"}, {"x": 817.0277777777778, "y": 641, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1h", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 307.4583333333333, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Either"}]}]}}, "index": "aN2of", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-m", "type": "text", "parentId": "shape:ch04-h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The annual report is a treasure trove, but it is not enough. It comes out once a year, so it goes out of date, and it says little about the industry and economy. So analysts also:"}]}]}}, "index": "a5u8b", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2i", "type": "frame", "props": {"w": 1400, "h": 961, "name": "4.7 Commodity research", "color": "black"}, "parentId": "page:page", "index": "a4872", "typeName": "shape"}, {"x": 712, "y": 1724, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3j", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Top consumers", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "USA, China, "}, {"type": "text", "text": "India", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", Germany, Japan"}]}]}}, "index": "aRfyE", "typeName": "shape"}, {"x": 56, "y": 3103, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4k", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Weather", "marks": [{"type": "bold"}]}]}]}}, "index": "b025Cr", "typeName": "shape"}, {"x": 384, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5l", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Whether information is \"insider\" depends on its source, impact and certainty."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9AAf", "typeName": "shape"}, {"x": 1132.486111111111, "y": 641, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1i", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 211.51388888888889, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Either"}]}]}}, "index": "aOZGA", "typeName": "shape"}, {"x": 56, "y": 402, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-n", "type": "text", "parentId": "shape:ch04-h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Secondary research:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " talk to industry experts, buy market research reports, track the economy and competitors."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Primary research:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " visit company facilities, speak to customers, suppliers and employees."}]}]}]}]}}, "index": "a6Uly", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2j", "type": "geo", "parentId": "shape:ch04-2i", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.7", "marks": [{"type": "bold"}]}]}]}}, "index": "a1YUe", "typeName": "shape"}, {"x": 56, "y": 1864, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3k", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supply is controlled by the US and "}, {"type": "text", "text": "OPEC+", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (13 OPEC members plus Russia). The Middle East holds "}, {"type": "text", "text": "48%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of known oil reserves. The book also says OPEC owns almost 40% of the world's crude oil, accounts for 75% of proven reserves and exports 55% of the oil sold worldwide."}]}]}}, "index": "aSdR2", "typeName": "shape"}, {"meta": {}, "id": "binding:vtXjWB_icx3c1kR0zrrp0", "type": "arrow", "fromId": "shape:ch04-29", "toId": "shape:ch04-26", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 484.4958677685951, "y": 3103, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4l", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": ""