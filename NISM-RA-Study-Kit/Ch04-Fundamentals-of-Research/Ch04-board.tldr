t", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " If markets were fully efficient, would research analysts have a job?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6MC6", "typeName": "shape"}, {"x": 712, "y": 1315.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5u", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Gold rises in a bear stock market; crude rises in a bull stock market."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aInwU", "typeName": "shape"}, {"meta": {}, "id": "binding:2vklgRSml6m_ry2jdY8pr", "type": "arrow", "fromId": "shape:ch04-20", "toId": "shape:ch04-1y", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"meta": {}, "id": "binding:ybxUEfRTg0WZVZTJNACBb", "type": "arrow", "fromId": "shape:ch04-29", "toId": "shape:ch04-27", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 817.0277777777778, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-12", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 307.4583333333333, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Quantitative", "marks": [{"type": "bold"}]}]}]}}, "index": "a8RcU", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-7", "type": "text", "parentId": "shape:ch04-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investing", "marks": [{"type": "bold"}]}, {"type": "text", "text": " means putting money in upfront to earn returns over a period. It needs careful study of the security's safety, income and growth potential."}]}]}}, "index": "a4Lsf", "typeName": "shape"}, {"x": 56, "y": 2846.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-23", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Questions fundamental analysts ask: Is the economic trend helping the industry? How intense is competition? How is the company placed against rivals? What is its cost structure? Is its finance strong enough to grow or survive a crisis? Is management capable? Is governance protecting shareholders?"}]}]}}, "index": "aiRCU", "typeName": "shape"}, {"x": 56, "y": 1148, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1r", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. "}, {"type": "text", "text": "Past prices", "marks": [{"type": "bold"}]}, {"type": "text", "text": " show the underlying trend and its direction."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. "}, {"type": "text", "text": "Volume", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shows the strength of the trend."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. "}, {"type": "text", "text": "Time span", "marks": [{"type": "bold"}]}, {"type": "text", "text": " over which price and volume carry the impact of long-term factors."}]}]}}, "index": "aXrSA", "typeName": "shape"}, {"x": 56, "y": 752, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-34", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 853.3333333333334, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investment", "marks": [{"type": "bold"}]}]}]}}, "index": "aCjHb", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-w", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four approaches to research"}]}]}}, "index": "a25aX", "typeName": "shape"}, {"x": 3080, "y": 1889.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2s", "type": "frame", "props": {"w": 1400, "h": 4089.800000000003, "name": "4.8 Case studies: gold and crude oil", "color": "black"}, "parentId": "page:page", "index": "a5bQX", "typeName": "s