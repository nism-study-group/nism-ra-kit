", "content": [{"type": "text", "text": "Going economy first, then industry, then company is the top-down path (E-I-C) seen in Chapter 1."}]}]}}, "index": "aovi2", "typeName": "shape"}, {"x": 712, "y": 1028, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3b", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Top consumers", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "China, "}, {"type": "text", "text": "India", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", USA, Germany, Saudi Arabia"}]}]}}, "index": "aJxrr", "typeName": "shape"}, {"x": 484.4958677685951, "y": 2845, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4c", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Expansionary (rate cuts)"}]}]}}, "index": "auYKv", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5d", "type": "geo", "parentId": "shape:ch04-5c", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "m