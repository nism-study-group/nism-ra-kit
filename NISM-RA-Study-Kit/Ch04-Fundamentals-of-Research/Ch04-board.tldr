index": "aHzTL", "typeName": "shape"}, {"x": 712, "y": 1404.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-g", "type": "geo", "parentId": "shape:ch04-3", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.1.2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Passive", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Buys a broad set that represents the asset class, usually "}, {"type": "text", "text": "all the stocks in an index", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". No picking of individual securities."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Goal:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " earn the return of the asset class."}]}]}}, "index": "aDC7b", "typeName": "shape"}, {"x": 56, "y": 3313.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2c", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Some analysts approach shares purely through numbers. This works for both technical and fundamental analysis:"}]}]}}, "index": "aqFIn", "typeName": "shape"}, {"x": 56, "y": 1257, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3d", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Called the \"mother of the global financial market\" and \"black gold\". Uses: fuel, plastics (polymers), lubricating oil, naphtha, bitumen. Distilled at different temperatures, it gives bitumen, lubricating oils, fuel oil, diesel, paraffin, naphtha and gasoline. Any supply and demand imbalance raises inflation worries around the world."}]}]}}, "index": "aLFTA", "typeName": "shape"}, {"x": 56, "y": 2931, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4e", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation", "marks": [{"type": "bold"}]}]}]}}, "index": "awTUq", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5f", "type": "text", "parentId": "shape:ch04-5c", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read these the night before. Each one is a question waiting to happen"}]}]}}, "index": "a37sz", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-6g", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aHqGv", "typeName": "shape"}, {"x": 817.0277777777778, "y": 507, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1c", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 307.4583333333333, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Some metrics may be leading indicators of performance"}]}]}}, "index": "aIEI6", "typeName": "shape"}, {"x": 0, "y": 2623.399999999999, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-h", "type": "frame", "props": {"w": 1400, "h": 1896.199999999997, "name": "4.2 Why research?", "color": "black"}, "parentId": "page:page", "index": "a2d9E", "typeName": "shape"}, {"x": 56, "y": 3371.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2d", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technical:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " study the data behind the charts, such as up moves versus down moves and volume."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fundamental:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " look for financial and operating metrics that may lead company performance."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tools:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " time series analysis and regression to extrapolate earnings; econometrics; financial statement projections; sensitivity analysis and simulations to test assumptions."}]}]}]}]}}, "index": "arwmb", "typeName": "shape"}, {"x": 56, "y": 1379, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3e", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Crude quality depends on "}, {"type": "text", "text": "density", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "sulphur content", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aMY0X", "typeName": "shape"}, {"x": 484.4958677685951, "y": 2931, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4f", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Higher inflation"}]}]}}, "index": "ax7gQ", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5g", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Traders profit from price patterns without a change in value; investors look for growth in value. Speculation is short term."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a46Cf", "typeName": "shape"}, {"x": 1132.486111111111, "y": 507, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1d", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 211.51388888888889, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fear and greed push prices away from fair value"}]}]}}, "index": "aJL1Q", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-i", "type": "geo", "parentId": "shape:ch04-h", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1vvA", "typeName": "shape"}, {"x": 1084, "y": 3371.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2e", "type": "note", "parentId": "shape:ch04-u", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The main limit of a pure quantitative approach in fundamental analysis: "}, {"type": "text", "text": "comparable data is hard to get", "