t": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Mosaic analysis is like a detective noticing muddy shoes, a train ticket and a sunburn, and working out where someone went. Insider information is someone reading you their diary."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCwyj", "typeName": "shape"}, {"x": 56, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2p", "type": "geo", "parentId": "shape:ch04-2i", "props": {"w": 413.3333333333333, "h": 414, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supply", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Production", "marks": [{"type": "bold"}]}, {"type": "text", "text": " from farms, oil wells, mines"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Weather", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": floods, drought, cyclones"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Government policy", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": tariffs, levies, trade limits, subsidies"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Geopolitics", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": sanctions, wars, trade disputes"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Input costs", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": energy, wages, technology"}]}]}]}]}}, "index": "a7zK3", "typeName": "shape"}, {"x": 56, "y": 2563, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-42", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supply", "marks": [{"type": "bold"}]}]}]}}, "index": "akCqM", "typeName": "shape"}, {"x": 56, "y": 2219, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3q", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "US dollar", "marks": [{"type": "bold"}]}]}]}}, "index": "aYdWz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-53", "type": "text", "parentId": "shape:ch04-4z", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Many listed companies use commodities as raw material. When commodity prices change, their profit margins change, and so do their share prices."}]}]}}, "index": "a4rkI", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4r", "type": "geo", "parentId": "shape:ch04-4q", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.9", "marks": [{"type": "bold"}]}]}]}}, "index": "a1LXU", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-64", "type": "note", "parentId": "shape:ch04-60", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Are you more of a trader or an investor by temperament? What would change your mind?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4vUN", "typeName": "shape"}, {"x": 56, "y": 1315.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5s", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Higher interest rates strengthen the USD and lower commodity prices."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aG5Yb", "typeName": "shape"}, {"x": 238.44444444444446, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-10", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 259.4861111111111, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technical", "marks": [{"type": "bold"}]}]}]}}, "index": "a64I6", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5", "type": "text", "parentId": "shape:ch04-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What is investing?"}]}]}}, "index": "a2SWj", "typeName": "shape"}, {"x": 56, "y": 2310.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-21", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "So profit comes from finding a good business "}, {"type": "text", "text": "and", "marks": [{"type": "bold"}]}, {"type": "text", "text": " buying it at the right price."}]}]}}, "index": "aglGz", "typeName": "shape"}, {"x": 56, "y": 968, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1p", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technical analysts (also called "}, {"type": "text", "text": "chartists", "marks": [{"type": "bold"}]}, {"type": "text", "text": " or technicians) assume that everything, from company results to the economy to market mood, is already reflected in the price. They forecast price direction from patterns in past "}, {"type": "text", "text": "price and volume", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aVzwq", "typeName": "shape"}, {"x": 56, "y": 666, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-32", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 853.3333333333334, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Jewellery", "marks": [{"type": "bold"}]}]}]}}, "index": "aAtcQ", "typeName": "shape"}, {"x": 1540, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-u", "type": "frame", "props": {"w": 1400, "h": 4393.799999999996, "name": "4.3 to 4.6 Four approaches to research", "color": "black"}, "parentId": "page:page", "index": "a37pX", "typeName": "shape"}, {"x": 493.3333333333333, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2q", "type": "geo", "parentId": "shape:ch04-2i", "props": {"w": 413.3333333333333, "h": 414, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Demand", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Global growth", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": higher GDP, more demand for metals, energy, farm goods"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Population and cities", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": more food and energy used"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Substitution", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": switching between commodities"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Seasons", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": fuel in winter or summer, festive food"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tastes", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": organic food, renewables, electric vehicles"}]}]}]}]}}, "index": "a8006", "typeName": "shape"}, {"x": 484.4958677685951, "y": 2563, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-43", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower supply"}]}]}}, "index": "al8aU", "typeName": "shape"}, {"x": 484.4958677685951, "y": 2219, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3r", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": fa