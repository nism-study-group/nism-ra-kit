on": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-b", "type": "geo", "parentId": "shape:ch04-3", "props": {"w": 632, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investor", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Will this asset's value grow?\"", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Value rises if cash flow rises without the same rise in risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Or if risk falls without the same fall in cash flow"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Needs deeper analysis"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Longer horizon"}]}]}]}]}}, "index": "a8upr", "typeName": "shape"}, {"x": 700, "y": 516, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5a", "type": "arrow", "parentId": "shape:ch04-4z", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aAz4W", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-6b", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four ways to study a share: read the charts, study the business, crunch the data, or watch the people. Plus how commodities are studied."}]}]}}, "index": "aCyXf", "typeName": "shape"}, {"x": 56, "y": 749, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-c", "type": "geo", "parentId": "shape:ch04-3", "props": {"w": 1004, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Speculator", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": A trader betting on short-term price moves, based on a calculated guess."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chartist", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": A trader who relies on price patterns and charts."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Day trader", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": A trader whose whole buy and sell cycle is one day."}]}]}]}]}}, "index": "a98zB", "typeName": "shape"}, {"meta": {}, "id": "binding:Cc-gFOd-TDz0EEOTWcq7V", "type": "arrow", "fromId": "shape:ch04-5a", "toId": "shape:ch04-57", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 912.9917355371902, "y": 2759, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4a", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 431.0082644628099, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "asSg2", "typeName": "shape"}, {"x": 56, "y": 599, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5b", "type": "text", "parentId": "shape:ch04-4z", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Commodities are traded globally, so their prices signal changes in world demand and supply. Equity markets, which care about growth, react to those signals. Example: a "}, {"type": "text", "text": "fall in copper prices", "marks": [{"type": "bold"}]}, {"type": "text", "text": " may signal slowing industrial demand, dragging down metal and infrastructure stocks."}]}]}}, "index": "aBeuM", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-6c", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aD57n", "typeName": "shape"}, {"x": 1084, "y": 749, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-d", "type": "note", "parentId": "shape:ch04-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A trader is like someone who buys mangoes in the morning market and sells them in the evening market for a little more. An investor is like someone who buys the mango orchard, because they expect it to produce more fruit every year."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aA8LX", "typeName": "shape"}, {"x": 56, "y": 1028, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3a", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Top producers", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "China, Australia, Russia, USA, Canada"}]}]}}, "index": "aI0df", "typeName": "shape"}, {"x": 56, "y": 2845, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4b", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 420.4958677685951, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Monetary policy", "marks": [{"type": "bold"}]}]}]}}, "