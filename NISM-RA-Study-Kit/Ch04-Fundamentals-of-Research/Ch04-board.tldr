": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5t", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Gold demand: jewellery 47%, investment 24%, central banks 23%, technology 6%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHlKA", "typeName": "shape"}, {"x": 505.93055555555554, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-11", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 303.09722222222223, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fundamental", "marks": [{"type": "bold"}]}]}]}}, "index": "a7UXc", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-6", "type": "text", "parentId": "shape:ch04-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 4 of 15"}]}]}}, "index": "a3rbX", "typeName": "shape"}, {"x": 1084, "y": 2310.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-22", "type": "note", "parentId": "shape:ch04-u", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Fundamental analysis "}, {"type": "text", "text": "contradicts", "marks": [{"type": "bold"}]}, {"type": "text", "text": " the "}, {"type": "text", "text": "Efficient Market Hypothesis (EMH)", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", which says prices already reflect all relevant information. If EMH were fully true, there would be no mispriced shares to find."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "ahKVj", "typeName": "shape"}, {"x": 56, "y": 1090, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-1q", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three essential elements:"}]}]}}, "index": "aW9vj", "typeName": "shape"}, {"x": 917.3333333333334, "y": 666, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-33", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 426.6666666666667, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "47%"}]}]}}, "index": "aBnDj", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-v", "type": "geo", "parentId": "shape:ch04-u", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false