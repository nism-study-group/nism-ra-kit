4.1.1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Active", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Picks specific securities. Buys those priced "}, {"type": "text", "text": "below", "marks": [{"type": "bold"}]}, {"type": "text", "text": " intrinsic value, sells those "}, {"type": "text", "text": "above", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Constant review, more trades, more effort."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Goal:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " beat the return of the broad asset class."}]}]}}, "index": "aCHsA", "typeName": "shape"}, {"x": 56, "y": 3238.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-2b", "type": "text", "parentId": "shape:ch04-u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.5 Quantitative research"}]}]}}, "index": "aprXr", "typeName": "shape"}, {"x": 56, "y": 1182, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-3c", "type": "text", "parentId": "shape:ch04-2s", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Crude oil"}]}]}}, "index": "aKEZX", "typeName": "shape"}, {"x": 912.9917355371902, "y": 2845, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4d", "type": "geo", "parentId": "shape:ch04-2s", "props": {"w": 431.0082644628099, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "fo