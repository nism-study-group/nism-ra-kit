, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 4 of 15"}]}]}}, "index": "a33iI", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4q", "type": "frame", "props": {"w": 1400, "h": 1028.199999999997, "name": "4.9 Historical events", "color": "black"}, "parentId": "page:page", "index": "a6Iyv", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-63", "type": "text", "parentId": "shape:ch04-60", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3DPb", "typeName": "shape"}, {"x": 1040, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-5r", "type": "note", "parentId": "shape:ch04-5c", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Behavioural finance: fear and greed push prices from fair value."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFppz", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch04-4", "type": "geo", "parentId": "shape:ch04-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"