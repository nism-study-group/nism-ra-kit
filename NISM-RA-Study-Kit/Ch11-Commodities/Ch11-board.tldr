Align": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6NQr", "typeName": "shape"}, {"x": 56, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3p", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Higher interest rates strengthen currencies and often reduce commodity prices."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aG7lQ", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-20", "type": "text", "parentId": "shape:ch11-1v", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How the economy moves commodity prices"}]}]}}, "index": "a5Wqz", "typeName": "shape"}, {"x": 712, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1o", "type": "geo", "parentId": "shape:ch11-1i", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Production lower than expected", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Prices can "}, {"type": "text", "text": "rise", "marks": [{"type": "bold"}]}]}]}}, "index": "a6S1n", "typeName": "shape"}, {"x": 175.75, "y": 1880.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-31", "type": "arrow", "parentId": "shape:ch11-2h", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aHuauV", "typeName": "shape"}, {"x": 1084, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2p", "type": "note", "parentId": "shape:ch11-2h", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The goal", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The goal of hedging is "}, {"type": "text", "text": "not to make a profit", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". It is stable, predictable cash flows. But it needs careful planning: "}, {"type": "text", "text": "over-hedging", "marks": [{"type": "bold"}]}, {"type": "text", "text": " or a wrong strategy can increase risk instead of reducing it. Transaction costs and margins also matter."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a83tf", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-42", "type": "note", "parentId": "shape:ch11-3v", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A jeweller buys gold every month. Should it hedge all of its needs, part, or none? Why?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7pSr", "typeName": "shape"}, {"x": 384, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3q", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " An export ban on wheat or rice tightens global supply and raises prices."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHvEE", "typeName": "shape"}, {"x": 930.6666666666666, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-10", "type": "geo", "parentId": "shape:ch11-r", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pound sterling", "marks": [{"type": "bold"}]}]}]}}, "index": "a9MeA", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-21", "type": "geo", "parentId": "shape:ch11-1v", "props": {"w": 287.75193798449607, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Indicator", "marks": [{"type": "bold"}]}]}]}}, "index": "a6fmI", "typeName": "shape"}, {"x": 56, "y": 452, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1p", "type": "text", "parentId": "shape:ch11-1i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Weather reports", "marks": [{"type": "bold"}]}, {"type": "text", "text": " matter because crops are highly sensitive to rain, temperature, drought, floods and frost. Book examples: a "}, {"type": "text", "text": "delayed monsoon", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in India hits rice and sugarcane; bad weather in "}, {"type": "text", "text": "Brazil", "marks": [{"type": "bold"}]}, {"type": "text", "text": " disrupts coffee and soybean. Traders watch short-term forecasts and long-term patterns such as "}, {"type": "text", "text": "El Niño and La Niña", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a7T4M", "typeName": "shape"}, {"x": 525.25, "y": 1880.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-32", "type": "arrow", "parentId": "shape:ch11-2h", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aIzyMUZ", "typeName": "shape"}, {"x": 1084, "y": 999, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2q", "type": "note", "parentId": "shap