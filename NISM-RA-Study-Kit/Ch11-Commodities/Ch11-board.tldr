500 tonnes the same ratio would mean 457.5 tonnes. The quiz does not use this mismatch."}]}]}}, "index": "aLuM2", "typeName": "shape"}, {"x": 56, "y": 1405.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2s", "type": "text", "parentId": "shape:ch11-2h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The "}, {"type": "text", "text": "hedge ratio", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the share of a position that is hedged with derivatives: how much of the price risk is covered."}]}]}}, "index": "aB9zw", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-45", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 5 marks of 100  ·  Book pages 218 to 227  ·  About 30 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "a99rA", "typeName": "shape"}, {"x": 56, "y": 1606.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3t", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Hedge ratio = correlation × (SD spot changes ÷ SD futures changes)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKUMUV", "typeName": "shape"}, {"x": 930.6666666666666, "y": 663, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-13", "type": "geo", "parentId": "shape:ch11-r", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Swiss franc", "marks": [{"type": "bold"}]}]}]}}, "index": "aCzZ3", "typeName": "shape"}, {"x": 351.75193798449607, "y": 487, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-24", "type": "geo", "parentId": "shape:ch11-1v", "props": {"w": 992.2480620155038, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Strong growth raises demand for energy, metals and farm goods. Slowdown or recession cuts demand, often lowering prices"}]}]}}, "index": "a95xU", "typeName": "shape"}, {"x": 56, "y": 752, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1s", "type": "geo", "parentId": "shape:ch11-1i", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inventory", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Stock held in warehouses, exchanges or government reserves. "}, {"type": "text", "text": "High", "marks": [{"type": "bold"}]}, {"type": "text", "text": " stock signals oversupply, so prices fall; "}, {"type": "text", "text": "low", "marks": [{"type": "bold"}]}, {"type": "text", "text": " stock signals scarcity, so prices may rise."}]}]}}, "index": "aAvqX", "typeName": "shape"}, {"x": 56, "y": 2098.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-35", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 1288, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: Try it: hedge ratio and contracts", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Defaults are the book's numbers for 100 tonnes"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "aMAZE", "typeName": "shape"}, {"x": 56, "y": 1463.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2t", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Hedge ratio = correlation between spot and futures prices × (SD of change in spot price ÷ SD of change in futures price)"}]}]}}, "index": "aCpUzV", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-46", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A commodity has no balance sheet. Its price comes from supply and demand, the US dollar, the weather and politics. Users protect themselves by hedging."}]}]}}, "index": "aAcJ2", "typeName": "shape"}, {"x": 384, "y": 1606.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3u", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Over-hedging or a wrong hedge ratio can increase risk. Hedging costs margins or premiums and caps gains."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLPvb", "typeName": "shape"}, {"x": 56, "y": 787, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-14", "type": "text", "parentId": "shape:ch11-r", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "When the dollar moves, commodities move the other way"}]}]}}, "index": "aDxWX", "typeName": "shape"}, {"x": 56, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-25", "type": "geo", "parentId": "shape:ch11-1v", "props": {"w": 287.75193798449607, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "