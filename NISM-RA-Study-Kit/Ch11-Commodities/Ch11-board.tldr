": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Match the exchange to the commodity: CBOT, "}, {"type": "text", "text": "agri", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; COMEX, "}, {"type": "text", "text": "bullion", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; NYMEX, "}, {"type": "text", "text": "energy", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; LME, "}, {"type": "text", "text": "base metals", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aQhgb", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2i", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.9", "marks": [{"type": "bold"}]}]}]}}, "index": "a1HHb", "typeName": "shape"}, {"x": 712, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3j", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Dollar index: USD against six currencies (euro, yen, pound, Canadian dollar, Swedish krona, Swiss franc)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAvTj", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-5", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supply and demand"}]}]}}, "index": "a24sr", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-u", "type": "text", "parentId": "shape:ch11-r", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 11 of 15"}]}]}}, "index": "a3xqU", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1i", "type": "frame", "props": {"w": 1400, "h": 1042, "name": "11.5 Crop and weather reports", "color": "black"}, "parentId": "page:page", "index": "a3qFE", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2j", "type": "text", "parentId": "shape:ch11-2h", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Hedging in commodities"}]}]}}, "index": "a2Qur", "typeName": "shape"}, {"x": 1040, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3k", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Stronger dollar: commodity prices tend to fall. Weaker dollar: they tend to rise."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBI4n", "typeName": "shape"}, {"meta": {}, "id": "binding:v55y7dL4sf2p2hKw4xN1N", "type": "arrow", "fromId": "shape:ch11-32", "toId": "shape:ch11-2z", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"meta": {}, "id": "binding:2IoCXg6Kl_f7PY3ux-HKR", "type": "arrow", "fromId": "shape:ch11-32", "toId": "shape:ch11-2y", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-6", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 11 of 15"}]}]}}, "index": "a3DQQ", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-v", "type": "text", "parentId": "shape:ch11-r", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Countries trade commodities across borders: those with a surplus export to those short of it. Settling in many currencies creates "}, {"type": "text", "text": "currency risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", so the world settled on quoting and settling in a few easily convertible currencies. Since the post-war period, the "}, {"type": "text", "text": "US dollar", "marks": [{"type": "bold"}]}, {"type": "text", "text": " has been the preferred one, and central banks hold it as a reserve currency. Commodities trade mostly in US dollars, followed by the "}, {"type": "text", "text": "euro", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a4ojb", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1j", "type": "geo", "parentId": "shape:ch11-1i", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.5", "marks": [{"type": "bold"}]}]}]}}, "index": "a1zqP", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2k", "type": "text", "parentId": "shape:ch11-2h", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 11 of 15"}]}]}}, "index": "a3SRQ", "typeName": "shape"}, {"x": 56, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3l", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A weakening domestic currency makes imports dearer and amplifies global price rises."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCvqA", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-7", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity analysis studies the company's financial statements, the industry and the economy. "}, {"type": "text", "text": "Fundamental analysis of commodities", "marks": [{"type": "bold"}]}, {"type": "text", "text": " depends mainly on the "}, {"type": "text", "text": "supply and demand", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of that particular commodity. Chapter 4 (4.7) gave a first look; this chapter goes further."}]}]}}, "index": "a4huj", "typeName": "shape"}, {"x": 56, "y": 376, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-w", "type": "text", "parentId": "shape:ch11-r", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "To see the overall movement of the dollar in one number, analysts use the "}, {"type": "text", "text": "dollar index", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": the strength of the US dollar against "}, {"type": "text", "text": "six", "marks": [{"type": "bold"}]}, {"type": "text", "text": " major currencies."}]}]}}, "index": "a52jz", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1k", "type": "text", "parentId": "shape:ch11-1i", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Crop and weather reports"}]}]}}, "index": "a2XEz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2l", "type": "text", "parentId": "shape:ch11-2h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Hedging", "marks": [{"type": "bold"}]}, {"type": "text", "text": " means taking an "}, {"type": "text", "text": "opposite position", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in futures or options to offset possible losses in the physical (cash) market. It is used by producers, consumers, traders, importers, exporters and investors."}]}]}}, "index": "a4UAT", "typeName": "shape"}, {"x": 384, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3m", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " CBOT: agri. COMEX: bullion. NYMEX: energy. LME: base metals."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDm1U", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-8", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What drives supply and demand"}]}]}}, "index": "a5RxA", "typeName": "shape"}, {"x": 56, "y": 480, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-x", "type": "text", "parentId": "shape:ch11-r", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The six currencies in the dollar index"}]}]}}, "index": "a6Whb", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1l", "type": "text", "parentId": "shape:ch11-1i", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 11 of 15"}]}]}}, "index": "a35qI", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2m", "type": "text", "parentId": "shape:ch11-2h", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two hedges from the book"}]}]}}, "index": "a5UON", "typeName": "shape"}, {"x": 712, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3n", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Higher-than-expected crop production: prices fall."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEyd6", "typeName": "shape"}, {"meta": {}, "id": "binding:LRayq7sva7eBnr-pYwb0l", "type": "arrow", "fromId": "shape:ch11-31", "toId": "shape:ch11-2x", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-9", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.1.1 and 11.1.2"}]}]}}, "index": "a621z", "typeName": "shape"}, {"x": 56, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-y", "type": "geo", "parentId": "shape:ch11-r", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Euro", "marks": [{"type": "bold"}]}]}]}}, "index": "a7vxf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1m", "type": "text", "parentId": "shape:ch11-1i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Crop reports", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", from government agencies or research bodies, give acreage, planting progress, yield estimates, production and stocks of crops such as wheat, corn, soybeans, cotton and pulses."}]}]}}, "index": "a4iRI", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2n", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 490, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Seller's hedge", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A wheat farmer", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Expects a harvest, so "}, {"type": "text", "text": "sells wheat futures", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in advance. If wheat prices fall by harvest, the gain on futures makes up the loss on the crop."}]}]}}, "index": "a6sNM", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-40", "type": "note", "parentId": "shape:ch11-3v", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why might Indian gold prices rise even when international gold prices are flat?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5ngj", "typeName": "shape"}, {"x": 1040, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3o", "type": "note", "parentId": "shape:ch11-39", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " High inventory: oversupply, prices fall. Low inventory: scarcity, prices rise."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFBlr", "typeName": "shape"}, {"x": 493.3333333333333, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-z", "type": "geo", "parentId": "shape:ch11-r", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Japanese yen", "marks": [{"type": "bold"}]}]}]}}, "index": "a8yOM", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1n", "type": "geo", "parentId": "shape:ch11-1i", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Production higher than expected", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Prices generally "}, {"type": "text", "text": "fall", "marks": [{"type": "bold"}]}]}]}}, "index": "a5R7j", "typeName": "shape"}, {"x": 1104.5, "y": 1778.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-30", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "u