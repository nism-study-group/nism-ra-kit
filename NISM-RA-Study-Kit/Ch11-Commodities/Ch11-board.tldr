, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SD means standard deviation (Chapter 12)."}]}]}}, "index": "aDWFb", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-47", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aB2L2", "typeName": "shape"}, {"x": 6160, "y": 2932.0400000000022, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-3v", "type": "frame", "props": {"w": 1400, "h": 946.4799999999959, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "a7436", "typeName": "shape"}, {"x": 56, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-a", "type": "geo", "parentId": "shape:ch11-3", "props": {"w": 632, "h": 414, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supply side", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Production levels:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " crop yields, mining output, oil drilling capacity"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Weather and natural disasters:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " droughts, floods, hurricanes"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Geopolitical events:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " wars, sanctions, trade restrictions, OPEC decisions"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technology and infrastructure:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " better farming, mining and transport reduce supply risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Government policies:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " subsidies, tariffs, export bans, regulations"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cost of production:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " labour, energy and other input costs"}]}]}]}]}}, "index": "a70QE", "typeName": "shape"}, {"x": 56, "y": 862, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-15", "type": "geo", "parentId": "shape:ch11-r", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dollar strengthens", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Commodities cost more for buyers paying in other currencies. Global demand falls, pushing commodity "}, {"type": "text", "text": "prices down", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aEckE", "typeName": "shape"}, {"x": 351.75193798449607, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-26", "type": "geo", "parentId": "shape:ch11-1v", "props": {"w": 992.2480620155038, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rising inflation pushes investors to commodities, especially "}, {"type": "text", "text": "gold", "marks": [{"type": "bold"}]}, {"type": "text", "text": " as a hedge. It also raises production and transport costs"}]}]}}, "index": "aB9xv", "typeName": "shape"}, {"x": 930.6666666666666, "y": 752, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1u", "type": "geo", "parentId": "shape:ch11-1i", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Consumption", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Demand: industrial use of metals, energy use, changing diets in emerging economies. Demand rising faster than supply pushes prices "}, {"type": "text", "text": "up", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aC2BE", "typeName": "shape"}, {"x": 56, "y": 2357.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-37", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "c