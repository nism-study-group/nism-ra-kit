 "shape:ch11-r", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Think of the dollar as the price tag's language. When the dollar gets stronger, the same tag costs an Indian buyer more rupees, so they buy less, and sellers cut prices."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aH5Hj", "typeName": "shape"}, {"x": 56, "y": 817, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-29", "type": "geo", "parentId": "shape:ch11-1v", "props": {"w": 287.75193798449607, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trade balance and geopolitics", "marks": [{"type": "bold"}]}]}]}}, "index": "aEQiz", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1x", "type": "text", "parentId": "shape:ch11-1v", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Macroeconomic indicators"}]}]}}, "index": "a2KjU", "typeName": "shape"}, {"x": 405.5, "y": 1778.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2y", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, 