 "content": [{"type": "text", "text": "11.4 Global and domestic markets move together"}]}]}}, "index": "aIIVE", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1y", "type": "text", "parentId": "shape:ch11-1v", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 11 of 15"}]}]}}, "index": "a3G0X", "typeName": "shape"}, {"x": 755, "y": 1778.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-2z", "type": "geo", "parentId": "shape:ch11-2h", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Quantity", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "For 100 tonnes of exposure: "}, {"type": "text", "text": "91.5 tonnes", "marks": [{"type": "bold"}]}]}]}}, "index": "aIzrq", "typeName": "shape"}, {"x": 56, "y": 1263, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-f", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Prices also depend on the health of the main producing and consuming countries: their economies, weather and political stability. Slowing growth or political instability in a key producing region can constrain supply and upset global balance. Trade sanctions, "}, {"type": "text", "text": "currency volatility", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and trade policies add to the swings."}]}]}}, "index": "aCYQQ", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-1z", "type": "text", "parentId": "shape:ch11-1v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Commodities are raw materials for industry and essentials for consumers, so their prices are tied to the wider economy."}]}]}}, "index": "a4iQQ", "typeName": "shape"}, {"x": 56, "y": 1399, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-g", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The big players"}]}]}}, "index": "aD46n", "typeName": "shape"}, {"x": 56, "y": 1474, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch11-h", "type": "text", "parentId": "shape:ch11-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Footnote in the book, citing the World Gold Council (June 2025) and the EIA"}]}]}}, "index": "aEIov", "typeName": "shape"}, {"name": "", "color": "#FF802B", "imageUrl": "", "meta": {}, "id": "user:eXQfN0pWBHlxGmMA87UiX", "typeName": "user"}, {"meta": {}, "id": "page:page", "name": "Chapter 11: Fundamental analysis of commodities", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 56, "y": 1532