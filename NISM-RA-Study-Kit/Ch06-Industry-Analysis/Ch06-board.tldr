"content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a18iX", "typeName": "shape"}, {"meta": {}, "id": "binding:tXso73KUOznwIWTFVxk-B", "type": "arrow", "fromId": "shape:ch06-1u", "toId": "shape:ch06-1q", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-8", "type": "geo", "parentId": "shape:ch06-3", "props": {"w": 1288, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Industry", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Firms offering the same or similar products for the same customer need. Examples: auto, insurance, steel, telecom."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Business sector", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": A broader group of related industries. Financial services = insurance, banking, credit rating, investment banking. Industrial metals = steel, copper, aluminium."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Economic sector", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Parts of the economy that add to national income: agriculture, manufacturing, public utilities, services."}]}]}]}]}}, "index": "a5Oy2", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-x", "type": "text", "parentId": "shape:ch06-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "An "}, {"type": "text", "text": "under-penetrated", "marks": [{"type": "bold"}]}, {"type": "text", "text": " industry has room to grow. As it matures, growth slows. So analysts estimate both the "}, {"type": "text", "text": "current", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and the "}, {"type": "text", "text": "potential", "marks": [{"type": "bold"}]}, {"type": "text", "text": " market size. Both are hard: unorganised and private players do not publish data, and potential size rests on assumptions that may be wrong. Past trends help fill the gaps and reveal secular trends."}]}]}}, "index": "a4in6", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-17", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Secular trends", "marks": [{"type": "bold"}]}, {"type": "text", "text": " are long-term changes in what is made or consumed (Chapter 5). The book names five drivers:"}]}]}}, "index": "a4V0z", "typeName": "shape"}, {"x": 930.6666666666666, "y": 548.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-28", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 413.3333333333333, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Industry rivalry", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Threat of established rivals (horizontal)"}]}]}}, "index": "a9Hun", "typeName": "shape"}, {"x": 56, "y": 2069, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1w", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's Indian example: call taxis.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " They took shape around the turn of the century, grew fast for a decade on the back of more phones and rising income, then shrank sharply when app-based aggregators arrived."}]}]}}, "index": "aQISz", "typeName": "shape"}, {"x": 56, "y": 837.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-39", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "PESTLE: what investors look at in a country"}]}]}}, "index": "a9V0X", "typeName": "shape"}, {"x": 180.23529411764707, "y": 2628, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2x", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 435.88235294117646, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Low barriers. Barriers are high with licensing, patents, huge specialised investment, strong brands, distribution and loyalty"}]}]}}, "index": "aYVq2", "typeName": "shape"}, {"x": 700, "y": 2711.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3y", "type": "arrow", "parentId": "shape:ch06-30", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aXVv2", "typeName": "shape"}, {"x": 1084, "y": 693, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4z", "type": "note", "parentId": "shape:ch06-40", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Match the KPI to the industry. CASA and NPA are bank metrics. ARPU and churn are telecom. Same-store sales growth is retail. Revenue per FTE and bench strength are IT services. Passenger km is airlines."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aZJhX", "typeName": "shape"}, {"x": 56, "y": 542, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-9", "type": "text", "parentId": "shape:ch06-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Seven questions every industry analysis must answer:"}]}]}}, "index": "a6gUs", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-y", "type": "text", "parentId": "shape:ch06-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two ways to size a market"}]}]}}, "index": "a52OU", "typeName": "shape"}, {"x": 56, "y": 294, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-18", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Five drivers of secular trends, with the book's examples"}]}]}}, "index": "a5cC6", "typeName": "shape"}, {"x": 56, "y": 716.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-29", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Horizontal", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Threat of substitutes", "marks": [{"type": "bold"}]}]}]}}, "index": "aAMAU", "typeName": "shape"}, {"x": 56, "y": 2159, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1x", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Each shift displaces workers, who must reskill, and capacity, which must find a new use. Not every disruptor causes displacement, though: shale gas lowered crude prices for the long term without changing what people consumed."}]}]}}, "index": "aRq4v", "typeName": "shape"}, {"x": 624.1176470588235, "y": 2628, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2y", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 435.88235294117646, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Skills (IT), capital (oil and gas), distribution (banking), brand loyalty (toothpaste, coffee). Buffett: \"economic castles protected by unbreachable moats\""}]}]}}, "index": "aZlvb", "typeName": "shape"}, {"x": 56, "y": 2884.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3z", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Conduct example from the book: high interest rates may deter buyers of real estate and four-wheelers, but hit two-wheelers less."}]}]}}, "index": "aY8yI", "typeName": "shape"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-z", "type": "text", "parentId": "shape:ch06-t", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example: a medical therapy"}]}]}}, "index": "a6mYM", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-19", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technology", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Horizontal drilling opened up shale gas, lowering long-term oil and gas prices"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Digital cameras killed film rolls; phone cameras hit entry-level digital cameras"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Better batteries are driving electric vehicles"}]}]}]}]}}, "index": "a6Uxa", "typeName": "shape"}, {"x": 1084, "y": 2159, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1y", "type": "note", "parentId": "shape:ch06-13", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Secular trends tell you the "}, {"type": "text", "text": "long-term", "marks": [{"type": "bold"}]}, {"type": "text", "text": " path. For the medium and short term, study "}, {"type": "text", "text": "cyclical", "marks": [{"type": "bold"}]}, {"type": "text", "text": " trends."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aSk8z", "typeName": "shape"}, {"x": 1084, "y": 1910, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2z", "type": "note", "parentId": "shape:ch06-1z", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How to win in a crowded industry", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Innovate. Internally: efficient operations, less working capital, faster turnaround, lower cost of capital. Externally: differentiated products, strong brands, unique positioning."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aaCor", "typeName": "shape"}, {"x": 1540, "y": 3403.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1z", "type": "frame", "props": {"w": 1400, "h": 2834, "name": "6.6 Four frameworks for the industry landscape (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a5xmn", "typeName": "shape"}, {"x": 56, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6a", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Life cycle: pioneering, growth, mature, declining, reinvention. Call taxis went through it."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCOCQ", "typeName": "shape"}, {"x": 56, "y": 826, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5a", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Direct tax: how it shapes behaviour"}]}]}}, "index": "aAbyb", "typeName": "shape"}, {"x": 384, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6b", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Porter (1979): 3 horizontal (substitutes, new entrants, rivals), 2 vertical (suppliers, buyers)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDLL2", "typeName": "shape"}, {"x": 615.6221889055473, "y": 693, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4a", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 444.3778110944528, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Key metrics", "marks": [{"type": "bold"}]}]}]}}, "index": "aAr1E", "typeName": "shape"}, {"x": 56, "y": 901, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5b", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "To promote research, companies can claim "}, {"type": "text", "text": "1.5 times", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " the actual spend on certain scientific research as an expense."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interest owed to scheduled commercial banks is deductible only when "}, {"type": "text", "text": "actually paid", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", to discourage delays."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Such rules make tax profit differ from reported profit. This shows as a "}, {"type": "text", "text": "deferred tax asset", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (paying more tax now, less later) or a "}, {"type": "text", "text": "deferred tax liability", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (paying less now, more later)."}]}]}]}]}}, "index": "aBsUq", "typeName": "shape"}, {"x": 712, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6c", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " High rivalry means lower pricing power and lower incomes."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEYpr", "typeName": "shape"}, {"x": 56, "y": 912.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3a", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Political", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Stable laws and policy, little corruption and red tape, press freedom, ease of doing business, healthy public finances."}]}]}}, "index": "aAVC6", "typeName": "shape"}, {"x": 56, "y": 779, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4b", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 118.50074962518742, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Airlines, transport, logistics", "marks": [{"type": "bold"}]}]}]}}, "index": "aBgsE", "typeName": "shape"}, {"x": 56, "y": 1069, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5c", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Corporate income tax in India: four parts (as per the book)"}]}]}}, "index": "aCW16", "typeName": "shape"}, {"x": 1040, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6d", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " No substitute threat (book): power, healthcare, education."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFbHj", "typeName": "shape"}, {"x": 56, "y": 600, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-a", "type": "text", "parentId": "shape:ch06-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. Which industry is the company in?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. How much do economic cycles affect it?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. How big can it get?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. How has it done in the past, and why?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. How strong is competition, and how does that affect pricing power?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "6. Which secular trends affect it, and are they causing value migration?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "7. Are there regulatory headwinds or tailwinds?"}]}]}}, "index": "a7Fdf", "typeName": "shape"}, {"x": 493.3333333333333, "y": 716.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2a", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Vertical", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Bargaining power of buyers", "marks": [{"type": "bold"}]}]}]}}, "index": "aBVGE", "typeName": "shape"}, {"x": 493.3333333333333, "y": 912.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3b", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Economic", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "GDP growth, inflation, rates, trade mix, BoP, currency stability, forex reserves, monetary policy, dependence on imported resources like oil."}]}]}}, "index": "aBakQ", "typeName": "shape"}, {"x": 182.50074962518744, "y": 779, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4c", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 425.1214392803598, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Passengers or cargo × distance. Constraint: capacity"}]}]}}, "index": "aCTU1", "typeName": "shape"}, {"x": 56, "y": 1158, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5d", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Income tax, MAT, surcharge, cess"}]}]}}, "index": "aDISb", "typeName": "shape"}, {"x": 56, "y": 1315.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6e", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Attractive industry: low competition, high barriers, weak suppliers, weak buyers, few substitutes."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGyob", "typeName": "shape"}, {"meta": {}, "id": "binding:ztwjyH3OPpuMktxpzYQvC", "type": "arrow", "fromId": "shape:ch06-3x", "toId": "shape:ch06-3v", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 864, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-b", "type": "text", "parentId": "shape:ch06-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.2 Defining the industry"}]}]}}, "index": "a8Xjf", "typeName": "shape"}, {"x": 712, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1a", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Income", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "As incomes rise, people shift to premium products."}]}]}}, "index": "a7veb", "typeName": "shape"}, {"x": 56, "y": 856.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2b", "type": "text", "parentId": "shape:ch06-1z", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book: 3 horizontal forces (substitutes, new entrants, established rivals) and 2 vertical forces (suppliers, customers)."}]}]}}, "index": "aCHuA", "typeName": "shape"}, {"x": 930.6666666666666, "y": 912.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3c", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Socio-cultural", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Age, education, health, values, lifestyle. Young India versus ageing Japan. Nuclear families raise demand for day care and packaged food."}]}]}}, "index": "aCxaA", "typeName": "shape"}, {"x": 615.6221889055473, "y": 779, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4d", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 444.3778110944528, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Passenger or cargo km; price per passenger or cargo km; capacity and occupancy rate"}]}]}}, "index": "aDkU7", "typeName": "shape"}, {"x": 56, "y": 1233, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5e", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book figures, for assessment year 2025-26 where stated"}]}]}}, "index": "aE7Uo", "typeName": "shape"}, {"x": 384, "y": 1315.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6f", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " PESTLE plus Ethics and Demographics = STEEPLED. Mostly used when choosing a country."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHSfA", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 6: Industry analysis", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 56, "y": 939, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-c", "type": "text", "parentId": "shape:ch06-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "This is the first step, and it is not always easy. Standard systems exist: "}, {"type": "text", "text": "NIC", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (National Industry Classification) in India, "}, {"type": "text", "text": "GICS", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (Global Industry Classification Standard), and "}, {"type": "text", "text": "NAICS", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (North American Industry Classification System) in the US. But they may miss the real substance."}]}]}}, "index": "a9ZH6", "typeName": "shape"}, {"x": 56, "y": 627, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1b", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Demography", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Japan's ageing population cut per capita beer consumption."}]}]}}, "index": "a8E6U", "typeName": "shape"}, {"x": 56, "y": 946.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2c", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 490, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unattractive for owners (book)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Aviation, telecom, retail, textile, sugar, power. The forces keep profits low."}]}]}}, "index": "aD64r", "typeName": "shape"}, {"x": 56, "y": 1170.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3d", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technological", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "R&D push, tech-savvy people and institutions, scientific temper."}]}]}}, "index": "aD1lQ", "typeName": "shape"}, {"x": 56, "y": 913, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4e", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 118.50074962518742, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Autos, capital goods", "marks": [{"type": "bold"}]}]}]}}, "index": "aEzlF", "typeName": "shape"}, {"x": 56, "y": 1291, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5f", "type": "geo", "parentId": "shape:ch06-50", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Income tax", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "30%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of taxable profit; "}, {"type": "text", "text": "25%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " if turnover was below Rs 400 crore. Optional schemes: "}, {"type": "text", "text": "15% to 25%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " if the company gives up certain deductions."}]}]}}, "index": "aFFkE", "typeName": "shape"}, {"x": 712, "y": 1315.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6g", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " BCG looks at segments within a business. Star: Cera. Cash cow: Navneet, Colgate. Question mark: Nano (failed), Pulsar (succeeded)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aI5jz", "typeName": "shape"}, {"x": 56, "y": 1075, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-d", "type": "text", "parentId": "shape:ch06-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three examples of the definition problem"}]}]}}, "index": "aAHKQ", "typeName": "shape"}, {"x": 712, "y": 627, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1c", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Culture and tastes", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Western influence raised demand for western clothing in Asia. Change can be sudden, as after a pandemic."}]}]}}, "index": "a9prM", "typeName": "shape"}, {"x": 570, "y": 946.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2d", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 490, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Attractive for owners (book)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Education, FMCG, healthcare, IT. Weak forces, high margins for long periods."}]}]}}, "index": "aE2CM", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1170.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3e", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Legal", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Consistent, transparent, enforced laws. Book examples of discomfort: Vodafone retrospective tax, cancelled telecom and mining licences."}]}]}}, "index": "aEWcU", "typeName": "shape"}, {"x": 182.50074962518744, "y": 913, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4f", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 425.1214392803598, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Goods sold. Constraint: capacity"}]}]}}, "index": "aFvzc", "typeName": "shape"}, {"x": 712, "y": 1291, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5g", "type": "geo", "parentId": "shape:ch06-50", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "MAT", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Minimum Alternate Tax. If normal tax is below "}, {"type": "text", "text": "15% of book profits", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", pay 15% of book profits + 4% cess + surcharge. The excess becomes "}, {"type": "text", "text": "MAT credit", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for future years."}]}]}}, "index": "aG3Aj", "typeName": "shape"}, {"x": 1040, "y": 1315.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6h", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " SCP: structure, conduct, performance (RoE, RoIC, WACC). An extension of Porter."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJvBz", "typeName": "shape"}, {"x": 56, "y": 1150, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-e", "type": "geo", "parentId": "shape:ch06-3", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Too broad", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cars", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "NIC puts every passenger car maker in one class. But entry-level cars and luxury cars behave very differently. Analysts may treat them as separate industries."}]}]}}, "index": "aBwpz", "typeName": "shape"}, {"x": 56, "y": 795, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1d", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "GST made logistics more efficient, which reduced demand for new commercial vehicles."}]}]}}, "index": "aAGbQ", "typeName": "shape"}, {"x": 1084, "y": 946.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2e", "type": "note", "parentId": "shape:ch06-1z", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Warren Buffett, quoted in the book: \"Should you find yourself in a chronically leaking boat, energy devoted to changing vessels is likely to be more productive than energy devoted to patching leaks.\" And: when brilliant management takes on a business with bad economics, \"it is the reputation of the business that remains intact.\""}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 408, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aFDvf", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1170.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3f", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Environmental", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Clear policy on pollution, waste, mining, forests, rehabilitation. Unclear rules deter manufacturers."}]}]}}, "index": "aFSJM", "typeName": "shape"}, {"x": 615.6221889055473, "y": 913, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4g", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 444.3778110944528, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Volume and growth; average realisation and growth; capacity utilisation"}]}]}}, "index": "aGUULV", "typeName": "shape"}, {"x": 56, "y": 1489, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5h", "type": "geo", "parentId": "shape:ch06-50", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Surcharge", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A tax on tax. All goes to the "}, {"type": "text", "text": "central", "marks": [{"type": "bold"}]}, {"type": "text", "text": " government, not shared with states. "}, {"type": "text", "text": "12%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " if income is above Rs 10 crore; "}, {"type": "text", "text": "7%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " from Rs 1 to 10 crore; nil below Rs 1 crore."}]}]}}, "index": "aHJeU", "typeName": "shape"}, {"x": 56, "y": 1716.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6i", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Limited market: penetration rate. Limited capacity: utilisation rate."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aK4yU", "typeName": "shape"}, {"x": 398.6666666666667, "y": 1150, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-f", "type": "geo", "parentId": "shape:ch06-3", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Too narrow?", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "PVR cinemas", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Competes with OTT platforms and TV, and also with live theatre and sport. Call it only a \"cinema exhibitor\" and you miss rivals. Call it \"media and entertainment\" and the peers are not comparable."}]}]}}, "index": "aCsgb", "typeName": "shape"}, {"x": 56, "y": 979, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1e", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.5.1 Value migration"}]}]}}, "index": "aB6Z6", "typeName": "shape"}, {"x": 56, "y": 1777, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2f", "type": "text", "parentId": "shape:ch06-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "When is each force strong?"}]}]}}, "index": "aGHHM", "typeName": "shape"}, {"x": 56, "y": 1400.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3g", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Not every factor matters equally to every company. Judge each factor's weight for the business."}]}]}}, "index": "aGnx2", "typeName": "shape"}, {"x": 56, "y": 1047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4h", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 118.50074962518742, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Banks, NBFCs", "marks": [{"type": "bold"}]}]}]}}, "index": "aHYK2", "typeName": "shape"}, {"x": 712, "y": 1489, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5i", "type": "geo", "parentId": "shape:ch06-50", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cess", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Levied on tax plus surcharge, and used only for its stated purpose. "}, {"type": "text", "text": "4%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for health and education."}]}]}}, "index": "aI2Zz", "typeName": "shape"}, {"x": 384, "y": 1716.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6j", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Bank KPIs include NIM, CASA, NPA; telecom: ARPU, churn; retail: same-store sales; IT: revenue per FTE."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLy0z", "typeName": "shape"}, {"x": 741.3333333333334, "y": 1150, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-g", "type": "geo", "parentId": "shape:ch06-3", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Moving target", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cameras", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Phone cameras took sales from entry-level, then mid-tier cameras. Treat cameras as a standalone industry and you ignore the biggest competitor."}]}]}}, "index": "aDPvr", "typeName": "shape"}, {"x": 56, "y": 1054, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1f", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "When a secular trend gives one party a lasting advantage at another's cost, "}, {"type": "text", "text": "shareholder value migrates", "marks": [{"type": "bold"}]}, {"type": "text", "text": " from loser to winner. Spotting it early helps analysts get in ahead of time and get out of losing businesses."}]}]}}, "index": "aC3vE", "typeName": "shape"}, {"x": 56, "y": 1852, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2g", "type": "text", "parentId": "shape:ch06-1z", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's checklist"}]}]}}, "index": "aHdv6", "typeName": "shape"}, {"x": 56, "y": 1472.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3h", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.6.3 BCG matrix"}]}]}}, "index": "aHxkr", "typeName": "shape"}, {"x": 182.50074962518744, "y": 1047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4i", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 425.1214392803598, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Loan value, priced as interest. Constraints: deposits, regulatory capital, liquid assets, market liquidity"}]}]}}, "index": "aIRYU", "typeName": "shape"}, {"x": 56, "y": 1689, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5j", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Worked example: taxable profit Rs 100 crore at 30% = 30. Surcharge 12% of 30 = 3.6. Cess 4% of 33.6 = 1.344. Total about Rs 34.94 crore."}]}]}}, "index": "aJ3MX", "typeName": "shape"}, {"x": 712, "y": 1716.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6k", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Direct tax: payer bears it. Indirect: consumer bears it, seller collects."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMj2M", "typeName": "shape"}, {"meta": {}, "id": "binding:EQww9dsjfKm11UAlYwYeD", "type": "arrow", "fromId": "shape:ch06-1s", "toId": "shape:ch06-1o", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 1084, "y": 1150, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-h", "type": "note", "parentId": "shape:ch06-3", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's rule", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Group a company with others that share the "}, {"type": "text", "text": "same driving factors", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". If PVR's business depends on people's wish to spend time out of home, put it in out-of-home entertainment. If it depends on people's wish to watch movie content, put it in entertainment media. This choice matters later, when you pick peers and compare valuations."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 384, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aEXnn", "typeName": "shape"}, {"x": 56, "y": 1158, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1g", "type": "text", "parentId": "shape:ch06-13", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four kinds of value migration"}]}]}}, "index": "aD3cb", "typeName": "shape"}, {"x": 56, "y": 1910, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2h", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 116.23529411764707, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Force", "marks": [{"type": "bold"}]}]}]}}, "index": "aIJPI", "typeName": "shape"}, {"x": 56, "y": 1547.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3i", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Developed by the Boston Consulting Group. Unlike Porter and PESTLE, which look at industries and countries, BCG looks at the "}, {"type": "text", "text": "segments within one business", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", as a portfolio, through market growth and cash generation."}]}]}}, "index": "aIXQ2", "typeName": "shape"}, {"x": 615.6221889055473, "y": 1047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4j", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 444.3778110944528, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Net interest margin; capital adequacy; NPA ratio; deposit and loan growth; CRR and SLR; CASA ratio; central bank policy rates"}]}]}}, "index": "aJ5En", "typeName": "shape"}, {"x": 56, "y": 1793, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5k", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Indirect taxes"}]}]}}, "index": "aKkBQ", "typeName": "shape"}, {"x": 1040, "y": 1716.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6l", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " R&D deduction: 1.5 times. MAT: 15% of book profits. Surcharge: 12% above Rs 10 crore, 7% from 1 to 10 crore. Cess: 4%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aN3nI", "typeName": "shape"}]}