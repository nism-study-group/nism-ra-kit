o", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 169.6, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Growth", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Concept works. Customers adopt. Steep growth."}]}]}}, "index": "aLUVzV", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-31", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1Ovv", "typeName": "shape"}, {"x": 624.1176470588235, "y": 2178, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2p", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 435.88235294117646, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Telegram to SMS; cement pipes to steel and plastic; typewriters to computers; Kodak. No substitute threat: power, healthcare, education. Solar and LED are slow because of upfront cost."}]}]}}, "index": "aQq9U", "typeName": "shape"}, {"x": 216, "y": 60, "ro