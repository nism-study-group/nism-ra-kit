, "content": [{"type": "text", "text": "Michael Porter, 1979. Laid out the way the book classifies them."}]}]}}, "index": "a6qtr", "typeName": "shape"}, {"x": 420.40000000000003, "y": 1911, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1t", "type": "arrow", "parentId": "shape:ch06-13", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.59999999999997, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aMwbdl", "typeName": "shape"}, {"x": 56, "y": 458.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-36", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example: education in India.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Demand is large and growing; students have little bargaining power; it is largely recession-proof; opening an institute needs many permissions (high barriers); quality institutes are few (low competition); teachers' salaries are set by management (weak suppliers); alternative courses lack credibility (few substitutes)."}]}]}}, "index": "a6CU5", "typeName": "shape"}, {"x": 180.23529411764707, "y": 2470, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2u", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 435.88235294117646, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Few suppliers, many buyers; critical inputs; low competition with differentiation; no substitutes; high switching cost"}]}]}}, "index": "aVUoT", "typeName": "shape"}, {"x": 56, "y": 618, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-47", "type": "text", "parentId": "shape:ch06-40", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.7.3 KPIs for select industries"}]}]}}, "index": "a7S9n", "typeName": "shape"}, {"x": 522, "y": 2564.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3v", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 356, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Conduct", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Behaviour that follows: commoditised or branded, seasonal (umbrellas) or year-round (FMCG, pharma), cyclical, skill needs, dependence on policy."}]}]}}, "index": "aVZUN", "typeName": "shape"}, {"x": 56, "y": 612, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-58", "type": "geo", "parentId": "shape:ch06-50", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"typ