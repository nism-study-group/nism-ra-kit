: "paragraph", "content": [{"type": "text", "text": "Aviation, Indian telecom. Munger: \"If only basis of competition in an industry is pricing, it is a self-defeating business.\" Micromax won 10% share in 3 years with special features at low prices."}]}]}}, "index": "aNXnr", "typeName": "shape"}, {"x": 56, "y": 2012.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3n", "type": "geo", "parentId": "shape:ch06-30", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Low growth, high share", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cash cow", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Little investment needed, steady cash."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Navneet Publications", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "Colgate", "marks": [{"type": "bold"}]}]}]}}, "index": "aNaZ6", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-50", "type": "frame", "props": {"w": 1400, "h": 2447, "name": "6.8 The rules of the game", "color": "black"}, "parentId": "page:page", "index": "a8xEn", "typeName": "shape"}, {"x": 182.50074962518744, "y": 1291, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4o", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 425.1214392803598, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size"