eName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-64", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Classify by common driving factors, not by product label."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6WxX", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5s", "type": "text", "parentId": "shape:ch06-5q", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Where to find data"}]}]}}, "index": "a24WA", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6u", "type": "note", "parentId": "shape:ch06-6o", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Pick a company you know with several businesses. Place each in the BCG matrix."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6o1j", "typeName": "shape"}, {"meta": {}, "id": "binding:y8KPEjkA1tsLuvTCyLcME", "type": "arrow", "fromId": "shape:ch06-1t", "toId": "shape:ch06-1p", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 398.6666666666667, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-q", "type": "geo", "parentId": "shape:ch06-j", "props": {"w": 318.6666666666667, "h": 384, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Semi-cyclical", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Moves, with a floor", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Grows in expansion, falls in recession, but keeps a base level of demand."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Example:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " consumer durables."}]}]}}, "index": "a71tj", "typeName": "shape"}, {"x": 56, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-10", "type": "geo", "parentId": "shape:ch06-t", "props": {"w": 490, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Top-down", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Start from the big picture", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Start from macro factors and work down to the industry."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Number of patients who had the therapy × average spend per patient = industry revenue."}]}]}}, "index": "a7Ykn", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-21", "type": "text", "parentId": "shape:ch06-1z", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four frameworks for the industry landscape"}]}]}}, "index": "a24Aj", "typeName": "shape"}, {"x": 615.2, "y": 1779, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1p", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 169.6, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mature", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Most possible users already use it. Few new customers."}]}]}}, "index": "aMltI", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-32", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Four frameworks for the industry landscape"}]}]}}, "index": "a2qJr", "typeName": "shape"}, {"x": 56, "y": 2336, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2q", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 116.23529411764707, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buyer power", "marks": [{"type": "bold"}]}]}]}}, "index": "aReyE", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-43", "type": "text", "parentId": "shape:ch06-40", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 6 of 15"}]}]}}, "index": "a3DHr", "typeName": "shape"}, {"x": 56, "y": 2342.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3r", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.6.4 Structure, Conduct, Performance (SCP)"}]}]}}, "index": "aRoDz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-54", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Small changes in regulation can have big effects. The book's examples: the long debate on FDI in multi-brand retail (back-end investment, local sourcing), mine closures after environmental policy changes, cancelled telecom licences, and amendments to the Companies Act. Analysts must pay close attention to regulation."}]}]}}, "index": "a4n9f", "typeName": "shape"}, {"x": 615.6221889055473, "y": 1425, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4s", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 444.3778110944528, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Readership, viewership, TRPs, site visitors; ad realisation per unit; content acquisition cost"}]}]}}, "index": "aSIfv", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-65", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Defensive: low income elasticity (food, agri inputs, healthcare). Semi-cyclical: consumer durables. Deep cyclical: capital goods, steel."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7maX", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5t", "type": "text", "parentId": "shape:ch06-5q", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 6 of 15"}]}]}}, "index": "a3Zfv", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6v", "type": "note", "parentId": "shape:ch06-6o", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Which KPI would you check first for a bank, a telecom company and a retailer? Why?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7Uj9", "typeName": "shape"}, {"x": 741.3333333333334, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-r", "type": "geo", "parentId": "shape:ch06-j", "props": {"w": 318.6666666666667, "h": 384, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Deep cyclical", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Swings hard", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Driven by economic and commodity cycles. Sales collapse in recession as firms freeze expansion, then surge at the first sign of recovery from pent-up orders."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Examples:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " capital goods, steel."}]}]}}, "index": "a84hb", "typeName": "shape"}, {"x": 570, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-11", "type": "geo", "parentId": "shape:ch06-t", "props": {"w": 490, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bottom-up", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Start from the companies", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Add up data from individual companies."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "For each hospital offering the therapy, take the revenue from it. Add them all."}]}]}}, "index": "a8KJv", "typeName": "shape"}, {"x": 216, "y": 209.60000000000582, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-22", "type": "text", "parentId": "shape:ch06-1z", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 6 of 15  ·  Part 1 of 2"}]}]}}, "index": "a3WAz", "typeName": "shape"}, {"x": 894.8000000000001, "y": 1779, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1q", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 169.6, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Declining", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "New technology or tastes replace it."}]}]}}, "index": "aNIKr", "typeName": "shape"}, {"x": 216, "y": 209.60000000000582, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-33", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 6 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3oy2", "typeName": "shape"}, {"x": 180.23529411764707, "y": 2336, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2r", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 435.88235294117646, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Strong competition among sellers; standard products; close substitutes with low switching cost"}]}]}}, "index": "aSsvA", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-44", "type": "text", "parentId": "shape:ch06-40", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Key performance indicators (KPIs) differ by industry. Revenue per employee suits a BPO, which bills by headcount, but tells little about a capital-heavy manufacturer. Company annual reports and management discussion show which KPIs an industry uses. Two more guides:"}]}]}}, "index": "a4n6b", "typeName": "shape"}, {"x": 56, "y": 2417.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3s", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Can be seen as an extension of Porter's model that also looks at the financial results."}]}]}}, "index": "aSc1M", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-55", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.9 Taxation"}]}]}}, "index": "a5Bcb", "typeName": "shape"}, {"x": 56, "y": 1535, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4t", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 118.50074962518742, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Retail", "marks": [{"type": "bold"}]}]}]}}, "index": "aT7zy", "typeName": "shape"}, {"x": 56, "y": 659.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-66", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Top-down sizing starts from macro factors; bottom-up adds up companies."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8trj", "typeName": "shape"}, {"meta": {}, "id": "binding:xlCWFIuI9JxNMFP_RC6gn", "type": "arrow", "fromId": "shape:ch06-3y", "toId": "shape:ch06-3w", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5u", "type": "geo", "parentId": "shape:ch06-5q", "props": {"w": 632, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Industry reports", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Industry journals and media reports"}]}]}}, "index": "a4BlI", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6w", "type": "note", "parentId": "shape:ch06-6o", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Name a value migration you have seen in India in the last ten years. Who won, who lost?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8AMj", "typeName": "shape"}, {"meta": {}, "id": "binding:k6RY0Da8t-Wfp7TprZjKp", "type": "arrow", "fromId": "shape:ch06-3y", "toId": "shape:ch06-3v", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3", "type": "frame", "props": {"w": 1400, "h": 2055.2000000000007, "name": "6.1 Why study the industry?", "color": "black"}, "parentId": "page:page", "index": "a19zk", "typeName": "shape"}, {"x": 1084, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-s", "type": "note", "parentId": "shape:ch06-j", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Income elasticity is how much you cut back when money is tight. You still buy rice and medicine (defensive). You delay a new fridge (semi-cyclical). A factory delays a new machine altogether (deep cyclical)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a9UKH", "typeName": "shape"}, {"x": 1084, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-12", "type": "note", "parentId": "shape:ch06-t", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book sample question, worked", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Three organised tyre makers earn Rs 6,000, 8,000 and 10,000 crore = "}, {"type": "text", "text": "Rs 24,000 crore", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Unorganised players make about 20% of sales, so organised = 80%. Market size = 24,000 ÷ 0.8 = "}, {"type": "text", "text": "Rs 30,000 crore", "marks": [{"type": "highlight"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a9mtX", "typeName": "shape"}, {"x": 56, "y": 279.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-23", "type": "text", "parentId": "shape:ch06-1z", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Industry landscaping", "marks": [{"type": "bold"}]}, {"type": "text", "text": " means studying all the players and how they interact: competitors, customers, suppliers, regulators and new technology. Low competition lets firms pass cost increases to customers and keep margins. High competition squeezes prices and profits. Four established frameworks help:"}]}]}}, "index": "a4zlB", "typeName": "shape"}, {"x": 1174.4, "y": 1779, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-1r", "type": "geo", "parentId": "shape:ch06-13", "props": {"w": 169.6, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reinvention", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Rare: finds a new use and starts again."}]}]}}, "index": "aOALz", "typeName": "shape"}, {"x": 56, "y": 293.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-34", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The attractive industry, in five features"}]}]}}, "index": "a4bvX", "typeName": "shape"}, {"x": 624.1176470588235, "y": 2336, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2s", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 435.88235294117646, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Large buyers such as the government have more power"}]}]}}, "index": "aTnwv", "typeName": "shape"}, {"x": 56, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-45", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.7.1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Unit of pricing", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What the company treats as one unit when it sets a price. Easy for manufacturers (goods sold). Hard for services: a cafe like Starbucks prices on what it expects to earn per "}, {"type": "text", "text": "patron", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not per cup."}]}]}}, "index": "a54xM", "typeName": "shape"}, {"x": 56, "y": 2489.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-3t", "type": "text", "parentId": "shape:ch06-30", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SCP in three steps"}]}]}}, "index": "aT0rE", "typeName": "shape"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-56", "type": "text", "parentId": "shape:ch06-50", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Taxes raise money for the government, and also encourage or discourage businesses. Kerala's "}, {"type": "text", "text": "fat tax", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (2017) added "}, {"type": "text", "text": "14.5%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " tax on junk food. GST charges essentials little or nothing and luxuries more."}]}]}}, "index": "a6zxY", "typeName": "shape"}, {"x": 182.50074962518744, "y": 1535, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-4u", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 425.1214392803598, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unit of pricing less relevant (trading business). Constraint: store network"}]}]}}, "index": "aURWz", "typeName": "shape"}, {"x": 384, "y": 659.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-67", "type": "note", "parentId": "shape:ch06-5y", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Tyre sample: 24,000 is 80% of the market, so the market is 30,000."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 