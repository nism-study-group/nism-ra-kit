, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5Zhn", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-5r", "type": "geo", "parentId": "shape:ch06-5q", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.10", "marks": [{"type": "bold"}]}]}]}}, "index": "a1u1n", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-74", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aJzmF", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-6t", "type": "note", "parentId": "shape:ch06-6o", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Run Porter's five forces on Indian airlines. Why does the book call aviation unattractive?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5sxz", "typeName": "shape"}, {"meta": {}, "id": "binding:vsIs7qKjc2Xu_ZVZ_ZMzO", "type": "arrow", "fromId": "shape:ch06-1v", "toId": "shape:ch06-1r",