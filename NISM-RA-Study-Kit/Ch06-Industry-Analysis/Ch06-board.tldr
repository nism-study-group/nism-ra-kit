 strong "}, {"type": "text", "text": "pricing power", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and high margins."}]}]}}, "index": "a5SKf", "typeName": "shape"}, {"x": 56, "y": 2470, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-2t", "type": "geo", "parentId": "shape:ch06-1z", "props": {"w": 116.23529411764707, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supplier power", "marks": [{"type": "bold"}]}]}]}}, "index": "aUW7j", "typeName": "shape"}, {"x": 712, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch06-46", "type": "geo", "parentId": "shape:ch06-40", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.7.2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Key constraining factors", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Demand", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "supply", "marks": [{"type": "bold"}]}, {"type": "text", "text": " or "}, {"type": "text", "text": "regulatory", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Limited market: track "}, {"type": "text", "text": "penetration rate", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Limited capacity: track "}, {"type": "text", "text": "capacity utilisation",