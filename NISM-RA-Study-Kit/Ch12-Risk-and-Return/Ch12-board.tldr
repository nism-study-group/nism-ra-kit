": "bold"}]}]}]}}, "index": "aCHtI", "typeName": "shape"}, {"x": 56, "y": 891, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-44", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Winner's curse", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Winning a competitive bid by overpaying. A behavioural win, a financial loss."}]}]}}, "index": "aAEDX", "typeName": "shape"}, {"x": 56, "y": 835, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3s", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 1004, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: Try it: risk-adjusted returns", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "All rates in % a year"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "aMJvA", "typeName": "shape"}, {"x": 712, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-55", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Beta measures market risk; modified duration, interest rate risk; delta, option sensitivity."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aIz5W", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4t", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Simple annualised = HPR ÷ months × 12."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6F6U", "typeName": "shape"}, {"x": 6640, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5u", "type": "note", "parentId": "page:page", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WHY IT MATTERS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The reason behind a rule"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aETxA", "typeName": "shape"}, {"x": 192.31168831168833, "y": 733, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-12", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bond prices fall when rates rise and rise when rates fall"}]}]}}, "index": "aDUiUV", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-23", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3yR2", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1r", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A country default affects all securities issued there"}]}]}}, "index": "acYsn", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1519.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-34", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company performance and the economy"}]}]}}, "index": "aPTPv", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1175.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2s", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity", "marks": [{"type": "bold"}]}]}]}}, "index": "aDqlv", "typeName": "shape"}, {"x": 712, "y": 891, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-45", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Herd mentality", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Following others in the belief they know more. Leads to bubbles and crashes; small investors enter when markets are overheated. Keynes: \"It is better for reputations to fail conventionally than to succeed unconventionally.\""}]}]}}, "index": "aBJ0j", "typeName": "shape"}, {"x": 1084, "y": 835, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3t", "type": "note", "parentId": "shape:ch12-36", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sharpe divides by "}, {"type": "text", "text": "standard deviation", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; Treynor divides by "}, {"type": "text", "text": "beta", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Jensen's alpha is a "}, {"type": "text", "text": "difference", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (return minus the CAPM return), not a ratio. The book says Jensen's alpha \"factors the systematic risk using equity beta\"."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aNb1A", "typeName": "shape"}, {"x": 1040, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-56", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " VaR (1%) of 12%: 99% confident the loss will not exceed 12%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJ1Fz", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4u", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " CAGR = (end ÷ beginning)^1/n − 1. The standard measure, except for periods under one year."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7Lwr", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5v", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aFISE", "typeName": "shape"}, {"x": 578.8311688311688, "y": 733, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-13", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Also hits equity: higher cost of capital lowers present value, borrowing and profits"}]}]}}, "index": "aEFUL", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-24", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk is the variability of possible outcomes, both up and down, though we usually mean the downside. The book separates "}, {"type": "text", "text": "risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " from "}, {"type": "text", "text": "uncertainty", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": when we know nothing about a cause (like a tsunami or COVID before they happened), it is uncertainty; once research explains the cause, it becomes a measurable risk. Risk is \"known uncertainty\"."}]}]}}, "index": "a4AGQ", "typeName": "shape"}, {"x": 1084, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1s", "type": "note", "parentId": "shape:ch12-p", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Asha's fixed deposit pays her Rs 5,000 a month, enough for groceries. Prices rise 10%, and groceries now cost Rs 5,500. Her deposit is perfectly safe, yet she is poorer. That is inflation risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "adF8A", "typeName": "shape"}, {"x": 56, "y": 1623.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-35", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buffett, as quoted in the book: compare the returns on bonds and stocks when deploying capital. If stocks offer more, buy stocks; if bonds offer more, buy bonds. In distress, rates fall sharply and equities may be \"dirt cheap\" even on dividend yield."}]}]}}, "index": "aQMrr", "typeName": "shape"}, {"x": 56, "y": 1261.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2t", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 285.84269662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Main source of return", "marks": [{"type": "bold"}]}]}]}}, "index": "aE6xU", "typeName": "shape"}, {"x": 56, "y": 1119, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-46", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Anchoring", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Relying too much on the first piece of information. Waiting for a \"right price\" to sell that is no longer realistic, and ignoring new information."}]}]}}, "index": "aCxxb", "typeName": "shape"}, {"x": 3080, "y": 2391.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3u", "type": "frame", "props": {"w": 1400, "h": 3173.600000000006, "name": "12.10 Behavioural biases", "color": "black"}, "parentId": "page:page", "index": "a61qX", "typeName": "shape"}, {"x": 56, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-57", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Beta above 1: more volatile than the market. Beta 1.2 and market +15% gives +18%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aK7Ob", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4v", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Multiple cash flows on different dates: use XIRR."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8kEb", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5w", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aGpZM", "typeName": "shape"}, {"x": 56, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-14", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Business", "marks": [{"type": "bold"}]}]}]}}, "index": "aFW9n", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-25", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three ways to measure risk"}]}]}}, "index": "a5JSX", "typeName": "shape"}, {"x": 1084, "y": 1000.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1t", "type": "note", "parentId": "shape:ch12-p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Liquidity\" has three meanings in the book: a "}, {"type": "text", "text": "company's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ability to meet short-term obligations; an "}, {"type": "text", "text": "asset's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ease of conversion into cash (shares and bonds easy, gold and real estate harder); and a "}, {"type": "text", "text": "market's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " depth of ready buyers and sellers. Check which one a question means."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 288, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aeUMu", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-36", "type": "frame", "props": {"w": 1400, "h": 1463, "name": "12.9 Risk-adjusted returns", "color": "black"}, "parentId": "page:page", "index": "a56Mb", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1261.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2u", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coupon income, plus some gain when rates fall"}]}]}}, "index": "aFPDz", "typeName": "shape"}, {"x": 712, "y": 1119, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-47", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Projection bias", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Projecting the recent past into the distant future, ignoring the more distant past."}]}]}}, "index": "aD556", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3v", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.10", "marks": [{"type": "bold"}]}]}]}}, "index": "a1tWM", "typeName": "shape"}, {"x": 384, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-58", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sensitivity analysis changes one variable at a time; scenario analysis uses best, worst and most likely cases."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLYrz", "typeName": "shape"}, {"x": 384, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4w", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Inflation risk is highest for fixed-return instruments and lower for equity."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9idf", "typeName": "shape"}, {"meta": {}, "id": "binding:inxuqkgKo45d_LqQcvlTb", "type": "arrow", "fromId": "shape:ch12-j", "toId": "shape:ch12-g", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 192.31168831168833, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-15", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk in operations; measured as the standard deviation of EBIT or EBITDA"}]}]}}, "index": "aGAj2", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-26", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. Statistical", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Standard deviation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Variability of returns around the mean. For a sample: s = √[Σ(X − mean)² ÷ (n − 1)]."}]}]}}, "index": "a6CJQ", "typeName": "shape"}, {"x": 56, "y": 1875, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1u", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Systematic and unsystematic risk"}]}]}}, "index": "afrOn", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-37", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.9", "marks": [{"type": "bold"}]}]}]}}, "index": "a1Yj2", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1261.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2v", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Appreciation in value; dividend is a small part"}]}]}}, "index": "aGnzR", "typeName": "shape"}, {"x": 56, "y": 1333, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-48", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.11 Wisdom from investment gurus"}]}]}}, "index": "aEnoz", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3w", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Behavioural biases"}]}]}}, "index": "a2CvQ", "typeName": "shape"}, {"x": 712, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-59", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Margin of safety: Benjamin Graham; no universal standard; no guarantee."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMRir", "typeName": "shape"}, {"x": 712, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4x", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Bond prices move opposite to interest rates."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAA12", "typeName": "shape"}, {"meta": {}, "id": "binding:xPg_bstAlZW1GYYoJVRN-", "type": "arrow", "fromId": "shape:ch12-i", "toId": "shape:ch12-f", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 578.8311688311688, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-16", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Includes commodity, operations, competition, supply chain and currency risk. Reduced by holding varied businesses"}]}]}}, "index": "aH1wQ", "typeName": "shape"}, {"x": 493.3333333333333, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-27", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2. Sensitivity", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Elasticity measures", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " stock returns versus index returns; market (systematic) risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Modified duration:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " bond price versus interest rates; interest rate risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Delta:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " option price versus the underlying's price; market risk"}]}]}]}]}}, "index": "a7Ynf", "typeName": "shape"}, {"x": 56, "y": 1964, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1v", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Can diversification remove it?"}]}]}}, "index": "agfmb", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-38", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk-adjusted returns"}]}]}}, "index": "a2RX2", "typeName": "shape"}, {"x": 56, "y": 1347.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2w", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 285.84269662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Assurance", "marks": [{"type": "bold"}]}]}]}}, "index": "aHesj", "typeName": "shape"}, {"x": 56, "y": 1408, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-49", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Markets move in "}, {"type": "text", "text": "bull", "marks": [{"type": "bold"}]}, {"type": "text", "text": " cycles (rising optimism, sometimes overdone, ending in a crash) and "}, {"type": "text", "text": "bear", "marks": [{"type": "bold"}]}, {"type": "text", "text": " cycles (pessimism, prices below value, until buyers return and central banks cut rates). Great investors teach discipline through both."}]}]}}, "index": "aFPlU", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3x", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3R52", "typeName": "shape"}, {"x": 1040, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4y", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Business risk is measured as the standard deviation of EBIT or EBITDA."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBjKz", "typeName": "shape"}, {"x": 56, "y": 480, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-a", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Higher is better, and it is simple to use. But be careful with investments whose returns are not known in advance, such as equity and mutual funds: their ROI is an estimate built on past returns and assumptions."}]}]}}, "index": "a7ZSj", "typeName": "shape"}, {"x": 56, "y": 977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-17", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market", "marks": [{"type": "bold"}]}]}]}}, "index": "aI4uA", "typeName": "shape"}, {"x": 930.6666666666666, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-28", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3. Loss", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value at Risk (VaR)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Maximum loss over a period at a given confidence level. VaR (1%) of 12%: 99% confident the loss will not exceed 12%; a 1% chance it will. Confidence level = 1 − significance level."}]}]}}, "index": "a8Uxs", "typeName": "shape"}, {"x": 56, "y": 2039, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1w", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's classification"}]}]}}, "index": "ahYkv", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-39", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a31U1", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1347.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2x", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pre-defined coupon; may be secured"}]}]}}, "index": "aIFwf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3y", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Classical finance assumes people are rational. In practice, emotion and psychology drive decisions. Benjamin Graham, in \"The Intelligent Investor\", said markets are more psychological and less logical. "}, {"type": "text", "text": "Behavioural finance", "marks": [{"type": "bold"}]}, {"type": "text", "text": " combines psychology with economics to explain irrational financial decisions. Simon Savage of GLG Partners, quoted in the book: \"We were all born to be bad fund managers because of inbuilt behavioural biases.\""}]}]}}, "index": "a4U4k", "typeName": "shape"}, {"x": 56, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4z", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Deposits and small savings have no market risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aClGE", "typeName": "shape"}, {"x": 56, "y": 584, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-b", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.2 Simple, annualised and compounded returns"}]}]}}, "index": "a8Bi2", "typeName": "shape"}, {"x": 192.31168831168833, "y": 977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-18", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Loss from adverse price moves in a traded asset"}]}]}}, "index": "aJCpM", "typeName": "shape"}, {"x": 56, "y": 829, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-29", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.5 Beta"}]}]}}, "index": "a9SzzV", "typeName": "shape"}, {"x": 56, "y": 2097, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1x", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Systematic (undiversifiable)", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Felt across investments: government policy, external factors, wars, natural calamities."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market, inflation, exchange rate, interest rate, reinvestment", "marks": [{"type": "bold"}]}, {"type": "text", "text": " risk."}]}]}}, "index": "aiYm6", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1347.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2y", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No assurance of dividend or appreciation"}]}]}}, "index": "aJoPf", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3z", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Eight biases to watch"}]}]}}, "index": "a5vgQ", "typeName": "shape"}, {"x": 56, "y": 659, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-c", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A return measure should help investors judge whether the return is enough for their goals and risk, compare investments, and compare against a benchmark. "}, {"type": "text", "text": "Total return", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = periodic income (interest, dividend, rent) + change in value, whether realised or not. Gold and other commodities give no periodic income at all."}]}]}}, "index": "a9PlM", "typeName": "shape"}, {"x": 578.8311688311688, "y": 977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-19", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Affects equity, bonds, gold, real estate. Deposits and small savings have none, but also do not appreciate"}]}]}}, "index": "aKAbA", "typeName": "shape"}, {"x": 712, "y": 2097, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1y", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unsystematic (diversifiable)", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Specific to one security or a small group. Reduced by adding other assets."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Credit, business, liquidity", "marks": [{"type": "bold"}]}, {"type": "text", "text": " risk."}]}]}}, "index": "aj2Jr", "typeName": "shape"}, {"x": 56, "y": 1433.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2z", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 285.84269662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk and return", "marks": [{"type": "bold"}]}]}]}}, "index": "aKEDb", "typeName": "shape"}, {"x": 56, "y": 795, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-d", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "One investment, three return figures"}]}]}}, "index": "aAcHM", "typeName": "shape"}, {"x": 56, "y": 2327, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1z", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ajay", "marks": [{"type": "bold"}]}, {"type": "text", "text": " buys shares of an infrastructure company. A change in the government's push for infrastructure hits all infra companies: unsystematic, reduced by investing in other sectors. Rising rates or a recession hit everyone: systematic, seen as market risk."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ashima", "marks": [{"type": "bold"}]}, {"type": "text", "text": " buys bonds. She cuts credit risk by holding more highly rated bonds, but if rates rise, all her bonds fall: interest rate risk, common to all debt."}]}]}]}]}}, "index": "akI0n", "typeName": "shape"}, {"x": 56, "y": 870, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-e", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example: 150 shares bought at Rs 25, sold at Rs 30, Rs 1 dividend per share, Rs 20 brokerage each way"}]}]}}, "index": "aB1sQ", "typeName": "shape"}, {"x": 56, "y": 928, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-f", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 356, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total cost", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "150 × 25 + 20 = "}, {"type": "text", "text": "Rs 3,770", "marks": [{"type": "bold"}]}]}]}}, "index": "aCjxI", "typeName": "shape"}, {"x": 522, "y": 928, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-g", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 356, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total returns", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sale 150 × 30 − 20 = 4,480. Dividend 150. Total "}, {"type": "text", "text": "Rs 4,630", "marks": [{"type": "bold"}]}]}]}}, "index": "aDmCj", "typeName": "shape"}, {"name": "", "color": "#FF802B", "imageUrl": "", "meta": {}, "id": "user:eXQfN0pWBHlxGmMA87UiX", "typeName": "user"}, {"meta": {}, "id": "binding:L5iE9w2JC262FVMAjxA1w", "type": "arrow", "fromId": "shape:ch12-j", "toId": "shape:ch12-h", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"meta": {}, "id": "page:page", "name": "Chapter 12: Fundamentals of risk and return", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 1040, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5a", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Jensen's alpha = Rp − [Rf + β × MRP]. Sharpe uses SD; Treynor uses beta."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aNEuI", "typeName": "shape"}, {"x": 988, "y": 928, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-h", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 356, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simple (holding period) return", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4,630 ÷ 3,770 − 1 = "}, {"type": "text", "text": "23%", "marks": [{"type": "bold"}]}]}]}}, "index": "aElVr", "typeName": "shape"}, {"x": 1084, "y": 1408, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4a", "type": "note", "parentId": "shape:ch12-3u", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Graham's Mr. Market", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "You own a business with a partner, Mr. Market, who offers every day to buy your share or sell you his, at prices swayed by his moods. Do not let his emotions drive yours. Use his mispricing as an opportunity."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aGQk6", "typeName": "shape"}, {"x": 56, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5b", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sharpe suits undiversified investors; Treynor suits well-diversified ones."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aOrMf", "typeName": "shape"}, {"x": 234, "y": 1000, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-i", "type": "arrow", "parentId": "shape:ch12-3", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aDtZHG", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3a", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A high-risk strategy usually earns more in the long run but swings more. So compare portfolios on return "}, {"type": "text", "text": "per unit of risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". For all three measures below, "}, {"type": "text", "text": "higher is better", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a4t0A", "typeName": "shape"}, {"x": 56, "y": 1957.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4b", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Quotes the book collects"}]}]}}, "index": "aHhCM", "typeName": "shape"}, {"x": 384, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5c", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Loss aversion: losses hurt about twice as much as equal gains please."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aPc7r", "typeName": "shape"}, {"x": 700, "y": 1000, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-j", "type": "arrow", "parentId": "shape:ch12-3", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aFQhI", "typeName": "shape"}, {"x": 56, "y": 904, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2a", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta", "marks": [{"type": "bold"}]}, {"type": "text", "text": " measures "}, {"type": "text", "text": "systematic risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " relative to the market index: the risk that cannot be diversified away. It is used in CAPM (Chapter 10)."}]}]}}, "index": "aAvSE", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3b", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Jensen's alpha, Sharpe, Treynor"}]}]}}, "index": "a5muA", "typeName": "shape"}, {"x": 56, "y": 2032.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4c", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Benjamin Graham", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"In the short run, market is a voting machine but in the long run, it is a weighing machine.\""}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"To achieve satisfactory investment results is easier than most people realize; to achieve superior results is harder than it looks.\""}]}]}}, "index": "aI89U", "typeName": "shape"}, {"x": 712, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5d", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Ownership bias is also called the endowment effect. Confirmation bias is also called my-side bias."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQy9r", "typeName": "shape"}, {"x": 56, "y": 1098, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-k", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If held 15 months", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Simple annualised return", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(23% ÷ 15) × 12 = "}, {"type": "text", "text": "18.4%", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Divide by months (or days) held, multiply by 12 (or 365)."}]}]}}, "index": "aGMKr", "typeName": "shape"}, {"x": 56, "y": 1087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1a", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Credit (default)", "marks": [{"type": "bold"}]}]}]}}, "index": "aLWeM", "typeName": "shape"}, {"x": 56, "y": 994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2b", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 318.6666666666667, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta = 1", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Moves with the market. Market +10%: stock +10%."}]}]}}, "index": "aBUUZV", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 