{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.group": 0, "com.tldraw.shape.text": 4, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.geo": 12, "com.tldraw.shape.note": 13, "com.tldraw.shape.line": 5, "com.tldraw.shape.frame": 1, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.embed": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"x": 578.8311688311688, "y": 1087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1c", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A sovereign has no default risk on local-currency debt (it can tax or print). Measured by credit ratings: AAA and A1 highest, D is default. Reduced by diversifying"}]}]}}, "index": "aNB7j", "typeName": "shape"}, {"x": 741.3333333333334, "y": 994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2d", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 318.6666666666667, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta above 1", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "More volatile. Beta 1.2, market +15%: stock +18%."}]}]}}, "index": "aDcHX", "typeName": "shape"}, {"x": 602.7403314917128, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3e", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 272.353591160221, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk used", "marks": [{"type": "bold"}]}]}]}}, "index": "a8KeQ", "typeName": "shape"}, {"x": 56, "y": 2348.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4f", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "John Templeton", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Invest at the point of maximum pessimism.\""}]}]}}, "index": "aLBK6", "typeName": "shape"}, {"x": 712, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5g", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Selling the loans", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "To lend more, banks sold long-dated mortgages to investors at lower yields, booked the profit up front and earned bigger bonuses. They stopped caring about credit quality as long as someone bought: "}, {"type": "text", "text": "moral hazard", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Lending became a fee business."}]}]}}, "index": "a7qkQ", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6h", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Simple annualised = HPR ÷ months × 12."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a64H2", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7i", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 7 marks of 100  ·  Book pages 228 to 246, and 334 to 341  ·  About 75 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "aCeN2", "typeName": "shape"}, {"x": 56, "y": 1408, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-n", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The simple return ignores "}, {"type": "text", "text": "time", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": 23% over one year is not the same as 23% over five."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simple annualising ignores "}, {"type": "text", "text": "compounding", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Most interest calculations assume compound interest."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "CAGR", "marks": [{"type": "bold"}]}, {"type": "text", "text": " assumes periodic returns are reinvested. It is the smoothed rate at which the investment grew. Actual yearly returns differ, and that difference reflects the risk."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "CAGR is the accepted standard measure of return, "}, {"type": "text", "text": "except for periods under one year", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "With several cash flows on different dates, use Excel's "}, {"type": "text", "text": "XIRR", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The book's example: buy at Rs 150 on 31 July 2011; dividends of Rs 5, 6 and 4 each October; sell at Rs 165 on 15 January 2014. CAGR = "}, {"type": "text", "text": "8.06%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": "."}]}]}]}]}}, "index": "aJb8f", "typeName": "shape"}, {"x": 56, "y": 1221, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1d", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Liquidity", "marks": [{"type": "bold"}]}]}]}}, "index": "aOQVE", "typeName": "shape"}, {"x": 1084, "y": 994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2e", "type": "note", "parentId": "shape:ch12-20", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Not everyone trusts beta", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value investor Seth Klarman, quoted in the book, calls it \"preposterous\" that one number from past price moves could describe a security's risk. Beta ignores business fundamentals and the price paid (IBM at $50 is less risky than at $100), and assumes upside and downside are equal. Past volatility does not reliably predict future performance."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 456, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aEcyX", "typeName": "shape"}, {"x": 883.0939226519338, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3f", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 460.9060773480663, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Suits (as per the book)", "marks": [{"type": "bold"}]}]}]}}, "index": "a9UZF", "typeName": "shape"}, {"x": 712, "y": 2348.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4g", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Peter Lynch", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Go for a business that any idiot can run, because sooner or later, any idiot is probably going to run it.\""}]}]}}, "index": "aMfQz", "typeName": "shape"}, {"x": 56, "y": 627, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5h", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Home buyers", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Got almost 100% financing, so they treated a house like a "}, {"type": "text", "text": "call option", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": if prices rose, sell and keep the profit; if prices fell, hand the keys to the bank."}]}]}}, "index": "a8AaX", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6i", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " CAGR = (end ÷ beginning)^1/n − 1. The standard measure, except for periods under one year."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a72Y6", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7j", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measure the return properly, name the risks you took to earn it, and judge the return per unit of risk. Then watch your own biases."}]}]}}, "index": "aDj4E", "typeName": "shape"}, {"x": 56, "y": 1658, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-o", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 1288, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: Try it: simple, annualised and CAGR", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Defaults are the book's example held for 5 years (60 months)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "aKyZn", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1221, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1e", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cannot sell when wanted, or only below value, or at high cost"}]}]}}, "index": "aP6zu", "typeName": "shape"}, {"x": 1540, "y": 2831.400000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2f", "type": "frame", "props": {"w": 1400, "h": 1775.800000000003, "name": "12.6 Sensitivity analysis", "color": "black"}, "parentId": "page:page", "index": "a4xAj", "typeName": "shape"}, {"x": 56, "y": 487, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3g", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 186.22467771639043, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Jensen's alpha", "marks": [{"type": "bold"}]}]}]}}, "index": "aAHU7", "typeName": "shape"}, {"x": 56, "y": 2516.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4h", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "David Dreman", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Psychology is probably the most important factor in the market, and one that is least understood.\""}]}]}}, "index": "aNSaI", "typeName": "shape"}, {"x": 712, "y": 627, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5i", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investors and raters", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Funds bought "}, {"type": "text", "text": "mortgage-backed securities", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and passed them on, like passing the pillow. Rating agencies gave them top grades (AAA kind) based on history and the hard assets behind them. Many credit derivatives were written on them too."}]}]}}, "index": "a9iOr", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6j", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Multiple cash flows on different dates: use XIRR."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8Fab", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7k", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aEJnf", "typeName": "shape"}, {"x": 0, "y": 2786.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-p", "type": "frame", "props": {"w": 1400, "h": 2543, "name": "12.3 Risks in investments", "color": "black"}, "parentId": "page:page", "index": "a2OqE", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1221, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1f", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Indian corporate bonds, property and art; lock-ins. Book: a Sovereign Gold Bond order book on 17 July 2020 had a bid-ask gap above Rs 80 (about 2%)"}]}]}}, "index": "aQYlv", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2g", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1YP2", "typeName": "shape"}, {"x": 250.22467771639043, "y": 487, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3h", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 344.51565377532233, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Portfolio return − [Rf + β × market risk premium]"}]}]}}, "index": "aBQyA", "typeName": "shape"}, {"x": 712, "y": 2516.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4i", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Walter Schloss", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"If you can't find good value investing positions, park your money in cash.\""}]}]}}, "index": "aOKyz", "typeName": "shape"}, {"x": 56, "y": 887, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5j", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"typ