shape:ch12-2f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How bond and equity returns differ"}]}]}}, "index": "aABTj", "typeName": "shape"}, {"x": 56, "y": 693, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-42", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ownership bias (endowment effect)", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Valuing what you own more than others would. You hold positions you would not buy at today's price."}]}]}}, "index": "a8eEQ", "typeName": "shape"}, {"x": 602.7403314917128, "y": 707, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3q", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 272.353591160221, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta (systematic)"}]}]}}, "index": "aKITQ", "typeName": "shape"}, {"x": 56, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-53", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Reinvestment risk rises when rates fall and falls when rates rise."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGN3v", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4r", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ROI = net profit ÷ investment × 100. Safety of capital matters as much as return."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4zui", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5s", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aCGWj", "typeName": "shape"}, {"x": 192.31168831168833, "y": 551, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-z", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 174, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", 