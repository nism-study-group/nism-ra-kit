ctangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Charlie Munger", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Understanding how to be a good investor makes you a better business manager and vice versa.\""}]}]}}, "index": "aPDdf", "typeName": "shape"}, {"x": 56, "y": 991, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5k", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lessons from 2008"}]}]}}, "index": "aBOfz", "typeName": "shape"}, {"x": 712, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6l", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Bond prices move opposite to interest rates."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAJCU", "typeName": "shape"}, {"x": 6640, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7m", "type": "note", "parentId": "page:page", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WHY IT MATTERS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The reason behind a rule"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aG25b", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-r", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risks in investments"}]}]}}, "index": "a2MsM", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1355, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1h", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A bond is called before maturity"}]}]}}, "index": "aS6Tn", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2i", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3cuz", "typeName": "shape"}, {"x": 883.0939226519338, "y": 487, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3j", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 460.9060773480663, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aDFk6", "typeName": "shape"}, {"x": 56, "y": 2868.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4k", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.12 Measuring liquidity of shares"}]}]}}, "index": "aQ1M2", "typeName": "shape"}, {"x": 56, "y": 1066, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5l", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Banks", "marks": [{"type": "bold"}]}, {"type": "text", "text": " are leveraged, so they must stay disciplined. Their business is lending, not betting on asset prices. Risk management is the heart of banking; never dilute it to win business."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investors", "marks": [{"type": "bold"}]}, {"type": "text", "text": " should do their own due diligence, not just rely on rating agencies, and keep asking: \"What could go wrong here?\""}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "History matters, but decisions cannot rest "}, {"type": "text", "text": "only", "marks": [{"type": "bold"}]}, {"type": "text", "text": " on historical data. Rating agencies leaned on past mortgage data. The book notes no rating agency ever stood up to take responsibility."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Respect the limits of what you understand. Nassim Taleb: \"Black Swan events pose significant risk in this integrated world.\" Risk management should come first."}]}]}]}]}}, "index": "aCXBz", "typeName": "shape"}, {"x": 1040, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6m", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Business risk is measured as the standard deviation of EBIT or EBITDA."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBOuQ", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7n", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aHglE", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3", "type": "frame", "props": {"w": 1400, "h": 1858, "name": "12.1 Return on investment", "color": "black"}, "parentId": "page:page", "index": "a1sdv", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-s", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3ZRn", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1355, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1i", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Most common when rates are "}, {"type": "text", "text": "falling", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": issuers replace high-coupon bonds. Goes with reinvestment risk"}]}]}}, "index": "aTdun", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2j", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A valuation model is only as good as its inputs. Identify the critical variables and see how the value changes when "}, {"type": "text", "text": "one variable changes and all others stay constant", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". That is "}, {"type": "text", "text": "sensitivity analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Example: in a DCF, run the valuation at several discount rates and tabulate the results. "}, {"type": "text", "text": "Scenario analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": " instead takes a best case, a worst case and the most likely case."}]}]}}, "index": "a4Z8E", "typeName": "shape"}, {"x": 56, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3k", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 186.22467771639043, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sharpe ratio", "marks": [{"type": "bold"}]}]}]}}, "index": "aEc7A", "typeName": "shape"}, {"x": 56, "y": 2943.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4l", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stock exchanges exist to provide liquidity, but not every share is liquid: liquidity needs many buyers and sellers."}]}]}}, "index": "aRq9X", "typeName": "shape"}, {"x": 56, "y": 1362, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5m", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frauds the book lists"}]}]}}, "index": "aDOU5", "typeName": "shape"}, {"x": 56, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6n", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Deposits and small savings have no market risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCjqr", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7o", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aISF6", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1iOf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-t", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the volatility and uncertainty of returns and, at the extreme, loss of capital. An investment is also risky if actual returns differ from expected ones. A bank fixed deposit is low risk; equity is risky because dividends are uncertain and values swing. Higher return comes only with willingness to take higher risk. Investors should know which risks they face: a retired investor may accept low returns but not loss of capital."}]}]}}, "index": "a4vqb", "typeName": "shape"}, {"x": 56, "y": 1465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1j", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reinvestment", "marks": [{"type": "bold"}]}]}]}}, "index": "aUzwW", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2k", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.7 Margin of safety"}]}]}}, "index": "a5M7E", "typeName": "shape"}, {"x": 250.22467771639043, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3l", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 344.51565377532233, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "(Portfolio return − Rf) ÷ Standard deviation"}]}]}}, "index": "aFRfA", "typeName": "shape"}, {"x": 56, "y": 3001.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4m", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stock turnover ratio", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Shares traded in a period (usually a year) ÷ "}, {"type": "text", "text": "free float", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shares outstanding."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Free float: shares held by non-promoter shareholders."}]}]}}, "index": "aSEu2", "typeName": "shape"}, {"x": 56, "y": 1437, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5n", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Warren Buffett: \"People with pen do much bigger thefts than the people with guns.\""}]}]}}, "index": "aE0l6", "typeName": "shape"}, {"x": 384, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-70", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Loss aversion: losses hurt about twice as much as equal gains please."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aPuCj", "typeName": "shape"}, {"x": 384, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6o", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A sovereign has no default risk on local-currency borrowing."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDTMv", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return on investment"}]}]}}, "index": "a2XSX", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-u", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ten risks, as described in the book"}]}]}}, "index": "a5igI", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1k", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coupons may have to be reinvested at a lower rate"}]}]}}, "index": "aVd7A", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2l", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Popularised by "}, {"type": "text", "text": "Benjamin Graham", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", \"the father of value investing\", and followers such as Warren Buffett. "}, {"type": "text", "text": "Margin of safety", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the gap between value and price when a security is bought well "}, {"type": "text", "text": "below its intrinsic value", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The bigger the gap, the bigger the margin."}]}]}}, "index": "a6wzzV", "typeName": "shape"}, {"x": 602.7403314917128, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3m", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 272.353591160221, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total risk (standard deviation)"}]}]}}, "index": "aGujU", "typeName": "shape"}, {"x": 712, "y": 3001.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4n", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Traded value turnover ratio", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Traded value of shares ÷ market capitalisation."}]}]}}, "index": "aTpr2", "typeName": "shape"}, {"x": 227.86473429951693, "y": 1948, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-60", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 614.4927536231884, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Promoter "}, {"type": "text", "text": "Ramalinga Raju", "marks": [{"type": "bold"}]}, {"type": "text", "text": " confessed in "}, {"type": "text", "text": "2009", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to inflating cash and bank balances by about "}, {"type": "text", "text": "Rs 5,000 crore", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", after a failed bid to buy Maytas, another promoter-owned company"}]}]}}, "index": "aRJzk", "typeName": "shape"}, {"x": 56, "y": 1509, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5o", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Disgraced companies and fund managers"}]}]}}, "index": "aFO9n", "typeName": "shape"}, {"x": 712, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-71", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Ownership bias is also called the endowment effect. Confirmation bias is also called my-side bias."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQ7nU", "typeName": "shape"}, {"meta": {}, "id": "binding:YSlDj8jfDKadRtyK5WcMc", "type": "arrow", "fromId": "shape:ch12-53", "toId": "shape:ch12-50", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 712, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6p", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Credit ratings: AAA and A1 highest, D default. SEBI standardised the symbols."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEiXj", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3v2z", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-v", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk", "marks": [{"type": "bold"}]}]}]}}, "index": "a6VPj", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1l", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rates rise: risk falls. Rates fall: risk rises. A cumulative option avoids it (but a bond may then swing more in price)"}]}]}}, "index": "aWD9b", "typeName": "shape"}, {"x": 56, "y": 587, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2m", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "It allows investing with minimal downside risk, but does "}, {"type": "text", "text": "not guarantee", "marks": [{"type": "bold"}]}, {"type": "text", "text": " success."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "It gives a "}, {"type": "text", "text": "cushion", "marks": [{"type": "bold"}]}, {"type": "text", "text": " against errors in the analyst's valuation, which is subjective anyway."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "There is "}, {"type": "text", "text": "no universal standard", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for how wide it should be; each investor sets their own."}]}]}]}]}}, "index": "a7Rkr", "typeName": "shape"}, {"x": 883.0939226519338, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3n", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 460.9060773480663, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investors with much of their wealth in one investment, "}, {"type": "text", "text": "not adequately diversified", "marks": [{"type": "bold"}]}]}]}}, "index": "aHOzi", "typeName": "shape"}, {"x": 1104.5, "y": 670, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-50", "type": "geo", "parentId": "shape:ch12-4o", "props": {"w": 239.5, "h": 504, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The collapse", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "One trader could not turn the market. It kept falling, and Barings failed on both the futures and the straddles. The exchanges stayed safe because they had collected margins."}]}]}}, "index": "aCQt6", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4o", "type": "frame", "props": {"w": 1400, "h": 2569.600000000006, "name": "A3 Annexure 3: Lessons from history (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a73YE", "typeName": "shape"}, {"x": 850.3574879227053, "y": 1948, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-61", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 493.64251207729467, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Jailed on fraud charges. Satyam was later acquired by "}, {"type": "text", "text": "Tech Mahindra", "marks": [{"type": "bold"}]}]}]}}, "index": "aSk4b", "typeName": "shape"}, {"x": 56, "y": 1584, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5p", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Facts as stated in the book"}]}]}}, "index": "aGWNU", "typeName": "shape"}, {"x": 1040, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-72", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "24.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Graham: short run a voting machine, long run a weighing machine."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aRXeA", "typeName": "shape"}, {"x": 1040, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6q", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Call risk is most prevalent when rates are falling."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFynM", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "An investor expects two things: a "}, {"type": "text", "text": "return", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and, more importantly, the "}, {"type": "text", "text": "capital back", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Safety of capital matters as much as return. Judge a return by its "}, {"type": "text", "text": "level", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", its "}, {"type": "text", "text": "volatility", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and its "}, {"type": "text", "text": "nature", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (periodic income or capital gain)."}]}]}}, "index": "a4vJA", "typeName": "shape"}, {"x": 192.31168831168833, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-w", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What it is", "marks": [{"type": "bold"}]}]}]}}, "index": "a7lir", "typeName": "shape"}, {"x": 56, "y": 1599, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1m", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Political", "marks": [{"type": "bold"}]}]}]}}, "index": "aXNDX", "typeName": "shape"}, {"x": 1084, "y": 587, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2n", "type": "note", "parentId": "shape:ch12-2f", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An engineer rates a bridge for 30 tonnes but lets only 10-tonne trucks cross. The gap covers the mistakes nobody knows they made."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a8Y86", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-40", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Loss aversion", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Strongly preferring to avoid losses over making gains. The pain of a loss is about "}, {"type": "text", "text": "twice", "marks": [{"type": "bold"}]}, {"type": "text", "text": " as strong as the pleasure of an equal gain. Leads to inaction: holding losers, avoiding equity when volatility is in the news."}]}]}}, "index": "a6DoQ", "typeName": "shape"}, {"x": 56, "y": 707, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3o", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 186.22467771639043, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Treynor ratio", "marks": [{"type": "bold"}]}]}]}}, "index": "aIJZM", "typeName": "shape"}, {"x": 175.75, "y": 922, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-51", "type": "arrow", "parentId": "shape:ch12-4o", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aAoxiV", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4p", "type": "geo", "parentId": "shape:ch12-4o", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1jHz", "typeName": "shape"}, {"x": 56, "y": 2082, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-62", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bernard Madoff", "marks": [{"type": "bold"}]}]}]}}, "index": "aTUHzV", "typeName": "shape"}, {"x": 56, "y": 1642, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5q", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Who", "marks": [{"type": "bold"}]}]}]}}, "index": "aHFLn", "typeName": "shape"}, {"x": 56, "y": 2226.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-73", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "25.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Stock turnover ratio uses free float shares; traded value turnover uses market cap."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aS6ib", "typeName": "shape"}, {"x": 56, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6r", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Reinvestment risk rises when rates fall and falls when rates rise."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGf6A", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-8", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A return in rupees means little on its own; compare it with the capital that earned it."}]}]}}, "index": "a5xbI", "typeName": "shape"}, {"x": 578.8311688311688, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-x", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book's example or note", "marks": [{"type": "bold"}]}]}]}}, "index": "a8cjv", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1599, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1n", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unfavourable government action: nationalisation, tax or licensing changes"}]}]}}, "index": "aYfBr", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1433.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-30", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower risk, so lower return"}]}]}}, "index": "aLI0b", "typeName": "shape"}, {"x": 56, "y": 1011.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2o", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.8 Equity returns versus bond returns"}]}]}}, "index": "a9JNv", "typeName": "shape"}, {"x": 712, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-41", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Confirmation (my-side) bias", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Seeking or reading information so it confirms what you already believe. A trader whose reason for buying fails invents a new reason to hold."}]}]}}, "index": "a71sz", "typeName": "shape"}, {"x": 250.22467771639043, "y": 707, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3p", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 344.51565377532233, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "(Portfolio return − Rf) ÷ Beta"}]}]}}, "index": "aJI6U", "typeName": "shape"}, {"x": 525.25, "y": 922, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-52", "type": "arrow", "parentId": "shape:ch12-4o", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aBtYz8", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4q", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Annexure 3: Lessons from history"}]}]}}, "index": "a2arQ", "typeName": "shape"}, {"x": 227.86473429951693, "y": 2082, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-63", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 614.4927536231884, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "New York money manager. "}, {"type": "text", "text": "$65 billion Ponzi scheme", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", the largest financial fraud in US history, exposed in December 2008"}]}]}}, "index": "aUebM", "typeName": "shape"}, {"x": 227.86473429951693, "y": 1642, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5r", "type": "geo", "pare