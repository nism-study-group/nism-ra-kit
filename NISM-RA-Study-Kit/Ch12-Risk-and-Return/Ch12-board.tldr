662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aB4bA", "typeName": "shape"}, {"x": 712, "y": 693, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-43", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Gambler's fallacy", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Predicting random events from the past: believing something that happened often will now happen less, or the reverse, to \"balance\" things."}]}]}}, "index": "a9FuX", "typeName": "shape"}, {"x": 883.0939226519338, "y": 707, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3r", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 460.9060773480663, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investors who have "}, {"type": "text", "text": "adequately diversified", "marks": [{"type": "bold"}]}, {"type": "text", "text": " across asset classes"}]}]}}, "index": "aLdxb", "typeName": "shape"}, {"x": 56, "y": 1214, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-54", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Five lessons from Barings"}]}]}}, "index": "aEAZr", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4s", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book ends with real cases from market history. Its point: life is too short to learn only from your own mistakes, so learn from others'. It quotes Mark Twain: \"We learn from the past that we don't learn from the past.\""}]}]}}, "index": "a4Uaw", "typeName": "shape"}, {"x": 56, "y": 2192, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-65", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Michael Milken", "marks": [{"type": "bold"}]}]}]}}, "index": "aWnZ2", "typeName": "shape"}, {"x": 56, "y": 1728, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5t", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Enron", "marks": [{"type": "bold"}]}]}]}}, "index": "aKWfA", "typeName": "shape"}, {"x": 1040, "y": 2226.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-76", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "28.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " 2008: banks diluted loan to value, sold loans on (moral hazard), and investors leaned on AAA ratings without their own due diligence."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aVBUR", "typeName": "shape"}, {"x": 1040, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6u", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " VaR (1%) of 12%: 99% confident the loss will not exceed 12%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJipI", "typeName": "shape"}, {"x": 56, "y": 733, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-11", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interest rate", "marks": [{"type": "bold"}]}]}]}}, "index": "aCyIz", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-22", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measuring risk"}]}]}}, "index": "a27lI", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1q", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Socio-economic-political-cultural risks of a country; it may not honour its commitments"}]}]}}, "index": "abCQI", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1519.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-33", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Default risk: higher credit risk means higher interest"}]}]}}, "index": "aOGIE", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1175.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2r", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bonds", "marks": [{"type": "bold"}]}]}]}}, "index": "aCqTU", "typeName": "shape"}, {"x": 56, "y": 891, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-44", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Winner's curse", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Winning a competitive bid by overpaying. A behavioural win, a financial loss."}]}]}}, "index": "aAEgI", "typeName": "shape"}, {"x": 56, "y": 835, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3s", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 1004, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: Try it: risk-adjusted returns", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "All rates in % a year"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "aM5E6", "typeName": "shape"}, {"x": 56, "y": 1289, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-55", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. "}, {"type": "text", "text": "One trader cannot move the market.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Work with the market and manage the position: here, cut the loss on the short puts."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. "}, {"type": "text", "text": "Set clear position limits", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for each trader, by product, market or total exposure, and tell every trader."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. "}, {"type": "text", "text": "Monitor the limits closely.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Leeson broke his limits and sent false reports, which went unnoticed because he ran the back office himself. Keep front and back office under different people. Systems should block a trader at the limit."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. "}, {"type": "text", "text": "Exchanges should share information", "marks": [{"type": "bold"}]}, {"type": "text", "text": " on large positions. The two exchanges competed for Nikkei business and never cross-checked. Sharing also deters manipulation across two exchanges."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. "}, {"type": "text", "text": "Big institutions are as prone to risk as individuals.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Collect margins from everyone, on time. SEBI applies margins to all categories of participants, including institutions."}]}]}}, "index": "aFewM", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4t", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Case 1: the Barings collapse"}]}]}}, "index": "a57G6", "typeName": "shape"}, {"x": 227.86473429951693, "y": 2192, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-66", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 614.4927536231884, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Drexel's \""}, {"type": "text", "text": "Junk Bond King", "marks": [{"type": "bold"}]}, {"type": "text", "text": "\" of the mid-1980s. Brought down by "}, {"type": "text", "text": "insider trading", "marks": [{"type": "bold"}]}]}]}}, "index": "aXCsn", "typeName": "shape"}, {"x": 227.86473429951693, "y": 1728, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5u", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 614.4927536231884, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Power trading company. Massive accounting fraud wiped out "}, {"type": "text", "text": "$78 billion", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of market value"}]}]}}, "index": "aLFhb", "typeName": "shape"}, {"x": 6160, "y": 3624.519999999998, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-77", "type": "frame", "props": {"w": 1400, "h": 946.4799999999959, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "aAplj", "typeName": "shape"}, {"x": 56, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6v", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Beta above 1: more volatile than the market. Beta 1.2 and market +15% gives +18%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKl9b", "typeName": "shape"}, {"x": 192.31168831168833, "y": 733, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-12", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bond prices fall when rates rise and rise when rates fall"}]}]}}, "index": "aDMF6", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-23", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3Zdn", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1r", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A country default affects all securities issued there"}]}]}}, "index": "acd7r", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1519.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-34", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company performance and the economy"}]}]}}, "index": "aPcOn", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1175.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2s", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity", "marks": [{"type": "bold"}]}]}]}}, "index": "aDpbf", "typeName": "shape"}, {"x": 712, "y": 891, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-45", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Herd mentality", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Following others in the belief they know more. Leads to bubbles and crashes; small investors enter when markets are overheated. Keynes: \"It is better for reputations to fail conventionally than to succeed unconventionally.\""}]}]}}, "index": "aBi5X", "typeName": "shape"}, {"x": 1084, "y": 835, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3t", "type": "note", "parentId": "shape:ch12-36", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sharpe divides by "}, {"type": "text", "text": "standard deviation", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; Treynor divides by "}, {"type": "text", "text": "beta", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Jensen's alpha is a "}, {"type": "text", "text": "difference", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (return minus the CAPM return), not a ratio. The book says Jensen's alpha \"factors the systematic risk using equity beta\"."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aNRW6", "typeName": "shape"}, {"x": 56, "y": 1603, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-56", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lessons 1 to 3 are for trading firms, 4 for exchanges, and 5 is the one SEBI has acted on in India."}]}]}}, "index": "aGwYz", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4u", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Nick Leeson", "marks": [{"type": "bold"}]}, {"type": "text", "text": " headed derivatives trading at "}, {"type": "text", "text": "Barings Futures Singapore", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", a subsidiary of Barings Plc, London. He was a star trader and a favourite of top management. He ran both the "}, {"type": "text", "text": "front office", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (trading) and the "}, {"type": "text", "text": "back office", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (checking and reporting)."}]}]}}, "index": "a6ZYQ", "typeName": "shape"}, {"x": 850.3574879227053, "y": 2192, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-67", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 493.64251207729467, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10 years in prison; $600 million fine"}]}]}}, "index": "aYzpW", "typeName": "shape"}, {"x": 850.3574879227053, "y": 1728, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5v", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 493.64251207729467, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bankrupt in "}, {"type": "text", "text": "2001", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Former President Jeff Skilling: 24 years in prison"}]}]}}, "index": "aMNeb", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-78", "type": "geo", "parentId": "shape:ch12-77", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a16yX", "typeName": "shape"}, {"x": 384, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6w", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sensitivity analysis changes one variable at a time; scenario analysis uses best, worst and most likely cases."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLhbf", "typeName": "shape"}, {"x": 578.8311688311688, "y": 733, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-13", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Also hits equity: higher cost of capital lowers present value, borrowing and profits"}]}]}}, "index": "aEti6", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-24", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk is the variability of possible outcomes, both up and down, though we usually mean the downside. The book separates "}, {"type": "text", "text": "risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " from "}, {"type": "text", "text": "uncertainty", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": when we know nothing about a cause (like a tsunami or COVID before they happened), it is uncertainty; once research explains the cause, it becomes a measurable risk. Risk is \"known uncertainty\"."}]}]}}, "index": "a4fg2", "typeName": "shape"}, {"x": 1084, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1s", "type": "note", "parentId": "shape:ch12-p", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Asha's fixed deposit pays her Rs 5,000 a month, enough for groceries. Prices rise 10%, and groceries now cost Rs 5,500. Her deposit is perfectly safe, yet she is poorer. That is inflation risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "adoYn", "typeName": "shape"}, {"x": 56, "y": 1623.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-35", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buffett, as quoted in the book: compare the returns on bonds and stocks when deploying capital. If stocks offer more, buy stocks; if bonds offer more, buy bonds. In distress, rates fall sharply and equities may be \"dirt cheap\" even on dividend yield."}]}]}}, "index": "aQax6", "typeName": "shape"}, {"x": 56, "y": 1261.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2t", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 285.84269662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Main source of return", "marks": [{"type": "bold"}]}]}]}}, "index": "aE7kA", "typeName": "shape"}, {"x": 56, "y": 1119, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-46", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Anchoring", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Relying too much on the first piece of information. Waiting for a \"right price\" to sell that is no longer realistic, and ignoring new information."}]}]}}, "index": "aCQIf", "typeName": "shape"}, {"x": 3080, "y": 2391.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3u", "type": "frame", "props": {"w": 1400, "h": 3231.600000000006, "name": "12.10 Behavioural biases", "color": "black"}, "parentId": "page:page", "index": "a6Qxr", "typeName": "shape"}, {"x": 1084, "y": 1603, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-57", "type": "note", "parentId": "shape:ch12-4o", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's verdict", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Barings' failure was not the derivatives failure, it was management's failure.\" The Board of Banking Supervision blamed poor operational controls ("}, {"type": "text", "text": "operational risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": "), not derivatives. Afterwards, firms worldwide separated front and back office, exchanges began sharing information, and all positions came to be margined."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 432, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aHWAM", "typeName": "shape"}, {"x": 56, "y": 537, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4v", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How Barings fell"}]}]}}, "index": "a7vnr", "typeName": "shape"}, {"x": 56, "y": 2302, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-68", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Raj Rajaratnam", "marks": [{"type": "bold"}]}]}]}}, "index": "aZJpQ", "typeName": "shape"}, {"meta": {}, "id": "binding:UFYY9JeQ-QZvHk8aOapNO", "type": "arrow", "fromId": "shape:ch12-52", "toId": "shape:ch12-4z", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 1838, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5w", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WorldCom", "marks": [{"type": "bold"}]}]}]}}, "index": "aNxPb", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-79", "type": "text", "parentId": "shape:ch12-77", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a2QXX", "typeName": "shape"}, {"x": 712, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6x", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Margin of safety: Benjamin Graham; no universal standard; no guarantee."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMzwL", "typeName": "shape"}, {"meta": {}, "id": "binding:yKA9LIKA8xxdUHYWYw6IP", "type": "arrow", "fromId": "shape:ch12-53", "toId": "shape:ch12-4z", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-14", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Business", "marks": [{"type": "bold"}]}]}]}}, "index": "aFo1n", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-25", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three ways to measure risk"}]}]}}, "index": "a5zZo", "typeName": "shape"}, {"x": 1084, "y": 1000.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1t", "type": "note", "parentId": "shape:ch12-p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Liquidity\" has three meanings in the book: a "}, {"type": "text", "text": "company's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ability to meet short-term obligations; an "}, {"type": "text", "text": "asset's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ease of conversion into cash (shares and bonds easy, gold and real estate harder); and a "}, {"type": "text", "text": "market's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " depth of ready buyers and sellers. Check which one a question means."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 288, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aetfM", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-36", "type": "frame", "props": {"w": 1400, "h": 1463, "name": "12.9 Risk-adjusted returns", "color": "black"}, "parentId": "page:page", "index": "a5o4M", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1261.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2u", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coupon income, plus some gain when rates fall"}]}]}}, "index": "aF1zy", "typeName": "shape"}, {"x": 712, "y": 1119, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-47", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Projection bias", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Projecting the recent past into the distant future, ignoring the more distant past."}]}]}}, "index": "aDIfn", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3v", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.10", "marks": [{"type": "bold"}]}]}]}}, "index": "a1Xnj", "typeName": "shape"}, {"x": 56, "y": 2464.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-58", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Case 2: the credit event of 2008"}]}]}}, "index": "aIcGE", "typeName": "shape"}, {"x": 56, "y": 612, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4w", "type": "text", "parentId": "shape:ch12-4o", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Annexure 3, Case 1"}]}]}}, "index": "a8vPM", "typeName": "shape"}, {"x": 227.86473429951693, "y": 2302, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-69", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 614.4927536231884, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Co-founded hedge fund "}, {"type": "text", "text": "Galleon Group", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in 1997. Arrested in October 2009 for "}, {"type": "text", "text": "insider trading", "marks": [{"type": "bold"}]}]}]}}, "index": "aaEYX", "typeName": "shape"}, {"x": 227.86473429951693, "y": 1838, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5x", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 614.4927536231884, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Telecom giant. Top management manipulated the financials; once had over "}, {"type": "text", "text": "$100 billion", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in assets"}]}]}}, "index": "aO2Mn", "typeName": "shape"}, {"x": 1040, "y": 1570.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6y", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Jensen's alpha = Rp − [Rf + β × MRP]. Sharpe uses SD; Treynor uses beta."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aNq66", "typeName": "shape"}, {"x": 192.31168831168833, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-15", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk in operations; measured as the standard deviation of EBIT or EBITDA"}]}]}}, "index": "aGbrI", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-26", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. Statistical", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Standard deviation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Variability of returns around the mean. For a sample: s = √[Σ(X − mean)² ÷ (n − 1)]."}]}]}}, "index": "a6g7r", "typeName": "shape"}, {"meta": {}, "id": "binding:_V_zh_YbOf0yhuvsq56IZ", "type": "arrow", "fromId": "shape:ch12-j", "toId": "shape:ch12-h", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 1875, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1u", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Systematic and unsystematic risk"}]}]}}, "index": "afUzEV", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-37", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.9", "marks": [{"type": "bold"}]}]}]}}, "index": "a17RA", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1261.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2v", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Appreciation in value; dividend is a small part"}]}]}}, "index": "aG6AQ", "typeName": "shape"}, {"x": 56, "y": 1333, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-48", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.11 Wisdom from investment gurus"}]}]}}, "index": "aE5nQ", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3w", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Behavioural biases"}]}]}}, "index": "a23KA", "typeName": "shape"}, {"x": 4620, "y": 3498.2000000000057, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-59", "type": "frame", "props": {"w": 1400, "h": 2460, "name": "A3 Annexure 3: Lessons from history (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a8q8f", "typeName": "shape"}, {"x": 56, "y": 670, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4x", "type": "geo", "parentId": "shape:ch12-4o", "props": {"w": 239.5, "h": 504, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The bet", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sold many "}, {"type": "text", "text": "straddles", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (a call and a put sold together) on Nikkei 225 index futures, on SGX-DT in Singapore and the Osaka Securities Exchange. A straddle loses if the market moves sharply either way. It was a bet that Japan's market would stay stable."}]}]}}, "index": "a9ixn", "typeName": "shape"}, {"x": 850.3574879227053, "y": 1838, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5y", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 493.64251207729467, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fraud-induced bankruptcy in "}, {"type": "text", "text": "2002", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Former CEO Bernard Ebbers: 25 years"}]}]}}, "index": "aP3uj", "typeName": "shape"}, {"x": 56, "y": 1898.479999999996, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6z", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sharpe suits undiversified investors; Treynor suits well-diversified ones."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aOXfU", "typeName": "shape"}, {"meta": {}, "id": "binding:GAVma5WxaO0--XeI2ud1W", "type": "arrow", "fromId": "shape:ch12-j", "toId": "shape:ch12-g", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 578.8311688311688, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-16", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Includes commodity, operations, competition, supply chain and currency risk. Reduced by holding varied businesses"}]}]}}, "index": "aH6Yz", "typeName": "shape"}, {"x": 493.3333333333333, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-27", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2. Sensitivity", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Elasticity measures", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " stock returns versus index returns; market (systematic) risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Modified duration:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " bond price versus interest rates; interest rate risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Delta:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " option price versus the underlying's price; market risk"}]}]}]}]}}, "index": "a7U7k", "typeName": "shape"}, {"x": 56, "y": 1964, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1v", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Can diversification remove it?"}]}]}}, "index": "agYgb", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-38", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk-adjusted returns"}]}]}}, "index": "a21zY", "typeName": "shape"}, {"x": 56, "y": 1347.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2w", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 285.84269662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Assurance", "marks": [{"type": "bold"}]}]}]}}, "index": "aHUnP", "typeName": "shape"}, {"x": 56, "y": 1408, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-49", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Markets move in "}, {"type": "text", "text": "bull", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "bear", "marks": [{"type": "bold"}]}, {"type": "text", "text": " cycles. Great investors teach discipline through both."}]}]}}, "index": "aF0XQ", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3x", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3Qoz", "typeName": "shape"}, {"x": 405.5, "y": 670, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4y", "type": "geo", "parentId": "shape:ch12-4o", "props": {"w": 239.5, "h": 504, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The shock", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A violent earthquake hit "}, {"type": "text", "text": "Kobe", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The Nikkei fell and the put side of his straddles lost money."}]}]}}, "index": "aAKDr", "typeName": "shape"}, {"x": 56, "y": 1948, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5z", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 163.86473429951693, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Satyam Computers", "marks": [{"type": "bold"}]}]}]}}, "index": "aQ6jE", "typeName": "shape"}, {"x": 56, "y": 480, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-a", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Higher is better, and it is simple to use. But be careful with investments whose returns are not known in advance, such as equity and mutual funds: their ROI is an estimate built on past returns and assumptions."}]}]}}, "index": "a7GQj", "typeName": "shape"}, {"x": 56, "y": 977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-17", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market", "marks": [{"type": "bold"}]}]}]}}, "index": "aIz6w", "typeName": "shape"}, {"x": 930.6666666666666, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-28", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3. Loss", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value at Risk (VaR)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Maximum loss over a period at a given confidence level. VaR (1%) of 12%: 99% confident the loss will not exceed 12%; a 1% chance it will. Confidence level = 1 − significance level."}]}]}}, "index": "a84ME", "typeName": "shape"}, {"x": 56, "y": 2039, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1w", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's classification"}]}]}}, "index": "ahoBf", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-39", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3zzLV", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1347.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2x", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pre-defined coupon; may be secured"}]}]}}, "index": "aIDov", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3y", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Classical finance assumes people are rational. In practice, emotion and psychology drive decisions. Benjamin Graham, in \"The Intelligent Investor\", said markets are more psychological and less logical. "}, {"type": "text", "text": "Behavioural finance", "marks": [{"type": "bold"}]}, {"type": "text", "text": " combines psychology with economics to explain irrational financial decisions. Simon Savage of GLG Partners, quoted in the book: \"We were all born to be bad fund managers because of inbuilt behavioural biases.\""}]}]}}, "index": "a4wPQ", "typeName": "shape"}, {"x": 755, "y": 670, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4z", "type": "geo", "parentId": "shape:ch12-4o", "props": {"w": 239.5, "h": 504, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Doubling down", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Instead of cutting the loss, he bought huge long Nikkei futures on both exchanges to hold the index up. He told London it was arbitrage between the two exchanges, and told each exchange he had opposite positions on the other."}]}]}}, "index": "aBk1I", "typeName": "shape"}, {"x": 56, "y": 584, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-b", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.2 Simple, annualised and compounded returns"}]}]}}, "index": "a8uyU", "typeName": "shape"}, {"x": 192.31168831168833, "y": 977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-18", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Loss from adverse price moves in a traded asset"}]}]}}, "index": "aJN2z", "typeName": "shape"}, {"x": 56, "y": 829, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-29", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.5 Beta"}]}]}}, "index": "a9yEn", "typeName": "shape"}, {"x": 56, "y": 2097, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1x", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Systematic (undiversifiable)", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Felt across investments: government policy, external factors, wars, natural calamities."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market, inflation, exchange rate, interest rate, reinvestment", "marks": [{"type": "bold"}]}, {"type": "text", "text": " risk."}]}]}}, "index": "ai3Qr", "typeName": "shape"}, {"x": 893.7977528089889, "y": 1347.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2y", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 450.2022471910113, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No assurance of dividend or appreciation"}]}]}}, "index": "aJZxr", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3z", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Eight biases to watch"}]}]}}, "index": "a5wEQ", "typeName": "shape"}, {"x": 56, "y": 659, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-c", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A return measure should help investors judge whether the return is enough for their goals and risk, compare investments, and compare against a benchmark. "}, {"type": "text", "text": "Total return", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = periodic income (interest, dividend, rent) + change in value, whether realised or not. Gold and other commodities give no periodic income at all."}]}]}}, "index": "a9OmU", "typeName": "shape"}, {"meta": {}, "id": "binding:LTGfvFxzEaLODMQop0Ho1", "type": "arrow", "fromId": "shape:ch12-51", "toId": "shape:ch12-4x", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"meta": {}, "id": "binding:PwMuLDBxFyN2CKOe5x_QR", "type": "arrow", "fromId": "shape:ch12-52", "toId": "shape:ch12-4y", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 578.8311688311688, "y": 977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-19", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Affects equity, bonds, gold, real estate. Deposits and small savings have none, but also do not appreciate"}]}]}}, "index": "aKMKI", "typeName": "shape"}, {"meta": {}, "id": "binding:0R3f6H_R36Nem_NtO2wR5", "type": "arrow", "fromId": "shape:ch12-i", "toId": "shape:ch12-g", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 712, "y": 2097, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1y", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unsystematic (diversifiable)", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Specific to one security or a small group. Reduced by adding other assets."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Credit, business, liquidity", "marks": [{"type": "bold"}]}, {"type": "text", "text": " risk."}]}]}}, "index": "ajOq6", "typeName": "shape"}, {"x": 56, "y": 1433.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2z", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 285.84269662921355, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk and return", "marks": [{"type": "bold"}]}]}]}}, "index": "aK9Ab", "typeName": "shape"}, {"x": 56, "y": 795, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-d", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "One investment, three return figures"}]}]}}, "index": "aAYMj", "typeName": "shape"}, {"x": 56, "y": 2327, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1z", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ajay", "marks": [{"type": "bold"}]}, {"type": "text", "text": " buys shares of an infrastructure company. A change in the government's push for infrastructure hits all infra companies: unsystematic, reduced by investing in other sectors. Rising rates or a recession hit everyone: systematic, seen as market risk."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ashima", "marks": [{"type": "bold"}]}, {"type": "text", "text": " buys bonds. She cuts credit risk by holding more highly rated bonds, but if rates rise, all her bonds fall: interest rate risk, common to all debt."}]}]}]}]}}, "index": "akrAU", "typeName": "shape"}, {"meta": {}, "id": "binding:9INONEYM39GBeRMqq0az2", "type": "arrow", "fromId": "shape:ch12-51", "toId": "shape:ch12-4y", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 870, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-e", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example: 150 shares bought at Rs 25, sold at Rs 30, Rs 1 dividend per share, Rs 20 brokerage each way"}]}]}}, "index": "aBp0n", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7a", "type": "text", "parentId": "shape:ch12-77", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3DUzV", "typeName": "shape"}, {"x": 56, "y": 928, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-f", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 356, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total cost", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "150 × 25 + 20 = "}, {"type": "text", "text": "Rs 3,770", "marks": [{"type": "bold"}]}]}]}}, "index": "aCiZX", "typeName": "shape"}, {"x": 850.3574879227053, "y": 2302, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6a", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 493.64251207729467, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sentenced in October 2011 to 11 years and a $10 million fine"}]}]}}, "index": "ab2x2", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7b", "type": "note", "parentId": "shape:ch12-77", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Your fixed deposit earns 7% and inflation is 6%. Your friend's equity fund fell 10% this year. Who took more risk?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4LbQ", "typeName": "shape"}, {"x": 522, "y": 928, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-g", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 356, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total returns", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sale 150 × 30 − 20 = 4,480. Dividend 150. Total "}, {"type": "text", "text": "Rs 4,630", "marks": [{"type": "bold"}]}]}]}}, "index": "aDeHE", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 12: Fundamentals of risk and return", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5a", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1CA6", "typeName": "shape"}, {"x": 6160, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6b", "type": "frame", "props": {"w": 1400, "h": 2695.9199999999983, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "a92p2", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7c", "type": "note", "parentId": "shape:ch12-77", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Which bias do you recognise most in your own investing? Give a real example."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a51xI", "typeName": "shape"}, {"x": 988, "y": 928, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-h", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 356, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Simple (holding period) return", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4,630 ÷ 3,770 − 1 = "}, {"type": "text", "text": "23%", "marks": [{"type": "bold"}]}]}]}}, "index": "aE6CQ", "typeName": "shape"}, {"x": 56, "y": 1466, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4a", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bull market", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": buyers pay higher and higher prices. Businesses are growing fast with strong demand, or there is just a change in perception or too much liquidity. It can overdo it: prices go past intrinsic value, firms borrow for expansion on rosy forecasts, and input, labour and interest costs rise near the peak. Unrealistic prices tend to correct with a crash."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bear market", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": prices fall. Businesses face lower demand, higher costs and less access to capital; some fail. Sellers quit in despair. When prices fall well below value, buyers return, central banks cut rates, and the next bull cycle slowly begins."}]}]}]}]}}, "index": "aGZZM", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5b", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Annexure 3: Lessons from history"}]}]}}, "index": "a2PzJ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6c", "type": "geo", "parentId": "shape:ch12-6b", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a1cOj", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7d", "type": "note", "parentId": "shape:ch12-77", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Klarman says beta is a poor measure of risk. Do you agree? What would you use instead?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a63Rf", "typeName": "shape"}, {"x": 234, "y": 1000, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-i", "type": "arrow", "parentId": "shape:ch12-3", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aDpjBV", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3a", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A high-risk strategy usually earns more in the long run but swings more. So compare portfolios on return "}, {"type": "text", "text": "per unit of risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". For all three measures below, "}, {"type": "text", "text": "higher is better", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a4tKE", "typeName": "shape"}, {"x": 1084, "y": 1466, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4b", "type": "note", "parentId": "shape:ch12-3u", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Graham's Mr. Market", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "You own a business with a partner, Mr. Market, who offers every day to buy your share or sell you his, at prices swayed by his moods. Do not let his emotions drive yours. Use his mispricing as an opportunity."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aHjP2", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5c", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3CiI", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6d", "type": "text", "parentId": "shape:ch12-6b", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All exam traps in this chapter"}]}]}}, "index": "a2OOz", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7e", "type": "note", "parentId": "shape:ch12-77", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Two funds both returned 18%. What else would you ask before choosing one?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7shU", "typeName": "shape"}, {"name": "", "color": "#02B1CC", "imageUrl": "", "meta": {}, "id": "user:A2z92cXaFSW1oVPGoVkrh", "typeName": "user"}, {"x": 700, "y": 1000, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-j", "type": "arrow", "parentId": "shape:ch12-3", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aFzSB", "typeName": "shape"}, {"x": 56, "y": 904, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2a", "type": "text", "parentId": "shape:ch12-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta", "marks": [{"type": "bold"}]}, {"type": "text", "text": " measures "}, {"type": "text", "text": "systematic risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " relative to the market index: the risk that cannot be diversified away. It is used in CAPM (Chapter 10)."}]}]}}, "index": "aAJ6n", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3b", "type": "text", "parentId": "shape:ch12-36", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Jensen's alpha, Sharpe, Treynor"}]}]}}, "index": "a5SNM", "typeName": "shape"}, {"x": 56, "y": 2015.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4c", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Quotes the book collects"}]}]}}, "index": "aIy9z", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5d", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How the 2008 crisis built up"}]}]}}, "index": "a4jHE", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6e", "type": "text", "parentId": "shape:ch12-6b", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read these the night before. Each one is a question waiting to happen"}]}]}}, "index": "a311M", "typeName": "shape"}, {"x": 56, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7f", "type": "note", "parentId": "shape:ch12-77", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " How wide a margin of safety would you want before buying a share? Why that number?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a80T2", "typeName": "shape"}, {"x": 56, "y": 1098, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-k", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If held 15 months", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Simple annualised return", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(23% ÷ 15) × 12 = "}, {"type": "text", "text": "18.4%", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Divide by months (or days) held, multiply by 12 (or 365)."}]}]}}, "index": "aG3SM", "typeName": "shape"}, {"x": 56, "y": 1087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1a", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Credit (default)", "marks": [{"type": "bold"}]}]}]}}, "index": "aLCNM", "typeName": "shape"}, {"x": 56, "y": 994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2b", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 318.6666666666667, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta = 1", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Moves with the market. Market +10%: stock +10%."}]}]}}, "index": "aBN7M", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3c", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 186.22467771639043, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measure", "marks": [{"type": "bold"}]}]}]}}, "index": "a6UpL", "typeName": "shape"}, {"x": 56, "y": 2090.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4d", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Benjamin Graham", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"In the short run, market is a voting machine but in the long run, it is a weighing machine.\""}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"To achieve satisfactory investment results is easier than most people realize; to achieve superior results is harder than it looks.\""}]}]}}, "index": "aJNXX", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5e", "type": "text", "parentId": "shape:ch12-59", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Annexure 3, Case 2. The book's account, from 2003 to 2004 onwards"}]}]}}, "index": "a538X", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6f", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ROI = net profit ÷ investment × 100. Safety of capital matters as much as return."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4qRU", "typeName": "shape"}, {"x": 384, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7g", "type": "note", "parentId": "shape:ch12-77", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Barings and 2008 were both called failures of management, not of the products. Do you agree?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9A4b", "typeName": "shape"}, {"x": 712, "y": 1098, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-l", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If held 5 years", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "CAGR", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(4,630 ÷ 3,770)^1/5 − 1 = "}, {"type": "text", "text": "4.2%", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Counts compounding."}]}]}}, "index": "aH1pv", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1b", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Issuer may not pay interest or principal"}]}]}}, "index": "aMQ4f", "typeName": "shape"}, {"x": 398.6666666666667, "y": 994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2c", "type": "geo", "parentId": "shape:ch12-20", "props": {"w": 318.6666666666667, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Beta below 1", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Less volatile than the market."}]}]}}, "index": "aCukv", "typeName": "shape"}, {"x": 250.22467771639043, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3d", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 344.51565377532233, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Formula", "marks": [{"type": "bold"}]}]}]}}, "index": "a7myn", "typeName": "shape"}, {"x": 712, "y": 2090.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4e", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Warren Buffett", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Rule No.1 is never lose money. Rule No.2 is never forget rule number one.\""}]}]}}, "index": "aKwNn", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5f", "type": "geo", "parentId": "shape:ch12-59", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Banks", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Lent to less creditworthy borrowers and loosened "}, {"type": "text", "text": "loan to value", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (for example from 80:20 to 85:15) to earn higher margins (NIMs). They assumed ever-rising house prices would cover any default: a view on real estate, which is not a banker's job."}]}]}}, "index": "a66fj", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6g", "type": "note", "parentId": "shape:ch12-6b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Simple (holding period) return ignores time; simple annualising ignores compounding."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5qxI", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7h", "ty