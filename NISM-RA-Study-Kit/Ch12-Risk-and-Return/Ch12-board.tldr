t": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3xcU", "typeName": "shape"}, {"x": 883.0939226519338, "y": 487, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3j", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 460.9060773480663, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aDaBr", "typeName": "shape"}, {"x": 56, "y": 2885.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4k", "type": "text", "parentId": "shape:ch12-3u", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stock exchanges exist to provide liquidity, but not every share is liquid: liquidity needs many buyers and sellers."}]}]}}, "index": "aQ5Vn", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5l", "type": "note", "parentId": "shape:ch12-5g", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Which bias do you recognise most in your own investing? Give a real example."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5X2X", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3", "type": "frame", "props": {"w": 1400, "h": 1858, "name": "12.1 Return on investment", "color": "black"}, "parentId": "page:page", "index": "a1xZv", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-s", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3ULm", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1355, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1i", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Most common when rates are "}, {"type": "text", "text": "falling", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": issuers replace high-coupon bonds. Goes with reinvestment risk"}]}]}}, "index": "aTyXz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2j", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A valuation model is only as good as its inputs. Identify the critical variables and see how the value changes when "}, {"type": "text", "text": "one variable changes and all others stay constant", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". That is "}, {"type": "text", "text": "sensitivity analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Example: in a DCF, run the valuation at several discount rates and tabulate the results. "}, {"type": "text", "text": "Scenario analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": " instead takes a best case, a worst case and the most likely case."}]}]}}, "index": "a4OFI", "typeName": "shape"}, {"x": 56, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3k", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 186.22467771639043, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sharpe ratio", "marks": [{"type": "bold"}]}]}]}}, "index": "aErBf", "typeName": "shape"}, {"x": 56, "y": 2943.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4l", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stock turnover ratio", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Shares traded in a period (usually a year) ÷ "}, {"type": "text", "text": "free float", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shares outstanding."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Free float: shares held by non-promoter shareholders."}]}]}}, "index": "aRDin", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5m", "type": "note", "parentId": "shape:ch12-5g", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Klarman says beta is a poor measure of risk. Do you agree? What would you use instead?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6vBf", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1QHb", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-t", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the volatility and uncertainty of returns and, at the extreme, loss of capital. An investment is also risky if actual returns differ from expected ones. A bank fixed deposit is low risk; equity is risky because dividends are uncertain and values swing. Higher return comes only with willingness to take higher risk. Investors should know which risks they face: a retired investor may accept low returns but not loss of capital."}]}]}}, "index": "a4z7u", "typeName": "shape"}, {"x": 56, "y": 1465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1j", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reinvestment", "marks": [{"type": "bold"}]}]}]}}, "index": "aUrm6", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2k", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.7 Margin of safety"}]}]}}, "index": "a5egA", "typeName": "shape"}, {"x": 250.22467771639043, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3l", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 344.51565377532233, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "(Portfolio return − Rf) ÷ Standard deviation"}]}]}}, "index": "aFccj", "typeName": "shape"}, {"x": 712, "y": 2943.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4m", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Traded value turnover ratio", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Traded value of shares ÷ market capitalisation."}]}]}}, "index": "aS41E", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5n", "type": "note", "parentId": "shape:ch12-5g", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Two funds both returned 18%. What else would you ask before choosing one?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7mpA", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return on investment"}]}]}}, "index": "a2K8I", "typeName": "shape"}, {"x": 56, "y": 390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-u", "type": "text", "parentId": "shape:ch12-p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ten risks, as described in the book"}]}]}}, "index": "a5Xaz", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1k", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coupons may have to be reinvested at a lower rate"}]}]}}, "index": "aVhyQ", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2l", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Popularised by "}, {"type": "text", "text": "Benjamin Graham", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", \"the father of value investing\", and followers such as Warren Buffett. "}, {"type": "text", "text": "Margin of safety", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the gap between value and price when a security is bought well "}, {"type": "text", "text": "below its intrinsic value", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The bigger the gap, the bigger the margin."}]}]}}, "index": "a6VaQ", "typeName": "shape"}, {"x": 602.7403314917128, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3m", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 272.353591160221, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total risk (standard deviation)"}]}]}}, "index": "aGZuI", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4n", "type": "frame", "props": {"w": 1400, "h": 2586.479999999996, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "a7U2D", "typeName": "shape"}, {"x": 56, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5o", "type": "note", "parentId": "shape:ch12-5g", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " How wide a margin of safety would you want before buying a share? Why that number?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8YY6", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-6", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12 of 15"}]}]}}, "index": "a3QU1", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-v", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk", "marks": [{"type": "bold"}]}]}]}}, "index": "a6bbj", "typeName": "shape"}, {"x": 578.8311688311688, "y": 1465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1l", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rates rise: risk falls. Rates fall: risk rises. A cumulative option avoids it (but a bond may then swing more in price)"}]}]}}, "index": "aWL0A", "typeName": "shape"}, {"x": 56, "y": 587, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2m", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "It allows investing with minimal downside risk, but does "}, {"type": "text", "text": "not guarantee", "marks": [{"type": "bold"}]}, {"type": "text", "text": " success."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "It gives a "}, {"type": "text", "text": "cushion", "marks": [{"type": "bold"}]}, {"type": "text", "text": " against errors in the analyst's valuation, which is subjective anyway."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "There is "}, {"type": "text", "text": "no universal standard", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for how wide it should be; each investor sets their own."}]}]}]}]}}, "index": "a7UYP", "typeName": "shape"}, {"x": 883.0939226519338, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3n", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 460.9060773480663, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investors with much of their wealth in one investment, "}, {"type": "text", "text": "not adequately diversified", "marks": [{"type": "bold"}]}]}]}}, "index": "aH26Q", "typeName": "shape"}, {"x": 384, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-50", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A sovereign has no default risk on local-currency borrowing."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDZsU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4o", "type": "geo", "parentId": "shape:ch12-4n", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a1MVv", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5p", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 12: Fundamentals of risk and return"}]}]}}, "index": "a9qVz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-7", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "An investor expects two things: a "}, {"type": "text", "text": "return", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and, more importantly, the "}, {"type": "text", "text": "capital back", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Safety of capital matters as much as return. Judge a return by its "}, {"type": "text", "text": "level", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", its "}, {"type": "text", "text": "volatility", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and its "}, {"type": "text", "text": "nature", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (periodic income or capital gain)."}]}]}}, "index": "a4kJj", "typeName": "shape"}, {"x": 192.31168831168833, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-w", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What it is", "marks": [{"type": "bold"}]}]}]}}, "index": "a7L1j", "typeName": "shape"}, {"x": 56, "y": 1599, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1m", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Political", "marks": [{"type": "bold"}]}]}]}}, "index": "aXypE", "typeName": "shape"}, {"x": 1084, "y": 587, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2n", "type": "note", "parentId": "shape:ch12-2f", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An engineer rates a bridge for 30 tonnes but lets only 10-tonne trucks cross. The gap covers the mistakes nobody knows they made."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a8ugr", "typeName": "shape"}, {"x": 56, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-40", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Loss aversion", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Strongly preferring to avoid losses over making gains. The pain of a loss is about "}, {"type": "text", "text": "twice", "marks": [{"type": "bold"}]}, {"type": "text", "text": " as strong as the pleasure of an equal gain. Leads to inaction: holding losers, avoiding equity when volatility is in the news."}]}]}}, "index": "a6PVz", "typeName": "shape"}, {"x": 56, "y": 707, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3o", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 186.22467771639043, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Treynor ratio", "marks": [{"type": "bold"}]}]}]}}, "index": "aIhyj", "typeName": "shape"}, {"x": 712, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-51", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Credit ratings: AAA and A1 highest, D default. SEBI standardised the symbols."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aELUB", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4p", "type": "text", "parentId": "shape:ch12-4n", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All exam traps in this chapter"}]}]}}, "index": "a2c1U", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5q", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 7 marks of 100  ·  Book pages 228 to 246  ·  About 60 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "aAFbU", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-8", "type": "text", "parentId": "shape:ch12-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A return in rupees means little on its own; compare it with the capital that earned it."}]}]}}, "index": "a5B3A", "typeName": "shape"}, {"x": 578.8311688311688, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-x", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 481.16883116883116, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book's example or note", "marks": [{"type": "bold"}]}]}]}}, "index": "a8cP2", "typeName": "shape"}, {"x": 192.31168831168833, "y": 1599, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-1n", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 378.5194805194805, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unfavourable government action: nationalisation, tax or licensing changes"}]}]}}, "index": "aY8YA", "typeName": "shape"}, {"x": 349.84269662921355, "y": 1433.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-30", "type": "geo", "parentId": "shape:ch12-2f", "props": {"w": 535.9550561797753, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower risk, so lower return"}]}]}}, "index": "aLSMI", "typeName": "shape"}, {"x": 56, "y": 1011.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-2o", "type": "text", "parentId": "shape:ch12-2f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.8 Equity returns versus bond returns"}]}]}}, "index": "a9Qgn", "typeName": "shape"}, {"x": 712, "y": 465, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-41", "type": "geo", "parentId": "shape:ch12-3u", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Confirmation (my-side) bias", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Seeking or reading information so it confirms what you already believe. A trader whose reason for buying fails invents a new reason to hold."}]}]}}, "index": "a7m8X", "typeName": "shape"}, {"x": 250.22467771639043, "y": 707, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-3p", "type": "geo", "parentId": "shape:ch12-36", "props": {"w": 344.51565377532233, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "(Portfolio return − Rf) ÷ Beta"}]}]}}, "index": "aJ0Fn", "typeName": "shape"}, {"x": 1040, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-52", "type": "note", "parentId": "shape:ch12-4n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Call risk is most prevalent when rates are falling."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFfNA", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-4q", "type": "text", "parentId": "shape:ch12-4n", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read these the night before. Each one is a question waiting to happen"}]}]}}, "index": "a3YMj", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-5r", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measure the return properly, name the risks you took to earn it, and judge the return per unit of risk. Then watch your own biases."}]}]}}, "index": "aBy3r", "typeName": "shape"}, {"x": 56, "y": 370, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-9", "type": "geo", "parentId": "shape:ch12-3", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return on investment (%) = (Net profit ÷ Investment) × 100"}]}]}}, "index": "a60zJ", "typeName": "shape"}, {"x": 56, "y": 551, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch12-y", "type": "geo", "parentId": "shape:ch12-p", "props": {"w": 128.31168831168833, "h": 174, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "c