c", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's worked examples"}]}]}}, "index": "aHIff", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3g", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1djb", "typeName": "shape"}, {"x": 56, "y": 1235, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4h", "type": "geo", "parentId": "shape:ch03-44", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sold abroad", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "External (Euro) bond", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Currency differs from the currency of the country where it is sold. INR bonds sold abroad are "}, {"type": "text", "text": "masala bonds", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; the "}, {"type": "text", "text": "investor", "marks": [{"type": "bold"}]}, {"type": "text", "text": " carries currency risk."}]}]}}, "index": "aD8BE", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5i", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " No fixed cut-off for large, mid and small cap. Book's rule of thumb: top 50 to 100 large, next 200 to 500 mid."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7YRQ", "typeName": "shape"}, {"x": 56, "y": 769, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-l", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 237.3573573573574, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Say in management", "marks": [{"type": "bold"}]}]}]}}, "index": "aIx9I", "typeName": "shape"}, {"x": 56, "y": 2067, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1f", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "This is hard to get right every time, because what is being priced is an unknown future. The book calls equity investing both an art and a science, shaped by human behaviour in groups."}]}]}}, "index": "aMEi6", "typeName": "shape"}, {"x": 56, "y": 1474.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2g", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EPS", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Earnings per share", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Net profit ÷ shares outstanding (strictly, the time-weighted average)."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Rs 10 lakh ÷ 2 lakh shares = "}, {"type": "text", "text": "Rs 5", "marks": [{"type": "bold"}]}]}]}}, "index": "aINHM", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3h", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Debt words"}]}]}}, "index": "a22iX", "typeName": "shape"}, {"x": 712, "y": 1235, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4i", "type": "geo", "parentId": "shape:ch03-44", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No maturity", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Perpetual bond", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "No maturity date. Issuer never has to redeem. May be \"callable\": the issuer can buy it back when it chooses."}]}]}}, "index": "aEllM", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5j", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " EV subtracts cash and non-operating investments. Use market value of listed equity, not its book value."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8cWM", "typeName": "shape"}, {"x": 301.3573573573574, "y": 769, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-m", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 376.8048048048048, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Yes"}]}]}}, "index": "aJZMv", "typeName": "shape"}, {"x": 56, "y": 2171, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1g", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market capitalisation"}]}]}}, "index": "aNFVv", "typeName": "shape"}, {"x": 712, "y": 1474.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2h", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "DPS", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Dividend per share", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Dividend % × face value, or dividend paid ÷ shares."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "40% on Rs 10 face value = "}, {"type": "text", "text": "Rs 4", "marks": [{"type": "bold"}]}]}]}}, "index": "aJgiU", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3i", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3q2E", "typeName": "shape"}, {"x": 56, "y": 1479, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4j", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Zero coupon bonds in practice"}]}]}}, "index": "aFgzm", "typeName": "shape"}, {"x": 384, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5k", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " TTM = trailing twelve months. Forward earnings = projected."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9kY2", "typeName": "shape"}, {"x": 686.1621621621622, "y": 769, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-n", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 373.83783783783787, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No"}]}]}}, "index": "aKuzm", "typeName": "shape"}, {"x": 56, "y": 2246, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1h", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market cap = market price per share × number of shares outstanding"}]}]}}, "index": "aO5UY", "typeName": "shape"}, {"x": 56, "y": 1702.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2i", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/E", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price to earnings", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market price ÷ EPS. What the market pays for Rs 1 of earnings."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"12x\" = twelve times earnings"}]}]}}, "index": "aKE3I", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3j", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three ways to measure a bond's return"}]}]}}, "index": "a4M9v", "typeName": "shape"}, {"x": 56, "y": 1554, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4k", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Money market", "marks": [{"type": "bold"}]}, {"type": "text", "text": " instruments are short-term zeroes, under 1 year: "}, {"type": "text", "text": "T-bills", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (government), "}, {"type": "text", "text": "commercial paper", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (companies), "}, {"type": "text", "text": "certificates of deposit", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (banks and financial institutions)."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Very long zeroes issued at a steep discount are "}, {"type": "text", "text": "deep discount bonds", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Examples: an old "}, {"type": "text", "text": "IDBI", "marks": [{"type": "bold"}]}, {"type": "text", "text": " issue, and "}, {"type": "text", "text": "Kisan Vikas Patra", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example: in October 2009, ETHL Communications Holdings (an Essar Group company) raised "}, {"type": "text", "text": "Rs 4,280 crore", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " in zero coupon bonds. Series 1 was issued at Rs 85.80 (implied rate 9.15%), Series 2 at Rs 82.55 (9.25%). Both repaid Rs 100 in 2011."}]}]}]}]}}, "index": "aG6IU", "typeName": "shape"}, {"x": 712, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5l", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Forward P/E is lower than current P/E when earnings are expected to grow."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAFwM", "typeName": "shape"}, {"x": 56, "y": 855, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-o", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 237.3573573573574, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk", "marks": [{"type": "bold"}]}]}]}}, "index": "aLc6X", "typeName": "shape"}, {"x": 56, "y": 2356, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1i", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Example: 1 lakh shares at Rs 20 = market cap of "}, {"type": "text", "text": "Rs 20 lakh", "marks": [{"type": "highlight"}]}, {"type": "text", "text": ". It changes every time the price changes. \"Outstanding\" means issued, subscribed and fully paid up. Do not confuse it with authorised capital."}]}]}}, "index": "aPApj", "typeName": "shape"}, {"x": 712, "y": 1702.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2j", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/S", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price to sales", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price ÷ sales per share, or market cap ÷ annual net sales."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sales Rs 1 crore, 10 lakh shares, price Rs 40: 40 ÷ 10 = "}, {"type": "text", "text": "4", "marks": [{"type": "bold"}]}]}]}}, "index": "aLQ6Q", "typeName": "shape"}, {"x": 56, "y": 325, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3k", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "HPR, current yield, YTM, realised yield"}]}]}}, "index": "a52QI", "typeName": "shape"}, {"x": 1084, "y": 1554, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4l", "type": "note", "parentId": "shape:ch03-44", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "For the same rupee return, a zero coupon bond has "}, {"type": "text", "text": "more", "marks": [{"type": "bold"}]}, {"type": "text", "text": " interest rate risk than a coupon bond of the same maturity, because its duration is higher. A floating rate bond has "}, {"type": "text", "text": "less", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aHqY6", "typeName": "shape"}, {"x": 1040, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5m", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " P/S suits loss-making firms. P/BV suits banks and financial firms, not services firms."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBXw6", "typeName": "shape"}, {"x": 301.3573573573574, "y": 855, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-p", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 376.8048048048048, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Higher. Long term, growth, volatile"}]}]}}, "index": "aMdBE", "typeName": "shape"}, {"x": 56, "y": 2460, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1j", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Large, mid and small cap"}]}]}}, "index": "aQBsI", "typeName": "shape"}, {"x": 56, "y": 1930.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2k", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/BV", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price to book value", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market price ÷ book value per share."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(10 + 50 lakh) ÷ 6 lakh = BV Rs 10. Price Rs 20: "}, {"type": "text", "text": "2x", "marks": [{"type": "bold"}]}]}]}}, "index": "aMfuz", "typeName": "shape"}, {"x": 56, "y": 400, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3l", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "From crude to complete"}]}]}}, "index": "a6MpI", "typeName": "shape"}, {"x": 4620, "y": 2985.799999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4m", "type": "frame", "props": {"w": 1400, "h": 1854.199999999997, "name": "3.3 Types of bonds (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a7qOz", "typeName": "shape"}, {"x": 56, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5n", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " P/BV below 1 is not automatically a bargain."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCAZb", "typeName": "shape"}, {"x": 686.1621621621622, "y": 855, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-q", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 373.83783783783787, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower. Steady income, unless the company defaults"}]}]}}, "index": "aNiQQ", "typeName": "shape"}, {"x": 56, "y": 2535, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1k", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's common rule of thumb, ranked by market cap"}]}]}}, "index": "aRMEb", "typeName": "shape"}, {"x": 712, "y": 1930.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2l", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Payout", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Dividend payout ratio", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "DPS ÷ EPS. The share of profit paid out as dividend."}]}]}}, "index": "aN2vX", "typeName": "shape"}, {"x": 56, "y": 458, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3m", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Holding period return", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "HPR", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "(Coupons + interest on reinvested coupons + price gain) ÷ purchase price."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Book: buy at 104, coupon 8 reinvested at 7%, sell at 110 after a year. (8 + 0.56 + 6) ÷ 104 = "}, {"type": "text", "text": "14.00%", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Crude. Ignores compounding. Do not compare with annualised returns."}]}]}}, "index": "a7elf", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4n", "type": "geo", "parentId": "shape:ch03-4m", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1pgA", "typeName": "shape"}, {"x": 384, "y": 2007.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-60", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " AT1 perpetual coupons are non-cumulative and paid only from distributable profits."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aPAF2", "typeName": "shape"}, {"x": 384, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5o", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " DVR: fewer than 1 vote per share; 10% dividend over 3 years; at most 25% of post-issue paid-up capital; trades at a discount."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aD5NE", "typeName": "shape"}, {"x": 1084, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-r", "type": "note", "parentId": "shape:ch03-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A company borrows at "}, {"type": "text", "text": "12%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " and earns "}, {"type": "text", "text": "14%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " on what it builds with the loan. The lender gets exactly 12%, as promised. The extra 2% goes to the owners. If the company earns only 10%, the lender still gets 12%, and the owners make up the gap from their share."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 264, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aOlLU", "typeName": "shape"}, {"x": 56, "y": 2593, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1l", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 236.29629629629628, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Large: top 50 to 100"}]}]}}, "index": "aS5T6", "typeName": "shape"}, {"x": 56, "y": 2144.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2m", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reading the P/E"}]}]}}, "index": "aOCyM", "typeName": "shape"}, {"x": 712, "y": 458, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3n", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Current yield", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Coupon ÷ market price", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "8.24GS2018 at Rs 104: 8.24 ÷ 104 = "}, {"type": "text", "text": "7.92%", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Simple, but ignores future cash flows, its biggest drawback. Like a share's dividend yield."}]}]}}, "index": "a8fyM", "typeName": "shape"}, {"x": 56, "y": 1337.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-50", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Foreign currency bond example: Delhi International Airport Limited (a GMR company) issued USD bonds in February 2020. Euro bond example: a USD bond sold in Kuwait. Hedging the currency risk can wipe out the interest saving. See Chapter 2 for the naming rules and the first masala bond."}]}]}}, "index": "aEyej", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4o", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Types of bonds"}]}]}}, "index": "a2AlE", "typeName": "shape"}, {"x": 712, "y": 2007.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-61", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Basis = spot − futures. Contango: futures above spot. Backwardation: futures below spot."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQljE", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3", "type": "frame", "props": {"w": 1400, "h": 1150.2000000000007, "name": "Intro Equity or debt?", "color": "black"}, "parentId": "page:page", "index": "a1Y1U", "typeName": "shape"}, {"x": 712, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5p", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Coupon amount = face value × coupon rate. G-secs pay half-yearly."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEenM", "typeName": "shape"}, {"x": 56, "y": 1030.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-s", "type": "text", "parentId": "shape:ch03-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "So the choice is a trade-off. Lower risk and a steady return: choose debt. A higher return: accept the extra risk of equity. Most investors split their money between the two."}]}]}}, "index": "aPxZv", "typeName": "shape"}, {"x": 298.2962962962963, "y": 2593, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1m", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 472.59259259259255, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mid: next 200 to 500"}]}]}}, "index": "aTDQI", "typeName": "shape"}, {"x": 56, "y": 2219.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2n", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A P/E on past earnings has limited use. Prices move ahead of earnings, in anticipation of future profits."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If earnings are expected to grow, the market pays a higher multiple. So analysts look at the "}, {"type": "text", "text": "forward P/E", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Example: a share at 20 times this year's earnings but only 15 times next year's. The same price is divided by bigger future earnings."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The P/E of the whole index is used to judge if the market is expensive or cheap. It rises when prices run ahead of earnings and falls when markets correct. A value investor may buy when the P/E is low."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A large, stable company usually has a higher P/E than a small, risky one. But this is not \"gospel truth\": a small company with high expected growth can have a higher P/E."}]}]}]}]}}, "index": "aPNuE", "typeName": "shape"}, {"x": 493.3333333333333, "y": 2238.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-40", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower coupon", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Higher duration"}]}]}}, "index": "aLh42", "typeName": "shape"}, {"x": 56, "y": 776, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3o", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Yield to maturity", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "YTM", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The rate that makes the present value of all future cash flows (coupons, their reinvestment, redemption) equal to today's price. It is the bond's "}, {"type": "text", "text": "IRR", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Found by trial and error or Excel's "}, {"type": "text", "text": "XIRR", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a9Hxj", "typeName": "shape"}, {"x": 56, "y": 1473.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-51", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "AT1 perpetual bonds"}]}]}}, "index": "aFJ6Q", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4p", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3K8U", "typeName": "shape"}, {"x": 6160, "y": 4269.320000000016, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-62", "type": "frame", "props": {"w": 1400, "h": 910, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "aAvPv", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Intro", "marks": [{"type": "bold"}]}]}]}}, "index": "a14k2", "typeName": "shape"}, {"x": 1040, "y": 878, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5q", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Rates up, bond prices down. A bond with a coupon below market yield trades below face value."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFXx2", "typeName": "shape"}, {"x": 0, "y": 2078.8000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-t", "type": "frame", "props": {"w": 1400, "h": 3622.800000000003, "name": "3.1 Equity words (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a2rKE", "typeName": "shape"}, {"x": 776.8888888888889, "y": 2593, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1n", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 567.1111111111111, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Small: all the rest"}]}]}}, "index": "aU15U", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-30", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A bond is a contract. Its features are the "}, {"type": "text", "text": "principal", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", the "}, {"type": "text", "text": "coupon", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", the "}, {"type": "text", "text": "maturity", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", how often coupons are paid, and any "}, {"type": "text", "text": "collateral", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". With "}, {"type": "text", "text": "secured", "marks": [{"type": "bold"}]}, {"type": "text", "text": " debt, the lender can have assets sold if the company defaults. With "}, {"type": "text", "text": "unsecured", "marks": [{"type": "bold"}]}, {"type": "text", "text": " debt, they cannot. Debt can be "}, {"type": "text", "text": "privately placed", "marks": [{"type": "bold"}]}, {"type": "text", "text": " with a few select investors or sold to the public. Debt sold in a public issue must be listed on a stock exchange. Unlisted debt is held to maturity or traded over the counter."}]}]}}, "index": "a5tXM", "typeName": "shape"}, {"x": 56, "y": 2515.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2o", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "When P/S and P/BV are useful"}]}]}}, "index": "aQdmb", "typeName": "shape"}, {"x": 930.6666666666666, "y": 2238.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-41", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower yield", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Higher duration"}]}]}}, "index": "aMhSI", "typeName": "shape"}, {"x": 712, "y": 776, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3p", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Realised yield", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "If you sell before maturity", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Annualised, with compounding. Book: buy at 1,000, 12% coupons reinvested at 14%, sell at 1,050 after 5 years = about "}, {"type": "text", "text": "13%", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aAwDA", "typeName": "shape"}, {"x": 56, "y": 1548.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-52", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Many Indian banks issued perpetual bonds as "}, {"type": "text", "text": "Additional Tier 1 (AT1)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " capital under "}, {"type": "text", "text": "Basel III", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". They are riskier than normal bonds:"}]}]}}, "index": "aGESv", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4q", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Convertible bonds: the terms fixed at issue"}]}]}}, "index": "a4hVQ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-63", "type": "geo", "parentId": "shape:ch03-62", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a1uR2", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5", "type": "text", "parentId": "shape:ch03-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity or debt?"}]}]}}, "index": "a2k4j", "typeName": "shape"}, {"x": 56, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5r", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Current yield = coupon ÷ market price. Ignores future cash flows."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGxUc", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-u", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1xzzV", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-20", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rs crore. 10 lakh shares trading at Rs 340."}]}]}}, "index": "a5GIQ", "typeName": "shape"}, {"x": 56, "y": 2683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1o", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "grey", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Large caps have high liquidity and include most "}, {"type": "text", "text": "blue chips", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (long history, stable profits, market share). Small caps have little liquidity."}]}]}}, "index": "aV7FI", "typeName": "shape"}, {"x": 56, "y": 480, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-31", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The three questions every loan answers"}]}]}}, "index": "a6zPW", "typeName": "shape"}, {"x": 56, "y": 2590.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2p", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 490, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/S", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Useful when a company is making "}, {"type": "text", "text": "losses", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for a while, so P/E means nothing. A lower P/S than peers may mean undervalued. A fall in revenue growth is a big risk for such shares."}]}]}}, "index": "aRYnn", "typeName": "shape"}, {"x": 56, "y": 2378.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-42", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "grey", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Duration shrinks as a bond nears maturity, so the bond gets less risky with time."}]}]}}, "index": "aNCN6", "typeName": "shape"}, {"x": 56, "y": 1036, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3q", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 1004, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Realised yield = [ (coupon × ((1 + reinvestment rate)^years − 1) ÷ reinvestment rate + sale price) ÷ purchase price ]^1/years − 1"}]}]}}, "index": "aBMPU", "typeName": "shape"}, {"x": 56, "y": 1638.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-53", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. No fixed maturity date."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. Rank below deposits, loans from other banks and all other bonds."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. Coupon can be paid only from distributable profits."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. Coupon is "}, {"type": "text", "text": "non-cumulative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": a missed coupon is not made up later."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. Can be converted into equity by the issuer if a pre-set trigger event happens."}]}]}}, "index": "aHUbo", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4r", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The conversion date (on or before which to convert), the conversion ratio (shares per bond), the conversion price (usually at a discount to market price), and the portion that converts. Conversion can be "}, {"type": "text", "text": "compulsory", "marks": [{"type": "bold"}]}, {"type": "text", "text": " or "}, {"type": "text", "text": "optional", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "full", "marks": [{"type": "bold"}]}, {"type": "text", "text": " or "}, {"type": "text", "text": "partial", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". After conversion, debt leaves the balance sheet and equity capital rises."}]}]}}, "index": "a5Gs2", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-64", "type": "text", "parentId": "shape:ch03-62", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a2Twv", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-6", "type": "text", "parentId": "shape:ch03-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15"}]}]}}, "index": "a3e1v", "typeName": "shape"}, {"x": 384, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5s", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " YTM = IRR of the bond. Assumes holding to maturity and reinvesting at the same rate."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHAjv", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-v", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity words"}]}]}}, "index": "a2BPz", "typeName": "shape"}, {"x": 56, "y": 458, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-10", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Face value", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The printed price", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The nominal value of a share, such as Rs 10. Share capital = number of shares × face value."}]}]}}, "index": "a7r8j", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-21", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 169.6, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market cap", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "340 × 10 lakh = "}, {"type": "text", "text": "34.0", "marks": [{"type": "bold"}]}]}]}}, "index": "a6YIQ", "typeName": "shape"}, {"x": 1084, "y": 2683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1p", "type": "note", "parentId": "shape:ch03-t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The book says there is "}, {"type": "text", "text": "no fixed size cut-off", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for large, mid and small cap. The ranking floats with the market, the period and the regulatory definition."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aW1lb", "typeName": "shape"}, {"x": 56, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-32", "type": "geo", "parentId": "shape:ch03-2v", "props": {"w": 318.6666666666667, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How much?", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Face value (principal)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The loan amount per bond, also called par value. Rs 100, Rs 1,000 or any amount. This is what is repaid at maturity, whatever price you paid in the market."}]}]}}, "index": "a7jin", "typeName": "shape"}, {"x": 570, "y": 2590.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2q", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 490, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/BV", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Useful when earnings are negative, and for "}, {"type": "text", "text": "banks and financial institutions", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", whose assets are mostly valued at market prices. Not relevant for "}, {"type": "text", "text": "services", "marks": [{"type": "bold"}]}, {"type": "text", "text": " firms with few assets."}]}]}}, "index": "aSesX", "typeName": "shape"}, {"x": 1084, "y": 2378.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-43", "type": "note", "parentId": "shape:ch03-3f", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Duration is like a seesaw. A long plank (long maturity, small coupons) swings a lot when someone sits at the far end. A short plank barely moves. The \"someone\" is a change in interest rates."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 168, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aOLRE", "typeName": "shape"}, {"x": 1084, "y": 1036, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3r", "type": "note", "parentId": "shape:ch03-3f", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "YTM assumes two things: you "}, {"type": "text", "text": "hold the bond to maturity", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and you "}, {"type": "text", "text": "reinvest every coupon at the same YTM", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". That means a flat yield curve that never changes, which is not realistic. It is still widely used because it is quick and simple."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCCMv", "typeName": "shape"}, {"x": 6160, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-54", "type": "frame", "props": {"w": 1400, "h": 832.8000000000029, "name": "3.4 Commodity words", "color": "black"}, "parentId": "page:page", "index": "a8SW2", "typeName": "shape"}, {"x": 56, "y": 447, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4s", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Principal protected notes"}]}]}}, "index": "a6Wdj", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-65", "type": "text", "parentId": "shape:ch03-62", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3j8v", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-7", "type": "text", "parentId": "shape:ch03-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A business that needs money can raise it in two ways. It can sell a part of itself ("}, {"type": "text", "text": "equity", "marks": [{"type": "bold"}]}, {"type": "text", "text": ") or borrow ("}, {"type": "text", "text": "debt", "marks": [{"type": "bold"}]}, {"type": "text", "text": "). Chapter 2 introduced both. Here is how they differ."}]}]}}, "index": "a42PA", "typeName": "shape"}, {"x": 712, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5t", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " HPR ignores compounding; realised yield is annualised."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aIx9v", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-w", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15  ·  Part 1 of 2"}]}]}}, "index": "a3XeM", "typeName": "shape"}, {"meta": {}, "id": "binding:9-4-G2kWB1aW2fuIe5ez6", "type": "arrow", "fromId": "shape:ch03-26", "toId": "shape:ch03-21", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"meta": {}, "id": "binding:oExxwz_iLVPe-9QMEXRIu", "type": "arrow", "fromId": "shape:ch03-29", "toId": "shape:ch03-25", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 493.3333333333333, "y": 458, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-11", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book value", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What the books say", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Net worth ÷ number of shares. What each share would get, in theory, if the company closed down."}]}]}}, "index": "a8t8Q", "typeName": "shape"}, {"x": 335.6, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-22", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 169.6, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "+ Preferred", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "8.5", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (book value)"}]}]}}, "index": "a7cDf", "typeName": "shape"}, {"x": 56, "y": 3093.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1q", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The ratio of a country's total "}, {"type": "text", "text": "market cap to its GDP", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is used to judge the size and importance of its stock market."}]}]}}, "index": "aXit2", "typeName": "shape"}, {"x": 398.6666666666667, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-33", "type": "geo", "parentId": "shape:ch03-2v", "props": {"w": 318.6666666666667, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "At what rate?", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Coupon rate", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The fixed yearly payment, as a % of face value. Coupon amount = face value × coupon rate."}]}]}}, "index": "a8Ncv", "typeName": "shape"}, {"x": 1084, "y": 2590.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2r", "type": "note", "parentId": "shape:ch03-1v", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "P/BV below 1 does "}, {"type": "text", "text": "not", "marks": [{"type": "bold"}]}, {"type": "text", "text": " automatically mean a bargain. The company may have made poor investments that still have to be written down. Always ask why the market prices it below book value."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aT3mz", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-44", "type": "frame", "props": {"w": 1400, "h": 2057.199999999997, "name": "3.3 Types of bonds (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a6czy", "typeName": "shape"}, {"x": 56, "y": 1616.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3s", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Duration"}]}]}}, "index": "aDX5r", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-55", "type": "geo", "parentId": "shape:ch03-54", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.4", "marks": [{"type": "bold"}]}]}]}}, "index": "a1z0i", "typeName": "shape"}, {"x": 56, "y": 522, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4t", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Several NBFCs have issued PPNs as "}, {"type": "text", "text": "Equity Linked Bonds (ELBs)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "Commodity Linked Bonds (CLBs)", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Some are listed."}]}]}}, "index": "a7RYj", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-66", "type": "note", "parentId": "shape:ch03-62", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Pick a listed company you know. Find its price, EPS and book value. Work out its P/E and P/BV. Is it cheap?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4xIU", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-8", "type": "text", "parentId": "shape:ch03-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Owner versus lender"}]}]}}, "index": "a5XVz", "typeName": "shape"}, {"x": 1040, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5u", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Higher duration with longer maturity, lower coupon, lower yield. Modified duration = Macaulay ÷ (1 + y)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJmuI", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-x", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Five kinds of \"value\""}]}]}}, "index": "a4p46", "typeName": "shape"}, {"x": 930.6666666666666, "y": 458, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-12", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market value", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What buyers pay today", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The price on the stock exchange. Depends on expected performance, sentiment and liquidity."}]}]}}, "index": "a9nnX", "typeName": "shape"}, {"x": 615.2, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-23", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 169.6, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "+ Debt", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "6.4", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (book value)"}]}]}}, "index": "a8LiA", "typeName": "shape"}, {"x": 56, "y": 3165.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1r", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Enterprise value (EV)"}]}]}}, "index": "aYfpv", "typeName": "shape"}, {"x": 741.3333333333334, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-34", "type": "geo", "parentId": "shape:ch03-2v", "props": {"w": 318.6666666666667, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For how long?", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Maturity (tenor)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "From 91 days (T-bills) to 30 years or more. Some bonds never mature. It shrinks every day until the bond is redeemed."}]}]}}, "index": "a9sw2", "typeName": "shape"}, {"x": 56, "y": 3077.7999999999956, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2s", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Differential voting rights (DVR)"}]}]}}, "index": "aUzgR", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-45", "type": "geo", "parentId": "shape:ch03-44", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1Bpr", "typeName": "shape"}, {"x": 56, "y": 1691.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3t", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Macaulay duration", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the weighted average time in which you get your money back. The weights are the present values of each cash flow. It is usually less than the time to maturity."}]}]}}, "index": "aEUkc", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-56", "type": "text", "parentId": "shape:ch03-54", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Commodity words"}]}]}}, "index": "a2jI2", "typeName": "shape"}, {"x": 1084, "y": 522, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4u", "type": "note", "parentId": "shape:ch03-4m", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Principal protected\" does not mean \"no credit risk\". If the issuer fails, the protection fails too."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a8IHX", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-67", "type": "note", "parentId": "shape:ch03-62", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why might a bank trade below book value? What would you check before calling it a bargain?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5GwA", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-9", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 237.3573573573574, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "a6D9v", "typeName": "shape"}, {"x": 56, "y": 1679.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5v", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Zero coupon: issued at discount, higher rate risk. Floating: lower rate risk, cap and floor."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKMv6", "typeName": "shape"}, {"x": 56, "y": 325, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-y", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "One share, five values"}]}]}}, "index": "a5vA6", "typeName": "shape"}, {"x": 56, "y": 686, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-13", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Replacement value", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cost to rebuild", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What a new company would pay today to set up the same plants and infrastructure."}]}]}}, "index": "aAzo9", "typeName": "shape"}, {"x": 894.8000000000001, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-24", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 169.6, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "− Cash, investments", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2.5 + 1.4", "marks": [{"type": "bold"}]}]}]}}, "index": "a9DNQ", "typeName": "shape"}, {"x": 56, "y": 3240.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1s", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the value of the whole business, counting only the capital actually at work in it. So it adds the lenders' and preference holders' money to the shareholders', then takes out cash and non-core investments."}]}]}}, "index": "aZTUi", "typeName": "shape"}, {"x": 1084, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-35", "type": "note", "parentId": "shape:ch03-2v", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coupon, not \"interest rate\"", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The book advises calling it the coupon rate. \"Interest rate\" means the market-wide rate for borrowing and lending, which the central bank controls at its base."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aAFbr", "typeName": "shape"}, {"x": 56, "y": 3152.7999999999956, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2t", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "DVR share", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is like a normal share but carries "}, {"type": "text", "text": "less than one vote", "marks": [{"type": "bold"}]}, {"type": "text", "text": " per share. The company raises money without giving away control. Investors who only want dividends and price gains do not mind. DVRs trade separately, usually at a "}, {"type": "text", "text": "discount", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to the normal share."}]}]}}, "index": "aV6Hb", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-46", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Types of bonds"}]}]}}, "index": "a29eX", "typeName": "shape"}, {"x": 56, "y": 1781.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3u", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Macaulay duration = Σ [ t × CFt ÷ (1 + y)^t ] ÷ current price"}]}]}}, "index": "aF5Yb", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-57", "type": "text", "parentId": "shape:ch03-54", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15"}]}]}}, "index": "a3AyA", "typeName": "shape"}, {"x": 56, "y": 853.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4v", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation protection in India"}]}]}}, "index": "a9KC2", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-68", "type": "note", "parentId": "shape:ch03-62", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Would you buy a floating rate bond or a zero coupon bond if you expected rates to rise? Why?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6Bmz", "typeName": "shape"}, {"x": 384, "y": 1679.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5w", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Convertibles have lower coupons and dilute EPS on conversion."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLda6", "typeName": "shape"}, {"x": 56, "y": 400, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-z", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Each answers a different question"}]}]}}, "index": "a6N6M", "typeName": "shape"}, {"x": 493.3333333333333, "y": 686, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-14", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Intrinsic value", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What it is really worth", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The present value of the cash the business will produce in future."}]}]}}, "index": "aBrkI", "typeName": "shape"}, {"x": 1174.4, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-25", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 169.6, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Rs 45.0 crore", "marks": [{"type": "bold"}]}]}]}}, "index": "aAfKX", "typeName": "shape"}, {"x": 56, "y": 3330.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1t", "type": "geo", "parentId": "shape:ch03-t", "props": {"w": 1288, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV (standalone) = market value of equity + preferred capital + debt − cash and equivalents − non-operating financial investments"}]}]}}, "index": "aaUmY", "typeName": "shape"}, {"x": 56, "y": 1028.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-36", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Example.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " 8.24GS2018 means an 8.24% government security maturing in 2018. With face value Rs 1,000 it pays Rs 82.40 a year. G-secs pay "}, {"type": "text", "text": "twice a year", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", so the investor gets "}, {"type": "text", "text": "Rs 41.20", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " every 6 months. The last coupon comes with the principal on the maturity date."}]}]}}, "index": "aBHM2", "typeName": "shape"}, {"x": 56, "y": 3274.7999999999956, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2u", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Under the "}, {"type": "text", "text": "Companies Act, 2013", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", to issue DVRs a company needs a dividend record of at least "}, {"type": "text", "text": "10%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " over the preceding "}, {"type": "text", "text": "3 years", "marks": [{"type": "highlight"}]}, {"type": "text", "text": ", and DVRs cannot exceed "}, {"type": "text", "text": "25%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " of total post-issue paid-up capital. Examples from the book: "}, {"type": "text", "text": "Tata Motors", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "Pantaloons", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aWx5X", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-47", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15  ·  Part 1 of 2"}]}]}}, "index": "a3NU3", "typeName": "shape"}, {"x": 56, "y": 1891.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3v", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Modified duration = Macaulay duration ÷ (1 + y)"}]}]}}, "index": "aGVJf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-58", "type": "geo", "parentId": "shape:ch03-54", "props": {"w": 1004, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Spot price", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Price for immediate delivery, set by supply and demand. Exchanges publish it daily. It is the basis for futures and for the "}, {"type": "text", "text": "Final Settlement Price (FSP)", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", which matters for cash settlement or when a seller defaults on delivery."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Basis", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": "}, {"type": "text", "text": "Spot price − futures price.", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Contango", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Futures price "}, {"type": "text", "text": "above", "marks": [{"type": "bold"}]}, {"type": "text", "text": " spot. Traders may expect the spot price to rise."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Backwardation", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Futures price "}, {"type": "text", "text": "below", "marks": [{"type": "bold"}]}, {"type": "text", "text": " spot. Traders may expect the spot price to fall."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cost of carry", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Cost of holding the commodity from purchase until futures delivery: storage, insurance, transport, financing and other costs."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Delivery", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Commodity futures are deliverable: on expiry the actual goods change hands between buyer and seller."}]}]}]}]}}, "index": "a4c52", "typeName": "shape"}, {"x": 56, "y": 928.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4w", "type": "geo", "parentId": "shape:ch03-4m", "props": {"w": 490, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation Indexed Bonds (IIB)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Government securities issued by the "}, {"type": "text", "text": "RBI", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". A fixed "}, {"type": "text", "text": "real", "marks": [{"type": "bold"}]}, {"type": "text", "text": " coupon is applied to the inflation-adjusted principal. At maturity you get the higher of face value or adjusted principal. Index: "}, {"type": "text", "text": "WPI", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Index ratio = reference index on settlement date ÷ reference index on issue date."}]}]}}, "index": "aA5LE", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-69", "type": "note", "parentId": "shape:ch03-62", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why would a promoter family issue DVRs instead of normal shares?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7pnQ", "typeName": "shape"}, {"x": 712, "y": 1679.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5x", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " PPN still has credit risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMC2r", "typeName": "shape"}, {"meta": {}, "id": "binding:uBsY9YQvxw9HTG-fN5TIS", "type": "arrow", "fromId": "shape:ch03-28", "toId": "shape:ch03-23", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 930, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-15", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Face value"}]}]}}, "index": "aCxCE", "typeName": "shape"}, {"x": 140.8, "y": 441, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-26", "type": "arrow", "parentId": "shape:ch03-1v", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.6, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "a7zpUd", "typeName": "shape"}, {"x": 56, "y": 3470.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1u", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "On a "}, {"type": "text", "text": "consolidated", "marks": [{"type": "bold"}]}, {"type": "text", "text": " basis you also add non-controlling interest and the subsidiary's preferred capital and debt, and subtract the subsidiary's cash and investments too. Use fair market values. If a value is not available (unlisted bonds, bank loans), use the balance sheet value instead."}]}]}}, "index": "ab3OE", "typeName": "shape"}, {"x": 56, "y": 1150.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-37", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Maturity", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the single biggest factor behind changes in bond prices. Government T-bills are issued for "}, {"type": "text", "text": "91, 182 and 364 days", "marks": [{"type": "highlight"}]}, {"type": "text", "text": "."}]}]}}, "index": "aCpNb", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2v", "type": "frame", "props": {"w": 1400, "h": 2150.399999999994, "name": "3.2 Debt words (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a4bl2", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-48", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Every bond is built from three parts: principal, maturity and coupon. Change one of them and you get a new type of bond. Chapter 2 already covered convertible types (FCD, PCD, OCD, NCD) and the foreign, euro and masala naming rules. Here is what is new."}]}]}}, "index": "a4DjX", "typeName": "shape"}, {"x": 56, "y": 2001.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3w", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Modified duration", "marks": [{"type": "bold"}]}, {"type": "text", "text": " measures how sensitive the price is to interest rates. The higher it is, the more the price rises when rates fall, and the more it drops when rates rise."}]}]}}, "index": "aHHBX", "typeName": "shape"}, {"x": 1084, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-59", "type": "note", "parentId": "shape:ch03-54", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Basis is "}, {"type": "text", "text": "spot minus futures", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not the other way round. So in contango (futures above spot) the basis is "}, {"type": "text", "text": "negative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". In backwardation it is positive."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a5tfv", "typeName": "shape"}, {"x": 570, "y": 928.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4x", "type": "geo", "parentId": "shape:ch03-4m", "props": {"w": 490, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inflation Indexed National Saving Securities, Cumulative 2013", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "For "}, {"type": "text", "text": "retail", "marks": [{"type": "bold"}]}, {"type": "text", "text": " investors (individuals, minors, HUFs, charities). "}, {"type": "text", "text": "10 years", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Interest = fixed "}, {"type": "text", "text": "1.5%", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " + inflation based on "}, {"type": "text", "text": "CPI", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Compounded every 6 months and paid at maturity. The fixed rate is a floor, paid even in deflation. Taxable."}]}]}}, "index": "aBHeU", "typeName": "shape"}, {"x": 1040, "y": 1679.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5y", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " IIB uses WPI. The 2013 retail inflation securities use CPI with a 1.5% fixed rate."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aNp8f", "typeName": "shape"}, {"x": 56, "y": 1005, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-16", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A share may be issued at face value, above it (at a "}, {"type": "text", "text": "premium", "marks": [{"type": "bold"}]}, {"type": "text", "text": ") or below it (at a "}, {"type": "text", "text": "discount", "marks": [{"type": "bold"}]}, {"type": "text", "text": "). Face value changes only when the company "}, {"type": "text", "text": "splits", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shares (face value goes down) or "}, {"type": "text", "text": "consolidates", "marks": [{"type": "bold"}]}, {"type": "text", "text": " them (face value goes up)."}]}]}}, "index": "aDuU5", "typeName": "shape"}, {"x": 420.40000000000003, "y": 441, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-27", "type": "arrow", "parentId": "shape:ch03-1v", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.59999999999997, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "a8wz2V", "typeName": "shape"}, {"x": 1540, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1v", "type": "frame", "props": {"w": 1400, "h": 3426.7999999999956, "name": "3.1 Equity words (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a3te2", "typeName": "shape"}, {"x": 56, "y": 1254.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-38", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market price moves opposite to interest rates"}]}]}}, "index": "aDZc2", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2w", "type": "geo", "parentId": "shape:ch03-2v", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1ETU", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-49", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Eight types of bonds"}]}]}}, "index": "a5VGX", "typeName": "shape"}, {"x": 56, "y": 2105.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3x", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What pushes duration (and rate risk) up"}]}]}}, "index": "aIRLn", "typeName": "shape"}, {"x": 1084, "y": 928.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4y", "type": "note", "parentId": "shape:ch03-4m", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The two use different indices, as per the book: IIB uses "}, {"type": "text", "text": "WPI", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; the 2013 retail securities use "}, {"type": "text", "text": "CPI", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCpBA", "typeName": "shape"}, {"x": 56, "y": 2007.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-5z", "type": "note", "parentId": "shape:ch03-5b", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Foreign currency bond: issuer bears currency risk. Masala bond: investor bears it."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aOHvX", "typeName": "shape"}, {"meta": {}, "id": "binding:vc0Z5-9N-Dwjg94ANdk6U", "type": "arrow", "fromId": "shape:ch03-27", "toId": "shape:ch03-23", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 1095, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-17", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Example: you hold 1 share of Rs 10. The company splits each share into 5. You now hold 5 shares of "}, {"type": "text", "text": "Rs 2", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " each."}]}]}}, "index": "aE5v2", "typeName": "shape"}, {"x": 700, "y": 441, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-28", "type": "arrow", "parentId": "shape:ch03-1v", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.60000000000014, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "a9mK5", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1w", "type": "geo", "parentId": "shape:ch03-1v", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1Ry2", "typeName": "shape"}, {"x": 56, "y": 1329.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-39", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Once a bond trades, its price depends on market interest rates, inflation and default risk. A bond's value is its future cash flows, discounted at the market rate. So:"}]}]}}, "index": "aEJ2A", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2x", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Debt words"}]}]}}, "index": "a2JBE", "typeName": "shape"}, {"x": 56, "y": 2180.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3y", "type": "text", "parentId": "shape:ch03-3f", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "With everything else the same"}]}]}}, "index": "aJ6nf", "typeName": "shape"}, {"x": 56, "y": 1262.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4z", "type": "text", "parentId": "shape:ch03-4m", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Foreign currency and external bonds"}]}]}}, "index": "aDFUT", "typeName": "shape"}, {"meta": {}, "id": "binding:jyJG1iRx2hrGAb7PgluCj", "type": "arrow", "fromId": "shape:ch03-27", "toId": "shape:ch03-22", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 1084, "y": 1095, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-18", "type": "note", "parentId": "shape:ch03-t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A dividend stated as a percentage is a percentage of "}, {"type": "text", "text": "face value", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not of market price. 30% dividend on a Rs 10 share = Rs 3. The same 30% on a Rs 2 share = "}, {"type": "text", "text": "Rs 0.60", "marks": [{"type": "highlight"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 120, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aFbwU", "typeName": "shape"}, {"x": 979.6000000000001, "y": 441, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-29", "type": "arrow", "parentId": "shape:ch03-1v", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.5999999999999, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aBvmf", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1x", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity words"}]}]}}, "index": "a209X", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2y", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15  ·  Part 1 of 2"}]}]}}, "index": "a3UJF", "typeName": "shape"}, {"x": 56, "y": 2238.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-3z", "type": "geo", "parentId": "shape:ch03-3f", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Longer maturity", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Higher duration"}]}]}}, "index": "aKDDM", "typeName": "shape"}, {"x": 56, "y": 1551, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-19", "type": "text", "parentId": "shape:ch03-t", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book value"}]}]}}, "index": "aGgMI", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-1y", "type": "text", "parentId": "shape:ch03-1v", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3QAb", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-2z", "type": "text", "parentId": "shape:ch03-2v", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A company that needs Rs 100 crore can take a bank loan, or issue bonds to many investors. If it issues 1 crore bonds of Rs 100 each, an investor putting in Rs 1,000 gets 10 bonds. Each investor's risk is limited to what they put in."}]}]}},