"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: Futures fair value calculator", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Fair value = spot + spot × carry rate × months ÷ 12. Book example: gold at Rs 1,02,000, 8%, 3 months."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "a6BYE", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-6b", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 3: Terms in the equity and debt markets"}]}]}}, "index": "aBNQA", "typeName": "shape"}, {"x": 301.3573573573574, "y": 487, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-d", "type": "geo", "parentId": "shape:ch03-3", "props": {"w": 376.8048048048048, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Owner of the business"}]}]}}, "index": "aAMoM", "typeName": "shape"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch03-4a", "type": "text", "parentId": "shape:ch03-44", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Which part is changed, and who it helps"}]}]}}, "index": "a6xrv", "typeName"