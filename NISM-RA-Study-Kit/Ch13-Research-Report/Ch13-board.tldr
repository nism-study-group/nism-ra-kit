{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.group": 0, "com.tldraw.shape.text": 4, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.geo": 12, "com.tldraw.shape.note": 13, "com.tldraw.shape.line": 5, "com.tldraw.shape.frame": 1, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.embed": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"x": 288.990099009901, "y": 3257.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1d", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 176.0792079207921, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Expected triggers in the time frame"}]}]}}, "index": "aj2BX", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2e", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Three steps: planning, drafting, editing."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7SUi", "typeName": "shape"}, {"x": 56, "y": 1211, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-m", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The major sections of a report: company business, peer group analysis, shareholding pattern, key strengths, key concerns, industry overview, company fundamentals, key financial indicators and financials."}]}]}}, "index": "aII4b", "typeName": "shape"}, {"x": 473.0693069306931, "y": 3257.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1e", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 586.9306930693069, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A view that triggers will play out in the period, so the returns materialise"}]}]}}, "index": "akKx2", "typeName": "shape"}, {"x": 56, "y": 586.4800000000032, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2f", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Fact-based sections: peer group, shareholding, fundamentals, financial indicators, financials. Sources: annual and quarterly reports, calculations."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 120, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8iRA", "typeName": "shape"}, {"name": "", "color": "#BD54C6", "imageUrl": "", "meta": {}, "id": "user:P8xR1f-dbKyEpbfWmnnJs", "typeName": "user"}, {"x": 56, "y": 1315, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-n", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fact-based and view-based sections"}]}]}}, "index": "aJsez", "typeName": "shape"}, {"x": 56, "y": 3367.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1f", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 224.99009900990097, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Outperformer, performer (neutral), underperformer", "marks": [{"type": "bold"}]}]}]}}, "index": "alL6v", "typeName": "shape"}, {"x": 384, "y": 586.4800000000032, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2g", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " View-based sections: business, strengths, concerns, industry overview. Sources: management and personal understanding."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9Vgj", "typeName": "shape"}, {"x": 56, "y": 1390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-o", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fact based", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Mostly copy and calculate", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Peer group analysis, shareholding pattern, company fundamentals, key financial indicators, financials."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sources:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " annual reports, quarterly reports, calculations."}]}]}}, "index": "aKBRv", "typeName": "shape"}, {"x": 288.990099009901, "y": 3367.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1g", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 176.0792079207921, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The sector or market"}]}]}}, "index": "amz49", "typeName": "shape"}, {"x": 712, "y": 586.4800000000032, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2h", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Not research reports: market trend comments, index discussions, economic commentaries, internal communications, prospectuses, statistical summaries, technical analysis of sector or index demand and supply."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAlz5", "typeName": "shape"}, {"x": 712, "y": 1390, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-p", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 632, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "View based", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Needs understanding", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Company business, key strengths, key concerns, industry overview."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sources:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " communication with management; personal understanding of the business and industry."}]}]}}, "index": "aLAtz", "typeName": "shape"}, {"x": 473.0693069306931, "y": 3367.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1h", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 586.9306930693069, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Expected return relative to sector or market; the analyst may state by how much"}]}]}}, "index": "an7Ff", "typeName": "shape"}, {"x": 1040, "y": 586.4800000000032, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2i", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Reports fail through unnecessary detail, long sentences, poor structure, inconsistent views, complex language."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aB4Nf", "typeName": "shape"}, {"x": 56, "y": 1664, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-q", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What is NOT a research report"}]}]}}, "index": "aMxhX", "typeName": "shape"}, {"x": 56, "y": 3501.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1i", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 224.99009900990097, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Overweight, equal weight, underweight", "marks": [{"type": "bold"}]}]}]}}, "index": "aoB4n", "typeName": "shape"}, {"x": 56, "y": 1206.3199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2j", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Book example: buy above 10%, hold between −10% and 10%, sell below −10% over 12 months."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCULF", "typeName": "shape"}, {"x": 56, "y": 1739, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-r", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book lists communications that do not count as a \"research report\" (citing SEBI's FAQs on research analysts):"}]}]}}, "index": "aNg2r", "typeName": "shape"}, {"x": 288.990099009901, "y": 3501.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1j", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 176.0792079207921, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The market"}]}]}}, "index": "apK4b", "typeName": "shape"}, {"x": 384, "y": 1206.3199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2k", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Overweight, equal weight, underweight compare with the market. Outperformer and underperformer compare with sector or market."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDr9U", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-3", "type": "frame", "props": {"w": 1400, "h": 3659.2000000000007, "name": "13.1 What makes a good research report", "color": "black"}, "parentId": "page:page", "index": "a1isn", "typeName": "shape"}, {"x": 56, "y": 1797, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-s", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. Comments on general trends in the securities market"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. Discussions on broad-based indices"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. Commentaries on economic, political or market conditions"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. Periodic reports for unit holders of mutual funds or AIFs, or clients of portfolio managers and investment advisers"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. Internal communications not given to current or prospective clients"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "6. Offer documents or prospectuses circulated under SEBI regulations"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "7. Statistical summaries of companies' financial data"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "8. Technical analyses of demand and supply in a sector or the index"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "9. Any other communication SEBI may specify"}]}]}}, "index": "aOYzo", "typeName": "shape"}, {"x": 473.0693069306931, "y": 3501.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1k", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 586.9306930693069, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Overweight: better than the market. Equal weight: in line. Underweight: worse"}]}]}}, "index": "aqfYj", "typeName": "shape"}, {"x": 712, "y": 1206.3199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2l", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Checklists help avoid errors of ineptitude (Atul Gawande, The Checklist Manifesto)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEISU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-4", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a1BUH", "typeName": "shape"}, {"x": 1084, "y": 1797, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-t", "type": "note", "parentId": "shape:ch13-3", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A commentary on economic conditions, a discussion of a broad-based index, or a statistical summary of a company's financials is "}, {"type": "text", "text": "not", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a research report under this list."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aPczT", "typeName": "shape"}, {"x": 1084, "y": 3061.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1l", "type": "note", "parentId": "shape:ch13-3", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Before acting on a rating, check what the analyst means by it. \"Buy\" at one firm may not mean the same as at another."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "arZOv", "typeName": "shape"}, {"x": 1040, "y": 1206.3199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2m", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Sample quantitative tests: NPM above 10%, D/E below 1, interest coverage above 3, ROE and ROCE above 15%, over 5 years."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFDjE", "typeName": "shape"}, {"meta": {}, "id": "binding:THfNwbHr8q6e2Xg_pE2_V", "type": "arrow", "fromId": "shape:ch13-k", "toId": "shape:ch13-h", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-5", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What makes a good research report"}]}]}}, "index": "a28bM", "typeName": "shape"}, {"x": 56, "y": 2284.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-u", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why most reports get ignored"}]}]}}, "index": "aQ2kr", "typeName": "shape"}, {"x": 1540, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1m", "type": "frame", "props": {"w": 1400, "h": 909.5999999999985, "name": "13.2 Why use a checklist?", "color": "black"}, "parentId": "page:page", "index": "a2yVn", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2n", "type": "frame", "props": {"w": 1400, "h": 946.4799999999959, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "a5sgX", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-6", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 13 of 15"}]}]}}, "index": "a3UDJ", "typeName": "shape"}, {"x": 56, "y": 2359.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-v", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Thousands of reports come out every results season; only a few get attention. The book's reasons for failure:"}]}]}}, "index": "aRXqf", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1n", "type": "geo", "parentId": "shape:ch13-1m", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1c2M", "typeName": "shape"}, {"x": 6160, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-30", "type": "note", "parentId": "page:page", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An everyday picture of the idea"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aAzo1", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2o", "type": "geo", "parentId": "shape:ch13-2n", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a1aAz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-7", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A research report does three jobs: it "}, {"type": "text", "text": "presents an investment idea", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", gives a "}, {"type": "text", "text": "market perspective", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and offers a "}, {"type": "text", "text": "detailed company analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a4F2z", "typeName": "shape"}, {"x": 56, "y": 2417.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-w", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 318.6666666666667, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Unnecessary details"}]}]}}, "index": "aSPRQ", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-20", "type": "text", "parentId": "shape:ch13-1w", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's questions are indicative only; readers may add, delete or edit them. The financial thresholds are for reference."}]}]}}, "index": "a488M", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1o", "type": "text", "parentId": "shape:ch13-1m", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why use a checklist?"}]}]}}, "index": "a2eD6", "typeName": "shape"}, {"x": 6640, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-31", "type": "note", "parentId": "page:page", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WHY IT MATTERS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The reason behind a rule"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aBgGz", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2p", "type": "text", "parentId": "shape:ch13-2n", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a28hE", "typeName": "shape"}, {"x": 56, "y": 312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-8", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All analysts have roughly the same information (annual reports, quarterly reports), and good analysts of a sector often say similar things. So they stand out by "}, {"type": "text", "text": "how they present", "marks": [{"type": "bold"}]}, {"type": "text", "text": " their views, conclusions and recommendations. Communication is as important as analysis. Writing a report is partly creative: the analyst takes in a lot of financial information and gives out an understandable version of what it means."}]}]}}, "index": "a5Mlz", "typeName": "shape"}, {"x": 398.6666666666667, "y": 2417.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-x", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 318.6666666666667, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Long sentences"}]}]}}, "index": "aTlAM", "typeName": "shape"}, {"x": 398.6666666666667, "y": 2525.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-10", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 318.6666666666667, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Complex language"}]}]}}, "index": "aW67E", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-21", "type": "text", "parentId": "shape:ch13-1w", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's sample checklist, in four parts"}]}]}}, "index": "a5vQA", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1p", "type": "text", "parentId": "shape:ch13-1m", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 13 of 15"}]}]}}, "index": "a3hnM", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-32", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aC0pr", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2q", "type": "text", "parentId": "shape:ch13-2n", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3AFf", "typeName": "shape"}, {"x": 56, "y": 480, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-9", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Five ground rules for a good report"}]}]}}, "index": "a6eGv", "typeName": "shape"}, {"x": 741.3333333333334, "y": 2417.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-y", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 318.6666666666667, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No proper structure"}]}]}}, "index": "aUTWr", "typeName": "shape"}, {"x": 1084, "y": 2417.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-11", "type": "note", "parentId": "shape:ch13-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A good report is like a good map: it leaves out most of the terrain so you can see the road."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aXURH", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-22", "type": "geo", "parentId": "shape:ch13-1w", "props": {"w": 490, "h": 924, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Qualitative", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Do I understand the business? Any technology collaboration?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Revenue model and segment mix, now and ahead"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Is the output a necessity or a choice? Any substitutes?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Distribution channels; is the business scalable or a good franchise?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Demand-supply gap and how long it lasts"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What will the business look like in a decade?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Moat or competitive advantage, and how lasting"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risks; pricing power on output and on inputs"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Competition and entry barriers"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Management quality: able, honest, with integrity"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Promoter stake, insider buying or selling, pledges"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buybacks in the last three years; corporate governance report"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Shareholding pattern and its changes over 5 years; top 10 holders"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Any catalyst? Can a fool run this business?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Strengths, weaknesses, opportunities, threats, and how the company handles each"}]}]}]}]}}, "index": "a6Bbb", "typeName": "shape"}, {"meta": {}, "id": "binding:6kju4S0g0r4-_MVrkMUku", "type": "arrow", "fromId": "shape:ch13-k", "toId": "shape:ch13-i", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1q", "type": "text", "parentId": "shape:ch13-1m", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "With so much information, some of it contradictory, it is easy to drown. Writing down the key decision drivers keeps decisions consistent. The market rewards disciplined investing and often punishes emotional, distracted, disorganised approaches. Pilots have used checklists for decades to avoid accidents; investors can too."}]}]}}, "index": "a4WrX", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-33", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aDuAM", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2r", "type": "note", "parentId": "shape:ch13-2n", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Pick a broker's research report. Does it follow the five ground rules? Where does it fail?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4cAv", "typeName": "shape"}, {"x": 56, "y": 2525.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-z", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 318.6666666666667, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Inconsistent views"}]}]}}, "index": "aVFYM", "typeName": "shape"}, {"x": 56, "y": 2717.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-12", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rating conventions"}]}]}}, "index": "aY05r", "typeName": "shape"}, {"x": 570, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-23", "type": "geo", "parentId": "shape:ch13-1w", "props": {"w": 490, "h": 924, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Quantitative", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Equity history"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Consistent revenue growth, with visibility ahead"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stable, growing profitability: "}, {"type": "text", "text": "NPM above 10%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and EPS growing every year for 5 years"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Low leverage: "}, {"type": "text", "text": "D/E below 1", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "interest coverage above 3", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", every year for 5 years"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Returns: "}, {"type": "text", "text": "ROE above 15%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "ROCE above 15%", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", every year for 5 years"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "At least a "}, {"type": "text", "text": "5-year", "marks": [{"type": "bold"}]}, {"type": "text", "text": " dividend record, stable and growing"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Positive operating and free cash flows every year for 5 years"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Auditors' qualifications; notes to accounts (intangibles, derivative MTM, guarantees); accounting policy changes"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capex plans and how they will be financed"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Financial discipline: quality of assets, earnings and cash flows"}]}]}]}]}}, "index": "a7oBQ", "typeName": "shape"}, {"x": 56, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1r", "type": "geo", "parentId": "shape:ch13-1m", "props": {"w": 490, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Avoids lazy mistakes and short-cuts"}]}]}}, "index": "a5xxv", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2s", "type": "note", "parentId": "shape:ch13-2n", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Run a company you know through the book's quantitative checklist. How many tests does it pass?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5Byf", "typeName": "shape"}, {"meta": {}, "id": "binding:gcQGpZngwbOVDOUjIczKV", "type": "arrow", "fromId": "shape:ch13-l", "toId": "shape:ch13-i", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 2792.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-13", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Common recommendations: "}, {"type": "text", "text": "buy, overweight, hold, underweight, sell", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". They reflect the analyst's view on a stock's total return over a set period, or its return relative to the market or peers. Each research firm may define them differently, so the definition is usually printed in the report."}]}]}}, "index": "aZ2Um", "typeName": "shape"}, {"x": 56, "y": 1349, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-24", "type": "geo", "parentId": "shape:ch13-1w", "props": {"w": 490, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Valuation", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Intrinsic value, and how confident am I?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cheap relative to itself, peers and market on P/E, P/BV, price/sales over the last 5 years?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What margin of safety? At what discount to intrinsic value?"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why is the market mispricing it, and will that correct?"}]}]}]}]}}, "index": "a8Gwf", "typeName": "shape"}, {"x": 570, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1s", "type": "geo", "parentId": "shape:ch13-1m", "props": {"w": 490, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ensures the analyst does what they intend, in a disciplined way"}]}]}}, "index": "a6p5I", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2t", "type": "note", "parentId": "shape:ch13-2n", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Is \"can a fool run this business?\" a fair test? Name a business that passes and one that fails."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6Odr", "typeName": "shape"}, {"x": 56, "y": 2928.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-14", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rating terms and what they compare against"}]}]}}, "index": "aaPoz", "typeName": "shape"}, {"x": 570, "y": 1349, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-25", "type": "geo", "parentId": "shape:ch13-1w", "props": {"w": 490, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Final decision", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The book closes with final decision parameters and points to sample research reports on the BSE and NSE websites."}]}]}}, "index": "a904b", "typeName": "shape"}, {"x": 56, "y": 482, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1t", "type": "geo", "parentId": "shape:ch13-1m", "props": {"w": 490, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Supports objective, fact-based decisions"}]}]}}, "index": "a7sav", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2u", "type": "note", "parentId": "shape:ch13-2n", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why would SEBI not treat a market commentary as a research report?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7qhb", "typeName": "shape"}, {"x": 56, "y": 3003.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-15", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's examples; firms set their own definitions"}]}]}}, "index": "abBZb", "typeName": "shape"}, {"x": 1084, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-26", "type": "note", "parentId": "shape:ch13-1w", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Know where each item sits. Leverage (D/E, interest coverage) is a "}, {"type": "text", "text": "quantitative", "marks": [{"type": "bold"}]}, {"type": "text", "text": " parameter. Management quality and moat are "}, {"type": "text", "text": "qualitative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Intrinsic value, P/E and P/BV are "}, {"type": "text", "text": "valuation", "marks": [{"type": "bold"}]}, {"type": "text", "text": " parameters; demand and supply of securities is not."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 264, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aAOHU", "typeName": "shape"}, {"x": 570, "y": 482, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1u", "type": "geo", "parentId": "shape:ch13-1m", "props": {"w": 490, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Leaves a decision trail that can be corrected over time"}]}]}}, "index": "a818v", "typeName": "shape"}, {"x": 56, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2v", "type": "note", "parentId": "shape:ch13-2n", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Two firms rate the same stock \"buy\" and \"accumulate\". Can both be right?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8Tob", "typeName": "shape"}, {"x": 56, "y": 3061.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-16", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 224.99009900990097, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ratings", "marks": [{"type": "bold"}]}]}]}}, "index": "acB7E", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-27", "type": "frame", "props": {"w": 1400, "h": 1675.760000000002, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "a4Wrj", "typeName": "shape"}, {"x": 1084, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1v", "type": "note", "parentId": "shape:ch13-1m", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The Checklist Manifesto", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Dr. Atul Gawande separates "}, {"type": "text", "text": "errors of ignorance", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (not knowing enough) from "}, {"type": "text", "text": "errors of ineptitude", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (not using what we know correctly). He argues that checklists can largely prevent the second kind."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a9BDX", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2w", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 13: Qualities of a good research report"}]}]}}, "index": "a6yWn", "typeName": "shape"}, {"x": 288.990099009901, "y": 3061.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-17", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 176.0792079207921, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Compared with", "marks": [{"type": "bold"}]}]}]}}, "index": "adfwv", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-28", "type": "geo", "parentId": "shape:ch13-27", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a1j5v", "typeName": "shape"}, {"x": 1540, "y": 1838.1999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1w", "type": "frame", "props": {"w": 1400, "h": 1729, "name": "13.3 A sample checklist", "color": "black"}, "parentId": "page:page", "index": "a3TNU", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2x", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 5 marks of 100  ·  Book pages 247 to 254  ·  About 25 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "a77p6", "typeName": "shape"}, {"x": 473.0693069306931, "y": 3061.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-18", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 586.9306930693069, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book's example meaning", "marks": [{"type": "bold"}]}]}]}}, "index": "aeDLv", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-29", "type": "text", "parentId": "shape:ch13-27", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All exam traps in this chapter"}]}]}}, "index": "a29iz", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1x", "type": "geo", "parentId": "shape:ch13-1w", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a12iU", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2y", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Every analyst reads the same annual reports. The good ones stand out by how clearly they write, and they stay disciplined with a checklist."}]}]}}, "index": "a8Ns2", "typeName": "shape"}, {"x": 56, "y": 555, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-a", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Clarity of idea", "marks": [{"type": "bold"}]}]}]}}, "index": "a7gIr", "typeName": "shape"}, {"x": 56, "y": 3147.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-19", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 224.99009900990097, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font