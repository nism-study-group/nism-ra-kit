"isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-e", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Customised for the reader type", "marks": [{"type": "bold"}]}]}]}}, "index": "aBypf", "typeName": "shape"}, {"x": 56, "y": 787, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-f", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three steps: planning, drafting, editing"}]}]}}, "index": "aCK7n", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 13: Qualities of a good research report", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 56, "y": 876, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-g", "type": "text", "parentId": "shape:ch13-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Writing a report"}]}]}}, "index": "aDWhU", "typeName": "shape"}, {"x": 56, "y": 951, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-h", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 356, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Plan", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Decide how to approach each section and set a deadline for each. Discipline matters most in results season, when delays cascade."}]}]}}, "index": "aE8rM", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2a", "type": "text", "parentId": "shape:ch13-27", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read these the night before. Each one is a question waiting to happen"}]}]}}, "index": "a3726", "typeName": "shape"}, {"x": 522, "y": 951, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-i", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 356, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Draft", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Work section by section, usually in the firm's own template. Use charts: visual data is easier to grasp than numbers."}]}]}}, "index": "aFOmI", "typeName": "shape"}, {"x": 288.990099009901, "y": 3147.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1a", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 176.0792079207921, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Absolute total return"}]}]}}, "index": "aggXQ", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2b", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A report presents an investment idea, a market perspective and a detailed company analysis."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4I3j", "typeName": "shape"}, {"x": 988, "y": 951, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-j", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 356, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Edit", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Recheck financial figures, spelling and grammar."}]}]}}, "index": "aGVeM", "typeName": "shape"}, {"x": 473.0693069306931, "y": 3147.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1b", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 586.9306930693069, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buy: more than 10% over 12 months. Hold: between −10% and 10%. Sell: less than −10%"}]}]}}, "index": "ahusr", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2c", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Analysts stand out by how they communicate, not by having different information."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5fRr", "typeName": "shape"}, {"x": 234, "y": 1068, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-k", "type": "arrow", "parentId": "shape:ch13-3", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aFt9SV", "typeName": "shape"}, {"x": 56, "y": 3257.2000000000007, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-1c", "type": "geo", "parentId": "shape:ch13-3", "props": {"w": 224.99009900990097, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Accumulate, reduce", "marks": [{"type": "bold"}]}]}]}}, "index": "aixmz", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-2d", "type": "note", "parentId": "shape:ch13-27", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Five ground rules: clarity of idea, simplicity, clear argument, narrative structure, customised for the reader."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6sUa", "typeName": "shape"}, {"x": 700, "y": 1068, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch13-l", "type": "arrow", "parentId": "shape:ch13-3", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 466, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aHbrU", "typeName": "shape"}]}