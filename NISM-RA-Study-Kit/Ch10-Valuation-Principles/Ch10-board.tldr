chText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "40"}]}]}}, "index": "aTGYA", "typeName": "shape"}, {"x": 574.4000000000001, "y": 834, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3p", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5"}]}]}}, "index": "aH7OU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-52", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.8", "marks": [{"type": "bold"}]}]}]}}, "index": "a1FDX", "typeName": "shape"}, {"x": 919.9999999999999, "y": 2583, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4q", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14 ÷ 15 = "}, {"type": "text", "text": "0.93x", "marks": [{"type": "bold"}]}]}]}}, "index": "as6sX", "typeName": "shape"}, {"x": 56, "y": 1712, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-63", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "grey", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "On P/B alone, AFB Finance is less expensive, even though its share price is higher."}]}]}}, "index": "ac3B6", "typeName": "shape"}, {"x": 56, "y": 1350, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5r", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total equity", "marks": [{"type": "bold"}]}]}]}}, "index": "aQmXI", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-74", "type": "geo", "parentId": "shape:ch10-73", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a17rr", "typeName": "shape"}, {"x": 56, "y": 820, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6s", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "So use the "}, {"type": "text", "text": "maximum, minimum and average", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the multiples, look at each company's own history over several years, and compare across peers and the industry."}]}]}}, "index": "a5LYr", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-85", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 10: Valuation principles"}]}]}}, "index": "aA1Jf", "typeName": "shape"}, {"meta": {}, "id": "binding:JGP9QVYcE3_7_2Kpb1Et3", "type": "arrow", "fromId": "shape:ch10-1l", "toId": "shape:ch10-1h", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 712, "y": 2153.8399999999965, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7t", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Transaction multiples are more relevant than trading multiples."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQYIb", "typeName": "shape"}, {"x": 627.5634218289085, "y": 1186, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-20", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 149.14454277286137, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cost of equity"}]}]}}, "index": "aPjkf", "typeName": "shape"}, {"x": 56, "y": 843, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1o", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analysts' DCF values differ mainly because they estimate the cash flows and the discount rate differently."}]}]}}, "index": "aDcYv", "typeName": "shape"}, {"x": 56, "y": 1715.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-31", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "It should reflect the risk in the cash flows. "}, {"type": "text", "text": "FCFF", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is discounted at "}, {"type": "text", "text": "WACC", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (debt and equity). "}, {"type": "text", "text": "FCFE", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is discounted at the "}, {"type": "text", "text": "cost of equity", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". "}, {"type": "text", "text": "Cost of debt", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is usually the prevailing interest rate for borrowers of comparable credit quality. "}, {"type": "text", "text": "Cost of equity", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the return the company's shareholders require."}]}]}}, "index": "aHlUW", "typeName": "shape"}, {"x": 56, "y": 490, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2p", "type": "geo", "parentId": "shape:ch10-2i", "props": {"w": 168.5, "h": 564, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stage 1", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Estimate how long high growth lasts. Forecast each year's free cash flow and discount it"}]}]}}, "index": "a7p2f", "typeName": "shape"}, {"x": 56, "y": 1110, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-42", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price to dividend = what the market pays for one rupee of dividend."}]}]}}, "index": "aUYFn", "typeName": "shape"}, {"x": 833.6000000000001, "y": 834, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3q", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5"}]}]}}, "index": "aIdUq", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-53", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Relative valuation: asset multiples"}]}]}}, "index": "a2sHn", "typeName": "shape"}, {"x": 56, "y": 2669, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4r", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Verdict", "marks": [{"type": "bold"}]}]}]}}, "index": "at3oI", "typeName": "shape"}, {"x": 1084, "y": 1712, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-64", "type": "note", "parentId": "shape:ch10-51", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Compare a company's multiple with the "}, {"type": "text", "text": "industry", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not just one peer. In a fragmented industry, a few outliers can pull the "}, {"type": "text", "text": "mean", "marks": [{"type": "bold"}]}, {"type": "text", "text": " up while most firms sit near the "}, {"type": "text", "text": "median", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Check both before deciding."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "adTeQ", "typeName": "shape"}, {"x": 487.99999999999994, "y": 1350, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5s", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9,900"}]}]}}, "index": "aRWPn", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-75", "type": "text", "parentId": "shape:ch10-73", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All exam traps in this chapter"}]}]}}, "index": "a21kM", "typeName": "shape"}, {"x": 56, "y": 910, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6t", "type": "geo", "parentId": "shape:ch10-6n", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trading multiples", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "From prices in the "}, {"type": "text", "text": "stock market", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a6BAj", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-86", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 12 marks of 100  ·  Book pages 198 to 217  ·  About 75 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "aBkqI", "typeName": "shape"}, {"x": 1040, "y": 2153.8399999999965, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7u", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "24.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " SOTP: value each business separately and add up (ITC, L&T)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aRo2r", "typeName": "shape"}, {"x": 0, "y": 3255.9999999999977, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-10", "type": "frame", "props": {"w": 1400, "h": 869, "name": "10.4 Three approaches to valuation", "color": "black"}, "parentId": "page:page", "index": "a24bA", "typeName": "shape"}, {"x": 784.7079646017698, "y": 1186, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-21", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 559.29203539823, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Companies that pay little or no dividend, and companies in "}, {"type": "text", "text": "high growth", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Book example: Alphabet (Google's parent) has never paid a dividend"}]}]}}, "index": "aQnbv", "typeName": "shape"}, {"x": 56, "y": 915, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1p", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three DCF models"}]}]}}, "index": "aEI92", "typeName": "shape"}, {"x": 56, "y": 1851.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-32", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "CAPM and WACC"}]}]}}, "index": "aIZXf", "typeName": "shape"}, {"x": 334.5, "y": 490, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2q", "type": "geo", "parentId": "shape:ch10-2i", "props": {"w": 168.5, "h": 564, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Stage 2: terminal value", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Gordon model on the cash flow after high growth, "}, {"type": "text", "text": "or", "marks": [{"type": "bold"}]}, {"type": "text", "text": " an exit value: EBITDA (or EBIT) at the end × EV/EBITDA (or EV/EBIT) of comparable firms"}]}]}}, "index": "a8atf", "typeName": "shape"}, {"x": 56, "y": 1168, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-43", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Compare dividend yield with "}, {"type": "text", "text": "bond yields", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The book: a 10% bond taxed at 30% leaves about 7% after tax; at Rs 50 the share's 10% dividend yield looks better, with potential upside too. At Rs 200, the 2.5% yield is clearly inferior."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "When equity yields are generally "}, {"type": "text", "text": "above", "marks": [{"type": "bold"}]}, {"type": "text", "text": " bond yields, equity is cheap; this is typical when markets are down. In bull markets, equity yields are well "}, {"type": "text", "text": "below", "marks": [{"type": "bold"}]}, {"type": "text", "text": " bond yields."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A high dividend yield is "}, {"type": "text", "text": "not always", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a value pick: a high payout may mean few avenues to grow, limiting capital gains. Check it against company fundamentals, which the book calls "}, {"type": "text", "text": "companion variables", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}]}]}}, "index": "aVC5X", "typeName": "shape"}, {"x": 1092.8000000000002, "y": 834, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3r", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5"}]}]}}, "index": "aJBiI", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-54", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 10 of 15"}]}]}}, "index": "a3UfP", "typeName": "shape"}, {"x": 487.99999999999994, "y": 2669, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4s", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cheaper on P/E"}]}]}}, "index": "au3gb", "typeName": "shape"}, {"x": 56, "y": 2261.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-65", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.8.2 EV to capital employed"}]}]}}, "index": "aeK6v", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1350, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5t", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8,000"}]}]}}, "index": "aS7Z6", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-76", "type": "text", "parentId": "shape:ch10-73", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read these the night before. Each one is a question waiting to happen"}]}]}}, "index": "a3K5U", "typeName": "shape"}, {"x": 712, "y": 910, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6u", "type": "geo", "parentId": "shape:ch10-6n", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Transaction multiples", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "From similar "}, {"type": "text", "text": "deals", "marks": [{"type": "bold"}]}, {"type": "text", "text": " completed recently. "}, {"type": "text", "text": "More relevant", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and more authentic: someone actually agreed to buy at that value."}]}]}}, "index": "a72LI", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-87", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price is what you pay; value is what you get. Estimate value from cash flows, or compare with similar companies."}]}]}}, "index": "aCSUs", "typeName": "shape"}, {"x": 56, "y": 2518.3199999999924, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7v", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "25.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Focus on ROE, not EPS. ROCE reflects true return on capital; a wide gap with ROE needs investigation."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aSWTU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-11", "type": "geo", "parentId": "shape:ch10-10", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.4", "marks": [{"type": "bold"}]}]}]}}, "index": "a1xWM", "typeName": "shape"}, {"x": 56, "y": 1320, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-22", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 199.48082595870207,