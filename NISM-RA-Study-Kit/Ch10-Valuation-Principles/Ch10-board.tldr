oc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " EV/EBITDA and EV/EBIT are neutral to capital structure; suit acquirers. EV/EBITDA for capital-intensive industries."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLFfI", "typeName": "shape"}, {"meta": {}, "id": "binding:Mgje8Q9wwp78uA-Hw1weR", "type": "arrow", "fromId": "shape:ch10-2v", "toId": "shape:ch10-2s", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"meta": {}, "id": "binding:0hlsA1TTm_LCgxq1CFkJh", "type": "arrow", "fromId": "shape:ch10-1m", "toId": "shape:ch10-1i", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 788.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-8", "type": "text", "parentId": "shape:ch10-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price", "marks": [{"type": "bold"}]}, {"type": "text", "text": " comes from the stock market and is known to all. "}, {"type": "text", "text": "Value", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the valuer's own estimate at a point in time. No formula gives a precise number, because the inputs are uncertain. At best, value is an "}, {"type": "text", "text": "educated estimate", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". That is why valuation is called both an "}, {"type": "text", "text": "art and a science", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": it needs knowledge, experience and professional judgement."}]}]}}, "index": "a5KWX", "typeName": "shape"}, {"x": 626.6666666666667, "y": 1949.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-y", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 433.3333333333333, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sale of tangible and intangible assets, if earnings fall short"}]}]}}, "index": "aVXUzV", "typeName": "shape"}, {"x": 755, "y": 613, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1j", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3. Discount rate", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The return investors expect"}]}]}}, "index": "aAoqA", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2k", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Discounted cash flow (DCF)"}]}]}}, "index": "a2CgX", "typeName": "shape"}, {"x": 833.6000000000001, "y": 748, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3l", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "150", "marks": [{"type": "bold"}]}]}]}}, "index": "aDslI", "typeName": "shape"}, {"x": 487.99999999999994, "y": 2497, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4m", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10% a year"}]}]}}, "index": "aouM2", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1178, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5n", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2,100"}]}]}}, "index": "aMgy2", "typeName": "shape"}, {"x": 56, "y": 1653, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-70", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "It may look objective, but it is "}, {"type": "text", "text": "very subjective", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": the inputs have no generally accepted standards. It is also not timeless; it can change dramatically when the business changes. Complicated models do not make a value precise. They only give a "}, {"type": "text", "text": "false impression of preciseness", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aDpbA", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6o", "type": "geo", "parentId": "shape:ch10-6n", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.9", "marks": [{"type": "bold"}]}]}]}}, "index": "a1N0A", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-81", "type": "note", "parentId": "shape:ch10-7w", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why might a bank trade on P/B and a software company on P/E? What could go wrong with each?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a501b", "typeName": "shape"}, {"x": 712, "y": 1789.3600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7p", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " EV/Sales for loss-making or just-profitable firms likely to turn profitable; otherwise liquidation value."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMzW9", "typeName": "shape"}, {"meta": {}, "id": "binding:RG3W7infCoOz3mKVEV_FU", "type": "arrow", "fromId": "shape:ch10-6d", "toId": "shape:ch10-6a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 924.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-9", "type": "text", "parentId": "shape:ch10-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.2 Why value a business?"}]}]}}, "index": "a6eKQ", "typeName": "shape"}, {"x": 1084, "y": 1605.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-z", "type": "note", "parentId": "shape:ch10-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Lenders think the same way. A bank first checks whether the borrower's cash flows can repay the loan. The collateral is only a fallback if those estimates prove wrong. As the book warns, assets may be worth much less than their balance sheet value, but liabilities must be paid in full."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 312, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aWMNU", "typeName": "shape"}, {"meta": {}, "id": "binding:mhK9CNnwuEL5tvwFUtqdX", "type": "arrow", "fromId": "shape:ch10-6f", "toId": "shape:ch10-6c", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 1104.5, "y": 613, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1k", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Present value", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What an investor would pay today"}]}]}}, "index": "aBURa", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2l", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 10 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3Szg", "typeName": "shape"}, {"x": 1092.8000000000002, "y": 748, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3m", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "200", "marks": [{"type": "bold"}]}]}]}}, "index": "aEX5r", "typeName": "shape"}, {"x": 919.9999999999999, "y": 2497, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4n", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15% a year"}]}]}}, "index": "apN3U", "typeName": "shape"}, {"x": 56, "y": 1608, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-60", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/B", "marks": [{"type": "bold"}]}]}]}}, "index": "aZNFf", "typeName": "shape"}, {"x": 56, "y": 1264, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5o", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reserves and surplus", "marks": [{"type": "bold"}]}]}]}}, "index": "aNNyU", "typeName": "shape"}, {"x": 56, "y": 1789, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-71", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.13 Nine things to keep in mind"}]}]}}, "index": "aEUig", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6p", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trading and transaction multiples"}]}]}}, "index": "a23On", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-82", "type": "note", "parentId": "shape:ch10-7w", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A start-up is valued on users, not profit. When is that reasonable, and when is it a story?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6Ulo", "typeName": "shape"}, {"x": 1040, "y": 1789.3600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7q", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " P/B is preferred for financial companies; poor for services and technology firms."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aN4Nv", "typeName": "shape"}, {"x": 175.75, "y": 715, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1l", "type": "arrow", "parentId": "shape:ch10-19", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "a9eNdV", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2m", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two-stage valuation for high-growth companies"}]}]}}, "index": "a4ud6", "typeName": "shape"}, {"x": 56, "y": 834, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3n", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dividend (Rs)", "marks": [{"type": "bold"}]}]}]}}, "index": "aFm0n", "typeName": "shape"}, {"x": 56, "y": 3301, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-50", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/E, EV/EBITDA and EV/EBIT cannot be used when profit is "}, {"type": "text", "text": "negative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and are too high to mean much when a company has "}, {"type": "text", "text": "only just broken even", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Sales are never negative, so "}, {"type": "text", "text": "EV/Sales", "marks": [{"type": "bold"}]}, {"type": "text", "text": " works. But only if the company is likely to turn and stay profitable. If no turnaround is likely, its \"going concern\" status is doubtful and it should be valued at "}, {"type": "text", "text": "liquidation value", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "b02kVv", "typeName": "shape"}, {"x": 56, "y": 2583, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4o", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "PEG", "marks": [{"type": "bold"}]}]}]}}, "index": "aqdQj", "typeName": "shape"}, {"x": 487.99999999999994, "y": 1608, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-61", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.01", "marks": [{"type": "bold"}]}]}]}}, "index": "aazBu", "typeName": "shape"}, {"x": 487.99999999999994, "y": 1264, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5p", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6,200"}]}]}}, "index": "aOwkE", "typeName": "shape"}, {"x": 56, "y": 1864, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-72", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. High earning power: book value matters less. Low earning power: book value matters a lot."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. A share is part ownership, so to value a share, value the whole business."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. For a private owner, the true value of the firm is "}, {"type": "text", "text": "EV", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not market cap."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. P/E of a leveraged firm can deceive: look at its debt."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. Use "}, {"type": "text", "text": "consolidated", "marks": [{"type": "bold"}]}, {"type": "text", "text": " numbers, not just standalone."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "6. Focus on "}, {"type": "text", "text": "ROE, not EPS", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": EPS ignores retained earnings."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "7. Leverage improves ROE, but excessive leverage is risky."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "8. "}, {"type": "text", "text": "ROCE", "marks": [{"type": "bold"}]}, {"type": "text", "text": " reflects the true return on capital; ROE can be inflated by high leverage."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "9. ROCE and ROE should be close. A wide gap should trigger investigation."}]}]}}, "index": "aFcjM", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6q", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 10 of 15"}]}]}}, "index": "a3nm6", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-83", "type": "note", "parentId": "shape:ch10-7w", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Two companies have the same P/E. One has no debt, the other is heavily borrowed. Which is cheaper?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7mxX", "typeName": "shape"}, {"x": 56, "y": 2153.8399999999965, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7r", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " NAV uses market value of assets; used for real estate, shipping, aviation."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aOusn", "typeName": "shape"}, {"x": 525.25, "y": 715, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1m", "type": "arrow", "parentId": "shape:ch10-19", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aAuqml", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2n", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A fast-growing company's growth may be unsustainable and even above its cost of capital, so a single constant growth rate does not fit. Value it in two stages:"}]}]}}, "index": "a5qpv", "typeName": "shape"}, {"x": 833.6000000000001, "y": 1006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-40", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "30"}]}]}}, "index": "aSUxY", "typeName": "shape"}, {"x": 315.20000000000005, "y": 834, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3o", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5"}]}]}}, "index": "aGC1E", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-51", "type": "frame", "props": {"w": 1400, "h": 3500.600000000006, "name": "10.8 Relative valuation: asset multiples", "color": "black"}, "parentId": "page:page", "index": "a6AIU", "typeName": "shape"}, {"x": 487.99999999999994, "y": 2583, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4p", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12 ÷ 10 = "}, {"type": "text", "text": "1.2x", "marks": [{"type": "bold"}]}]}]}}, "index": "ar0hn", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1608, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-62", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.09", "marks": [{"type": "bold"}]}]}]}}, "index": "abX9n", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1264, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5q", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5,400"}]}]}}, "index": "aP8B2", "typeName": "shape"}, {"x": 6160, "y": 3136.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-73", "type": "frame", "props": {"w": 1400, "h": 2878.3199999999924, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "a8qJQ", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6r", "type": "note", "parentId": "shape:ch10-6n", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Buying a flat: you check what similar flats in the locality sold for, and that becomes your starting point for negotiation. That is relative valuation. Quick and intuitive, but it reflects the current market mood, which may be too optimistic or too pessimistic."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a4wDr", "typeName": "shape"}, {"x": 56, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-84", "type": "note", "parentId": "shape:ch10-7w", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Try the calculator on the web page: how much does the Gordon value change if growth moves from 8% to 9%? What does that tell you about DCF?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8mn2", "typeName": "shape"}, {"x": 384, "y": 2153.8399999999965, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7s", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " P/Embedded value: life insurers. P/Adjusted book value: NBFCs. EV/Capacity: start-ups and special situations."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aPNMf", "typeName": "shape"}, {"meta": {}, "id": "binding:UbNZx6en9rjTL_gb6Qux0", "type": "arrow", "fromId": "shape:ch10-6e", "toId": "shape:ch10-6a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": 