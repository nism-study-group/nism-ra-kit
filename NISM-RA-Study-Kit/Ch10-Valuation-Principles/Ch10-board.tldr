net assets."}]}]}}, "index": "a7cF6", "typeName": "shape"}, {"x": 56, "y": 2984, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4w", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV/EBITDA", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Preferred for "}, {"type": "text", "text": "capital-intensive", "marks": [{"type": "bold"}]}, {"type": "text", "text": " industries, where historical asset costs and depreciation choices distort EBIT."}]}]}}, "index": "ayn5r", "typeName": "shape"}, {"x": 56, "y": 2593.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-69", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capital employed", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Net worth 1,00,000 + debt 1,00,000 = "}, {"type": "text", "text": "2,00,000", "marks": [{"type": "bold"}]}]}]}}, "index": "ai6aE", "typeName": "shape"}, {"x": 56, "y": 1522, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5x", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Market price", "marks": [{"type": "bold"}]}]}]}}, "index": "aWYYM", "typeName": "shape"}, {"x": 56, "y": 1410, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6y", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Valuations of companies like WhatsApp, Zomato, LinkedIn and Facebook are hard to explain with numbers. Such deals use new measures: "}, {"type": "text", "text": "eyeballs, page views, footfall, ARPU, number of users", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". As Buffett would say, these must eventually become "}, {"type": "text", "text": "profits for owners", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Without that, valuations last only as long as the story and the next buyer, and can fall like a pack of cards, as in the "}, {"type": "text", "text": "dot-com boom of 2000 to 2001", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aBlwX", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7z", "type": "text", "parentId": "shape:ch10-7w", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3R2j", "typeName": "shape"}, {"meta": {}, "id": "binding:SkQzQv2WR-FrMqtkHfxVq", "type": "arrow", "fromId": "shape:ch10-2t", "toId": "shape:ch10-2p", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"meta": {}, "id": "binding:dzgAEHuwp_LG9sY2HPZQy", "type": "arrow", "fromId": "shape:ch10-6d", "toId": "shape:ch10-69", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 1107.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-d", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Owners' general sense of what it is worth"}]}]}}, "index": "aAJ7f", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-15", "type": "text", "parentId": "shape:ch10-10", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book focuses on the last two"}]}]}}, "index": "a5RPU", "typeName": "shape"}, {"x": 56, "y": 1462, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-26", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Gordon growth model"}]}]}}, "index": "aV3UY", "typeName": "shape"}, {"x": 56, "y": 1076, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1u", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 199.48082595870207, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dividend discount model (DDM)", "marks": [{"type": "bold"}]}]}]}}, "index": "aJgY2", "typeName": "shape"}, {"x": 1084, "y": 2304.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-37", "type": "note", "parentId": "shape:ch10-2i", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "DCF gives wrong answers if the cash flows and the discount rate are not estimated with enough rigour. A small change in the discount rate or growth rate can move the value a lot."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aNMzT", "typeName": "shape"}, {"x": 697.25, "y": 772, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2v", "type": "arrow", "parentId": "shape:ch10-2i", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 278.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aBbcE", "typeName": "shape"}, {"x": 56, "y": 1892, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-48", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "PEG = (Price ÷ EPS) ÷ Growth rate"}]}]}}, "index": "aa1wr", "typeName": "shape"}, {"x": 1092.8000000000002, "y": 920, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3w", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.50%"}]}]}}, "index": "aOFNX", "typeName": "shape"}, {"x": 56, "y": 569, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-59", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 413.3333333333333, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Financial companies", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Preferred here.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Their assets are mostly monetary, so book value is close to fair value."}]}]}}, "index": "a8QGb", "typeName": "shape"}, {"x": 712, "y": 2984, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4x", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV/EBIT", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Preferred for "}, {"type": "text", "text": "other", "marks": [{"type": "bold"}]}, {"type": "text", "text": " industries."}]}]}}, "index": "azFXv", "typeName": "shape"}, {"x": 487.99999999999994, "y": 1522, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5y", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rs 200"}]}]}}, "index": "aXnyb", "typeName": "shape"}, {"x": 56, "y": 1578, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6z", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.12 Is valuation objective?"}]}]}}, "index": "aCNgn", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1107.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-e", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fair treatment of stakeholders in an equity swap"}]}]}}, "index": "aB0z1", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-16", "type": "geo", "parentId": "shape:ch10-10", "props": {"w": 413.3333333333333, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cost based", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value = cost to create the asset. Suits only a buyer choosing between "}, {"type": "text", "text": "buying and making", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Most stock market investors cannot build the company themselves, so it is generally "}, {"type": "text", "text": "not suitable for financial investors", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Strategic, long-term investors may use it. Often needs technical assessment by engineers."}]}]}}, "index": "a67nv", "typeName": "shape"}, {"x": 56, "y": 1537, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-27", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Also called the "}, {"type": "text", "text": "perpetual growth model", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". It values a company whose dividend is expected to grow forever at a constant rate."}]}]}}, "index": "aWb6M", "typeName": "shape"}, {"x": 263.4808259587021, "y": 1076, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1v", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 356.08259587020643, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Expected future dividends"}]}]}}, "index": "aKpmr", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-38", "type": "frame", "props": {"w": 1400, "h": 3485, "name": "10.6 and 10.7 Relative valuation: earnings multiples", "color": "black"}, "parentId": "page:page", "index": "a5wUD", "typeName": "shape"}, {"x": 1084, "y": 490, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2w", "type": "note", "parentId": "shape:ch10-2i", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capping the perpetual growth rate", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The perpetual growth rate is often capped at the "}, {"type": "text", "text": "long-term nominal GDP growth rate", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the company's markets, because no business can outgrow the economy forever. Analysts may use a lower rate. A rough forecast can extrapolate past growth; analysts refine it using the share of earnings ploughed back and the expected return on equity."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 432, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCU3u", "typeName": "shape"}, {"x": 56, "y": 2002, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-49", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coined by "}, {"type": "text", "text": "Peter Lynch", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". A high P/E can be justified by high growth, but high growth may not last. Lynch: "}, {"type": "text", "text": "PEG below 1", "marks": [{"type": "bold"}]}, {"type": "text", "text": " may be treated as "}, {"type": "text", "text": "undervalued", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Use rules of thumb with care; comparing PEGs across competitors is more useful."}]}]}}, "index": "ab1En", "typeName": "shape"}, {"x": 56, "y": 1006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3x", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price / dividend", "marks": [{"type": "bold"}]}]}]}}, "index": "aPPFv", "typeName": "shape"}, {"x": 56, "y": 3154, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4y", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lower ratios look more attractive, all else equal; higher growth or lower risk earns a premium."}]}]}}, "index": "b00RmX", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1522, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5z", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rs 175"}]}]}}, "index": "aY7Eb", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1107.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-f", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Accounting, tax, regulatory and legal needs"}]}]}}, "index": "aCnpr", "typeName": "shape"}, {"x": 493.3333333333333, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-17", "type": "geo", "parentId": "shape:ch10-10", "props": {"w": 413.3333333333333, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cash flow based (intrinsic)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value = what an investor would pay for the asset's cash flows, discounted at the return they expect."}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Risk neutral:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " cash flows adjusted for probability, discounted at the "}, {"type": "text", "text": "risk-free rate", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Used for "}, {"type": "text", "text": "insurance companies", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (embedded value and appraisal value)."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Real world:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " most likely cash flows, discounted at risk-free rate "}, {"type": "text", "text": "plus a risk premium", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}]}]}}, "index": "a75hQ", "typeName": "shape"}, {"x": 56, "y": 1627, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-28", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P = D1 ÷ (k − g)"}]}]}}, "index": "aXckA", "typeName": "shape"}, {"x": 627.5634218289085, "y": 1076, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1w", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 149.14454277286137, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cost of equity"}]}]}}, "index": "aLYRX", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-39", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1KwM", "typeName": "shape"}, {"x": 56, "y": 1351.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2x", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "From firm value to equity value (FCFF)"}]}]}}, "index": "aDpY6", "typeName": "shape"}, {"x": 315.20000000000005, "y": 1006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3y", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10"}]}]}}, "index": "aQBTU", "typeName": "shape"}, {"x": 56, "y": 3226, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4z", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.7.5 EV to sales"}]}]}}, "index": "b01zN5", "typeName": "shape"}, {"x": 56, "y": 1247.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-g", "type": "text", "parentId": "shape:ch10-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Whatever the reason, the purpose is to "}, {"type": "text", "text": "relate price to value", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": is it fairly priced, over-priced or under-priced? Because of the uncertainty, valuers usually present "}, {"type": "text", "text": "several scenarios", "marks": [{"type": "bold"}]}, {"type": "text", "text": " showing how value changes with the main inputs."}]}]}}, "index": "aDgyr", "typeName": "shape"}, {"x": 930.6666666666666, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-18", "type": "geo", "parentId": "shape:ch10-10", "props": {"w": 413.3333333333333, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Selling price based (relative)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value from the prices of "}, {"type": "text", "text": "similar assets", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", using ratios such as P/E, P/B, EV/EBITDA."}]}]}}, "index": "a8jnf", "typeName": "shape"}, {"x": 56, "y": 1737, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-29", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "D1", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = dividend expected at the "}, {"type": "text", "text": "end of the year", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". "}, {"type": "text", "text": "k", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = cost of equity. "}, {"type": "text", "text": "g", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = constant growth rate, which must be "}, {"type": "text", "text": "lower than k", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aYDSb", "typeName": "shape"}, {"x": 784.7079646017698, "y": 1076, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1x", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 559.29203539823, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Companies paying regular, substantial dividends: "}, {"type": "text", "text": "mature companies in defensive industries", "marks": [{"type": "bold"}]}]}]}}, "index": "aMRDM", "typeName": "shape"}, {"x": 56, "y": 1426.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2y", "type": "geo", "parentId": "shape:ch10-2i", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Value of equity = Firm value − minority interest − preferred share capital − interest-bearing debt"}]}]}}, "index": "aE8XI", "typeName": "shape"}, {"x": 574.4000000000001, "y": 1006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3z", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20"}]}]}}, "index": "aRss2", "typeName": "shape"}, {"x": 56, "y": 1351.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-h", "type": "text", "parentId": "shape:ch10-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.3 Where value comes from: earnings and assets"}]}]}}, "index": "aE54Q", "typeName": "shape"}, {"x": 1540, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-19", "type": "frame", "props": {"w": 1400, "h": 2731.4000000000015, "name": "10.5 Discounted cash flow (DCF) (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a3oFj", "typeName": "shape"}, {"x": 56, "y": 1186, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1y", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 199.48082595870207, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Free cash flow to equity (FCFE)", "marks": [{"type": "bold"}]}]}]}}, "index": "aNgon", "typeName": "shape"}, {"x": 56, "y": 1536.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2z", "type": "text", "parentId": "shape:ch10-2i", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "To get "}, {"type": "text", "text": "enterprise value", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", the book deducts surplus cash, cash equivalents and short-term investments not needed for current operations from the firm value."}]}]}}, "index": "aFO5U", "typeName": "shape"}, {"name": "", "color": "#F2555A", "imageUrl": "", "meta": {}, "id": "user:4YjEqqAB9ulj-3MRW6nWu", "typeName": "user"}, {"x": 56, "y": 1426.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-i", "type": "text", "parentId": "shape:ch10-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buffett, quoted in the book: "}, {"type": "text", "text": "\"There are only two sources of value in a business: Earnings and Assets.\"", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Every asset produces periodic earnings plus a final inflow when it is sold."}]}]}}, "index": "aFWze", "typeName": "shape"}, {"x": 263.4808259587021, "y": 1186, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1z", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 356.08259587020643, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cash flow available to equity shareholders, instead of actual dividends"}]}]}}, "index": "aOBz7", "typeName": "shape"}, {"x": 6640, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-8a", "type": "note", "parentId": "page:page", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WHY IT MATTERS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The reason behind a rule"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aF0rI", "typeName": "shape"}, {"x": 56, "y": 1530.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-j", "type": "text", "parentId": "shape:ch10-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Two streams of cash from every asset"}]}]}}, "index": "aG0Xn", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 10: Valuation principles", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7a", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Cost-based valuation suits buy-versus-make decisions; generally not for financial investors."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7vXI", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-8b", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aGczUV", "typeName": "shape"}, {"x": 56, "y": 1605.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-k", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 277.33333333333337, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Asset", "marks": [{"type": "bold"}]}]}]}}, "index": "aHqyA", "typeName": "shape"}, {"meta": {}, "id": "binding:tB2iFNJ7TIua2sAMD5Hij", "type": "arrow", "fromId": "shape:ch10-1m", "toId": "shape:ch10-1j", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 405.5, "y": 2593.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6a", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 239.5, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Market cap 5,00,000 + debt 1,00,000 − cash 0 = "}, {"type": "text", "text": "6,00,000", "marks": [{"type": "bold"}]}]}]}}, "index": "aj3Oz", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7b", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Risk-neutral valuation discounts at the risk-free rate; used for insurers. Real-world adds a risk premium."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8O3f", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-8c", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aHIu2", "typeName": "shape"}, {"meta": {}, "id": "binding:DQg9bsQNgPnHkwiPMYuEO", "type": "arrow", "fromId": "shape:ch10-2t", "toId": "shape:ch10-2q", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 341.33333333333337, "y": 1605.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-l", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 277.33333333333337, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Periodic earnings", "marks": [{"type": "bold"}]}]}]}}, "index": "aIHC6", "typeName": "shape"}, {"x": 493.3333333333333, "y": 569, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5a", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 413.3333333333333, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "st