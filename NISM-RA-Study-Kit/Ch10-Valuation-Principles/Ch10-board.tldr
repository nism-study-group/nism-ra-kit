ive", "marks": [{"type": "bold"}]}, {"type": "text", "text": " value of equity. Lower P/B looks more attractive, all else equal, but a "}, {"type": "text", "text": "higher ROE deserves a premium", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aBmhE", "typeName": "shape"}, {"x": 175.75, "y": 2695.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6d", "type": "arrow", "parentId": "shape:ch10-51", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 349.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "ajuci", "typeName": "shape"}, {"x": 1040, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7e", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " DDM suits mature dividend payers in defensive industries. FCFE suits low-dividend and high-growth firms. FCFF suits firms without an objective debt policy."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 120, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aB0K6", "typeName": "shape"}, {"x": 341.33333333333337, "y": 1691.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-o", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 277.33333333333337, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Coupons"}]}]}}, "index": "aLKkv", "typeName": "shape"}, {"x": 1084, "y": 1737, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2a", "type": "note", "parentId": "shape:ch10-19", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Use "}, {"type": "text", "text": "next year's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " dividend (D1), not the one just paid. If the last dividend was Rs 4 and growth is 5%, D1 = 4 × 1.05 = Rs 4.20."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aZICv", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3b", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 10 of 15"}]}]}}, "index": "a3aCE", "typeName": "shape"}, {"x": 56, "y": 2239, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4c", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index"