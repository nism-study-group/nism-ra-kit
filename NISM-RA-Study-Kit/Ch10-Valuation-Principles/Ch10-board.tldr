statement"}]}]}}, "index": "acxLE", "typeName": "shape"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3e", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dividend yield = Dividend per share ÷ Current price"}]}]}}, "index": "a6Ugg", "typeName": "shape"}, {"x": 56, "y": 2325, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4f", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price", "marks": [{"type": "bold"}]}]}]}}, "index": "ahFOz", "typeName": "shape"}, {"x": 487.99999999999994, "y": 1006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5g", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "AFB Finance", "marks": [{"type": "bold"}]}]}]}}, "index": "aFqLQ", "typeName": "shape"}, {"x": 56, "y": 2912.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6h", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NAV", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = "}, {"type": "text", "text": "market value", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of assets minus liabilities. Unlike book value, it uses market values. It can be stated in total or per share. Used for very asset-heavy businesses such as "}, {"type": "text", "text": "real estate, shipping and aviation", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aoExr", "typeName": "shape"}, {"x": 1040, "y": 1060.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7i", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Equity value = firm value − minority interest − preferred capital − interest-bearing debt."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFVuj", "typeName": "shape"}, {"meta": {}, "id": "binding:4p4zSgjvJ2bJkMKaNBl6_", "type": "arrow", "fromId": "shape:ch10-2v", "toId": "shape:ch10-2r", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"meta": {}, "id": "binding:8rGFOLY09vPWFEAfeQw-n", "type": "arrow", "fromId": "shape:ch10-6f", "toId": "shape:ch10-6b", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 626.6666666666667, "y": 1777.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-s", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 433.3333333333333, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sale of the share"}]}]}}, "index": "aPPrj", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1d", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Start with a bond. It pays 9% a year and repays its face value of Rs 1,00,000 after 10 years. Investors also expect 9% for this maturity and credit quality. Its value today is the present value of all its cash flows at 9%, which comes to exactly the "}, {"type": "text", "text": "face value", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". If investors expect more than 9%, the value is below face value; if less, above."}]}]}}, "index": "a4I6j", "typeName": "shape"}, {"x": 56, "y": 2321.4000000000015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2e", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 413.3333333333333, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "FCFE", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Operating cash flow"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "− Capital expenditure"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "− Interest payments"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "± Net borrowings (repayments)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "= Free cash flow to equity", "marks": [{"type": "bold"}]}]}]}}, "index": "adtoQ", "typeName": "shape"}, {"x": 56, "y": 543, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3f", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example: a company has paid Rs 5 or more in dividend every year for five years."}]}]}}, "index": "a7fAv", "typeName": "shape"}, {"x": 487.99999999999994, "y": 2325, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4g", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rs 120"}]}]}}, "index": "aiTV2", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5h", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "LKH Finance", "marks": [{"type": "bold"}]}]}]}}, "index": "aGJ6I", "typeName": "shape"}, {"x": 56, "y": 3016.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6i", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.8.4 Other metrics"}]}]}}, "index": "ap2TE", "typeName": "shape"}, {"x": 56, "y": 1461.3600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7j", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " CAPM: Ke = Rf + β(Rm − Rf). Rm − Rf is the market risk premium."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGYIf", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3", "type": "frame", "props": {"w": 1400, "h": 2327.399999999998, "name": "10.1 Price is not value", "color": "black"}, "parentId": "page:page", "index": "a1KVr", "typeName": "shape"}, {"x": 56, "y": 1863.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-t", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 277.33333333333337, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Real estate", "marks": [{"type": "bold"}]}]}]}}, "index": "aQIgI", "typeName": "shape"}, {"x": 56, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1e", "type": "text", "parentId": "shape:ch10-19", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Every asset is valued the same way. For equity, dividends replace coupons and the sale price replaces redemption. The difference: a bond's cash flows and timing are "}, {"type": "text", "text": "known", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; equity's are "}, {"type": "text", "text": "uncertain", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". So DCF valuations of businesses carry significant judgement error and can be very sensitive to some inputs."}]}]}}, "index": "a5XVA", "typeName": "shape"}, {"x": 493.3333333333333, "y": 2321.4000000000015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2f", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 413.3333333333333, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "FCFF, direct", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Operating cash flow"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "− Capital expenditure"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "− Tax benefit on interest payments"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "= Free cash flow to the firm", "marks": [{"type": "bold"}]}]}]}}, "index": "aeQWI", "typeName": "shape"}, {"x": 56, "y": 615, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3g", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Same Rs 5 dividend, four prices"}]}]}}, "index": "a8ZbM", "typeName": "shape"}, {"x": 919.9999999999999, "y": 2325, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4h", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rs 140"}]}]}}, "index": "ajURJ", "typeName": "shape"}, {"x": 56, "y": 1092, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5i", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Share capital", "marks": [{"type": "bold"}]}]}]}}, "index": "aHLfv", "typeName": "shape"}, {"x": 56, "y": 3105.600000000006, "rotation": 0, "isLocked"