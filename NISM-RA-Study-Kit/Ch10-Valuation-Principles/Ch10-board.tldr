cial risk"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "β × (Rm − Rf)", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": equity risk premium paid over the risk-free rate"}]}]}]}]}}, "index": "aKMkM", "typeName": "shape"}, {"x": 891.5, "y": 490, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2s", "type": "geo", "parentId": "shape:ch10-2i", "props": {"w": 168.5, "h": 564, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add them up", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Value of equity (FCFE) or of the firm (FCFF)"}]}]}}, "index": "aA9B6", "typeName": "shape"}, {"x": 56, "y": 1475, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-45", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Earnings yield = EPS ÷ Current price   |   P/E = Current price ÷ EPS (its reciprocal)"}]}]}}, "index": "aXsKM", "typeName": "shape"}, {"x": 315.20000000000005, "y": 920, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3t", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.00%"}]}]}}, "index": "aLOQQ", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-56", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.8.1 Price to book value"}]}]}}, "index": "a5uGr", "typeName": "shape"}, {"x": 56, "y": 2787, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4u", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.7.4 EV to EBIT(DA)"}]}]}}, "index": "awIsf", "typeName": "shape"}, {"x": 56, "y": 2446.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-67", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Used together with ROCE, it shows the return an investor actually earns on the price paid."}]}]}}, "index": "agW3v", "typeName": "shape"}, {"x": 487.99999999999994, "y": 1436, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5v", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9,900 ÷ 50 = "}, {"type": "text", "text": "Rs 198", "marks": [{"type": "bold"}]}]}]}}, "index": "aUJqX", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-78", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Buffett: only two sources of value, earnings and assets."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5oWI", "typeName": "shape"}, {"x": 56, "y": 1199, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6w", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Conglomerates such as "}, {"type": "text", "text": "ITC", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "L&T", "marks": [{"type": "bold"}]}, {"type": "text", "text": " run many businesses under one umbrella. Value each business separately, as an independent business, using the methods above, then "}, {"type": "text", "text": "add them up", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The book calls this sum-of-the-parts (SOTP or SOP) valuation."}]}]}}, "index": "a9BwE", "typeName": "shape"}, {"x": 6160, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-89", "type": "note", "parentId": "page:page", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An everyday picture of the idea"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aEPi6", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7x", "type": "geo", "parentId": "shape:ch10-7w", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a1X9j", "typeName": "shape"}, {"x": 493.3333333333333, "y": 999.7999999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-b", "type": "geo", "parentId": "shape:ch10-3", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Selling a business as an investment"}]}]}}, "index": "a8MGA", "typeName": "shape"}, {"meta": {}, "id": "binding:__4QMiStDOto0-ERBiWcd", "type": "arrow", "fromId": "shape:ch10-1n", "toId": "shape:ch10-1k", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-13", "type": "text", "parentId": "shape:ch10-10", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 10 of 15"}]}]}}, "index": "a3S4v", "typeName": "shape"}, {"x": 627.5634218289085, "y": 1320, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-24", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 149.14454277286137, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WACC", "marks": [{"type": "bold"}]}]}]}}, "index": "aTaFI", "typeName": "shape"}, {"x": 627.5634218289085, "y": 990, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1s", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 149.14454277286137, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Discount rate", "marks": [{"type": "bold"}]}]}]}}, "index": "aH12I", "typeName": "shape"}, {"x": 712, "y": 1984.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-35", "type": "geo", "parentId": "shape:ch10-2i", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Weighted average cost of capital", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "WACC = Ke × We + Kd × (1 − Tax) × Wd"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "We", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = Equity ÷ (Equity + Debt)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Wd", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = Debt ÷ (Equity + Debt)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Kd", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": cost of debt, taken "}, {"type": "text", "text": "after tax", "marks": [{"type": "bold"}]}, {"type": "text", "text": " because interest saves tax"}]}]}]}]}}, "index": "aLaVE", "typeName": "shape"}, {"x": 140.25, "y": 772, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-2t", "type": "arrow", "parentId": "shape:ch10-2i", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 278.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "a8zpUd", "typeName": "shape"}, {"x": 56, "y": 1585, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-46", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analysts move to earnings yield when dividend yields are very low."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/E is the money needed to buy one unit of profit. It uses historical EPS, or forecast EPS for "}, {"type": "text", "text": "forward P/E", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All else equal, a P/E above peers and the market looks "}, {"type": "text", "text": "expensive", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; below looks "}, {"type": "text", "text": "undervalued", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "But companies with "}, {"type": "text", "text": "higher growth or lower risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": " deserve a premium; lower growth or higher risk, a discount."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Earnings are for a period; price is at a point. Choose the EPS period with judgement: investors usually weigh "}, {"type": "text", "text": "future", "marks": [{"type": "bold"}]}, {"type": "text", "text": " earnings more, and may use next year's if this year's is unusually high or low."}]}]}]}]}}, "index": "aYngI", "typeName": "shape"}, {"x": 574.4000000000001, "y": 920, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3u", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.00%"}]}]}}, "index": "aMtdb", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-57", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "P/B = Market cap ÷ Book value of equity = Price per share ÷ Book value per share"}]}]}}, "index": "a6w0n", "typeName": "shape"}, {"x": 56, "y": 2862, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4v", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EPS, and so P/E and PEG, depend on the company's "}, {"type": "text", "text": "capital structure", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (equity has the residual claim). A retail investor cannot change that; a controlling shareholder can. So from an "}, {"type": "text", "text": "acquirer's", "marks": [{"type": "bold"}]}, {"type": "text", "text": " view, or for a takeover target, use ratios "}, {"type": "text", "text": "neutral to capital structure", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": "}, {"type": "text", "text": "EV/EBIT", "marks": [{"type": "bold"}]}, {"type": "text", "text": " or "}, {"type": "text", "text": "EV/EBITDA", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (see 3.1.7 for EV)."}]}]}}, "index": "axc5f", "typeName": "shape"}, {"x": 56, "y": 2518.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-68", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's EV to capital employed example"}]}]}}, "index": "ahEfb", "typeName": "shape"}, {"x": 919.9999999999999, "y": 1436, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5w", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8,000 ÷ 50 = "}, {"type": "text", "text": "Rs 160", "marks": [{"type": "bold"}]}]}]}}, "index": "aVVar", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-79", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Lenders look at cash flows first; collateral is a fallback."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6Feb", "typeName": "shape"}, {"x": 56, "y": 1335, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6x", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "viol