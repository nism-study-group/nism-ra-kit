ngle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "When the company has no objective debt policy, so future borrowing cannot be estimated for FCFE"}]}]}}, "index": "aUN5X", "typeName": "shape"}, {"x": 784.7079646017698, "y": 990, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-1t", "type": "geo", "parentId": "shape:ch10-19", "props": {"w": 559.29203539823, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Best for", "marks": [{"type": "bold"}]}]}]}}, "index": "aIyu2", "typeName": "shape"}, {"x": 56, "y": 2304.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-36", "type": "geo", "parentId": "shape:ch10-2i", "props": {"w": 1004, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: Try it: CAPM, WACC and Gordon", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Change any number. All rates are % a year."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "aMscn", "typeName": "shape"}, {"x": 418.75, "y": 772, "rot