 [{"type": "text", "text": "Discount the terminal value", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "It is a future amount, so bring it back to present value too"}]}]}}, "index": "a9LbQ", "typeName": "shape"}, {"x": 56, "y": 1400, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-44", "type": "text", "parentId": "shape:ch10-38", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.7.2 Earnings yield and P/E"}]}]}}, "index": "aW5Pb", "typeName": "shape"}, {"x": 56, "y": 920, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-3s", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 251.20000000000002, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dividend yield", "marks": [{"type": "bold"}]}]}]}}, "index": "aKDEr", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-55", "type": "text", "parentId": "shape:ch10-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Here assets replace earnings. Two ratios from earlier chapters: "}, {"type": "text", "text": "ROE", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = net profit ÷ net worth (return on the book value of equity); "}, {"type": "text", "text": "ROCE", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = EBIT ÷ capital employed (debt + net worth)."}]}]}}, "index": "a4yL6", "typeName": "shape"}, {"x": 919.9999999999999, "y": 2669, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-4t", "type": "geo", "parentId": "shape:ch10-38", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Better value once growth is counted", "marks": [{"type": "bold"}]}]}]}}, "index": "avEqb", "typeName": "shape"}, {"x": 56, "y": 2336.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-66", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EV / Capital employed = EV ÷ (Total equity + Total debt)"}]}]}}, "index": "afL9z", "typeName": "shape"}, {"x": 56, "y": 1436, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-5u", "type": "geo", "parentId": "shape:ch10-51", "props": {"w": 423.99999999999994, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book value per share", "marks": [{"type": "bold"}]}]}]}}, "index": "aThLz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-77", "type": "note", "parentId": "shape:ch10-73", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Price is known to all; value is an estimate. Valuation is an art and a science."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4EMr", "typeName": "shape"}, {"x": 56, "y": 1124, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-6v", "type": "text", "parentId": "shape:ch10-6n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.10 Sum of the parts (SOTP)"}]}]}}, "index": "a8LTM", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-88", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aDsxz", "typeName": "shape"}, {"x": 6160, "y": 6154.919999999993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch10-7w", "type": "frame", "props": {"w": 1400, "h": 1055.9199999999983, "name": "For the group discussion", "color": "black"}, "parentId