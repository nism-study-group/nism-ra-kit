rticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Legal rights: acquired copyrights, patents, brands. Internally developed software can be shown; other self-generated assets cannot"}]}]}}, "index": "aM7kn", "typeName": "shape"}, {"x": 56, "y": 2113.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2g", "type": "geo", "parentId": "shape:ch08-20", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Total debt", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Long-term debt + current portion of long-term debt + short-term debt + finance lease obligations + accrued interest."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Debt is settled in cash and carries interest, unlike other liabilities."}]}]}}, "index": "aGsgb", "typeName": "shape"}, {"x": 336.12598425196853, "y": 1615, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3h", "type": "geo", "parentId": "shape:ch08-2k", "props": {"w": 1007.8740157480315, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Subsidiary profit belonging to outside shareholders"}]}]}}, "index": "aX1Tj", "typeName": "shape"}, {"x": 303.5151515151515, "y": 1683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shap