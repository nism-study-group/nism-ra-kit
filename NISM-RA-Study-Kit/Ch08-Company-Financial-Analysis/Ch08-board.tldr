": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Other comprehensive income (OCI)"}]}]}}, "index": "abzcu", "typeName": "shape"}, {"x": 1142.3030303030305, "y": 1683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4m", "type": "geo", "parentId": "shape:ch08-43", "props": {"w": 201.69696969696975, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2009", "marks": [{"type": "bold"}]}]}]}}, "index": "aJvjb", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5n", "type": "frame", "props": {"w": 1400, "h": 3704.399999999994, "name": "8.10 Why ratios?", "color": "black"}, "parentId": "page:page", "index": "a86Dz", "typeName": "shape"}, {"x": 634.6153846153848, "y": 2213, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-70", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 709.3846153846154, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "anFq2", "typeName": "shape"}, {"x": 634.6153846153848, "y": 1821, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6o", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 709.3846153846154, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Capital employed = total assets − non-interest-bearing current liabilities, or equity + debt (book values). Pre-tax. Bharti: 2.38%"}]}]}}, "index": "abF7b", "typeName": "shape"}, {"x": 56, "y": 1002.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-81", "type": "text", "parentId": "shape:ch08-7q", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's comparison.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " HighLevCo: ROE "}, {"type": "text", "text": "92.3%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = 20% margin × 2.3x turnover × 2.0x leverage. LowLevCo: ROE "}, {"type": "text", "text": "52.4%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = 22% margin × 2.4x turnover × 1.0x leverage (no debt). LowLevCo is the better operator, with higher margin and slightly higher turnover. Its ROE is lower only because it uses no debt, which also means less risk."}]}]}}, "index": "aBpJv", "typeName": "shape"}, {"name": "", "color": "#F04F88", "imageUrl": "", "meta": {}, "id": "user:I5Y9hmMK0Xt4RjzWg-ajj", "typeName": "user"}, {"x": 56, "y": 3584.399999999994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7p", "type": "text", "parentId": "shape:ch08-5n", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book notes several versions of ROCE and D/E are used in the industry (for example, net debt = total debt minus cash). For the exam, use the formulas in the sheet above."}]}]}}, "index": "b0Ct9I", "typeName": "shape"}, {"x": 384, "y": 622.9599999999919, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-92", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Goodwill = price paid minus fair value of net assets. Paying less goes to capital reserve."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9uKb", "typeName": "shape"}, {"x": 56, "y": 2073.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8q", "type": "text", "parentId": "shape:ch08-88", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Insider buying and selling"}]}]}}, "index": "aItTb", "typeName": "shape"}, {"x": 216, "y": 138.79999999998836, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9r", "type": "text", "parentId": "shape:ch08-9o", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3KNz", "typeName": "shape"}, {"x": 56, "y": 459, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-g", "type": "geo", "parentId": "shape:ch08-9", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": 