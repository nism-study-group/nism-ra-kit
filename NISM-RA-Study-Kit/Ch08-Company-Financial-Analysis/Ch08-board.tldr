"shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Ind AS 1 requires OCI in the P&L statement, below net profit."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5Mbb", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9z", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read the balance sheet, the profit and loss account and the cash flow, then turn them into ratios that tell a story."}]}]}}, "index": "aFpgj", "typeName": "shape"}, {"x": 56, "y": 1294, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-o", "type": "text", "parentId": "shape:ch08-9", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Consolidated", "marks": [{"type": "bold"}]}, {"type": "text", "text": " statements treat all companies "}, {"type": "text", "text": "controlled", "marks": [{"type": "bold"}]}, {"type": "text", "text": " by the parent as one group and combine their results."}]}]}}, "index": "aFjZ2", "typeName": "shape"}, {"x": 56, "y": 719, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-12", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 175.56794425087108, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false