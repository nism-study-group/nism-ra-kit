e": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aGUJy", "typeName": "shape"}, {"x": 660.6689895470383, "y": 939, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1a", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 399.3310104529616, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Moved to PPE when ready to operate"}]}]}}, "index": "aHGGr", "typeName": "shape"}, {"meta": {}, "id": "binding:J72JtBhcK5bTMtIEGHDQG", "type": "arrow", "fromId": "shape:ch08-3y", "toId": "shape:ch08-3u", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 1084, "y": 837, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2b", "type": "note", "parentId": "shape:ch08-20", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Deferred revenue, the book's example: a customer buys a 6-month prepaid pack for Rs 1,200. After one month, the company counts Rs 200 as revenue. The other "}, {"type": "text", "text": "Rs 1,000", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (1,200 × 5/6) is deferred revenue: a promise still owed."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aBqzc", "typeName": "shape"}, {"x": 56, "y": 1443, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3c", "type": "geo", "parentId": "shape:ch08-2k", "props": {"w": 272.12598425196853, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Exceptional items", "marks": [{"type": "bold"}]}]}]}}, "index": "aSUd3", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1123, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4d", "type": "geo", "parentId": "shape:ch08-43", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Financing", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "From liabilities and equity (B/S items)", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Borrowing or issuing equity: "}, {"type": "text", "text": "positive", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Repaying debt or buying back equity: "}, {"type": "text", "text": "negative", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aAzzFV", "typeName": "shape"}, {"x": 56, "y": 1295.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5e", "type": "text", "parentId": "shape:ch08-52", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Numbers can be dressed up by assumptions or creative accounting. Auditors' "}, {"type": "text", "text": "qualifications", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in the notes (the fine print) are very useful."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "change in accounting period", "marks": [{"type": "bold"}]}, {"type": "text", "text": " can confuse comparisons with past years."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "One-off items can raise or lower profit; miss them and the whole analysis changes."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The best company for investors shows "}, {"type": "text", "text": "consistent", "marks": [{"type": "bold"}]}, {"type": "text", "text": " growth in sales, profit and net worth, lower debt, better margins and a rising "}, {"type": "text", "text": "return on net worth (RoNW)", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}]}]}}, "index": "aCImU", "typeName": "shape"}, {"x": 634.6153846153848, "y": 1539, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6f", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 709.3846153846154, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Used in valuation (later chapters)"}]}]}}, "index": "aS7Us", "typeName": "shape"}, {"x": 56, "y": 2801, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7g", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 279.5604395604396, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Asset turnover", "marks": [{"type": "bold"}]}]}]}}, "index": "b03DEr", "typeName": "shape"}, {"x": 56, "y": 734, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8h", "type": "geo", "parentId": "shape:ch08-88", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rights issue", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "No major dilution: offered to all in proportion. Dilutes "}, {"type": "text", "text": "only those who do not take up", "marks": [{"type": "bold"}]}, {"type": "text", "text": " their rights."}]}]}}, "index": "a96zw", "typeName": "shape"}, {"x": 384, "y": 1934.9599999999919, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9i", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " D/E benchmark: 1 or less on the most conservative basis."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aPXUy", "typeName": "shape"}, {"x": 6160, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-a1", "type": "note", "parentId": "page:page", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An everyday picture of the idea"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aHKzm", "typeName": "shape"}, {"meta": {}, "id": "binding:wx-hFsGG2NDTsVCpvMY8g", "type": "arrow", "fromId": "shape:ch08-3x", "toId": "shape:ch08-3t", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 1049, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1b", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 175.56794425087108, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Goodwill", "marks": [{"type": "bold"}]}]}]}}, "index": "aI5Hv", "typeName": "shape"}, {"x": 1084, "y": 1435, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2c", "type": "note", "parentId": "shape:ch08-20", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "provision", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is for a specific obligation (like retirement benefits). A "}, {"type": "text", "text": "reserve", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is set aside without a specific obligation. Do not mix them up."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCrnE", "typeName": "shape"}, {"x": 336.12598425196853, "y": 1443, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3d", "type": "geo", "parentId": "shape:ch08-2k", "props": {"w": 1007.8740157480315, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Not from the normal course of business: natural calamity losses, one-time regulatory charges"}]}]}}, "index": "aTKvU", "typeName": "shape"}, {"x": 56, "y": 1397, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4e", "type": "text", "parentId": "shape:ch08-43", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A warning from Kingfisher Airlines"}]}]}}, "index": "aBzAT", "typeName": "shape"}, {"x": 56, "y": 1527.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5f", "type": "text", "parentId": "shape:ch08-52", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.9 The audit report"}]}]}}, "index": "aDOkv", "typeName": "shape"}, {"x": 56, "y": 1625, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6g", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 279.5604395604396, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Return", "marks": [{"type": "bold"}]}]}]}}, "index": "aTUMF", "typeName": "shape"}, {"x": 343.5604395604396, "y": 2801, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7h", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 283.0549450549451, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Net sales ÷ Total assets"}]}]}}, "index": "b04x0z", "typeName": "shape"}, {"x": 712, "y": 734, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8i", "type": "geo", "parentId": "shape:ch08-88", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Preferential allotment", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Raises the chosen investor's stake, cuts everyone else's. Two views: dilution risk, "}, {"type": "text", "text": "or", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a sign that someone may bail the company out in a crisis. Check the situation and price: a "}, {"type": "text", "text": "premium", "marks": [{"type": "bold"}]}, {"type": "text", "text": " price is value-accretive for minorities."}]}]}}, "index": "aA5ZM", "typeName": "shape"}, {"x": 712, "y": 1934.9599999999919, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9j", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Current ratio below 1 is not always bad: customers may be funding working capital."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQJjz", "typeName": "shape"}, {"x": 6640, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-a2", "type": "note", "parentId": "page:page", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WHY IT MATTERS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The reason behind a rule"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aI4V2", "typeName": "shape"}, {"x": 239.56794425087108, "y": 1049, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1c", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 413.10104529616723, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price paid for a business above the fair value of net assets taken over"}]}]}}, "index": "aJ6uQ", "typeName": "shape"}, {"x": 56, "y": 1859.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2d", "type": "text", "parentId": "shape:ch08-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.3.2 Balance sheet metrics analysts add"}]}]}}, "index": "aD2Oz", "typeName": "shape"}, {"x": 56, "y": 1529, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3e", "type": "geo", "parentId": "shape:ch08-2k", "props": {"w": 272.12598425196853, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tax", "marks": [{"type": "bold"}]}]}]}}, "index": "aUb5n", "typeName": "shape"}, {"x": 56, "y": 1472, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4f", "type": "text", "parentId": "shape:ch08-43", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A business with "}, {"type": "text", "text": "negative operating cash flow", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for years needs constant doses of borrowing or new equity. In the end it either turns cash-positive or dies when lenders and investors stop. The book's example (Rs crore, source moneycontrol.com):"}]}]}}, "index": "aCro6", "typeName": "shape"}, {"x": 56, "y": 1602.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5g", "type": "text", "parentId": "shape:ch08-52", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Management prepares the accounts; auditors check that they give a "}, {"type": "text", "text": "true and fair view", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Auditors work on the information given to them and cannot vouch for every transaction. So they check, in order: are adequate "}, {"type": "text", "text": "control systems", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in place; were they "}, {"type": "text", "text": "properly implemented", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; were "}, {"type": "text", "text": "accounting standards", "marks": [{"type": "bold"}]}, {"type": "text", "text": " followed in measuring and disclosing items?"}]}]}}, "index": "aEseU", "typeName": "shape"}, {"x": 343.5604395604396, "y": 1625, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6h", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 283.0549450549451, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aUWfr", "typeName": "shape"}, {"x": 634.6153846153848, "y": 2801, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7i", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 709.3846153846154, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Higher is better: assets put to work. Used in DuPont"}]}]}}, "index": "b05KEA", "typeName": "shape"}, {"x": 56, "y": 962, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8j", "type": "geo", "parentId": "shape:ch08-88", "props": {"w": 632, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "QIP", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Dilutes, but likely shows "}, {"type": "text", "text": "institutional confidence", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in fundamentals."}]}]}}, "index": "aBAUq", "typeName": "shape"}, {"x": 1040, "y": 1934.9599999999919, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9k", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "24.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Inventory turnover is high for FMCG, low for capital goods."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aRbfQ", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-a3", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aJeU1", "typeName": "shape"}, {"x": 660.6689895470383, "y": 1049, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1d", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 399.3310104529616, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tested for impairment; any shortfall written off"}]}]}}, "index": "aKpdf", "typeName": "shape"}, {"x": 56, "y": 1934.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2e", "type": "text", "parentId": "shape:ch08-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Balance sheets often miss fair value because of the historical cost and money measurement concepts. So analysts compute extra metrics."}]}]}}, "index": "aE6Tj", "typeName": "shape"}, {"x": 336.12598425196853, "y": 1529, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3f", "type": "geo", "parentId": "shape:ch08-2k", "props": {"w": 1007.8740157480315, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Current tax, MAT, deferred tax. Deferred tax has "}, {"type": "text", "text": "no cash impact", "marks": [{"type": "bold"}]}]}]}}, "index": "aV9fQ", "typeName": "shape"}, {"x": 56, "y": 1608, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4g", "type": "text", "parentId": "shape:ch08-43", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Kingfisher Airlines, years ending March"}]}]}}, "index": "aD26M", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 8: Company analysis: financial analysis", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 56, "y": 1770.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5h", "type": "text", "parentId": "shape:ch08-52", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": 