ntent": [{"type": "text", "text": "As per the book, SEBI requires listed companies to publish "}, {"type": "text", "text": "consolidated statements annually", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "standalone results quarterly", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Quarterly consolidated results are voluntary, which leaves analysts with dated group numbers between annual reports."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 288, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aJp3Q", "typeName": "shape"}, {"x": 239.56794425087108, "y": 805, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-16", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 413.10104529616723, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Land, buildings, machines, furniture, computers"}]}]}}, "index": "aDLw2", "typeName": "shape"}, {"x": 56, "y": 762, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-28", "type": "text", "parentId": "shape:ch08-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Liability line items"}]}]}}, "index": "a8cZz", "typeName": "shape"}, {"x": 56, "y": 1891, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1w", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 175.56794425087108, "h": 102, "geo": "rectangle", "dash": "solid", "grow