 2887, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7l", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 709.3846153846154, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Higher is better. High for FMCG, low for capital goods"}]}]}}, "index": "b08syE", "typeName": "shape"}, {"x": 56, "y": 1221, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8m", "type": "text", "parentId": "shape:ch08-88", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dividends plus capital gains make up an investor's total return."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Growth phase:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " companies pay little or no dividend; shareholders do not mind if the company earns more on the money than they could."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mature phase:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shareholders expect timely dividends. Predictability matters; high-yield stocks attract long-term income seekers."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mature companies in "}, {"type": "text", "text": "defensive", "marks": [{"type": "bold"}]}, {"type": "text", "text": " industries offer the most predictable dividends, often with interim dividends. Book examples: "}, {"type": "text", "text": "Colgate Palmolive", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "Britannia", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Some companies smooth dividends: build reserves in good years, use them in bad years."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buybacks", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (other than for stock-based compensation) are also a way to distribute profit; companies may prefer them for tax reasons, and they let investors choose to sell or raise their stake."}]}]}]}]}}, "index": "aE5Rf", "typeName": "shape"}, {"x": 712, "y": 2262.959999999992, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9n", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "27.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Insider buying is a stronger signal than insider selling (Peter Lynch)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aUqTE", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-c", "type": "text", "parentId": "shape:ch08-9", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 8 of 15"}]}]}}, "index": "a3Wwb", "typeName": "shape"}, {"x": 660.6689895470383, "y": 1159, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1g", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 399.3310104529616, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Cost less accumulated amortisation"}]}]}}, "index": "aNeP6", "typeName": "shape"}, {"x": 398.6666666666667, "y": 2113.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2h", "type": "geo", "parentId": "shape:ch08-20", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Net working capital", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Current assets − current liabilities. The accountant's measure."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Bharti Airtel FY 2019: 329.06 − 930.55 = "}, {"type": "text", "text": "minus Rs 601.49 billion", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aHs7r", "typeName": "shape"}, {"x": 56, "y": 1733, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3i", "type": "text", "parentId": "shape:ch08-2k", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EPS: basic and diluted"}]}]}}, "index": "aYf06", "typeName": "shape"}, {"x": 513.2121212121212, "y": 1683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4j", "type": "geo", "parentId": "shape:ch08-43", "props": {"w": 201.69696969696975, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2012", "marks": [{"type": "bold"}]}]}]}}, "index": "aGocj", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1903.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5k", "type": "geo", "parentId": "shape:ch08-52", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Disclaimer", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Could not verify", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Auditors could not verify part of the financials because information was not available."}]}]}}, "index": "aIkqv", "typeName": "shape"}, {"x": 634.6153846153848, "y": 1711, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6l", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 709.3846153846154, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "\"Single most important parameter\" for equity investors. Net worth = share capital + reserves and surplus. Bharti: 2.1%"}]}]}}, "index": "aYA8I", "typeName": "shape"}, {"x": 56, "y": 3005, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7m", "type": "text", "parentId": "shape:ch08-5n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reading the liquidity ratios"}]}]}}, "index": "b095mz", "typeName": "shape"}, {"x": 1084, "y": 1221, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8n", "type": "note", "parentId": "shape:ch08-88", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reading the signals", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A strong company retaining more profit than usual may plan a big investment, or may expect hard times. A high-growth company raising its dividend may see fewer growth opportunities. When a dividend breaks sharply from the past, ask management why."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 312, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aF8On", "typeName": "shape"}, {"x": 6160, "y": 6114.159999999998, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9o", "type": "frame", "props": {"w": 1400, "h": 910, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "aCzha", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-d", "type": "text", "parentId": "shape:ch08-9", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "In India, the statements and their format are governed by "}, {"type": "text", "text": "Schedule III of the Companies Act, 2013", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "Ind AS 1", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". A complete set under Ind AS 1:"}]}]}}, "index": "a4FSr", "typeName": "shape"}, {"x": 56, "y": 1293, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1h", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 175.56794425087108, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Intangibles under development", "marks": [{"type": "bold"}]}]}]}}, "index": "aOokj", "typeName": "shape"}, {"x": 741.3333333333334, "y": 2113.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2i", "type": "geo", "parentId": "shape:ch08-20", "props": {"w": 318.6666666666667, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Core working capital", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Inventory + trade receivables − trade payables."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Only items from core operations. Helps judge the need for bank working capital finance. The book suggests also including a reasonable cash balance."}]}]}}, "index": "aISoA", "typeName": "shape"}, {"x": 56, "y": 1808, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3j", "type": "geo", "parentId": "shape:ch08-2k", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Basic EPS = net profit to equity shareholders ÷ weighted average shares outstanding"}]}]}}, "index": "aZWYv", "typeName": "shape"}, {"x": 722.909090909091, "y": 1683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4k", "type": "geo", "parentId": "shape:ch08-43", "props": {"w": 201.69696969696975, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2011", "marks": [{"type": "bold"}]}]}]}}, "index": "aH412", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1903.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5l", "type": "geo", "parentId": "shape:ch08-52", "props": {"w": 413.3333333333333, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Qualified", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Not true and fair", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Auditors believe all or part of the statements do not give a true and fair view: they disagree with a policy, or see serious discrepancies."}]}]}}, "index": "aJE3r", "typeName": "shape"}, {"x": 56, "y": 1821, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6m", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 279.5604395604396, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ROCE", "marks": [{"type": "bold"}]}]}]}}, "index": "aZteI", "typeName": "shape"}, {"x": 56, "y": 3080, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7n", "type": "text", "parentId": "shape:ch08-5n", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "High finished goods stock may mean slowing sales; high raw material stock may mean poor planning."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "High receivables: selling on credit and struggling to collect. High payables: may show strength in getting good credit terms."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A current ratio "}, {"type": "text", "text": "below 1", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is "}, {"type": "text", "text": "not always a red flag", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". A company that collects cash on sales and pays suppliers on credit has its working capital funded by customers. Firms with strong bargaining power often "}, {"type": "text", "text": "prefer", "marks": [{"type": "bold"}]}, {"type": "text", "text": " negative working capital: it is an interest-free obligation."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A very "}, {"type": "text", "text": "high", "marks": [{"type": "bold"}]}, {"type": "text", "text": " current ratio may point to poor management of inventory, receivables and cash."}]}]}]}]}}, "index": "b0AEpz", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-90", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " SEBI (as per the book): consolidated annually, standalone quarterly."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7tlI", "typeName": "shape"}, {"x": 56, "y": 1926.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8o", "type": "text", "parentId": "shape:ch08-88", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "History of corporate actions"}]}]}}, "index": "aGXkf", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9p", "type": "geo", "parentId": "shape:ch08-9o", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a15AM", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-e", "type": "text", "parentId": "shape:ch08-9", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A complete set of financial statements"}]}]}}, "index": "a5DqE", "typeName": "shape"}, {"x": 239.56794425087108, "y": 1293, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-1i", "type": "geo", "parentId": "shape:ch08-t", "props": {"w": 413.10104529616723, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Intangibles not yet ready"}]}]}}, "index": "aPRBb", "typeName": "shape"}, {"x": 1084, "y": 2113.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-2j", "type": "note", "parentId": "shape:ch08-20", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why working capital is needed", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The book says the \"day-to-day needs\" idea is a misnomer. A company needs working capital because it "}, {"type": "text", "text": "spends first", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (raw materials, production) and "}, {"type": "text", "text": "waits to be paid", "marks": [{"type": "bold"}]}, {"type": "text", "text": " by customers who buy on credit."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 240, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aJU2L", "typeName": "shape"}, {"x": 56, "y": 1918, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-3k", "type": "text", "parentId": "shape:ch08-2k", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Diluted EPS", "marks": [{"type": "bold"}]}, {"type": "text", "text": " assumes all instruments that could become shares without full payment are converted: in-the-money warrants, ESOPs, convertibles. Profit is adjusted for the effect too. For a "}, {"type": "text", "text": "loss-making", "marks": [{"type": "bold"}]}, {"type": "text", "text": " company, basic and diluted EPS are the "}, {"type": "text", "text": "same", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aazK1", "typeName": "shape"}, {"x": 932.6060606060607, "y": 1683, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-4l", "type": "geo", "parentId": "shape:ch08-43", "props": {"w": 201.69696969696975, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2010", "marks": [{"type": "bold"}]}]}]}}, "index": "aIDAM", "typeName": "shape"}, {"x": 56, "y": 2163.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-5m", "type": "text", "parentId": "shape:ch08-52", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For a disclaimer or a qualified report, auditors explain their reasons. Always read the audit report for reservations."}]}]}}, "index": "aKYT2", "typeName": "shape"}, {"x": 343.5604395604396, "y": 1821, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-6n", "type": "geo", "parentId": "shape:ch08-5n", "props": {"w": 283.0549450549451, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EBIT ÷ Capital employed"}]}]}}, "index": "aapEE", "typeName": "shape"}, {"x": 56, "y": 832.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-80", "type": "geo", "parentId": "shape:ch08-7q", "props": {"w": 1288, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interactive tool on the web page: DuPont calculator", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Starts with the book's HighLevCo. Press LowLevCo to compare."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Open this chapter's study page to try it."}]}]}}, "index": "aAiW6", "typeName": "shape"}, {"x": 1084, "y": 3080, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-7o", "type": "note", "parentId": "shape:ch08-5n", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "ROE uses "}, {"type": "text", "text": "PAT", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; ROCE uses "}, {"type": "text", "text": "EBIT", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". ROE's denominator is net worth only; ROCE's is equity plus debt. Interest coverage uses "}, {"type": "text", "text": "EBIT", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not PAT. Quick ratio removes "}, {"type": "text", "text": "inventories", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 168, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "b0Bl6b", "typeName": "shape"}, {"x": 56, "y": 622.9599999999919, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-91", "type": "note", "parentId": "shape:ch08-8t", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Self-generated brands cannot be shown as assets; internally developed software can."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8zXk", "typeName": "shape"}, {"x": 56, "y": 2001.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-8p", "type": "text", "parentId": "shape:ch08-88", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dividends, bonuses, splits and rights affect the share price. Chapter 9 covers them."}]}]}}, "index": "aHUP1", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-9q", "type": "text", "parentId": "shape:ch08-9o", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a2sDE", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch08-f", "type": "text", "parentId": "shape:ch08-9", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ind AS 1"}]}]}}, "index": "a6cbr", "typeName": "shape"}]}