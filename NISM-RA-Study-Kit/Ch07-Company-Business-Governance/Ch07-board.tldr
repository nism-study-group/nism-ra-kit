graph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Pricing power is driven mostly by industry factors; natural leadership, brand and low cost base set a company apart."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6HOj", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-c", "type": "text", "parentId": "shape:ch07-a", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The business and its model"}]}]}}, "index": "a2syf", "typeName": "shape"}, {"x": 56, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1d", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Strengths and weaknesses are internal. Opportunities and threats are external."}]}]}}, "index": "a7rvM", "typeName": "shape"}, {"x": 56, "y": 723, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2e", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Nomination committee", "marks": [{"type": "bold"}]}]}]}}, "index": "aF3UL", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3f", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.7", "marks": [{"type": "bold"}]}]}]}}, "index": "a1M46", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4h", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Three edges: product differentiation, competitive pricing (needs low cost), execution."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a775E", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-d", "type": "text", "parentId": "shape:ch07-a", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15"}]}]}}, "index": "a3jmQ", "typeName": "shape"}, {"x": 56, "y": 549, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1e", "type": "geo", "parentId": "shape:ch07-16", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false,