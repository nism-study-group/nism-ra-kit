}, "id": "shape:ch07-3a", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 261.3333333333333, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "More selling pressure", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price falls further"}]}]}}, "index": "alXnz", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4c", "type": "text", "parentId": "shape:ch07-4a", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All exam traps in this chapter"}]}]}}, "index": "a25n2", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-5d", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aHnSX", "typeName": "shape"}, {"x": 705.24236983842, "y": 455, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2a", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "At least "}, {"type": "text", "text": "50%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " independent if the chairman is an executive director; otherwise at least "}, {"type": "text", "text": "one third", "marks": [{"type": "bold"}]}]}]}}, "index": "aBi52", "typeName": "shape"}, {"x": 186.66666666666666, "y": 2312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3b", "type": "arrow", "parentId": "shape:ch07-1z", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 371.33333333333337, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "akqWc", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4d", "type": "text", "parentId": "shape:ch07-4a", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read these the night before. Each one is a question waiting to happen"}]}]}}, "index": "a36eM", "typeName": "shape"}, {"meta": {}, "id": "binding:VXr-ahiYw3oWe53xfbQPU", "type": "arrow", "fromId": "shape:ch07-3b", "toId": "shape:ch07-38", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1a", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Outside conditions keep changing. Each change opens opportunities for well-placed companies and creates threats for weak ones. The book's example: during Covid-19 lockdowns, companies with weak finances were extremely vulnerable, while financially strong ones survived."}]}]}}, "index": "a4OGA", "typeName": "shape"}, {"x": 56, "y": 589, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2b", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chairman separate from MD and CEO", "marks": [{"type": "bold"}]}]}]}}, "index": "aCG4M", "typeName": "shape"}, {"x": 558, "y": 2312, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3c", "type": "arrow", "parentId": "shape:ch07-1z", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 371.33333333333326, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "amViE", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4e", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " First question on the checklist: \"Do I understand the business?\""}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4k1n", "typeName": "shape"}, {"x": 0, "y": 1974.8000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-a", "type": "frame", "props": {"w": 1400, "h": 1012, "name": "7.2 The business and its model", "color": "black"}, "parentId": "page:page", "index": "a2Zdr", "typeName": "shape"}, {"x": 56, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1b", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SWOT", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = Strengths, Weaknesses, Opportunities, Threats. It helps judge both growth potential and risk tolerance."}]}]}}, "index": "a53Uy", "typeName": "shape"}, {"x": 225.41472172351885, "y": 589, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2c", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The CEO answers to the board, so should not chair it"}]}]}}, "index": "aDL9n", "typeName": "shape"}, {"x": 1084, "y": 2240, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3d", "type": "note", "parentId": "shape:ch07-1z", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Pledging by itself does "}, {"type": "text", "text": "not", "marks": [{"type": "bold"}]}, {"type": "text", "text": " signal a governance or business problem; it can be normal fund-raising. The risk is in the "}, {"type": "text", "text": "size", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the pledge."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "anthU", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4f", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Buffett: wide diversification is needed only when investors do not understand what they are doing."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5ukE", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 7: Company analysis: business and governance", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-b", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill"