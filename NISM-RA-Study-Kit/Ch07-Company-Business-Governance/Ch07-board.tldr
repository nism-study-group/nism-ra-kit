{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.group": 0, "com.tldraw.shape.text": 4, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.geo": 12, "com.tldraw.shape.note": 13, "com.tldraw.shape.line": 5, "com.tldraw.shape.frame": 1, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.embed": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"x": 56, "y": 512, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3k", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.8 Credit rating history"}]}]}}, "index": "a6niX", "typeName": "shape"}, {"x": 1040, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4l", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Agency risk comes from separating ownership and management."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBRsI", "typeName": "shape"}, {"name": "", "color": "#F04F88", "imageUrl": "", "meta": {}, "id": "user:I5Y9hmMK0Xt4RjzWg-ajj", "typeName": "user"}, {"x": 930.6666666666666, "y": 280, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-h", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How does it serve them?", "marks": [{"type": "bold"}]}]}]}}, "index": "a7jsb", "typeName": "shape"}, {"x": 56, "y": 1261, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1i", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Which side to start from?"}]}]}}, "index": "aCXgf", "typeName": "shape"}, {"x": 705.24236983842, "y": 833, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2j", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aKejb", "typeName": "shape"}, {"x": 56, "y": 587, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3l", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "credit rating", "marks": [{"type": "bold"}]}, {"type": "text", "text": " rates a borrower's ability to service its debt. Rating agencies rate both the "}, {"type": "text", "text": "issuer", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "individual debt", "marks": [{"type": "bold"}]}, {"type": "text", "text": " instruments, with separate ratings for short term and long term."}]}]}}, "index": "a7Pjn", "typeName": "shape"}, {"x": 56, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4m", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Integrity is almost impossible to judge, so analysts study governance structure."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCMO6", "typeName": "shape"}, {"x": 56, "y": 420, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-i", "type": "text", "parentId": "shape:ch07-a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The most prominent question on a research checklist: "}, {"type": "text", "text": "\"Do I understand the business?\"", "marks": [{"type": "bold"}]}, {"type": "text", "text": " If you cannot say what a company does in one clear line, do not move to the next question."}]}]}}, "index": "a8v9n", "typeName": "shape"}, {"x": 56, "y": 1336, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1j", "type": "geo", "parentId": "shape:ch07-16", "props": {"w": 490, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Approach 1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Strengths and weaknesses first", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Then find which opportunities they can exploit and which threats they expose. Suits a "}, {"type": "text", "text": "company deciding its strategy", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aDdgM", "typeName": "shape"}, {"x": 56, "y": 943, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2k", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Auditor rotation", "marks": [{"type": "bold"}]}]}]}}, "index": "aLpaI", "typeName": "shape"}, {"x": 56, "y": 677, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3m", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why equity investors care:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shareholders get returns only after lenders are paid. So the rating shows the financial risk and shapes the return investors should expect."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why history matters:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " rating reports list the agency's key concerns. If later reports show the company fixed them, management responds well to outside feedback."}]}]}]}]}}, "index": "a8CSE", "typeName": "shape"}, {"x": 384, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4n", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Concentrated decisions create key-man risk; succession plans ensure continuity."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aD8e6", "typeName": "shape"}, {"x": 56, "y": 510, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-j", "type": "text", "parentId": "shape:ch07-a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "India has over "}, {"type": "text", "text": "4,000", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " listed, active companies. No one can track them all. It is better to own a few companies you understand than many you do not. Warren Buffett, quoted in the book: "}, {"type": "text", "text": "\"Wide diversification is only required when investors do not understand what they are doing.\"", "marks": [{"type": "bold"}]}]}]}}, "index": "a9OVb", "typeName": "shape"}, {"x": 570, "y": 1336, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1k", "type": "geo", "parentId": "shape:ch07-16", "props": {"w": 490, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Approach 2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Opportunities and threats first", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Then find which strengths help and which weaknesses hurt. Suits an "}, {"type": "text", "text": "outside equity analyst", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and follows the E-I-C order (outside first, company last)."}]}]}}, "index": "aEwiz", "typeName": "shape"}, {"x": 225.41472172351885, "y": 943, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2l", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rotate once in "}, {"type": "text", "text": "five years", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", so anything hidden with an auditor's help can surface"}]}]}}, "index": "aMMTf", "typeName": "shape"}, {"x": 56, "y": 845, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3n", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.9 ESG"}]}]}}, "index": "a9FU7", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-50", "type": "text", "parentId": "shape:ch07-4x", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a3W76", "typeName": "shape"}, {"x": 712, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4o", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "11.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Board: 50% independent with an executive chairman, else one third. Audit committee: two thirds independent."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aEisX", "typeName": "shape"}, {"x": 56, "y": 632, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-k", "type": "text", "parentId": "shape:ch07-a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Each sector has its own yardsticks. The book's examples:"}]}]}}, "index": "aA0bf", "typeName": "shape"}, {"x": 1084, "y": 1336, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1l", "type": "note", "parentId": "shape:ch07-16", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "High customer concentration is a risk, but it is "}, {"type": "text", "text": "internal", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", so it is a "}, {"type": "text", "text": "weakness", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", not a threat. Threats come only from the external environment."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aFpU5", "typeName": "shape"}, {"x": 705.24236983842, "y": 943, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2m", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aNnfQ", "typeName": "shape"}, {"x": 56, "y": 920, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3o", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ESG", "marks": [{"type": "bold"}]}, {"type": "text", "text": " = Environment, Social and (corporate) Governance. First used by a few \"impact\" investors, it has spread because it also has commercial value. Investors ask:"}]}]}}, "index": "aAcef", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-51", "type": "note", "parentId": "shape:ch07-4x", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Describe a company you know in one clear line. Could everyone in the group do it?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4p4X", "typeName": "shape"}, {"x": 1040, "y": 987.4400000000023, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4p", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Auditor: fees below 10% of income; rotation once in five years."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aFWgv", "typeName": "shape"}, {"x": 56, "y": 690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-l", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 304, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Retail", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Footfalls, same-store sales (SSS)"}]}]}}, "index": "aBZSI", "typeName": "shape"}, {"x": 56, "y": 1715.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1m", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Focus on strengths and weaknesses that relate to the opportunities and threats. No self-driving car experience is a weakness for an Indian carmaker only if self-driving cars are about to take off."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A fall in revenue or profit is not a weakness unless it causes a vulnerability, such as losing a business opportunity or a loan."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Include only threats with a reasonable chance of happening. A list of every possible black swan, like Covid-19, would be too long to be useful."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Outsiders cannot see everything: no company discloses its government clout, and creative accounting can hide trouble."}]}]}]}]}}, "index": "aGOGz", "typeName": "shape"}, {"x": 56, "y": 1053, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2n", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Audit committee", "marks": [{"type": "bold"}]}]}]}}, "index": "aOtob", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1685, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-40", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Management interviews online"}]}]}}, "index": "aMm7X", "typeName": "shape"}, {"x": 56, "y": 1010, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3p", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "E", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "How does the company affect the environment? Low carbon emission and low pollution rank better."}]}]}}, "index": "aBJmj", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-52", "type": "note", "parentId": "shape:ch07-4x", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Which Indian brand do you think has real pricing power? What evidence would prove it?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5B2Q", "typeName": "shape"}, {"x": 56, "y": 1351.9199999999983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4q", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Remuneration committee: all non-executive, independent chairman."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGm7U", "typeName": "shape"}, {"x": 384, "y": 690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-m", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 304, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Banking", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Net interest income (NII), net interest margin (NIM)"}]}]}}, "index": "aCPtM", "typeName": "shape"}, {"x": 1540, "y": 3155.1999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1n", "type": "frame", "props": {"w": 1400, "h": 2310.4000000000087, "name": "7.6 Management and governance (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a5F36", "typeName": "shape"}, {"x": 56, "y": 1549, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-30", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.6.3 Promoter holdings"}]}]}}, "index": "abD3n", "typeName": "shape"}, {"x": 225.41472172351885, "y": 1053, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2o", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Entirely independent directors. Reviews accounts, nominates auditors"}]}]}}, "index": "aPXRI", "typeName": "shape"}, {"x": 56, "y": 1793, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-41", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company website"}]}]}}, "index": "aNoj2", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1010, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3q", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "S", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What does it do for social development: human rights, gender equality and so on?"}]}]}}, "index": "aCKXf", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-53", "type": "note", "parentId": "shape:ch07-4x", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Do a quick SWOT for an Indian airline, starting with opportunities and threats."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6yYj", "typeName": "shape"}, {"x": 384, "y": 1351.9199999999983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4r", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Related party transactions: placed before the audit committee; pre-approval not mandated."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHIpE", "typeName": "shape"}, {"x": 712, "y": 690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-n", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 304, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Telecom", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Average revenue per user (ARPU)"}]}]}}, "index": "aD3iU", "typeName": "shape"}, {"meta": {}, "id": "binding:iLRDJ6dVPE1FaAIz4HSdN", "type": "arrow", "fromId": "shape:ch07-3c", "toId": "shape:ch07-3a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-20", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1BPU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1o", "type": "geo", "parentId": "shape:ch07-1n", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.6", "marks": [{"type": "bold"}]}]}]}}, "index": "a1u0X", "typeName": "shape"}, {"x": 56, "y": 1624, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-31", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The idea of a \"promoter\" is somewhat unique to India. The law simply says a promoter is an investor named or identified as one. In practice, promoters are the founders or the controlling shareholder group."}]}]}}, "index": "acViM", "typeName": "shape"}, {"x": 705.24236983842, "y": 1053, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2p", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "At least "}, {"type": "text", "text": "two thirds", "marks": [{"type": "bold"}]}, {"type": "text", "text": " independent"}]}]}}, "index": "aQIUw", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1793, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-42", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ministry of Corporate Affairs website"}]}]}}, "index": "aOnoj", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1010, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3r", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "G", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "What corporate governance standards does it follow?"}]}]}}, "index": "aDP0M", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-54", "type": "note", "parentId": "shape:ch07-4x", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A promoter has pledged 60% of their shares. What would you check next?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7UvB", "typeName": "shape"}, {"x": 712, "y": 1351.9199999999983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4s", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Pledging is not a red flag by itself; a high pledge adds market risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aI3uQ", "typeName": "shape"}, {"x": 1040, "y": 690, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-o", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 304, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Hotels", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Average room tariffs"}]}]}}, "index": "aEUz7V", "typeName": "shape"}, {"x": 56, "y": 868, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-10", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "In every industry some players do better than others. The book groups the ways a company can stand out into three:"}]}]}}, "index": "aAnGA", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-21", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Management and governance"}]}]}}, "index": "a2m7j", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1p", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Management and governance"}]}]}}, "index": "a2Lur", "typeName": "shape"}, {"x": 56, "y": 1714, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-32", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Plus", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "More control over management, so management is more likely to act for shareholders."}]}]}}, "index": "admMM", "typeName": "shape"}, {"x": 56, "y": 1163, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2q", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Related party transactions", "marks": [{"type": "bold"}]}]}]}}, "index": "aRs2b", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1793, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-43", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Credit rating agency reports"}]}]}}, "index": "aPZzT", "typeName": "shape"}, {"x": 56, "y": 1210, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3s", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The ESG filter only "}, {"type": "text", "text": "shortlists", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". A shortlisted stock is not an automatic buy; all the usual analysis still follows."}]}]}}, "index": "aE5wn", "typeName": "shape"}, {"x": 56, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-55", "type": "note", "parentId": "shape:ch07-4x", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Would you buy a stock with a poor ESG score if everything else looked good? Why or why not?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8kUUV", "typeName": "shape"}, {"x": 1040, "y": 1351.9199999999983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4t", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Credit ratings: issuer and instrument level, short and long term. Matter to equity investors because lenders are paid first."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJhiz", "typeName": "shape"}, {"x": 56, "y": 860, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-p", "type": "text", "parentId": "shape:ch07-a", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Each company also has its own way of doing business, and how efficiently it makes and delivers its products drives its earnings. Management thinker Gary Hamel, quoted in the book: "}, {"type": "text", "text": "\"Competition in the marketplace is not between products and services but between the Business Models of the competing companies.\"", "marks": [{"type": "bold"}]}]}]}}, "index": "aFRBE", "typeName": "shape"}, {"x": 56, "y": 940, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-11", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Three ways to beat competitors"}]}]}}, "index": "aBUfR", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-22", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15  ·  Part 2 of 2"}]}]}}, "index": "a3ZCX", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1q", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15  ·  Part 1 of 2"}]}]}}, "index": "a35CX", "typeName": "shape"}, {"x": 712, "y": 1714, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-33", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Minus", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "They may push management into actions, such as related party transactions, that benefit them at minority shareholders' cost."}]}]}}, "index": "ae4kz", "typeName": "shape"}, {"x": 225.41472172351885, "y": 1163, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2r", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All material ones pre-approved by the audit committee"}]}]}}, "index": "aShwM", "typeName": "shape"}, {"x": 56, "y": 1901, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-44", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Other research and media reports"}]}]}}, "index": "aQUzDV", "typeName": "shape"}, {"x": 56, "y": 1268, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3t", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Financial advantages claimed for ESG companies:"}]}]}}, "index": "aFO8b", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-56", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7: Company analysis: business and governance"}]}]}}, "index": "aAlYX", "typeName": "shape"}, {"x": 56, "y": 1716.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4u", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ESG is a shortlist filter, not an automatic buy. Good governance lowers cost of capital."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKjJE", "typeName": "shape"}, {"x": 0, "y": 3126.8000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-q", "type": "frame", "props": {"w": 1400, "h": 1605, "name": "7.3 Pricing power", "color": "black"}, "parentId": "page:page", "index": "a3u66", "typeName": "shape"}, {"x": 56, "y": 1015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-12", "type": "geo", "parentId": "shape:ch07-q", "props": {"w": 318.6666666666667, "h": 534, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Product differentiation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Better quality or features for the target customer. Needs a strong R&D team and a culture of innovation. Leadership may keep shifting in fast-moving industries."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Check:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " compare products with data, not marketing claims."}]}]}}, "index": "aCQMA", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-23", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Nine governance checks"}]}]}}, "index": "a4tqv", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1r", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Shareholders own the company; a separate team (CEO or MD and those below) runs it day to day and reports to a board appointed by shareholders. This separation creates "}, {"type": "text", "text": "agency risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": managers may serve themselves, or may not be capable."}]}]}}, "index": "a4q6X", "typeName": "shape"}, {"x": 56, "y": 1914, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-34", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Track the promoters' stake and how it changes."}]}]}}, "index": "afeVU", "typeName": "shape"}, {"x": 705.24236983842, "y": 1163, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2s", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pre-approval not mandated; all must be "}, {"type": "text", "text": "placed before", "marks": [{"type": "bold"}]}, {"type": "text", "text": " the audit committee, with justification if not at arm's length"}]}]}}, "index": "aT3eE", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1901, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-45", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Parent company's annual report and website"}]}]}}, "index": "aRNGA", "typeName": "shape"}, {"x": 56, "y": 1326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3u", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. Environment focus: least disruption from regulation or environmental activism."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. Social causes: positive recall, easier hiring and customer attraction."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. Strong governance: lower risk perception, so "}, {"type": "text", "text": "lower cost of capital", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aGZm2", "typeName": "shape"}, {"x": 0, "y": 561, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-57", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 6 marks of 100  ·  Book pages 130 to 144  ·  About 40 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "aBkOA", "typeName": "shape"}, {"x": 384, "y": 1716.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4v", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " BRSR: top 1,000 listed companies from FY2023; 175+ reported voluntarily in FY22."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLnHQ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-r", "type": "geo", "parentId": "shape:ch07-q", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1rbv", "typeName": "shape"}, {"x": 398.6666666666667, "y": 1015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-13", "type": "geo", "parentId": "shape:ch07-q", "props": {"w": 318.6666666666667, "h": 534, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Competitive pricing", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Lower prices win when products look alike. Sustainable "}, {"type": "text", "text": "only with a low-cost advantage", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; otherwise rivals copy the price cut."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Check:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " easy for commodities. Harder elsewhere: a Toyota Camry and a Honda Civic are not like-for-like. Judge value for money through primary research or past models' performance."}]}]}}, "index": "aDxrQ", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-24", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What is ideal, and what SEBI requires, as per the book"}]}]}}, "index": "a5pg6", "typeName": "shape"}, {"x": 1084, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1s", "type": "note", "parentId": "shape:ch07-1n", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Competency and integrity", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The analyst must judge both. Competency is hard to judge. Integrity is almost impossible, and it is wrong to doubt anyone's integrity without reasonable evidence. So analysts look at the "}, {"type": "text", "text": "corporate governance structure", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": are the controls in place to prevent bad governance?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 336, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a5CYz", "typeName": "shape"}, {"x": 56, "y": 1986, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-35", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pledged shares"}]}]}}, "index": "ag346", "typeName": "shape"}, {"x": 56, "y": 1297, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2t", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Remuneration committee", "marks": [{"type": "bold"}]}]}]}}, "index": "aUjqr", "typeName": "shape"}, {"x": 930.6666666666666, "y": 1901, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-46", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Competitors' websites, including international ones"}]}]}}, "index": "aSPP6", "typeName": "shape"}, {"x": 56, "y": 1448, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3v", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SEBI named the "}, {"type": "text", "text": "top 1,000", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " listed companies to make ESG disclosures in the "}, {"type": "text", "text": "Business Responsibility and Sustainability Report (BRSR)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " format from "}, {"type": "text", "text": "FY2023", "marks": [{"type": "highlight"}]}, {"type": "text", "text": ". In FY22, more than "}, {"type": "text", "text": "175", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " companies reported on BRSR voluntarily."}]}]}}, "index": "aHZ2E", "typeName": "shape"}, {"x": 0, "y": 679.4, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-58", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Same industry, different results. Find out what the company does, why it can win, and who is minding the shop."}]}]}}, "index": "aCnJr", "typeName": "shape"}, {"x": 712, "y": 1716.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4w", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Annual and quarterly reports: most easily available, reliable and consistent source."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aM5sf", "typeName": "shape"}, {"x": 0, "y": 987.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3", "type": "frame", "props": {"w": 1400, "h": 847.2000000000007, "name": "7.1 Why study the company?", "color": "black"}, "parentId": "page:page", "index": "a1Inn", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-s", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pricing power"}]}]}}, "index": "a2brn", "typeName": "shape"}, {"x": 741.3333333333334, "y": 1015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-14", "type": "geo", "parentId": "shape:ch07-q", "props": {"w": 318.6666666666667, "h": 534, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Better execution", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Better communication with customers, a focused sales strategy."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Check:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " the past track record of the company and its management. Book examples: Flipkart, Airtel, Haldiram, Hero MotoCorp, through branding, advertising, alliances and positioning across India."}]}]}}, "index": "aEHCA", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-25", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Check", "marks": [{"type": "bold"}]}]}]}}, "index": "a6rh2", "typeName": "shape"}, {"x": 1084, "y": 944.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1t", "type": "note", "parentId": "shape:ch07-1n", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Hiring a manager to run your shop while you are away. You cannot read their mind, so you check their record, and you set rules: a second signature on cheques, an outside accountant, a lock on the cash box."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a6Zu6", "typeName": "shape"}, {"x": 56, "y": 2061, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-36", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Promoters needing money may "}, {"type": "text", "text": "pledge", "marks": [{"type": "bold"}]}, {"type": "text", "text": " shares rather than sell. The lender applies a "}, {"type": "text", "text": "haircut", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (lends less than the market value) so the collateral still covers the loan if the price falls somewhat."}]}]}}, "index": "ahIDj", "typeName": "shape"}, {"x": 225.41472172351885, "y": 1297, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2u", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Entirely independent directors. Sets pay of directors and senior management"}]}]}}, "index": "aVvtA", "typeName": "shape"}, {"x": 56, "y": 2039, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-47", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Print media reports"}]}]}}, "index": "aTGUg", "typeName": "shape"}, {"x": 56, "y": 1552, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3w", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.10 Sources of information"}]}]}}, "index": "aIian", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-59", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aDhWU", "typeName": "shape"}, {"x": 6160, "y": 3203.999999999994, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4x", "type": "frame", "props": {"w": 1400, "h": 910, "name": "For the group discussion", "color": "black"}, "parentId": "page:page", "index": "a9kxU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4", "type": "geo", "parentId": "shape:ch07-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a146I", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-t", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15"}]}]}}, "index": "a3Ta6", "typeName": "shape"}, {"x": 1084, "y": 1015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-15", "type": "note", "parentId": "shape:ch07-q", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Low prices are a lasting advantage only if the company also has "}, {"type": "text", "text": "lower costs", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Otherwise competitors simply match the price."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aFF6j", "typeName": "shape"}, {"x": 225.41472172351885, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-26", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ideal", "marks": [{"type": "bold"}]}]}]}}, "index": "a7Vmf", "typeName": "shape"}, {"x": 56, "y": 1494.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1u", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.6.1 Ten questions on management competency"}]}]}}, "index": "a7hvj", "typeName": "shape"}, {"x": 56, "y": 2165, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-37", "type": "text", "parentId": "shape:ch07-1z", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why a high pledge is a risk"}]}]}}, "index": "aiIwA", "typeName": "shape"}, {"x": 705.24236983842, "y": 1297, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2v", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All members "}, {"type": "text", "text": "non-executive", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; chairman "}, {"type": "text", "text": "independent", "marks": [{"type": "bold"}]}]}]}}, "index": "aWZdE", "typeName": "shape"}, {"x": 493.3333333333333, "y": 2039, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-48", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Talks with suppliers, vendors, consumers, competitors"}]}]}}, "index": "aUfUm", "typeName": "shape"}, {"x": 56, "y": 1627, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3x", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Annual and quarterly reports are the most easily available, reliable and consistent source. Others:"}]}]}}, "index": "aJ8hI", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4y", "type": "geo", "parentId": "shape:ch07-4x", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "?", "marks": [{"type": "bold"}]}]}]}}, "index": "a16Av", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-5", "type": "text", "parentId": "shape:ch07-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why study the company?"}]}]}}, "index": "a22Cr", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-u", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pricing power", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is a company's ability to set and charge its own price. With it, a company can pass on rising input costs to customers, and raise prices when demand is strong, so margins hold and grow."}]}]}}, "index": "a4kpU", "typeName": "shape"}, {"x": 1540, "y": 987.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-16", "type": "frame", "props": {"w": 1400, "h": 2027.5999999999985, "name": "7.5 SWOT analysis", "color": "black"}, "parentId": "page:page", "index": "a4PE2", "typeName": "shape"}, {"x": 705.24236983842, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-27", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SEBI requirement (book)", "marks": [{"type": "bold"}]}]}]}}, "index": "a8sFX", "typeName": "shape"}, {"x": 56, "y": 1569.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1v", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. "}, {"type": "text", "text": "Education", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in the relevant field? Often checked, but not conclusive."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. "}, {"type": "text", "text": "Years of experience?", "marks": [{"type": "bold"}]}, {"type": "text", "text": " More experience means more past challenges handled."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. "}, {"type": "text", "text": "Track record", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in senior roles elsewhere? Useful, though results depend on other factors too."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. "}, {"type": "text", "text": "Tenure here", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and how the company did under them? Long, successful tenure makes repeat performance more likely."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. "}, {"type": "text", "text": "Vision", "marks": [{"type": "bold"}]}, {"type": "text", "text": " on long-term goals and strategic direction? They need not reveal every strategy to rivals."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "6. Experience in executing the "}, {"type": "text", "text": "current", "marks": [{"type": "bold"}]}, {"type": "text", "text": " strategy? An innovation strategy needs someone who has led research."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "7. Do they give "}, {"type": "text", "text": "guidance", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and meet it? Consistently meeting guidance shows control of the business."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "8. Timely "}, {"type": "text", "text": "regulatory compliance", "marks": [{"type": "bold"}]}, {"type": "text", "text": "? Failure suggests loss of control, and is a red flag on integrity."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "9. Enough "}, {"type": "text", "text": "delegation", "marks": [{"type": "bold"}]}, {"type": "text", "text": "? Concentrated decisions create "}, {"type": "text", "text": "key-man risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "10. A "}, {"type": "text", "text": "succession plan", "marks": [{"type": "bold"}]}, {"type": "text", "text": "? Ensures continuity if top managers leave."}]}]}}, "index": "a8cgQ", "typeName": "shape"}, {"x": 56, "y": 2240, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-38", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 261.3333333333333, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Share price falls", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Lender's margin shrinks or disappears"}]}]}}, "index": "aj57z", "typeName": "shape"}, {"x": 56, "y": 1407, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2w", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Independent directors' pay", "marks": [{"type": "bold"}]}]}]}}, "index": "aXo8j", "typeName": "shape"}, {"x": 930.6666666666666, "y": 2039, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-49", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "BRSR report for ESG disclosures"}]}]}}, "index": "aV9qE", "typeName": "shape"}, {"x": 56, "y": 1685, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3y", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Conference call transcripts"}]}]}}, "index": "aKOjr", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4z", "type": "text", "parentId": "shape:ch07-4x", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a2e8n", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-6", "type": "text", "parentId": "shape:ch07-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15"}]}]}}, "index": "a31nr", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-v", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Where pricing power comes from"}]}]}}, "index": "a5aWn", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-17", "type": "geo", "parentId": "shape:ch07-16", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.5", "marks": [{"type": "bold"}]}]}]}}, "index": "a1U0e", "typeName": "shape"}, {"x": 56, "y": 455, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-28", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Board composition", "marks": [{"type": "bold"}]}]}]}}, "index": "a9hKA", "typeName": "shape"}, {"x": 56, "y": 1961.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1w", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.6.2 Corporate governance"}]}]}}, "index": "a9Xlj", "typeName": "shape"}, {"x": 427.3333333333333, "y": 2240, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-39", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 261.3333333333333, "h": 144, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Lender sells pledged shares", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Forced liquidation"}]}]}}, "index": "ak9G2", "typeName": "shape"}, {"x": 225.41472172351885, "y": 1407, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2x", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All income from the company fully disclosed, so independence can be judged"}]}]}}, "index": "aYI4b", "typeName": "shape"}, {"x": 493.3333333333333, "y": 1685, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3z", "type": "geo", "parentId": "shape:ch07-3e", "props": {"w": 413.3333333333333, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investor relations presentations"}]}]}}, "index": "aL7Tz", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-7", "type": "text", "parentId": "shape:ch07-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A company is a small unit in its industry and its economy, so outside forces shape its fortunes (Chapters 5 and 6). But how well each company does also depends on "}, {"type": "text", "text": "company-specific", "marks": [{"type": "bold"}]}, {"type": "text", "text": " factors. Once the economy and industry are understood, the analyst asks:"}]}]}}, "index": "a4d5I", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-w", "type": "text", "parentId": "shape:ch07-q", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mostly the industry, partly the company"}]}]}}, "index": "a6QMn", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-18", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SWOT analysis"}]}]}}, "index": "a2K5f", "typeName": "shape"}, {"x": 225.41472172351885, "y": 455, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-29", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Majority independent directors"}]}]}}, "index": "aAAwz", "typeName": "shape"}, {"x": 56, "y": 2036.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1x", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Corporate governance", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the rules, processes and procedures for managing and running a firm, so that it takes care of all stakeholders: shareholders, lenders, employees, suppliers and customers. Regulation focuses on protecting investors, especially "}, {"type": "text", "text": "minority", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (non-promoter) shareholders. As per the book, SEBI's Clause 49 of the listing agreement sets the standards in India."}]}]}}, "index": "aA6zu", "typeName": "shape"}, {"x": 705.24236983842, "y": 1407, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2y", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aZIUg", "typeName": "shape"}, {"x": 56, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-8", "type": "text", "parentId": "shape:ch07-3", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1. What is the company's business? (This decides the industry, as in 6.2.)"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "2. What is its business model?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "3. Does it have a competitive advantage over rivals?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "4. Can it exploit opportunities and withstand threats?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "5. Is management competent to pick and execute the right strategy?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "6. Does management have a vision, and does it give visibility on short-term performance and long-term goals?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "7. Is there a governance structure so that the board and management act for the company and its shareholders?"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "8. Is that structure actually implemented?"}]}]}}, "index": "a5IOv", "typeName": "shape"}, {"x": 56, "y": 459, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-x", "type": "geo", "parentId": "shape:ch07-q", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Industry factors (affect all players)", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Intensity of competition"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price elasticity of the product"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How commoditised the product is"}]}]}]}]}}, "index": "a7xYj", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-19", "type": "text", "parentId": "shape:ch07-16", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15"}]}]}}, "index": "a3uIj", "typeName": "shape"}, {"x": 56, "y": 2190.4000000000087, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1y", "type": "text", "parentId": "shape:ch07-1n", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulatory standards are the "}, {"type": "text", "text": "minimum", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Strong governance prevents agency risk, or at least catches and fixes it in time."}]}]}}, "index": "aBknv", "typeName": "shape"}, {"x": 1084, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2z", "type": "note", "parentId": "shape:ch07-1z", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Watch the fractions. Board: "}, {"type": "text", "text": "50%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " independent with an executive chairman, else "}, {"type": "text", "text": "one third", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Audit committee: "}, {"type": "text", "text": "two thirds", "marks": [{"type": "bold"}]}, {"type": "text", "text": " independent. Remuneration committee: all "}, {"type": "text", "text": "non-executive", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", chaired by an "}, {"type": "text", "text": "independent", "marks": [{"type": "bold"}]}, {"type": "text", "text": " director."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aaRyv", "typeName": "shape"}, {"x": 1084, "y": 344, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-9", "type": "note", "parentId": "shape:ch07-3", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Go deep", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Each answer raises follow-up questions. Do not accept surface answers. Many of these questions are qualitative, but analysts should still find data that backs up their findings."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a6PAI", "typeName": "shape"}, {"x": 712, "y": 459, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-y", "type": "geo", "parentId": "shape:ch07-q", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company factors (set it apart)", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Natural leadership:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " smaller petrochemical makers price off "}, {"type": "text", "text": "Reliance Industries (RIL)", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", so RIL can set its own prices"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Brand:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " strong brand loyalty lets a company price independently"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Low cost base:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " it can keep prices low; higher-cost rivals cannot afford to follow"}]}]}]}]}}, "index": "a8f8A", "typeName": "shape"}, {"x": 3080, "y": 987.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1z", "type": "frame", "props": {"w": 1400, "h": 2618.399999999994, "name": "7.6 Management and governance (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a6Lhz", "typeName": "shape"}, {"meta": {}, "id