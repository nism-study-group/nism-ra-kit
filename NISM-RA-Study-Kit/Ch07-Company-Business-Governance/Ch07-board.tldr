graph", "content": [{"type": "text", "text": "Internal", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Weaknesses", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Weak financial position"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "High fixed cost"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Low margins that can turn negative in a slowdown"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "High customer concentration"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Big legal cases"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No experience with a strategy or environment"}]}]}]}]}}, "index": "a9mtA", "typeName": "shape"}, {"x": 705.24236983842, "y": 723, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2g", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 354.75763016157987, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aHHZ6", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3h", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 7 of 15"}]}]}}, "index": "a3asz", "typeName": "shape"}, {"x": 384, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4j", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " High customer concentration is a weakness, not a threat."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9kfX", "typeName": "shape"}, {"x": 56, "y": 280, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-f", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What does it do, and how?", "marks": [{"type": "bold"}]}]}]}}, "index": "a5x9r", "typeName": "shape"}, {"x": 56, "y": 867, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1g", "type": "geo", "parentId": "shape:ch07-16", "props": {"w": 632, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "External", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Opportunities", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Events that speed growth: new battery technology for EVs; firms moving production out of China after Covid-19"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "New business from technology or regulation: Companies Act 2013 work for consultants; Y2K for Indian IT; ESG compliance"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "New geographies opening up"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Consolidation in bad times: Jet Airways stopped flying in April 2019, so rivals gained share"}]}]}]}]}}, "index": "aAkMU", "typeName": "shape"}, {"x": 56, "y": 833, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2h", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 161.41472172351885, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Auditor independence", "marks": [{"type": "bold"}]}]}]}}, "index": "aIHqv", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3i", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Promoters love to talk about the grand future, rarely about the risks. Cheap foreign borrowing looks attractive until you add "}, {"type": "text", "text": "currency risk", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Entrepreneurs can absorb shocks (the book mentions Rupert Murdoch failing three times before building the Star empire, and Steve Jobs being thrown out of Apple and later called back), but not all investors can."}]}]}}, "index": "a4yUg", "typeName": "shape"}, {"x": 712, "y": 586.4799999999959, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-4k", "type": "note", "parentId": "shape:ch07-4a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " SWOT approach 1 (S and W first) suits companies setting strategy; approach 2 (O and T first) suits outside analysts and the E-I-C order."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAdvj", "typeName": "shape"}, {"x": 493.3333333333333, "y": 280, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-g", "type": "geo", "parentId": "shape:ch07-a", "props": {"w": 413.3333333333333, "h": 114, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Who are the customers, and why do they buy?", "marks": [{"type": "bold"}]}]}]}}, "index": "a6YJQ", "typeName": "shape"}, {"x": 712, "y": 867, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-1h", "type": "geo", "parentId": "shape:ch07-16", "props": {"w": 632, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "External", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Threats", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Economic recession"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulatory headwinds: a possible ban on single-use plastics"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technology disruption: AI threatens BPOs doing repetitive tasks"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Deregulation: RBI's on-tap bank licences raise competition for existing banks"}]}]}]}]}}, "index": "aBUvq", "typeName": "shape"}, {"x": 225.41472172351885, "y": 833, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-2i", "type": "geo", "parentId": "shape:ch07-1z", "props": {"w": 471.8276481149012, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fees from the company or group below "}, {"type": "text", "text": "10%", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the auditor's total income"}]}]}}, "index": "aJs82", "typeName": "shape"}, {"x": 56, "y": 376, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch07-3j", "type": "text", "parentId": "shape:ch07-3e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Keep asking "}, {"type": "text", "text": "\"What could go wrong in the business?\"", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Promoters who say nothing can go wrong are \"people who don't know that they don't know\". Avoid them. A good businessperson knows the risks and how to guard against them."}]}]}}, "index": "a5PYz", "typeName": "shape"}]}