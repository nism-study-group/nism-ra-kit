}]}]}]}]}}, "index": "aX97n", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-21", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1CDU", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1p", "type": "geo", "parentId": "shape:ch14-1o", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1URg", "typeName": "shape"}, {"x": 1084, "y": 1988, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-32", "type": "note", "parentId": "shape:ch14-20", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Operational creditors can "}, {"type": "text", "text": "start", "marks": [{"type": "bold"}]}, {"type": "text", "text": " insolvency proceedings but "}, {"type": "text", "text": "cannot sit", "marks": [{"type": "bold"}]}, {"type": "text", "text": " on the committee of creditors. A financial creditor is one paid for the time value of money (earns interest)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 144, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aakX2", "typeName": "shape"}, {"x": 56, "y": 1604, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2q", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Book footnotes: persons doing sales and other non-core research services need NISM Series XXV-A; SEBI moved RA compliance reporting to BSE Ltd."}]}]}}, "index": "aQalv", "typeName": "shape"}, {"x": 954.5116279069767, "y": 1069, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-43", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 389.48837209302326, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Research entity acting as underwriter"}]}]}}, "index": "aMbTM", "typeName": "shape"}, {"x": 954.5116279069767, "y": 677, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3r", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 389.48837209302326, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Applies to", "marks": [{"type": "bold"}]}]}]}}, "index": "aAfIr", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-54", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14 of 15"}]}]}}, "index": "a3dav", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4s", "type": "text", "parentId": "shape:ch14-4o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Some traders use unscrupulous practices that distort prices. SEBI and the exchanges watch stocks against objective criteria and impose extra restrictions."}]}]}}, "index": "a4Vyj", "typeName": "shape"}, {"x": 56, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-65", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " IOSCO principles on analyst conflicts: September 2003."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aGUYD", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5t", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " SEBI was set up under section 3 of the SEBI Act, 1992; merged with the FMC on 28 September 2015."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4atX", "typeName": "shape"}, {"x": 5680, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6u", "type": "note", "parentId": "page:page", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A point the exam likes to twist"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aF5tn", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-7", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulators make sure market participants behave responsibly, so the market keeps financing companies and government, and investors are protected. Their shared aim: a "}, {"type": "text", "text": "fair and competitive", "marks": [{"type": "bold"}]}, {"type": "text", "text": " marketplace with high service standards."}]}]}}, "index": "a48zUV", "typeName": "shape"}, {"x": 273.8144329896908, "y": 1261, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-w", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 275.38144329896915, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Insolvency and Bankruptcy Code, 2016"}]}]}}, "index": "aTN4b", "typeName": "shape"}, {"meta": {}, "id": "binding:D64gYw6u4ly8yF-ElTRxm", "type": "arrow", "fromId": "shape:ch14-5m", "toId": "shape:ch14-5i", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 1084, "y": 1568, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-11", "type": "note", "parentId": "shape:ch14-3", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Preambles worth knowing", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "RBI: \"to regulate the issue of Bank Notes and keeping of reserves with a view to securing monetary stability in India and generally to operate the currency and credit system of the country to its advantage.\" SEBI: \"to protect the interests of investors in securities and to promote the development of, and to regulate the securities market.\""}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 432, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aYOg2", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-22", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The key laws"}]}]}}, "index": "a2fTE", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1q", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The key laws"}]}]}}, "index": "a2Fvr", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-33", "type": "frame", "props": {"w": 1400, "h": 857, "name": "14.3 Code of conduct for research analysts", "color": "black"}, "parentId": "page:page", "index": "a5a0I", "typeName": "shape"}, {"x": 56, "y": 1708, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2r", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2.6 Insolvency and Bankruptcy Code, 2016"}]}]}}, "index": "aRD5A", "typeName": "shape"}, {"x": 56, "y": 1155, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-44", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 446.1860465116279, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Around a lock-up agreement (reg 18(3))", "marks": [{"type": "bold"}]}]}]}}, "index": "aNHTv", "typeName": "shape"}, {"x": 56, "y": 763, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3s", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 446.1860465116279, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No trading in a recommended or followed security (reg 16(2))", "marks": [{"type": "bold"}]}]}]}}, "index": "aBhVf", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-55", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SEBI's "}, {"type": "text", "text": "Investor Charter for Research Analysts", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (Annexure 1 of the book) puts in one place the services, investors' rights, do's and don'ts and grievance timelines. RAs must share it: on their website and app, at their office, during onboarding, and by email or letter. RAs must also publish "}, {"type": "text", "text": "monthly complaint data", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", including SCORES complaints, in SEBI's format (Annexure 2); those without a website email it to investors."}]}]}}, "index": "a4SnE", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4t", "type": "text", "parentId": "shape:ch14-4o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "GSM versus ASM"}]}]}}, "index": "a5rHQ", "typeName": "shape"}, {"x": 384, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-66", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " RA qualification: graduate or CFA Charter plus NISM certification, or NISM's PG Program in Securities Market (Research Analysis)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aHcEE", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5u", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " MoF's Department of Economic Affairs prepares the Union Budget; Department of Revenue works through CBDT and CBEC."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5C6j", "typeName": "shape"}, {"x": 6160, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6v", "type": "note", "parentId": "page:page", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An everyday picture of the idea"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aGXEE", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-8", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Who regulates what"}]}]}}, "index": "a5tDz", "typeName": "shape"}, {"x": 557.19587628866, "y": 1261, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-x", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 786.8041237113403, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Oversees insolvency processes and insolvency professionals; rules on corporate and individual insolvency; also the authority for valuers"}]}]}}, "index": "aUU9UV", "typeName": "shape"}, {"meta": {}, "id": "binding:5ZZ_5L9ZUylwOUG9yDHD1", "type": "arrow", "fromId": "shape:ch14-31", "toId": "shape:ch14-2y", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 2429.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-12", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "SEBI's main functions"}]}]}}, "index": "aZfVr", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-23", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14 of 15  ·  Part 3 of 3"}]}]}}, "index": "a31LU", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1r", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14 of 15  ·  Part 2 of 3"}]}]}}, "index": "a3uYX", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-34", "type": "geo", "parentId": "shape:ch14-33", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1OQb", "typeName": "shape"}, {"x": 56, "y": 1783, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2s", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Consolidates insolvency laws for companies, partnership firms and individuals, with "}, {"type": "text", "text": "time-bound", "marks": [{"type": "bold"}]}, {"type": "text", "text": " resolution."}]}]}}, "index": "aSwoI", "typeName": "shape"}, {"x": 510.1860465116279, "y": 1155, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-45", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 436.3255813953488, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15 days before", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "15 days after", "marks": [{"type": "bold"}]}, {"type": "text", "text": " its expiry, waiver or termination"}]}]}}, "index": "aOwH6", "typeName": "shape"}, {"x": 510.1860465116279, "y": 763, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3t", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 436.3255813953488, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "30 days before", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "5 days after", "marks": [{"type": "bold"}]}, {"type": "text", "text": " publication of a report"}]}]}}, "index": "aCjGr", "typeName": "shape"}, {"x": 56, "y": 376, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-56", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The monthly table splits complaints by source: "}, {"type": "text", "text": "directly from investors", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", "}, {"type": "text", "text": "SEBI (SCORES)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "other sources", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". For each it shows: pending at the end of last month, received, resolved, total pending, pending for "}, {"type": "text", "text": "more than 3 months", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", and "}, {"type": "text", "text": "average resolution time", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in days (total days taken ÷ complaints resolved that month). Complaints caused by someone "}, {"type": "text", "text": "impersonating", "marks": [{"type": "bold"}]}, {"type": "text", "text": " the RA are reported separately and may be left out of the totals. RAs also show a month-by-month and a year-by-year trend of complaints received and resolved."}]}]}}, "index": "a5GZU", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4u", "type": "geo", "parentId": "shape:ch14-4o", "props": {"w": 632, "h": 474, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Graded Surveillance Measures", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Based on valuation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Stocks with low market cap or net worth whose "}, {"type": "text", "text": "valuation is not justified by fundamentals", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Criteria (book): net worth up to Rs 10 crore and net fixed assets up to Rs 25 crore, with negative P/E or P/E at 2x the benchmark index; or market cap below Rs 25 crore with P/E above 2x the benchmark, or negative P/E with negative P/B or P/B at 2x the benchmark"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measures: trade-for-trade (delivery only), surveillance deposit, narrower price band, higher margin, freeze on upside price"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Not applied to PSUs, index stocks, recent IPOs, F&O stocks and others listed in the book"}]}]}]}]}}, "index": "a6jsX", "typeName": "shape"}, {"x": 712, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-67", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Form B for an RA, Form C for a part-time RA. Registration valid until suspended or cancelled."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aI7P2", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5v", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " MCA administers the Companies Act and the Competition Act 2002 (which replaced MRTP 1969)."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a61Zz", "typeName": "shape"}, {"x": 6640, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6w", "type": "note", "parentId": "page:page", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "WHY IT MATTERS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The reason behind a rule"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aHZVz", "typeName": "shape"}, {"x": 56, "y": 433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-9", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "As described in the book"}]}]}}, "index": "a69m2", "typeName": "shape"}, {"x": 56, "y": 1389, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-y", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The official syllabus also lists WDRA (Warehouse Development Regulatory Authority), but the book's chapter does not describe it."}]}]}}, "index": "aVWsE", "typeName": "shape"}, {"meta": {}, "id": "binding:ovxO0lc0XatHM_dLfiEeD", "type": "arrow", "fromId": "shape:ch14-5l", "toId": "shape:ch14-5g", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 2504.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-13", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Protect investors; develop and regulate the securities market and stock exchanges"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Register and regulate brokers, sub-brokers and other intermediaries; promote and regulate self-regulatory organisations"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investor education and training of intermediaries"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Prohibit insider trading and fraudulent and unfair trade practices"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulate substantial acquisition of shares and takeovers"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Call for information, inspect, inquire and audit exchanges, intermediaries, SROs, mutual funds and others"}]}]}]}]}}, "index": "aa4vM", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-24", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2.5 SEBI (Research Analyst) Regulations, 2014"}]}]}}, "index": "a4rKb", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1s", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2.4 Prohibition of Fraudulent and Unfair Trade Practices (PFUTP) Regulations, 2003"}]}]}}, "index": "a4D7M", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-35", "type": "text", "parentId": "shape:ch14-33", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Code of conduct for research analysts"}]}]}}, "index": "a2FIr", "typeName": "shape"}, {"x": 56, "y": 1855, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2t", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How a corporate insolvency runs under the IBC"}]}]}}, "index": "aT06r", "typeName": "shape"}, {"x": 954.5116279069767, "y": 1155, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-46", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 389.48837209302326, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Manager or co-manager of the offering"}]}]}}, "index": "aPB0b", "typeName": "shape"}, {"x": 954.5116279069767, "y": 763, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3u", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 389.48837209302326, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Independent and part-time RAs, employed analysts and their associates"}]}]}}, "index": "aDx06", "typeName": "shape"}, {"x": 56, "y": 576, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-57", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The Investor Charter in brief"}]}]}}, "index": "a6MlI", "typeName": "shape"}, {"x": 712, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4v", "type": "geo", "parentId": "shape:ch14-4o", "props": {"w": 632, "h": 474, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Additional Surveillance Measures", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Based on price and volume", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "High-low price variation over 3 months; close-to-close variation over 1 month, 60 days and 365 days"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Client concentration", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": share of volume by the "}, {"type": "text", "text": "top 25 clients", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Volume variation over time"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Once shortlisted: margin raised to "}, {"type": "text", "text": "80%", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", then tighter price bands and margin up to "}, {"type": "text", "text": "100%", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Not applied to: stocks already in GSM, trade-for-trade stocks, F&O stocks, PSUs"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reviewed after a minimum period; removed if criteria no longer met"}]}]}]}]}}, "index": "a7Cpr", "typeName": "shape"}, {"x": 1040, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-68", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " No trading 30 days before and 5 days after a report; never contrary to one's own recommendation."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJvTb", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5w", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " RBI administers FEMA 1999 and is banker to government and banks."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a75zR", "typeName": "shape"}, {"x": 7120, "y": 20, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6x", "type": "note", "parentId": "page:page", "props": {"color": "yellow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "REMEMBER", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A number or date to learn. "}, {"type": "text", "text": "Highlighted", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " text means the same."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 2.2, "textLastEditedBy": null}, "index": "aI8Ff", "typeName": "shape"}, {"x": 56, "y": 1493, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-z", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The five departments of the Ministry of Finance"}]}]}}, "index": "aWt2X", "typeName": "shape"}, {"meta": {}, "id": "binding:nhcOue7DFuGn1p7cCRZ2O", "type": "arrow", "fromId": "shape:ch14-2z", "toId": "shape:ch14-2w", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 2754.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-14", "type": "text", "parentId": "shape:ch14-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For commodities, SEBI monitors forward markets, advises the government on recognising associations, and sets open position limits, circuit filters, margins and physical delivery rules."}]}]}}, "index": "ab0NQ", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-25", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analysts' advice can be distorted by conflicts of interest. Regulators worldwide responded; the "}, {"type": "text", "text": "IOSCO", "marks": [{"type": "bold"}]}, {"type": "text", "text": " report of "}, {"type": "text", "text": "September 2003", "marks": [{"type": "bold"}]}, {"type": "text", "text": " set principles: analysts' own trading and their firms' business must not prejudice research; reporting lines and pay should limit conflicts; firms need written procedures; undue influence of issuers and investors must be managed; disclosures must be complete, timely, clear and prominent; high integrity; investor education. India's RA Regulations followed."}]}]}}, "index": "a5SCE", "typeName": "shape"}, {"x": 56, "y": 360, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1t", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Also made under "}, {"type": "text", "text": "section 30", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the SEBI Act. "}, {"type": "text", "text": "Fraud", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (Regulation 2(1)(c)) includes any act, expression, omission or concealment to induce someone to deal in securities. Whether anyone gains or avoids a loss "}, {"type": "text", "text": "does not matter", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Examples: wilful misrepresentation; false suggestion; active concealment; a promise made with no intention to keep it; reckless representation; false statements without reasonable grounds; an issuer's misinformation that moves the price."}]}]}}, "index": "a5HFM", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-36", "type": "text", "parentId": "shape:ch14-33", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14 of 15"}]}]}}, "index": "a3zcUV", "typeName": "shape"}, {"x": 56, "y": 1930, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2u", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "As described in the book"}]}]}}, "index": "aUPxX", "typeName": "shape"}, {"x": 56, "y": 1283, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-47", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The 40, 10 and 15-day windows can be relaxed with prior written approval of legal or compliance staff. The 30/5-day trading ban can be relaxed for significant news or an unexpected change in the analyst's personal finances, with prior written approval."}]}]}}, "index": "aQIkE", "typeName": "shape"}, {"x": 56, "y": 873, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3v", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 446.1860465116279, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No report or public appearance after an IPO the RA managed (reg 18(1))", "marks": [{"type": "bold"}]}]}]}}, "index": "aEmIA", "typeName": "shape"}, {"x": 56, "y": 651, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-58", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Annexure 1 of the book"}]}]}}, "index": "a7Niv", "typeName": "shape"}, {"x": 56, "y": 915, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4w", "type": "text", "parentId": "shape:ch14-4o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The advertisement code for RAs and IAs"}]}]}}, "index": "a8Ivn", "typeName": "shape"}, {"x": 56, "y": 1752.8800000000047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-69", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Quiet periods: 40 days after IPO pricing, 10 days after FPO pricing, 25 days for an IPO underwriter, 15 days either side of a lock-up end."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKkuA", "typeName": "shape"}, {"x": 56, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5x", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " PFRDA: PFRDA Act 2013, constituted October 2003; promotes old age income security; runs NPS."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8WSM", "typeName": "shape"}, {"x": 5680, "y": 500.00000000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6y", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 1342.857142857143, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.4, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Frames read top to bottom, then left to right. Zoom into one frame at a time."}]}]}}, "index": "aJyxv", "typeName": "shape"}, {"x": 0, "y": 3803.1999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-15", "type": "frame", "props": {"w": 1400, "h": 3573.600000000006, "name": "14.2 The key laws (1 of 3)", "color": "black"}, "parentId": "page:page", "index": "a2c7E", "typeName": "shape"}, {"x": 56, "y": 511, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-26", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Registration rules at a glance"}]}]}}, "index": "a6psA", "typeName": "shape"}, {"x": 56, "y": 560, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1u", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Deemed manipulative, fraudulent or unfair (selected)"}]}]}}, "index": "a6ugr", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-37", "type": "text", "parentId": "shape:ch14-33", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Set out in the "}, {"type": "text", "text": "Third Schedule", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the RA Regulations."}]}]}}, "index": "a4112", "typeName": "shape"}, {"x": 56, "y": 1988, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2v", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 168.5, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Application", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Any financial or operational creditor (or the company itself) on default. Threshold in the book: undisputed dues above Rs 1,00,000"}]}]}}, "index": "aVVa2", "typeName": "shape"}, {"x": 56, "y": 1419, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-48", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "More limits under regulation 16"}]}]}}, "index": "aRLVz", "typeName": "shape"}, {"x": 510.1860465116279, "y": 873, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3w", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 436.3255813953488, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "40 days", "marks": [{"type": "bold"}]}, {"type": "text", "text": " after pricing"}]}]}}, "index": "aFr5Q", "typeName": "shape"}, {"x": 56, "y": 709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-59", "type": "geo", "parentId": "shape:ch14-51", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Grievance route", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Approach the RA: redress within "}, {"type": "text", "text": "21 days", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Then "}, {"type": "text", "text": "SCORES 2.0", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (SEBI's online system) or email the RAASB. Two-level review: first RAASB, then SEBI"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Still unhappy: "}, {"type": "text", "text": "SMART ODR", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for online conciliation or arbitration"}]}]}]}]}}, "index": "a8cSj", "typeName": "shape"}, {"x": 56, "y": 990, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4x", "type": "text", "parentId": "shape:ch14-4o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "\"Advertisement\" covers all communications that may influence investment decisions, in any medium, print, electronic, social media or audio-visual. A research report counts as an advertisement if it promotes the RA's products or services."}]}]}}, "index": "a9ezm", "typeName": "shape"}, {"x": 384, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5y", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " IBBI: under IBC 2016; also regulates valuers."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a9j7z", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-16", "type": "geo", "parentId": "shape:ch14-15", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2", "marks": [{"type": "bold"}]}]}]}}, "index": "a1xSM", "typeName": "shape"}, {"x": 56, "y": 586, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-27", "type": "text", "parentId": "shape:ch14-20", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulations 3 to 12, as in the book"}]}]}}, "index": "a7YSv", "typeName": "shape"}, {"x": 56, "y": 635, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1v", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's list is not exhaustive"}]}]}}, "index": "a73tj", "typeName": "shape"}, {"x": 56, "y": 294, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-38", "type": "text", "parentId": "shape:ch14-33", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Eight duties"}]}]}}, "index": "a5tzq", "typeName": "shape"}, {"x": 334.5, "y": 1988, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2w", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 168.5, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "IRP appointed", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Interim resolution professional runs the company; the board is dissolved"}]}]}}, "index": "aWCr2", "typeName": "shape"}, {"x": 56, "y": 1494, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-49", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Employed analysts' personal trading is monitored, recorded and, where needed, approved."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No trading "}, {"type": "text", "text": "contrary", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to one's own recommendation."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No buying or receiving shares of an issuer "}, {"type": "text", "text": "before its IPO", "marks": [{"type": "bold"}]}, {"type": "text", "text": " if it is in the same business as companies the analyst covers."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "These apply to a research entity too, unless research is segregated and at arm's length."}]}]}]}]}}, "index": "aSZHv", "typeName": "shape"}, {"x": 954.5116279069767, "y": 873, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3x", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 389.48837209302326, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Manager or co-manager of the issue"}]}]}}, "index": "aGlZr", "typeName": "shape"}, {"x": 56, "y": 1112, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4y", "type": "geo", "parentId": "shape:ch14-4o", "props": {"w": 632, "h": 624, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Must include", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Registered name, address, SEBI registration number, logo, CIN"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Accurate, true, complete, concise information"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The standard warning, unchanged, in at least "}, {"type": "text", "text": "10-point", "marks": [{"type": "bold"}]}, {"type": "text", "text": " font: \"Investment in securities market is subject to market risks. Read all the related documents carefully before investing.\""}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "In audio-visual ads, the warning shown and spoken clearly (the book's example: 20 words over at least 10 seconds)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Translated accurately if the ad is not in English"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For SMS or pop-ups without full details: a link to the website that has them"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "\"The securities quoted are for illustration only and are not recommendatory\" if securities are shown"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The disclaimer that SEBI registration, BASL membership (for IAs) and NISM certification do not guarantee performance or returns"}]}]}]}]}}, "index": "aAbZE", "typeName": "shape"}, {"x": 712, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5z", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " SCRA 1956 gives SEBI power to make or amend exchange bye-laws."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aAiIf", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-17", "type": "text", "parentId": "shape:ch14-15", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The key laws"}]}]}}, "index": "a2fFX", "typeName": "shape"}, {"x": 56, "y": 644, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-28", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 269.4736842105263, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation", "marks": [{"type": "bold"}]}]}]}}, "index": "a85ZM", "typeName": "shape"}, {"x": 56, "y": 693, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1w", "type": "geo", "parentId": "shape:ch14-1o", "props": {"w": 632, "h": 414, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Creating a false or misleading appearance of trading"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dealing not meant to transfer ownership, only to move the price"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Funding people to subscribe so an issue meets minimum subscription"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Paying people to trade to inflate, depress or hold a price"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Manipulating a reference or benchmark price"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Publishing false financial results, M&A or approval news while dealing"}]}]}]}]}}, "index": "a8JxM", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-39", "type": "geo", "parentId": "shape:ch14-33", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Honesty and good faith", "marks": [{"type": "bold"}]}]}]}}, "index": "a62JM", "typeName": "shape"}, {"x": 613, "y": 1988, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2x", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 168.5, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Committee of creditors", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Financial creditors only; confirms the IRP or appoints another insolvency professional"}]}]}}, "index": "aXMOU", "typeName": "shape"}, {"x": 56, "y": 983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3y", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 446.1860465116279, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Same, after a further public offer", "marks": [{"type": "bold"}]}]}]}}, "index": "aHOar", "typeName": "shape"}, {"x": 712, "y": 1112, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4z", "type": "geo", "parentId": "shape:ch14-4o", "props": {"w": 632, "h": 624, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Must not include", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "False, misleading, biased or deceptive statements; misleading testimonials"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Statements that exploit inexperience; exaggeration; excessive jargon"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "\"Free\" unless truly free"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Any promise of assured, minimum or target returns, or percentage accuracy"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Discrediting other intermediaries"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Past performance", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the RA"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Superlatives: \"Best\", \"No. 1\", \"Leading\" (factual awards from independent bodies are allowed)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The "}, {"type": "text", "text": "SEBI logo", "marks": [{"type": "bold"}]}]}]}]}]}}, "index": "aBp0b", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-18", "type": "text", "parentId": "shape:ch14-15", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14 of 15  ·  Part 1 of 3"}]}]}}, "index": "a37KA", "typeName": "shape"}, {"x": 333.4736842105263, "y": 644, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-29", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 1010.5263157894738, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "What it says", "marks": [{"type": "bold"}]}]}]}}, "index": "a9g2I", "typeName": "shape"}, {"x": 712, "y": 693, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1x", "type": "geo", "parentId": "shape:ch14-1o", "props": {"w": 632, "h": 414, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trades without intention to perform or change ownership"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dealing in stolen or counterfeit securities (with exceptions for holders in due course)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Spreading false or misleading information or advice in any media"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trading for clients without their knowledge; misusing client funds"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Circular transactions", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; inducing trades to earn brokerage; falsifying records"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Front running", "marks": [{"type": "bold"}]}, {"type": "text", "text": "-type orders on non-public knowledge of a big impending trade; planting false news; "}, {"type": "text", "text": "mis-selling", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; illegal collective investment schemes"}]}]}]}]}}, "index": "a9g5b", "typeName": "shape"}, {"x": 891.5, "y": 1988, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2y", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 168.5, "h": 444, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Resolution in 180 days", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Restructuring, takeover, or liquidation as a last resort"}]}]}}, "index": "aY8Dv", "typeName": "shape"}, {"x": 510.1860465116279, "y": 983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3z", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 436.3255813953488, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10 days", "marks": [{"type": "bold"}]}, {"type": "text", "text": " after pricing"}]}]}}, "index": "aISpX", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-19", "type": "text", "parentId": "shape:ch14-15", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.2.1 Securities Contracts (Regulation) Act, 1956"}]}]}}, "index": "a45B6", "typeName": "shape"}, {"x": 56, "y": 1133, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1y", "type": "text", "parentId": "shape:ch14-1o", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investigation:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a person under investigation must produce books and documents and appear in person when required (Regulation 8(1)). SEBI may, pending or after investigation: suspend trading in a security; restrain persons from the market; suspend exchange or SRO office-bearers; impound proceeds; stop disposal of assets or securities. Against an intermediary: "}, {"type": "text", "text": "warning or censure, suspension, or cancellation", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of registration."}]}]}}, "index": "aAHVX", "typeName": "shape"}, {"x": 140.25, "y": 2210, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2z", "type": "arrow", "parentId": "shape:ch14-20", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 278.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aWfeY", "typeName": "shape"}, {"meta": {}, "id": "binding:4Qpwi3D-jxvNKXrztMlIR", "type": "arrow", "fromId": "shape:ch14-5n", "toId": "shape:ch14-5j", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 1084, "y": 1133, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1z", "type": "note", "parentId": "shape:ch14-1o", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Mis-selling means selling securities or services by knowingly making false statements, concealing material facts or risks, or "}, {"type": "text", "text": "not taking reasonable care", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to ensure suitability for the buyer."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aBcwQ", "typeName": "shape"}, {"x": 56, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-a", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 209.81443298969074, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulator", "marks": [{"type": "bold"}]}]}]}}, "index": "a7wHv", "typeName": "shape"}, {"meta": {}, "id": "binding:M2zy6kVmagf_d-F80dC1w", "type": "arrow", "fromId": "shape:ch14-5m", "toId": "shape:ch14-5h", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 273.8144329896908, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-b", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 275.38144329896915, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Set up under", "marks": [{"type": "bold"}]}]}]}}, "index": "a8JkM", "typeName": "shape"}, {"x": 384, "y": 1752.8800000000047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6a", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Disclose ownership of 1% or more at the end of the month before publication; compensation over the past 12 months."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLxQn", "typeName": "shape"}, {"x": 557.19587628866, "y": 491, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-c", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 786.8041237113403, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Main role", "marks": [{"type": "bold"}]}]}]}}, "index": "a9mXz", "typeName": "shape"}, {"meta": {}, "id": "binding:hf_w7SXyppDK78U-WOYYX", "type": "arrow", "fromId": "shape:ch14-5k", "toId": "shape:ch14-5g", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 493.3333333333333, "y": 709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5a", "type": "geo", "parentId": "shape:ch14-51", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Do's", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Deal only with SEBI-registered RAs; check the registration number"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read the disclosures"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pay through banking channels and keep receipts (or CeFCoM if the RA uses it)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Report any RA offering assured returns to SEBI"}]}]}]}]}}, "index": "a9yLA", "typeName": "shape"}, {"x": 712, "y": 1752.8800000000047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6b", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Price chart: daily closes for the rating period or three years, whichever is shorter."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aMcu6", "typeName": "shape"}, {"x": 56, "y": 577, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-d", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 209.81443298969074, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ministry of Finance (MoF)", "marks": [{"type": "bold"}]}]}]}}, "index": "aAWz7", "typeName": "shape"}, {"x": 56, "y": 1694, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4a", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation 18: other limits"}]}]}}, "index": "aTuUL", "typeName": "shape"}, {"x": 930.6666666666666, "y": 709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5b", "type": "geo", "parentId": "shape:ch14-51", "props": {"w": 413.3333333333333, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Don'ts", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Do not give the RA funds to invest"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Do not fall for luring ads, rumours or limited-period offers"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Never share trading or demat login credentials"}]}]}]}]}}, "index": "aAfZE", "typeName": "shape"}, {"x": 1040, "y": 1752.8800000000047, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6c", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "20.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Records kept at least five years; grievances redressed within 21 calendar days."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aN6Cn", "typeName": "shape"}, {"x": 273.8144329896908, "y": 577, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-e", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 275.38144329896915, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Government of India"}]}]}}, "index": "aBrAM", "typeName": "shape"}, {"meta": {}, "id": "page:page", "name": "Chapter 14: Legal and regulatory environment", "index": "a1", "typeName": "page"}, {"gridSize": 10, "name": "", "meta": {}, "id": "document:document", "typeName": "document"}, {"x": 384, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3a", "type": "geo", "parentId": "shape:ch14-33", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Diligence", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Due skill and care; report after thorough analysis"}]}]}}, "index": "a70mE", "typeName": "shape"}, {"x": 56, "y": 1769, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4b", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Analysts may not take part in "}, {"type": "text", "text": "sales pitches or deal road shows", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for investment banking or brokerage business, or talk to clients about such deals in the presence of those divisions or company management."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Those divisions may not direct analysts to do sales or marketing."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reports need adequate documentary basis; no promise of a favourable review in exchange for business; no report inconsistent with the analyst's own view; analysts kept separate from sales, trading and corporate finance staff (feedback from sales on a report's impact is allowed)."}]}]}]}]}}, "index": "aUanQ", "typeName": "shape"}, {"x": 56, "y": 1059, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5c", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investor rights include privacy, transparency, fair treatment, adequate information, fair advertisement, timely grievance redressal, exit as per agreed terms, and caution notices for complex, high-risk products."}]}]}}, "index": "aBs2f", "typeName": "shape"}, {"x": 56, "y": 2153.840000000011, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6d", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " An individual RA cannot provide distribution services."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aOX6j", "typeName": "shape"}, {"x": 557.19587628866, "y": 577, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-f", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 786.8041237113403, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Taxation, financial legislation, institutions, capital markets, state finances, Union Budget. Five departments (below)"}]}]}}, "index": "aCfZI", "typeName": "shape"}, {"x": 56, "y": 730, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2a", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 269.4736842105263, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3: Registration", "marks": [{"type": "bold"}]}]}]}}, "index": "aALIU", "typeName": "shape"}, {"x": 712, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3b", "type": "geo", "parentId": "shape:ch14-33", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Conflict of interest", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Address it; disclose it"}]}]}}, "index": "a8eQM", "typeName": "shape"}, {"x": 3080, "y": 3942.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4c", "type": "frame", "props": {"w": 1400, "h": 1926, "name": "14.4 Conflicts of interest and disclosures (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a7ivQ", "typeName": "shape"}, {"x": 56, "y": 1163, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5d", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.7 Cybersecurity and Cyber Resilience Framework (CSCRF)"}]}]}}, "index": "aCdzR", "typeName": "shape"}, {"x": 384, "y": 2153.840000000011, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6e", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " GSM is valuation-based; ASM is price and volume based (top 25 clients). ASM margin 80%, then up to 100%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aP5T6", "typeName": "shape"}, {"x": 56, "y": 687, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-g", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 209.81443298969074, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Ministry of Corporate Affairs (MCA)", "marks": [{"type": "bold"}]}]}]}}, "index": "aDOW2", "typeName": "shape"}, {"meta": {}, "id": "binding:-V1yH2OfPgD6arqJY6mp6", "type": "arrow", "fromId": "shape:ch14-5n", "toId": "shape:ch14-5i", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1a", "type": "text", "parentId": "shape:ch14-15", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Gives SEBI direct and indirect control over almost all of the market: instruments, intermediaries, issuers and investors. It prevents undesirable transactions. It covers:"}]}]}}, "index": "a5lCE", "typeName": "shape"}, {"x": 333.4736842105263, "y": 730, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2b", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 1010.5263157894738, "h": 150, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No one may act as an RA without SEBI registration. Existing RAs had 6 months to apply. Exempt (if they comply with Chapter III): investment advisers, credit rating agencies, AMCs or fund managers issuing research, and their staff making public appearances. A registered RA's principal officer, associated persons and partners need not register separately (if they meet regulation 7)"}]}]}}, "index": "aBhoX", "typeName": "shape"}, {"x": 1040, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3c", "type": "geo", "parentId": "shape:ch14-33", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "No insider trading or front running", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Including front running its own report"}]}]}}, "index": "a9Vpn", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4d", "type": "geo", "parentId": "shape:ch14-4c", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.4", "marks": [{"type": "bold"}]}]}]}}, "index": "a11rX", "typeName": "shape"}, {"x": 56, "y": 1238, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5e", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All RAs must comply with SEBI's CSCRF. Its five cyber resiliency goals:"}]}]}}, "index": "aDGyn", "typeName": "shape"}, {"x": 712, "y": 2153.840000000011, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6f", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Advertisements: no past performance, no superlatives, no SEBI logo, no assured returns; standard warning in at least 10-point font."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQWE6", "typeName": "shape"}, {"x": 273.8144329896908, "y": 687, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-h", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 275.38144329896915, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Government of India"}]}]}}, "index": "aEjgf", "typeName": "shape"}, {"meta": {}, "id": "binding:bT9hV04lPOO2pce_QVplU", "type": "arrow", "fromId": "shape:ch14-2z", "toId": "shape:ch14-2v", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1b", "type": "geo", "pare