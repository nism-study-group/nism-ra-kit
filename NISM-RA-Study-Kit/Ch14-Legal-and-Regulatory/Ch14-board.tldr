{"tldrawFileFormatVersion": 1, "schema": {"schemaVersion": 2, "sequences": {"com.tldraw.store": 5, "com.tldraw.asset": 1, "com.tldraw.camera": 1, "com.tldraw.document": 2, "com.tldraw.instance": 26, "com.tldraw.instance_page_state": 5, "com.tldraw.page": 1, "com.tldraw.instance_presence": 6, "com.tldraw.pointer": 1, "com.tldraw.shape": 4, "com.tldraw.user": 1, "com.tldraw.asset.image": 6, "com.tldraw.asset.video": 5, "com.tldraw.asset.bookmark": 2, "com.tldraw.shape.group": 0, "com.tldraw.shape.text": 4, "com.tldraw.shape.bookmark": 2, "com.tldraw.shape.draw": 5, "com.tldraw.shape.geo": 12, "com.tldraw.shape.note": 13, "com.tldraw.shape.line": 5, "com.tldraw.shape.frame": 1, "com.tldraw.shape.arrow": 8, "com.tldraw.shape.highlight": 4, "com.tldraw.shape.embed": 4, "com.tldraw.shape.image": 5, "com.tldraw.shape.video": 4, "com.tldraw.binding.arrow": 1}}, "records": [{"x": 56, "y": 720, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1e", "type": "text", "parentId": "shape:ch14-15", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Section 11(1)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " makes it SEBI's duty to protect investors and to develop and regulate the market by measures it thinks fit. "}, {"type": "text", "text": "Section 11(2)", "marks": [{"type": "bold"}]}, {"type": "text", "text": " lists those measures, including: regulating exchanges; registering and regulating brokers, sub-brokers, share transfer agents, bankers to an issue, trustees, registrars, merchant bankers, underwriters, portfolio managers, investment advisers, depositories, DPs, custodians, FIIs, credit rating agencies; registering venture capital funds and collective investment schemes including mutual funds; regulating SROs; prohibiting fraud, unfair practices and insider trading; regulating takeovers; inspection and audit; levying fees; and research. The Act also lets SEBI impose penalties and run adjudication."}]}]}}, "index": "a984b", "typeName": "shape"}, {"x": 333.4736842105263, "y": 974, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2f", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 1010.5263157894738, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Qualifications and certification (reg 7); deposit (reg 8); fit and proper; infrastructure; past refusals and disciplinary history; enlistment with the body recognised under reg 14"}]}]}}, "index": "aFSNb", "typeName": "shape"}, {"x": 1040, "y": 597, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3g", "type": "geo", "parentId": "shape:ch14-33", "props": {"w": 304, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Senior management responsibility", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Primary responsibility for standards and procedures"}]}]}}, "index": "aD3An", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4h", "type": "text", "parentId": "shape:ch14-4c", "props": {"color": "grey", "size": "m", "w": 1288, "font": "san