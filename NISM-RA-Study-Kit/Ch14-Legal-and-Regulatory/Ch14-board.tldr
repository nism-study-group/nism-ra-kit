tem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Whether the analyst served as officer, director or employee of the subject company"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Whether the RA has been a "}, {"type": "text", "text": "market maker", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in it"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The extent of use of "}, {"type": "text", "text": "Artificial Intelligence", "marks": [{"type": "bold"}]}, {"type": "text", "text": " tools in research services"}]}]}]}]}}, "index": "a8ZBf", "typeName": "shape"}, {"x": 420.40000000000003, "y": 1383, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5l", "type": "arrow", "parentId": "shape:ch14-51", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.59999999999997, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aGePR", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6m", "type": "note", "parentId": "shape:ch14-6i", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A friend at a listed company mentions results will be \"very strong\" next week. What does the PIT regulation say you must do?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a40iv", "typeName": "shape"}, {"x": 557.19587628866, "y": 931, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-o", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 786.8041237113403, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Protect investors, develop and regulate the securities market. Also commodities since merging with the Forward Markets Commission on "}, {"type": "text", "text": "28 September 2015", "marks": [{"type": "bold"}]}]}]}}, "index": "aLFp2", "typeName": "shape"}, {"x": 56, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1i", "type": "geo", "parentId": "shape:ch14-15", "props": {"w": 632, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Insider", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "connected person", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", or anyone in possession of or with access to "}, {"type": "text", "text": "unpublished price sensitive information (UPSI)", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aDkV2", "typeName": "shape"}, {"x": 333.4736842105263, "y": 1194, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2j", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 1010.5263157894738, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "As specified by SEBI, marked as lien to the body recognised under reg 14 (RAASB); held as liquid or overnight mutual fund units or a scheduled bank deposit"}]}]}}, "index": "aJgEE", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3k", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14 of 15  ·  Part 1 of 2"}]}]}}, "index": "a3iRb", "typeName": "shape"}, {"x": 712, "y": 687, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4l", "type": "geo", "parentId": "shape:ch14-4c", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Report contents (reg 20)", "marks": [{"type": "italic"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Facts from reliable information; terms defined and used consistently"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Define each rating, its time horizon and benchmark"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "If a rating or target has existed for at least one year: a graph of daily closing prices for that period or "}, {"type": "text", "text": "three years, whichever is shorter", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Recommendations backed by data and analysis"}]}]}]}]}}, "index": "a9yQM", "typeName": "shape"}, {"x": 700, "y": 1383, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5m", "type": "arrow", "parentId": "shape:ch14-51", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.60000000000014, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aHzheo", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6n", "type": "note", "parentId": "shape:ch14-6i", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why should an analyst's pay not depend on investment banking deals? Give a real-world example of what could go wrong."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5Hkv", "typeName": "shape"}, {"x": 56, "y": 1041, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-p", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 209.81443298969074, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "IRDAI", "marks": [{"type": "bold"}]}]}]}}, "index": "aMssf", "typeName": "shape"}, {"x": 712, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1j", "type": "geo", "parentId": "shape:ch14-15", "props": {"w": 632, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Connected person", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Anyone associated with the company in any capacity during the "}, {"type": "text", "text": "six months", "marks": [{"type": "bold"}]}, {"type": "text", "text": " before the act, in a way that gives or could give access to UPSI. Deemed connected unless shown otherwise: relatives, group companies, intermediaries and their staff, AMC and trustee staff, exchange officials, bankers of the company, and others."}]}]}}, "index": "aEvNE", "typeName": "shape"}, {"x": 56, "y": 1304, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2k", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 269.4736842105263, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9: Certificate", "marks": [{"type": "bold"}]}]}]}}, "index": "aK1if", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3l", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter III of the RA Regulations."}]}]}}, "index": "a4d8f", "typeName": "shape"}, {"x": 56, "y": 1021, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4m", "type": "text", "parentId": "shape:ch14-4c", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Other regulations in Chapter III onwards"}]}]}}, "index": "aAJJX", "typeName": "shape"}, {"x": 979.6000000000001, "y": 1383, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5n", "type": "arrow", "parentId": "shape:ch14-51", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 279.5999999999999, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aJNAn", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6o", "type": "note", "parentId": "shape:ch14-6i", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A finfluencer posts stock tips with \"100% accuracy\" claims. Which rules does that break?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6FtQ", "typeName": "shape"}, {"x": 273.8144329896908, "y": 1041, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-q", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 275.38144329896915, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "IRDA Act, 1999"}]}]}}, "index": "aNW6X", "typeName": "shape"}, {"x": 56, "y": 1496, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1k", "type": "geo", "parentId": "shape:ch14-15", "props": {"w": 1288, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "UPSI (Regulation 2(n))", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Information about a company or its securities, not generally available, which would likely "}, {"type": "text", "text": "materially affect the price", "marks": [{"type": "bold"}]}, {"type": "text", "text": " once public. Includes: financial results; dividends; change in capital structure; mergers, demergers, acquisitions, delisting, disposals, expansion; changes in key managerial personnel; resignation of a statutory or secretarial auditor; change in ratings (other than ESG ratings); proposed fund raising; agreements affecting management or control; fraud, defaults or arrests; loan restructuring or one-time settlement; insolvency admissions; forensic audits; regulatory actions; litigation outcomes; guarantees outside normal business; grant or loss of key licences."}]}]}}, "index": "aFUwzV", "typeName": "shape"}, {"x": 333.4736842105263, "y": 1304, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2l", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 1010.5263157894738, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Form B for an RA; "}, {"type": "text", "text": "Form C for a part-time RA", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". An individual or partnership registered as an investment adviser may also be registered as an RA"}]}]}}, "index": "aLSBv", "typeName": "shape"}, {"x": 56, "y": 280, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3m", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation 15:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " written internal policies on analysts' dealing and trading, to (i) address actual or potential conflicts from dealing in the subject company's securities, (ii) promote objective, reliable, unbiased research, (iii) "}, {"type": "text", "text": "prevent the use of research to manipulate the market", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; plus mechanisms to keep research independent of other business. "}, {"type": "text", "text": "15A:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " RAs may charge fees as SEBI specifies."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation 17 (compensation):", "marks": [{"type": "bold"}]}, {"type": "text", "text": " no pay linked to a specific merchant banking, investment banking or brokerage deal; pay reviewed and approved annually by a board or committee with no representation from those divisions; analysts not supervised by those divisions."}]}]}]}]}}, "index": "a51k2", "typeName": "shape"}, {"x": 56, "y": 1096, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4n", "type": "geo", "parentId": "shape:ch14-4c", "props": {"w": 1288, "h": 774, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "19A Website", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Maintain a functional website."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "21 Public media", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Disclose registration status and financial interest when appearing in public. Staff of IAs, CRAs, AMCs and fund managers commenting in media follow regs 16 and 17 and disclose name, registration status and interest."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22 Distribution", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": No selective early release to internal traders or favoured clients. Review third-party reports for false statements and disclose the third party's conflicts (unless there is no business relationship)."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23 Proxy advisers", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Covered by the RA Regulations. Review voting policies at least "}, {"type": "text", "text": "annually", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; alert clients of factual errors within "}, {"type": "text", "text": "24 hours", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; communicate material revisions within "}, {"type": "text", "text": "72 hours", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; share reports with clients and the company at the same time."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "24 General", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Arm's length between research and other activities; follow the code of conduct; SEBI's "}, {"type": "text", "text": "prior approval for a change in control", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; sole responsibility for client data and outputs when using AI tools; follow model portfolio guidelines and the Investor Charter. A "}, {"type": "text", "text": "model portfolio", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is a basket of securities in a research report that recommends "}, {"type": "text", "text": "weightages", "marks": [{"type": "bold"}]}, {"type": "text", "text": " for them. A plain list of recommended stocks, with no weightages, is not a model portfolio."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "25 Records", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Signed, dated reports; recommendations and their rationale; public appearances; KYC; client register with PAN; communication records; client terms and consent. Kept at least "}, {"type": "text", "text": "five years", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Annual compliance audit by a member of ICAI, ICSI or the Institute of Cost Accountants."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "26 Compliance officer", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": A non-individual RA appoints a compliance officer, or an independent ICAI, ICSI or ICMAI professional with NISM certification."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "26A Disputes", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Mediation, conciliation and/or arbitration as SEBI specifies."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "26B Grievances", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Redress within "}, {"type": "text", "text": "21 calendar days", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "26C Segregation", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": An individual RA may "}, {"type": "text", "text": "not provide distribution services", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Its family may not distribute to the RA's research clients. A non-individual RA keeps client-level segregation at group level: a client gets research or distribution, not both."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "32 Default", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Breaches, false information, missing returns, non-cooperation or unresolved complaints are dealt with under the SEBI Act or the Intermediaries Regulations, 2008."}]}]}]}]}}, "index": "aByXQ", "typeName": "shape"}, {"x": 1040, "y": 622.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-60", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " PIT 2015 and PFUTP 2003 are both made under section 30 of the SEBI Act."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aBHPX", "typeName": "shape"}, {"x": 56, "y": 1496, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5o", "type": "text", "parentId": "shape:ch14-51", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "CSCRF grades regulated entities into five categories: Market Infrastructure Institutions, Qualified, Mid-size, Small-size and Self-certification REs. RAs "}, {"type": "text", "text": "not registered in any other category", "marks": [{"type": "bold"}]}, {"type": "text", "text": " are excluded from submitting CSCRF compliance, but must submit a declaration under SEBI's 2020 SaaS (software-as-a-service) advisory. Institutional RAs registered in another category follow that category's classification."}]}]}}, "index": "aKlBI", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6p", "type": "note", "parentId": "shape:ch14-6i", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " GSM or ASM: which would catch a small company whose price tripled in a month on huge volumes?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7A1f", "typeName": "shape"}, {"x": 557.19587628866, "y": 1041, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-r", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 786.8041237113403, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Licenses insurers, sets capital rules, product and contract terms, distributor training and commission, supervises the Tariff Advisory Committee, investment of insurers' funds"}]}]}}, "index": "aO4wE", "typeName": "shape"}, {"x": 56, "y": 1786, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1l", "type": "text", "parentId": "shape:ch14-15", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation 3(1):", "marks": [{"type": "bold"}]}, {"type": "text", "text": " an insider must not communicate or give access to UPSI to anyone, other insiders included, except for "}, {"type": "text", "text": "legitimate purposes", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", duties or legal obligations. Information is handled on a "}, {"type": "text", "text": "need-to-know", "marks": [{"type": "bold"}]}, {"type": "text", "text": " basis."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulation 4:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " no insider may trade in listed (or to-be-listed) securities while "}, {"type": "text", "text": "in possession of UPSI", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Such trades are presumed to be motivated by it; the insider may prove innocence in the circumstances the regulation allows."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Initial disclosure:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a new key managerial person, director or promoter must disclose holdings to the company within "}, {"type": "text", "text": "seven days", "marks": [{"type": "highlight"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "compliance officer", "marks": [{"type": "bold"}]}, {"type": "text", "text": " sets and monitors the codes of fair disclosure and conduct."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fair disclosure:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " prompt, uniform, universal release of UPSI; no selective disclosure; information given to analysts must not be UPSI; record meetings with analysts."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Designated persons", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (including analysts, law firms, auditors, consultants) cannot trade while expected to hold UPSI; trades above board limits need "}, {"type": "text", "text": "pre-clearance", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}]}]}}, "index": "aGhzc", "typeName": "shape"}, {"x": 56, "y": 1414, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2m", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 269.4736842105263, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10: Validity", "marks": [{"type": "bold"}]}]}]}}, "index": "aMe2Q", "typeName": "shape"}, {"x": 56, "y": 544, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3n", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The time windows to remember"}]}]}}, "index": "a6AzF", "typeName": "shape"}, {"x": 56, "y": 1762, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-50", "type": "text", "parentId": "shape:ch14-4o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Also: get prior approval from the SEBI-recognised supervisory body; no ads while suspended; no games, leagues or prize schemes; keep a copy of each ad for "}, {"type": "text", "text": "five years", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". RAs may use brand names and logos if the registered name, number and contact details are shown prominently everywhere."}]}]}}, "index": "aCN26", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4o", "type": "frame", "props": {"w": 1400, "h": 1914, "name": "14.5 Exchange surveillance: GSM and ASM", "color": "black"}, "parentId": "page:page", "index": "a8vTj", "typeName": "shape"}, {"x": 56, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-61", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "9.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A connected person: associated with the company in the six months before the act."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aCeWn", "typeName": "shape"}, {"x": 6160, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5p", "type": "frame", "props": {"w": 1400, "h": 2987.7600000000093, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "aAzJ9", "typeName": "shape"}, {"x": 56, "y": 622.9599999999919, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6q", "type": "note", "parentId": "shape:ch14-6i", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Why might SEBI stop an individual RA from also distributing mutual funds?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8vkA", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3", "type": "frame", "props": {"w": 1400, "h": 2874.5999999999985, "name": "14.1 The regulators", "color": "black"}, "parentId": "page:page", "index": "a1SM6", "typeName": "shape"}, {"x": 56, "y": 1151, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-s", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 209.81443298969074, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "PFRDA", "marks": [{"type": "bold"}]}]}]}}, "index": "aPZKn", "typeName": "shape"}, {"x": 1084, "y": 1786, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1m", "type": "note", "parentId": "shape:ch14-15", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The Chinese wall", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Firms separate \"insider areas\" that routinely see confidential information from \"public areas\" such as sales, marketing and investment advice. Insiders must not pass price-sensitive information across; teams may be physically separated. In exceptional cases a person may be brought \"over the wall\" on a need-to-know basis, and the compliance officer must be told."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 456, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aHutr", "typeName": "shape"}, {"x": 333.4736842105263, "y": 1414, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2n", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 1010.5263157894738, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Valid until suspended or cancelled by SEBI"}]}]}}, "index": "aN7X2", "typeName": "shape"}, {"x": 954.5116279069767, "y": 983, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-40", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 389.48837209302326, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Manager or co-manager"}]}]}}, "index": "aJ0gf", "typeName": "shape"}, {"x": 56, "y": 619, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-3o", "type": "text", "parentId": "shape:ch14-3h", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Regulations 16 and 18"}]}]}}, "index": "a706Q", "typeName": "shape"}, {"x": 4620, "y": 2842.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-51", "type": "frame", "props": {"w": 1400, "h": 1680, "name": "14.6 Investor charter and complaints", "color": "black"}, "parentId": "page:page", "index": "a9JuI", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4p", "type": "geo", "parentId": "shape:ch14-4o", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.5", "marks": [{"type": "bold"}]}]}]}}, "index": "a1CPU", "typeName": "shape"}, {"x": 384, "y": 950.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-62", "type": "note", "parentId": "shape:ch14-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "10.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Change in ESG ratings is excluded from the UPSI list; other rating changes are included."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aDpUL", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-5q", "type": "geo", "parentId": "shape:ch14-5p", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a1E0f", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-6r", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 14: Legal and regulatory environment"}]}]}}, "index": "aCyhz", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-4", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.1", "marks": [{"type": "bold"}]}]}]}}, "index": "a13O2", "typeName": "shape"}, {"x": 273.8144329896908, "y": 1151, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-t", "type": "geo", "parentId": "shape:ch14-3", "props": {"w": 275.38144329896915, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "PFRDA Act, 2013 (constituted October 2003)"}]}]}}, "index": "aQ6nf", "typeName": "shape"}, {"meta": {}, "id": "binding:GeSI75usP8CrH9-ZYUkth", "type": "arrow", "fromId": "shape:ch14-30", "toId": "shape:ch14-2w", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 1084, "y": 2664.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-1n", "type": "note", "parentId": "shape:ch14-15", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Under the PIT section, the book quotes: analysts preparing reports on a client company must disclose their holdings to the compliance officer, and analysts who prepare a report on a listed company "}, {"type": "text", "text": "shall not trade in it for thirty days from preparation", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the report. (The RA Regulations' own window, in 14.4, is different: 30 days before and 5 days after publication.)"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 456, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aIECE", "typeName": "shape"}, {"x": 418.75, "y": 2210, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-30", "type": "arrow", "parentId": "shape:ch14-20", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 278.5, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "aXr8a", "typeName": "shape"}, {"x": 56, "y": 1500, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-2o", "type": "geo", "parentId": "shape:ch14-20", "props": {"w": 269.4736842105263, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12: Refusal", "marks": [{"type": "bold"}]}]}]}}, "index": "aORvX", "typeName": "shape"}, {"x": 56, "y": 1069, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch14-41", "type": "geo", "parentId": "shape:ch14-3h", "props": {"w": 446.1860465116279, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Underwriter of an IPO (reg 18(2))", "marks": [{"type": "bold"}]}]}]}}, "index": "aKuSQ", "typeName": "shape"}, {"x": 56, "y": 677, "ro