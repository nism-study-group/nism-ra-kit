content": [{"type": "paragraph", "content": [{"type": "text", "text": "Research on commodities, and how commodities affect shares"}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Book pages 78 to 89."}]}]}}, "index": "a9gUi", "typeName": "shape"}, {"x": 153.8181818181818, "y": 4132, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-4x", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 673.6363636363636, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technical Analysis (33 pages, 15 marks)"}]}]}}, "index": "b0pKx2", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-5y", "type": "text", "parentId": "shape:ch00-5u", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Register and book on NISM's certification portal: "}, {"type": "text", "text": "cert.nism.ac.in", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (linked from "}, {"type": "text", "text": "www.nism.ac.in", "marks": [{"type": "bold"}]}, {"type": "text", "text": ")."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Add your "}, {"type": "text", "text": "PAN", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to your profile, or the certificate will not be issued."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM publishes a list of test centres and dates "}, {"type": "text", "text": "every month", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The October 2026 list has about "}, {"type": "text", "text": "230", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " centres across India."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Most centres offer two afternoon slots: "}, {"type": "text", "text": "13:30 to 15:30", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "15:30 to 17:30", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". A few offer other times. Each centre runs on certain dates only, so check your city in the latest month's list."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Helpdesk, as printed on the centre list: certification@nism.ac.in, phone +91 8080806476."}]}]}]}]}}, "index": "a4ZoM", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-6z", "type": "note", "parentId": "shape:ch00-6t", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Who is comfortable with Excel formulas? Should we add a short spreadsheet session before Chapter 8?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6WAb", "typeName": "shape"}, {"x": 1084, "y": 905.5999999999985, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-b", "type": "note", "parentId": "shape:ch00-3", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A driving licence test. It does not make you a great driver. It proves you know the rules and the basics, so others can trust you on the road."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a8tRA", "typeName": "shape"}, {"x": 1084, "y": 420, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-16", "type": "note", "parentId": "shape:ch00-x", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Getting 60 questions right is not enough if you also got some wrong. 65 right and 20 wrong gives exactly 60. 62 right and 38 wrong gives only 52.5."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a9I2I", "typeName": "shape"}, {"x": 1054.909090909091, "y": 599, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-27", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 289.09090909090907, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2"}]}]}}, "index": "aF7yn", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-1v", "type": "text", "parentId": "shape:ch00-1s", "props": {"color": "grey", "size": "m", "w": 1128, "font