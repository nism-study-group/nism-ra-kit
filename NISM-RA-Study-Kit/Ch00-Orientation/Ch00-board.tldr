", "text": "Nothing", "marks": [{"type": "bold"}]}]}]}}, "index": "aIXUUV", "typeName": "shape"}, {"x": 1054.909090909091, "y": 857, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-2g", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 289.09090909090907, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5"}]}]}}, "index": "aOq6n", "typeName": "shape"}, {"x": 56, "y": 2286, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-3h", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapters 10 to 12", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Numbers and value", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "24 marks", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Valuation, commodities, risk and return"}]}]}}, "index": "azUML", "typeName": "shape"}, {"x": 153.8181818181818, "y": 3702, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-4i", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 673.6363636363636, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "si