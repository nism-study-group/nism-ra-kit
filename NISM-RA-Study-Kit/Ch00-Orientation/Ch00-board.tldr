ragraph", "content": [{"type": "text", "text": "11", "marks": [{"type": "bold"}]}]}]}}, "index": "b0c89M", "typeName": "shape"}, {"x": 1084, "y": 2711, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-5l", "type": "note", "parentId": "shape:ch00-50", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The workbook itself warns: the exam is "}, {"type": "text", "text": "largely", "marks": [{"type": "bold"}]}, {"type": "text", "text": " based on the book, but NISM does not promise every question will come from it. The sample questions in the book are for reference only; the real exam may be harder."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 192, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aLYsM", "typeName": "shape"}, {"x": 712, "y": 279.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-6m", "type": "note", "parentId": "shape:ch00-6g", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Guessing wildly on questions you know nothing about. It barely helps and adds risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a6G1I", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-5", "type": "text", "parentId": "shape:ch00-3", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why take this exam?"}]}]}}, "index": "a2UIi", "typeName": "shape"}, {"x": 56, "y": 894, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-u", "type": "text", "parentId": "shape:ch00-e", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "120 minutes for 100 questions is about "}, {"type": "text", "text": "72 seconds", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " a question. Case questions take longer, because you must read the story first."}]}]}}, "index": "aG5CU", "typeName": "shape"}, {"x": 825.2694610778443, "y": 1210.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-1i", "type": "geo", "parentId": "shape:ch00-x", "props": {"w": 234.7305389221557, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "+0.06", "marks": [{"type": "bold"}]}]}]}}, "index": "aL2db", "typeName": "shape"}, {"x": 1054.909090909091, "y": 943, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-2j", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 289.09090909090907, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "8"}]}]}}, "index": "aRBqI", "typeName": "shape"}, {"x": 56, "y": 2605, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-3k", "type": "text", "parentId": "shape:ch00-1s", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Some chapters are long but carry few marks. Others are short and carry many. The chart shows "}, {"type": "text", "text": "marks per 10 pages", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the book. A longer bar means each page you read is worth more in the exam."}]}]}}, "index": "b02dtb", "typeName": "shape"}, {"x": 153.8181818181818, "y": 3788, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-4l", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 673.6363636363636, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fundamental Analysis of Commodities (10 pages, 5 marks)"}]}]}}, "index": "b0dZUH", "typeName": "shape"}, {"x": 6160, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-5m", "type": "frame", "props": {"w": 1400, "h": 842, "name": "5 What about numericals?", "color": "black"}, "parentId": "page:page", "index": "a68Ev", "typeName": "shape"}, {"x": 1040, "y": 279.6000000000058, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-6n", "type": "note", "parentId": "shape:ch00-6g", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Giving every chapter equal time. Chapters 8, 10, 14 and 15 are nearly half the paper."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7rDU", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-6", "type": "text", "parentId": "shape:ch00-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Session 0: orientation"}]}]}}, "index": "a3KEv", "typeName": "shape"}, {"x": 1084, "y": 894, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-v", "type": "note", "parentId": "shape:ch00-e", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A suggested time plan", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "This is our suggestion, not an NISM rule. Do the 80 MCQs first, in about 70 minutes. Then the 5 cases, about 7 minutes each. Keep the last 15 minutes to return to questions you marked for review."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aH6jj", "typeName": "shape"}, {"x": 56, "y": 1296.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-1j", "type": "geo", "parentId": "shape:ch00-x", "props": {"w": 234.7305389221557, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1 option", "marks": [{"type": "bold"}]}]}]}}, "index": "aMctr", "typeName": "shape"}, {"x": 56, "y": 1029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-2k", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 115.63636363636363, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "7", "marks": [{"type": "bold"}]}]}]}}, "index": "aSKqI", "typeName": "shape"}, {"x": 56, "y": 2709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-3l", "type": "text", "parentId": "shape:ch00-1s", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Marks per 10 pages"}]}]}}, "index": "b03UyH", "typeName": "shape"}, {"x": 835.4545454545455, "y": 3788, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-4m", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 224.54545454545453, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.0"}]}]}}, "index": "b0eRvI", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-5n", "type": "geo", "parentId": "shape:ch00-5m", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5", "marks": [{"type": "bold"}]}]}]}}, "index": "a1E8b", "typeName": "shape"}, {"x": 1040, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-70", "type": "note", "parentId": "shape:ch00-6t", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " What meeting day, time and length works for everyone?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a7sMU", "typeName": "shape"}, {"x": 56, "y": 644.0800000000017, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-6o", "type": "note", "parentId": "shape:ch00-6g", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "5.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Judging a chapter by its length. Chapter 2 is 33 pages for 2 marks; Chapter 13 is 8 pages for 5 marks."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a8QTX", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-7", "type": "text", "parentId": "shape:ch00-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The exam is run by "}, {"type": "text", "text": "NISM", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", the National Institute of Securities Markets. Under a SEBI regulation of 2007 on certifying market professionals, NISM sets a minimum knowledge level for people who work in the securities markets."}]}]}}, "index": "a49tj", "typeName": "shape"}, {"x": 1084, "y": 1460.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-w", "type": "note", "parentId": "shape:ch00-e", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A cricket innings of 100 balls. Take the easy singles first. Do not spend five overs on one difficult bowler."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aIgnf", "typeName": "shape"}, {"x": 298.7305389221557, "y": 1296.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-1k", "type": "geo", "parentId": "shape:ch00-x", "props": {"w": 234.7305389221557, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1 in 3"}]}]}}, "index": "aN5Us", "typeName": "shape"}, {"x": 179.63636363636363, "y": 1029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-2l", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 867.2727272727273, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Company Analysis: Business and Governance"}]}]}}, "index": "aTTcI", "typeName": "shape"}, {"x": 56, "y": 2784, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-3m", "type": "text", "parentId": "shape:ch00-1s", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Page counts from the workbook contents page, so they are approximate"}]}]}}, "index": "b04NaU", "typeName": "shape"}, {"x": 56, "y": 3874, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-4n", "type": "geo", "parentId": "shape:ch00-1s", "props": {"w": 89.81818181818183, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "12", "marks": [{"type": "bold"}]}]}]}}, "index": "b0fiuX", "typeName": "shape"}, {"x": 6160, "y": 2542.2000000000057, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-60", "type": "frame", "props": {"w": 1400, "h": 1055, "name": "7 How does this group work?", "color": "black"}, "parentId": "page:page", "index": "a8Cnf", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch00-5o", "type": "text", "parentId": "shape:ch00-5m