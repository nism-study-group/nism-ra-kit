text": "rally", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (\"relief rally\"). Retraces "}, {"type": "text", "text": "1/3 to 2/3", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the prior move (Dow Theory). Volume usually lower"}]}]}}, "index": "aTGXb", "typeName": "shape"}, {"x": 446.4913151364764, "y": 1157, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1v", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 364.7642679900744, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Secondary", "marks": [{"type": "bold"}]}]}]}}, "index": "aHXFA", "typeName": "shape"}, {"x": 570, "y": 1892, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-38", "type": "geo", "parentId": "shape:ch15-2o", "props": {"w": 490, "h": 324, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bearish", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Evening star", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A large green candle in an uptrend; a small-bodied candle (red or green) that closes above the first; a large red candle"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The red candle opens below the middle candle and closes n