: "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price discounts everything", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Economic, political and psychological information is already in the price. Analysts look only at price and volume."}]}]}}, "index": "a6D4M", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2u", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Same shape, opposite meaning: it depends on what came before"}]}]}}, "index": "a68Nb", "typeName": "shape"}, {"x": 947.5324675324675, "y": 1120, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-47", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 396.46753246753235, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price bouncing off the 50 DMA"}]}]}}, "index": "aKp2I", "typeName": "shape"}, {"x": 56, "y": 763, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3v", "type": "text", "parentId": "shape:ch15-3n", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Types of support and resistance"}]}]}}, "index": "a8M7j", "typeName": "shape"}, {"x": 712, "y": 1656, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-58", "type": "geo", "parentId": "shape:ch15-4p", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Divergence", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bullish divergence:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in an oversold market the stock makes a new low but RSI does not. An early buy signal"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bearish divergence:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in an overbought market the stock makes a new high but RSI does not. An early sell signal"}]}]}]}]}}, "index": "aJ59z", "typeName": "shape"}, {"x": 308.61538461538464, "y": 1550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-y", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 504.51923076923066, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Forecast price moves and trading opportunities"}]}]}}, "index": "aVqr2", "typeName": "shape"}, {"x": 56, "y": 522, "rotation": 0, "isLoc