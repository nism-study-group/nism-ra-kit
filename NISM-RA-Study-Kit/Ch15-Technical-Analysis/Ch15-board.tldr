e", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Traders, chartists, speculators, short-term investors"}]}]}}, "index": "aYXjv", "typeName": "shape"}, {"x": 161.27047146401986, "y": 1353, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-22", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 277.2208436724565, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Typically one year or more"}]}]}}, "index": "aOg2U", "typeName": "shape"}, {"x": 1084, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1q", "type": "note", "parentId": "shape:ch15-1e", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Dow Theory has "}, {"type": "text", "text": "three", "marks": [{"type": "bold"}]}, {"type": "text", "text": " trends, not four, and "}, {"type": "text", "text": "six", "marks": [{"type": "bold"}]}, {"type": "text", "text": " tenets. The book's sample question offers \"the market has four trends\" as the false tenet."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCKYj", "typeName": "shape"}, {"x": 712, "y": 1365, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-33", "type": "geo", "parentId": "shape:ch15-2o", "props": {"w": 632, "h": 264, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bullish, near the bottom", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Piercing pattern", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "two-candlestick", "marks": [{"type": "bold"}]}, {"type": "text", "text": " pattern near the "}, {"type": "text", "text": "bottom", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of a congestion area"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A red candle, then a green candle that opens with a significant "}, {"type": "text", "text": "gap down", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The green body covers "}, {"type": "text", "text": "at least half", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of the red candle"}]}]}]}]}}, "index": "aFjFn", "typeName": "shape"}, {"x": 216, "y": 138.79999999999927, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6", "type": "text", "parentId": "shape:ch15-3", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 15 of 15"}]}]}}, "index": "a37HM", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2r", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 15 of 15"}]}]}}, "index": "a3YHn", "typeName": "shape"}, {"x": 947.5324675324675, "y": 1010, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-44", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 396.46753246753235, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Upward sloping support in a bull trend"}]}]}}, "index": "aHT1U", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3s", "type": "text", "parentId": "shape:ch15-3n", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A break above resistance on volume is a breakout."}]}]}}, "index": "a5LC2", "typeName": "shape"}, {"x": 444.8, "y": 1566, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-55", "type": "geo", "parentId": "shape:ch15-4p", "props": {"w": 510.4, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "30 to 70"}]}]}}, "index": "aGZEn", "typeName": "shape"}, {"x": 308.61538461538464, "y": 1464, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-v", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 504.51923076923066, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Price captures all information; trends continue"}]}]}}, "index": "aSP1Q", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4t", "type": "text", "parentId": "shape:ch15-4p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.9.1 Moving averages"}]}]}}, "index": "a40rr", "typeName": "shape"}, {"x": 4620, "y": 2874.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-66", "type": "frame", "props": {"w": 1400, "h": 2367.920000000013, "name": "All exam traps in this chapter", "color": "black"}, "parentId": "page:page", "index": "a9Bkz", "typeName": "shape"}, {"x": 250.85579196217495, "y": 1482, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5u", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 200.86997635933804, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Speed and size of price changes"}]}]}}, "index": "aLOxM", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-77", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 15: Technical analysis"}]}]}}, "index": "aBdrM", "typeName": "shape"}, {"x": 384, "y": 2007.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6v", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "22.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " ADX measures strength, not direction; below 25 weak; default 14."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aPYII", "typeName": "shape"}, {"x": 821.1346153846154, "y": 1636, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-12", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 522.8653846153845, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fund and portfolio managers, value and long-term investors"}]}]}}, "index": "aZ4W2", "typeName": "shape"}, {"x": 446.4913151364764, "y": 1353, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-23", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 364.7642679900744, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "About 3 weeks to 3 months (can vary)"}]}]}}, "index": "aPK0E", "typeName": "shape"}, {"x": 56, "y": 993, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1r", "type": "text", "parentId": "shape:ch15-1e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.4 Understanding market trends"}]}]}}, "index": "aDn5X", "typeName": "shape"}, {"x": 56, "y": 1655, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-34", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A congestion area is a price range where the market trades repeatedly, often for several weeks, before breaking out up or down."}]}]}}, "index": "aGzum", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-7", "type": "text", "parentId": "shape:ch15-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Technical analysis", "marks": [{"type": "bold"}]}, {"type": "text", "text": " evaluates securities from statistics of trading activity, mainly "}, {"type": "text", "text": "price and volume", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Unlike fundamental analysis, it assumes all relevant information is "}, {"type": "text", "text": "already in the price", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". It is used across equities, currencies, commodities and crypto, especially for "}, {"type": "text", "text": "short to medium term", "marks": [{"type": "bold"}]}, {"type": "text", "text": " trading. Chapter 4 (4.3) gave a first look."}]}]}}, "index": "a4N6A", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2s", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Each candle shows open, high, low and close. The "}, {"type": "text", "text": "real body", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the gap between open and close; the thin lines above and below are the "}, {"type": "text", "text": "shadows", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (wicks). The drawn pattern diagrams are on this chapter's web page."}]}]}}, "index": "a4MNn", "typeName": "shape"}, {"x": 56, "y": 1120, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-45", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 264.3116883116883, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Moving averages", "marks": [{"type": "bold"}]}]}]}}, "index": "aIVLf", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3t", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 632, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Definitions", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Support:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a level where a downtrend is expected to pause because of concentrated "}, {"type": "text", "text": "demand", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": a \"floor\"."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Resistance:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " a level where an uptrend is expected to pause because of concentrated "}, {"type": "text", "text": "supply", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": a \"ceiling\"."}]}]}}, "index": "a6BOr", "typeName": "shape"}, {"x": 961.2, "y": 1566, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-56", "type": "geo", "parentId": "shape:ch15-4p", "props": {"w": 382.8, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "70 to 100: overbought"}]}]}}, "index": "aHR6M", "typeName": "shape"}, {"x": 821.1346153846154, "y": 1464, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-w", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 522.8653846153845, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Prices can deviate from intrinsic value"}]}]}}, "index": "aTnmA", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4u", "type": "text", "parentId": "shape:ch15-4p", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A smoothed line of average closing prices (daily, weekly or monthly). Rising MA: uptrend; falling: downtrend. MAs are "}, {"type": "text", "text": "lagging", "marks": [{"type": "bold"}]}, {"type": "text", "text": " indicators but good for major trends. When monthly, weekly and daily MAs point the same way, the trend is likely to continue. Trading at or near a rising MA can be a good time to buy."}]}]}}, "index": "a59Vr", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-67", "type": "geo", "parentId": "shape:ch15-66", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "!", "marks": [{"type": "bold"}]}]}]}}, "index": "a1UqL", "typeName": "shape"}, {"x": 459.725768321513, "y": 1482, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5v", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 600.2742316784869, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "0 to 100; above 70 overbought, below 30 oversold; best in a trading range"}]}]}}, "index": "aMzmk", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-78", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 15 marks of 100  ·  Book pages 295 to 327  ·  About 90 minutes  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "aCjHM", "typeName": "shape"}, {"x": 712, "y": 2007.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6w", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "23.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " RSC above 100: outperforming the benchmark."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aQl6E", "typeName": "shape"}, {"x": 0, "y": 2722.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-13", "type": "frame", "props": {"w": 1400, "h": 769, "name": "15.2 Chart types", "color": "black"}, "parentId": "page:page", "index": "a290I", "typeName": "shape"}, {"x": 819.2555831265508, "y": 1353, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-24", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 240.74441687344913, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Usually under 3 weeks (some say up to 6)"}]}]}}, "index": "aQ6w6", "typeName": "shape"}, {"x": 56, "y": 1082, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1s", "type": "text", "parentId": "shape:ch15-1e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Primary, secondary, tertiary"}]}]}}, "index": "aERPE", "typeName": "shape"}, {"x": 56, "y": 1759, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-35", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Star patterns"}]}]}}, "index": "aHnEX", "typeName": "shape"}, {"x": 56, "y": 358, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-8", "type": "text", "parentId": "shape:ch15-3", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Five core assumptions"}]}]}}, "index": "a5Ocj", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2t", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Single-candle reversals: hanging man and hammer"}]}]}}, "index": "a5Dyb", "typeName": "shape"}, {"x": 328.3116883116883, "y": 1120, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-46", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 611.2207792207793, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dynamic levels, for example the 50-day MA"}]}]}}, "index": "aJGpz", "typeName": "shape"}, {"x": 712, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3u", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 632, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Why they matter", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Psychological anchors: traders remember past turning points"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buy and sell orders cluster near them"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Help set stop-loss and take-profit levels"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Breakouts or bounces confirm trend direction"}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Role reversal", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Broken support often becomes resistance, and vice versa: trapped traders exit at breakeven, sentiment shifts, institutions reposition."}]}]}}, "index": "a7kIj", "typeName": "shape"}, {"x": 56, "y": 1656, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-57", "type": "geo", "parentId": "shape:ch15-4p", "props": {"w": 632, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Reading RSI", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measures speed and size of recent price changes; can be a "}, {"type": "text", "text": "lead", "marks": [{"type": "bold"}]}, {"type": "text", "text": " indicator"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Works well in a "}, {"type": "text", "text": "trading range", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bull market: rarely falls below "}, {"type": "text", "text": "44 to 45", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Bear market: rarely rises above "}, {"type": "text", "text": "50 to 55", "marks": [{"type": "bold"}]}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Can stay overbought (or oversold) for long in a strong trend"}]}]}]}]}}, "index": "aIiu6", "typeName": "shape"}, {"x": 56, "y": 1550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-x", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 244.6153846153846, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Objective", "marks": [{"type": "bold"}]}]}]}}, "index": "aUvFj", "typeName": "shape"}, {"x": 56, "y": 447, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4v", "type": "text", "parentId": "shape:ch15-4p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's 13, 21 and 34 EMA combination"}]}]}}, "index": "a6u5n", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-68", "type": "text", "parentId": "shape:ch15-66", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All exam traps in this chapter"}]}]}}, "index": "a2tzY", "typeName": "shape"}, {"x": 56, "y": 1592, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5w", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 186.85579196217495, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ADX", "marks": [{"type": "bold"}]}]}]}}, "index": "aNjmX", "typeName": "shape"}, {"x": 0, "y": 413.9, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-79", "type": "text", "parentId": "page:page", "props": {"color": "violet", "size": "l", "w": 3044.4444444444443, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.8, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Read the market from its own record of price and volume: the trend, the patterns that signal a turn, and the indicators that confirm it."}]}]}}, "index": "aDVUL", "typeName": "shape"}, {"x": 1040, "y": 2007.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6x", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "24.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " OBV adds volume on up days and subtracts on down days; read with its 20-period average."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aRHhQ", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-14", "type": "geo", "parentId": "shape:ch15-13", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": 