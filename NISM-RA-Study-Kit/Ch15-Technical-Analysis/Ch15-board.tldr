raph", "content": [{"type": "text", "text": "The long lower shadow shows sellers took control for part of the session"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Only a warning: the "}, {"type": "text", "text": "next candle must close lower", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to confirm. Traders act during or after confirmation"}]}]}]}]}}, "index": "a7lVn", "typeName": "shape"}, {"x": 56, "y": 1206, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-48", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 264.3116883116883, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fibonacci levels", "marks": [{"type": "bold"}]}]}]}}, "index": "aL2UzV", "typeName": "shape"}, {"x": 56, "y": 838, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3w", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 264.3116883116883, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Type", "marks": [{"type": "bold"}]}]}]}}, "index": "a9LqU", "typeName": "shape"}, {"x": 4620, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-59", "type": "frame", "props": {"w": 1400, "h": 1946, "name": "15.9 Technical indicators (2 of 2)", "color": "black"}, "parentId": "page:page", "index": "a8zUUG", "typeName": "shape"}, {"x": 821.1346153846154,