"sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Channel", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Two "}, {"type": "text", "text": "parallel", "marks": [{"type": "bold"}]}, {"type": "text", "text": " trendlines, one through highs and one through lows. Ascending (higher highs and lows) is bullish; descending is bearish; horizontal is range-bound. Its width reflects volatility. Trade within it (buy at support, sell at resistance); a break of either line is a breakout or breakdown, with a target projected from the channel width."}]}]}}, "index": "aYAjU", "typeName": "shape"}, {"x": 459.725768321513, "y": 1200, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5m", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 600.2742316784869, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Key numbers and signals (book)", "marks": [{"type": "bold"}]}]}]}}, "index": "aD3UW", "typeName": "shape"}, {"x": 384, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6n", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "14.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Triangle target: height at its thickest point, from the breakout point."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aH7cz", "typeName": "shape"}, {"x": 56, "y": 326, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1j", "type": "text", "parentId": "shape:ch15-1e", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The six tenets of Dow Theory"}]}]}}, "index": "a5B8b", "typeName": "shape"}, {"x": 819.2555831265508, "y": 1937, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2k", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 240.74441687344913, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Fine-tuning entries, exits and tight stops"}]}]}}, "index": "agRJj", "typeName": "shape"}, {"x": 56, "y": 986, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3l", "type": "geo", "parentId": "shape:ch15-3a", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rectangle", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Flag", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "After a sharp rally (the "}, {"type": "text", "text": "flagpole", "marks": [{"type": "bold"}]}, {"type": "text", "text": "), price moves sideways or slightly lower in a small rectangle."}]}]}}, "index": "aB9Pn", "typeName": "shape"}, {"x": 56, "y": 1292, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-o", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 244.6153846153846, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Horizon", "marks": [{"type": "bold"}]}]}]}}, "index": "aLSDn", "typeName": "shape"}, {"x": 712, "y": 2064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4m", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 632, "h": 384, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trendline rules", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A straight line through two or more price points, extended forward as support or resistance"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Upward through higher lows: bullish. Downward through lower highs: bearish. Sideways: range-bound"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Needs at least "}, {"type": "text", "text": "two", "marks": [{"type": "bold"}]}, {"type": "text", "text": " points; "}, {"type": "text", "text": "three or more", "marks": [{"type": "bold"}]}, {"type": "text", "text": " make it more reliable"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Use wicks or closes depending on the strategy; adjust as new data comes"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Used for trend strength, entry and exit timing, and stop-losses"}]}]}]}]}}, "index": "aZ12z", "typeName": "shape"}, {"x": 56, "y": 1286, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5n", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 186.85579196217495, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Moving averages", "marks": [{"type": "bold"}]}]}]}}, "index": "aEGYn", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-70", "type": "text", "parentId": "shape:ch15-6y", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "For the group discussion"}]}]}}, "index": "a2AUzV", "typeName": "shape"}, {"x": 712, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6o", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Flag: small rectangle after a flagpole; pennant: small triangle."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aIKgf", "typeName": "shape"}, {"x": 56, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1k", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 318.6666666666667, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The market discounts everything", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Aligns with the Efficient Market Hypothesis."}]}]}}, "index": "a6H6X", "typeName": "shape"}, {"x": 1084, "y": 1157, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2l", "type": "note", "parentId": "shape:ch15-1e", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The book's example", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Nifty 50, 2020 to 2021: a bullish primary trend after the COVID crash; a secondary correction of about 7% in September to October 2020 on global risk-off sentiment; then new highs by early 2021."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 216, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "ahOjv", "typeName": "shape"}, {"x": 712, "y": 986, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3m", "type": "geo", "parentId": "shape:ch15-3a", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Small triangle", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Pennant", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Same idea, but the pause forms a small triangle. Traders buy when price breaks above the upper trendline."}]}]}}, "index": "aC3jv", "typeName": "shape"}, {"x": 308.61538461538464, "y": 1292, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-p", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 504.51923076923066, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Short and medium term trading"}]}]}}, "index": "aMLYf", "typeName": "shape"}, {"x": 56, "y": 2474, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4n", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Validation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Rising volume on breakouts; candlesticks (engulfing, hammer, shooting star) at the lines; RSI divergence or MACD crossovers near boundaries; lines visible on higher timeframes carry more weight."}]}]}}, "index": "aagm6", "typeName": "shape"}, {"x": 250.85579196217495, "y": 1702, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-60", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 200.86997635933804, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Performance versus a benchmark"}]}]}}, "index": "aRUUlV", "typeName": "shape"}, {"x": 250.85579196217495, "y": 1286, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5o", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 200.86997635933804, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Trend (lagging)"}]}]}}, "index": "aFilb", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-71", "type": "text", "parentId": "shape:ch15-6y", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pick one each. Argue it out"}]}]}}, "index": "a36TX", "typeName": "shape"}, {"x": 1040, "y": 1278.9600000000064, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6p", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "16.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Support is demand (a floor); resistance is supply (a ceiling). Broken support becomes resistance."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aJti2", "typeName": "shape"}, {"x": 398.6666666666667, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1l", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 318.6666666666667, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The market has three trends", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Primary (long term), secondary (weeks to months), tertiary (days to weeks)."}]}]}}, "index": "a7FBA", "typeName": "shape"}, {"x": 1084, "y": 1723.800000000003, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2m", "type": "note", "parentId": "shape:ch15-1e", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The primary trend is the tide, the secondary trend is the waves, and the tertiary trend is the ripples. A ripple against the tide does not turn it."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aizz1V", "typeName": "shape"}, {"x": 3080, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3n", "type": "frame", "props": {"w": 1400, "h": 2734, "name": "15.7 Support and resistance", "color": "black"}, "parentId": "page:page", "index": "a622X", "typeName": "shape"}, {"x": 56, "y": 899, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-50", "type": "geo", "parentId": "shape:ch15-4p", "props": {"w": 1288, "h": 84, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Default MACD line = difference between the 26 EMA and the 12 EMA. Slow line = 9 EMA of the default line."}]}]}}, "index": "aBzlW", "typeName": "shape"}, {"x": 821.1346153846154, "y": 1292, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-q", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 522.8653846153845, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Long-term investment"}]}]}}, "index": "aNvYf", "typeName": "shape"}, {"x": 712, "y": 2474, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4o", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "red", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Common pitfalls", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Forcing lines to fit a bias; ignoring breakouts and not redrawing after invalidation; relying on lines without other confirmation."}]}]}}, "index": "abiFA", "typeName": "shape"}, {"x": 459.725768321513, "y": 1702, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-61", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 600.2742316784869, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Normalised to 100; above 100 outperforming; 5 to 6 years of data"}]}]}}, "index": "aSJiU", "typeName": "shape"}, {"x": 459.725768321513, "y": 1286, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5p", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 600.2742316784869, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13, 21, 34 EMA; price above all three in an uptrend"}]}]}}, "index": "aGXhb", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-72", "type": "note", "parentId": "shape:ch15-6y", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Open a candlestick chart of a stock you know. Can you find a hammer or an engulfing pattern? Did the next candle confirm it?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a4ZRA", "typeName": "shape"}, {"x": 56, "y": 1679.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6q", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "17.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " A trendline needs at least two points; three or more make it more reliable."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aKWmr", "typeName": "shape"}, {"x": 741.3333333333334, "y": 401, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1m", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 318.6666666666667, "h": 294, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "3", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Primary trends have three phases", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Accumulation (smart money enters quietly), public participation, distribution (smart money exits). Mirrors Wyckoff's cycle."}]}]}}, "index": "a8N5I", "typeName": "shape"}, {"x": 56, "y": 2134.600000000006, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2n", "type": "text", "parentId": "shape:ch15-1e", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tertiary trends carry risks: noise in choppy markets, "}, {"type": "text", "text": "whipsaws", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (false breakouts), and "}, {"type": "text", "text": "overtrading", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", which raises costs and risk."}]}]}}, "index": "ajoFX", "typeName": "shape"}, {"x": 328.3116883116883, "y": 924, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-40", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 611.2207792207793, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Flat levels where price repeatedly reverses"}]}]}}, "index": "aDU0w", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3o", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.7", "marks": [{"type": "bold"}]}]}]}}, "index": "a1A86", "typeName": "shape"}, {"x": 56, "y": 1009, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-51", "type": "text", "parentId": "shape:ch15-4p", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Shows shifts in "}, {"type": "text", "text": "momentum", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and can warn early of a trend change. At times it "}, {"type": "text", "text": "leads", "marks": [{"type": "bold"}]}, {"type": "text", "text": " price."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Buy", "marks": [{"type": "bold"}]}, {"type": "text", "text": " when both lines are rising and the fast line crosses above the slow line; also when the fast line, already above, turns up again after nearly touching the slow line."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Divergence:", "marks": [{"type": "bold"}]}, {"type": "text", "text": " price makes a higher high but MACD a lower high: losing upward momentum. Price makes a new low but MACD a higher low: losing downward momentum, likely to bottom out."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The "}, {"type": "text", "text": "zero line", "marks": [{"type": "bold"}]}, {"type": "text", "text": " separates confirmed bull and bear markets, but a crossover of zero "}, {"type": "text", "text": "should not be used for trading", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Steep MACD: a powerful move; shallow: lack of power. A bulge of the fast line far above the slow line: a buying climax, possibly followed by a sideways market or mild correction."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "MACD can go flat or turn without a trend reversal; it shows momentum, not price, so use it with other indicators and price action."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A double top or bottom in MACD suggests a likely reversal. Avoid stocks whose weekly or monthly MACD is clearly trending down."}]}]}]}]}}, "index": "aCJzUV", "typeName": "shape"}, {"x": 56, "y": 1378, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-r", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 244.6153846153846, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Tools", "marks": [{"type": "bold"}]}]}]}}, "index": "aOfqX", "typeName": "shape"}, {"x": 3080, "y": 3662.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4p", "type": "frame", "props": {"w": 1400, "h": 2006, "name": "15.9 Technical indicators (1 of 2)", "color": "black"}, "parentId": "page:page", "index": "a7zRD", "typeName": "shape"}, {"x": 56, "y": 1812, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-62", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 186.85579196217495, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "OBV", "marks": [{"type": "bold"}]}]}]}}, "index": "aTSqX", "typeName": "shape"}, {"x": 56, "y": 1372, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5q", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 186.85579196217495, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "MACD", "marks": [{"type": "bold"}]}]}]}}, "index": "aH8JA", "typeName": "shape"}, {"x": 384, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-73", "type": "note", "parentId": "shape:ch15-6y", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Is technical analysis self-fulfilling? Does that make it more or less useful?"}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a5UJH", "typeName": "shape"}, {"x": 384, "y": 1679.9200000000128, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6r", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Moving averages are lagging. 13, 21, 34 EMA; price supported near the 34 EMA in a bull market."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "aLUbo", "typeName": "shape"}, {"x": 56, "y": 719, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1n", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 318.6666666666667, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "4", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Indices must confirm each other", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Major indices should move the same way, for example Nifty and Sensex."}]}]}}, "index": "a9EBX", "typeName": "shape"}, {"x": 56, "y": 1232, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-30", "type": "text", "parentId": "shape:ch15-2o", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Dark cloud cover and piercing pattern"}]}]}}, "index": "aC4kb", "typeName": "shape"}, {"x": 0, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3", "type": "frame", "props": {"w": 1400, "h": 1794, "name": "15.1 What technical analysis is", "color": "black"}, "parentId": "page:page", "index": "a1e8E", "typeName": "shape"}, {"x": 1540, "y": 788.6, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2o", "type": "frame", "props": {"w": 1400, "h": 2551.199999999997, "name": "15.5 Reversal patterns (candlesticks)", "color": "black"}, "parentId": "page:page", "index": "a4Mx6", "typeName": "shape"}, {"x": 947.5324675324675, "y": 924, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-41", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 396.46753246753235, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A stock resisting around Rs 1,950"}]}]}}, "index": "aEsYj", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3p", "type": "text", "parentId": "shape:ch15-3n", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Support and resistance"}]}]}}, "index": "a2iQb", "typeName": "shape"}, {"x": 56, "y": 1433, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-52", "type": "text", "parentId": "shape:ch15-4p", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "RSI: a scale from 0 to 100"}]}]}}, "index": "aD1Tb", "typeName": "shape"}, {"x": 308.61538461538464, "y": 1378, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-s", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 504.51923076923066, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chart patterns; RSI, moving averages, MACD, OBV"}]}]}}, "index": "aPPh6", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4q", "type": "geo", "parentId": "shape:ch15-4p", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "15.9", "marks": [{"type": "bold"}]}]}]}}, "index": "a1LEb", "typeName": "shape"}, {"x": 250.85579196217495, "y": 1812, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-63", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 200.86997635933804, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Volume flow"}]}]}}, "index": "aUjFz", "typeName": "shape"}, {"x": 250.85579196217495, "y": 1372, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5r", "type": "geo", "parentId": "shape:ch15-59", "props": {"w": 200.86997635933804, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Momentum"}]}]}}, "index": "aIixv", "typeName": "shape"}, {"x": 712, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "me