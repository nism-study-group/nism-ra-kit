, "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Data releases, central bank shifts, geopolitics, earnings surprises, technical exhaustion"}]}]}}, "index": "aXzTY", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3c", "type": "text", "parentId": "shape:ch15-3a", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Consolidation patterns"}]}]}}, "index": "a2za7", "typeName": "shape"}, {"x": 56, "y": 1010, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-f", "type": "geo", "parentId": "shape:ch15-3", "props": {"w": 244.6153846153846, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph"}]}}, "index": "aC1sj", "typeName": "shape"}, {"x": 947.5324675324675, "y": 1292, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-4d", "type": "geo", "parentId": "shape:ch15-3n", "props": {"w": 396.46753246753235, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Mostly used intraday"}]}]}}, "index": "aQ8E2", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-5e", "type": "text", "parentId": "shape:ch15-59", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Measures the "}, {"type": "text", "text": "strength", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of a trend, "}, {"type": "text", "text": "not its direction", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Values from 0 to 100; default setting "}, {"type": "text", "text": "14", "marks": [{"type": "bold"}]}, {"type": "text", "text": " bars."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Below "}, {"type": "text", "text": "25", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": weak or no trend. A rising ADX, especially above 25: a strong trend."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Plotted with "}, {"type": "text", "text": "+DMI", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and "}, {"type": "text", "text": "−DMI", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Buy when +DMI crosses above −DMI and ADX is rising; sell when +DMI crosses below −DMI and ADX is rising. Ignore crossovers when ADX is weak."}]}]}]}]}}, "index": "a5SHz", "typeName": "shape"}, {"x": 384, "y": 550, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-6f", "type": "note", "parentId": "shape:ch15-66", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "6.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Indices must confirm each other; volume should rise in the primary trend's direction."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.52, "textLastEditedBy": null}, "index": "a97YM", "typeName": "shape"}, {"x": 56, "y": 509, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-1b", "type": "geo", "parentId": "shape:ch15-13", "props": {"w": 413.3333333333333, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Point and figure", "marks": [{"type": "italic"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Price moves only; "}, {"type": "text", "text": "ignores time and volume", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". Breakouts and support and resistance; filters noise; long-term trends."}]}]}}, "index": "a8R62", "typeName": "shape"}, {"x": 819.2555831265508, "y": 1645, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-2c", "type": "geo", "parentId": "shape:ch15-1e", "props": {"w": 240.74441687344913, "h": 126, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Sentiment, news, technical triggers"}]}]}}, "index": "aYr32", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch15-3d", "type": "text", "parentId": "shape:ch15-3a", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 15 of 15"}]}]}}, "index": "a3t2f", "typeName": "shape"}, {"x": 308.615