outside India, invests in India. "}, {"type": "text", "text": "Must register with SEBI", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "a562A", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-5t", "type": "geo", "parentId": "shape:ch02-5p", "props": {"w": 490, "h": 354, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Help companies issue (primary)", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Merchant bankers", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": SEBI-registered issue managers or lead managers. Single point of contact for the issuer. Plan the issue, price it, run it until listing, and coordinate other intermediaries."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Underwriters", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": promise to buy what the public does not. "}, {"type": "text", "text": "Hard", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": committed at the start. "}, {"type": "text", "text": "Soft", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": committed after pricing, with an exit clause."}]}]}]}]}}, "index": "a4Uyy", "typeName": "shape"}, {"x": 56, "y": 774, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-76", "type": "geo", "parentId": "shape:ch02-6s", "props": {"w": 202.58064516129033, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor