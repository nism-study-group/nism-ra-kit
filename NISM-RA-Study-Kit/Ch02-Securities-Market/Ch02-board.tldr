nvestors are "}, {"type": "text", "text": "limited partners", "marks": [{"type": "bold"}]}, {"type": "text", "text": "; managers are "}, {"type": "text", "text": "general partners", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "aBRhQ", "typeName": "shape"}, {"x": 266.58064516129036, "y": 860, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-7c", "type": "geo", "parentId": "shape:ch02-6s", "props": {"w": 263.35483870967744, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Agree today to buy or sell later at a fixed price"}]}]}}, "index": "aJ9zy", "typeName": "shape"}, {"x": 178, "y": 1725.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-8d", "type": "text", "parentId": "shape:ch02-6s", "props": {"color": "red", "size": "s", "w": 200, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Salim: plus 100"}]}]}}, "index": "au2JX", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-9e", "type": "note", "parentId": "shape:ch02-9a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "1.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Borrowers "}, {"type": "text", "text": "sell", "marks": [{"type": "bold"}]}, {"type": "text", "text": " securities; investors "}, {"type": "text", "text": "buy", "marks": [{"type": "bold"}]}, {"type": "text", "text": " them."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "st