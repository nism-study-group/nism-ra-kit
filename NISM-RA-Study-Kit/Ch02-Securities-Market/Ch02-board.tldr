: 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-96", "type": "arrow", "parentId": "shape:ch02-90", "props": {"kind": "arc", "elbowMidPoint": 0.5, "dash": "draw", "size": "m", "fill": "none", "color": "grey", "labelColor": "black", "bend": 0, "start": {"x": 0, "y": 0}, "end": {"x": 734, "y": 0}, "arrowheadStart": "none", "arrowheadEnd": "arrow", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "demat"}]}]}, "labelPosition": 0.5, "font": "draw", "scale": 1}, "index": "a62MX", "typeName": "shape"}, {"x": 570, "y": 709, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-8u", "type": "geo", "parentId": "shape:ch02-8l", "props": {"w": 490, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Arbitrage", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Buy and sell at the same time", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in two markets to profit from a price gap. Example: buy in spot, sell in futures."}]}]}}, "index": "a9R2Q", "typeName": "shape"}, {"x": 580.8, "y": 1209.4560000000056, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-9v", "type": "note", "parentId": "shape:ch02-9a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "18.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " Novation: the clearing corporation is buyer to every seller and seller to every buyer. Initial margin is based on Value at Risk."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.192, "textLastEditedBy": null}, "index": "aLDAj", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-7", "type": "text", "parentId": "shape:ch02-3", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A "}, {"type": "text", "text": "security", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is a financial claim you can "}, {"type": "text", "text": "transfer", "marks": [{"type": "bold"}]}, {"type": "text", "text": " to someone else. It is one of two things:"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "a "}, {"type": "text", "text": "promise to pay", "marks": [{"type": "bold"}]}, {"type": "text", "text": " you back (debt, like a bond)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "a "}, {"type": "text", "text": "share of ownership", "marks": [{"type": "bold"}]}, {"type": "text", "text": " in a company (equity)"}]}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Companies, financial institutions and the government issue them. The words security, instrument and product mean the same thing in this book."}]}]}}, "index": "a4i5X", "typeName": "shape"}, {"x": 56, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-w", "type": "text", "parentId": "shape:ch02-s", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Every product has its own mix of risk and return. For each one, know who issues it, who invests, how it is sold and "}, {"type": "text", "text": "who regulates it", "marks": [{"type": "bold"}]}, {"type": "text", "text": ". The regulator is the part most likely to be asked."}]}]}}, "index": "a41fM", "typeName": "shape"}, {"meta": {}, "id": "binding:kbG9uWjtF4iuf2OIFzTxl", "type": "arrow", "fromId": "shape:ch02-5h", "toId": "shape:ch02-5e", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 843, "y": 479, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-20", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 501, "h": 64, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Rest earns interest, repaid"}]}]}}, "index": "aAMnI", "typeName": "shape"}, {"meta": {}, "id": "binding:CR05J072WMMQCfzcTExFZ", "type": "arrow", "fromId": "shape:ch02-c", "toId": "shape:ch02-a", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 1084, "y": 1921.4000000000015, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-1o", "type": "note", "parentId": "shape:ch02-s", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "\"Euro bond\" has nothing to do with Europe or the euro. It only means the currency is not local where it is sold."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aSpm6", "typeName": "shape"}, {"x": 227.33333333333334, "y": 2371, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-31", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 196, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "More than one country", "marks": [{"type": "bold"}]}]}]}}, "index": "akm5j", "typeName": "shape"}, {"x": 227.33333333333334, "y": 2089, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-2p", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 196, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "USA"}]}]}}, "index": "aYCH2", "typeName": "shape"}, {"x": 56, "y": 1716.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-42", "type": "text", "parentId": "shape:ch02-3c", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Commodities"}]}]}}, "index": "aOp9f", "typeName": "shape"}, {"x": 755, "y": 1003.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-3q", "type": "geo", "parentId": "shape:ch02-3c", "props": {"w": 239.5, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale"