ontent": [{"type": "text", "text": "To a select few (private placement)", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Up to "}, {"type": "text", "text": "50", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " investors, as per the book (Companies Act, 2013)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "QIP", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": a "}, {"type": "text", "text": "listed", "marks": [{"type": "bold"}]}, {"type": "text", "text": " company places shares with Qualified Institutional Buyers (FIs, mutual funds, banks and others)"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Preferential issue", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": a listed company issues to a select person or group. SEBI rules on pricing, disclosure and lock-in apply."}]}]}]}]}}, "index": "a9ekj", "typeName": "shape"}, {"x": 1084, "y": 628.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-5j", "type": "note", "parentId": "shape:ch02-4v", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "An online marketplace that holds the money. You trust the platform, not the stranger selling to you."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aN9TA", "typeName": "shape"}, {"x": 56, "y": 1374, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-6k", "type": "geo", "parentId": "shape:ch02-60", "props": {"w": 413.3333333333333, "h"