"type": "paragraph", "content": [{"type": "text", "text": "Missing", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": no voting rights, no claim on leftover assets."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Cumulative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": an unpaid dividend carries forward. "}, {"type": "text", "text": "Non-cumulative", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": it lapses."}]}]}}, "index": "aKeHv", "typeName": "shape"}, {"x": 712, "y": 2906, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-3b", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "MBS and ABS", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Bonds paid from loan repayments. "}, {"type": "text", "text": "MBS", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": home loans. "}, {"type": "text", "text": "ABS", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": auto loans, rent, credit card dues. Turns loans that cannot be sold into tradable bonds (securitisation)."}]}]}}, "index": "au1yv", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-4c", "type": "text", "parentId": "shape:ch02-49", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Part 1 of 2: primary and secondary market, ways to issue, the IPO split"}]}]}}, "index": "a3YV6", "typ