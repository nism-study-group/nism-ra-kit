t"}]}]}}, "index": "aPoQU", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-3g", "type": "text", "parentId": "shape:ch02-3c", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pooled products"}]}]}}, "index": "a4GcU", "typeName": "shape"}, {"meta": {}, "id": "binding:Qk_1Fea-B6nFuD2e5kHox", "type": "arrow", "fromId": "shape:ch02-1i", "toId": "shape:ch02-1c", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "start"}, "typeName": "binding"}, {"x": 56, "y": 721.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-4h", "type": "geo", "parentId": "shape:ch02-49", "props": {"w": 490, "h": 384, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "To the public", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "IPO", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": first ever sale of shares to the public. Mainly to raise equity for growth."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "FPO", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": an already listed company offers shares to the public again. For growth, to repay debt, or to meet public shareholding rules."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "OFS", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": existing holders sell their shares. "}, {"type": "text", "text": "No new shares", "marks": [{"type": "bold"}]}, {"type": "text", "text": ", share capital unchanged. Example: government disinvestment in PSUs."}]}]}]}]}}, "index": "a8k0M", "typeName": "shape"}, {"x": 1084, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-5i", "type": "note", "parentId": "shape:ch02-4v", "props": {"color": "light-blue", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Novation", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "The clearing corporation becomes the "}, {"type": "text", "text": "buyer to every seller", "marks": [{"type": "bold"}]}, {"type": "text", "text": " and the "}, {"type": "text", "text": "seller to every buyer", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 24, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aM4vj", "typeName": "shape"}, {"meta": {}, "id": "binding:9bykPGqLjz1J1oiiw_kQ8", "type": "arrow", "fromId": "shape:ch02-1m", "toId": "shape:ch02-1h", "props": {"isPrecise": false, "isExact": false, "normalizedAnchor": {"x": 0.5, "y": 0.5}, "snap": "none", "terminal": "end"}, "typeName": "binding"}, {"x": 56, "y": 1284, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-6j", "type": "text", "parentId": "shape:ch02-60", "props": {"color": "grey", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Defined in Regulation 2(1)(b), SEBI (AIF) Regulations, 2012. A privately pooled fund not already covered by other SEBI fund rules or by IRDAI, PFRDA or RBI."}]}]}