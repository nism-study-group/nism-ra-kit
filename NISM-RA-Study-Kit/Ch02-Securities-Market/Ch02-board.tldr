rt", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "The clearing corporation"}]}]}}, "index": "aDzV5", "typeName": "shape"}, {"x": 56, "y": 56, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-4w", "type": "geo", "parentId": "shape:ch02-4v", "props": {"w": 128, "h": 128, "geo": "ellipse", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "white", "fill": "fill", "size": "l", "font": "sans", "align": "middle", "verticalAlign": "middle", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.3", "marks": [{"type": "bold"}]}]}]}}, "index": "a1FQv", "typeName": "shape"}, {"x": 398.6666666666667, "y": 509, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-69", "type": "geo", "parentId": "shape:ch02-60", "props": {"w": 318.6666666666667, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Pension funds", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Retirement money from employers and employees. Among the largest investors."}]}]}}, "index": "a9Gij", "typeName": "shape"}, {"x": 1084, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-5x", "type": "note", "parentId": "shape:ch02-5p", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Depository and DP are a bank and its branch. NSDL or CDSL is head office. The DP is the branch where you open your account."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a8YAE", "typeName": "shape"}, {"x": 56, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-6y", "type": "geo", "parentId": "shape:ch02-6s", "props": {"w": 300, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "green", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "T+0: Cash", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Same day. Like buying vegetables at the market."}]}]}}, "index": "a6Pmn", "typeName": "shape"}, {"x": 1080.6451612903227, "y": 1276, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-7z", "type": "geo", "parentId": "shape:ch02-6s", "props": {"w": 263.35483870967744, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Borrower turns a floating-rate loan into fixed"}]}]}}, "index": "agp0n", "typeName": "shape"}, {"x": 0, "y": 0, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-ad", "type": "text", "parentId": "page:page", "props": {"color": "black", "size": "xl", "w": 1217.7777777777778, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 4.5, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Chapter 2: The securities market"}]}]}}, "index": "aErFI", "typeName": "shape"}, {"x": 56, "y": 981, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-15", "type": "text", "parentId": "shape:ch02-s", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "All three are loans. The names overlap and the book says you cannot draw hard lines. Rough usage:"}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Bonds", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": umbrella term in the US. Often government, often longer than 10 years. UK government bonds are called "}, {"type": "text", "text": "gilts", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Debentures", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": more common in UK usage and for companies. Can be "}, {"type": "text", "text": "secured", "marks": [{"type": "bold"}]}, {"type": "text", "text": " (backed by collateral) or "}, {"type": "text", "text": "unsecured", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Notes", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": short and medium term."}]}]}]}]}}, "index": "aDAuv", "typeName": "shape"}, {"x": 712, "y": 725, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-26", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Investor gains", "marks": [{"type": "bold"}]}]}, {"type": "bulletList", "content": [{"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Interest in the early years, while the project is young"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Share price gains later if the company does well"}]}]}]}]}}, "index": "aGdBI", "typeName": "shape"}, {"x": 56, "y": 236, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-1u", "type": "text", "parentId": "shape:ch02-1q", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Convertible debentures: how much turns into shares?"}]}]}}, "index": "a4IHb", "typeName": "shape"}, {"x": 56, "y": 2603, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-37", "type": "text", "parentId": "shape:ch02-1q", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "More hybrids, one line each"}]}]}}, "index": "aqbG6", "typeName": "shape"}, {"x": 684.3333333333334, "y": 2175, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-2v", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 375.6666666666667, "h": 78, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "grey", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Standard Chartered Bank"}]}]}}, "index": "aejmb", "typeName": "shape"}, {"x": 1084, "y": 1791.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-48", "type": "note", "parentId": "shape:ch02-3c", "props": {"color": "light-green", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "ANALOGY", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "A 10-gram gold bar is a commodity: any bar will do. A gold necklace is not: you care which design you get."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aUdsM", "typeName": "shape"}, {"x": 56, "y": 1352.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-3w", "type": "text", "parentId": "shape:ch02-3c", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "An index tracks the market using a "}, {"type": "text", "text": "sample", "marks": [{"type": "bold"}]}, {"type": "text", "text": " of shares. Most big indices are "}, {"type": "text", "text": "market-cap weighted", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": bigger companies count for more. Shares are picked for liquidity, free float and market cap, and the list is reviewed from time to time."}]}]}}, "index": "aIUde", "typeName": "shape"}, {"x": 56, "y": 593, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-59", "type": "geo", "parentId": "shape:ch02-4v", "props": {"w": 260, "h": 102, "geo": "rectangle", "dash": "solid", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Default risk", "marks": [{"type": "bold"}]}]}]}}, "index": "aEnBI", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-4x", "type": "text", "parentId": "shape:ch02-4v", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How the market is built"}]}]}}, "index": "a29Er", "typeName": "shape"}, {"x": 1084, "y": 570.3999999999942, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-5y", "type": "note", "parentId": "shape:ch02-5p", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Sub-brokers", "marks": [{"type": "bold"}]}, {"type": "text", "text": " were abolished. SEBI decided on "}, {"type": "text", "text": "21 June 2018", "marks": [{"type": "highlight"}]}, {"type": "text", "text": ", effective "}, {"type": "text", "text": "1 April 2019", "marks": [{"type": "highlight"}]}, {"type": "text", "text": ". They became authorised persons or trading members."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 96, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "a9oYj", "typeName": "shape"}, {"x": 550, "y": 369, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-6z", "type": "geo", "parentId": "shape:ch02-6s", "props": {"w": 300, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "T+1: Tom", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Next day (\"tomorrow\"). Some FX deals settle this way."}]}]}}, "index": "a7R12", "typeName": "shape"}, {"x": 0, "y": 295.5, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-ae", "type": "text", "parentId": "page:page", "props": {"color": "grey", "size": "l", "w": 3425, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1.6, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "NISM Series XV Research Analyst  ·  Worth 2 marks of 100  ·  Book pages 22 to 54  ·  Notes from the February 2026 workbook. Study aid only."}]}]}}, "index": "aFUo9", "typeName": "shape"}, {"x": 56, "y": 1181, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-16", "type": "text", "parentId": "shape:ch02-s", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Short-term debt (up to one year): who issues what"}]}]}}, "index": "aEwME", "typeName": "shape"}, {"x": 56, "y": 969, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-27", "type": "text", "parentId": "shape:ch02-1q", "props": {"color": "violet", "size": "l", "w": 1288, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Preference shares: half equity, half debt"}]}]}}, "index": "aHFLA", "typeName": "shape"}, {"x": 56, "y": 311, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-1v", "type": "text", "parentId": "shape:ch02-1q", "props": {"color": "black", "size": "m", "w": 1288, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A loan that may turn into shares. Terms are fixed "}, {"type": "text", "text": "at the time of issue", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": conversion date, ratio (shares per debenture), price (usually below market price), and the portion that converts."}]}]}}, "index": "a5t9A", "typeName": "shape"}, {"x": 56, "y": 2678, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-38", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 632, "h": 204, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "FCCB", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Foreign Currency Convertible Bond"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Usually "}, {"type": "text", "text": "optionally", "marks": [{"type": "bold"}]}, {"type": "text", "text": " convertible, issued offshore. Interest and principal in foreign currency. After conversion, dividends are in rupees and the currency risk moves to the investor. Regulated by "}, {"type": "text", "text": "RBI under FEMA", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "arEAI", "typeName": "shape"}, {"x": 56, "y": 2261, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-2w", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 163.33333333333334, "h": 102, "geo": "rectangle", "dash": 