 not."}]}]}}, "index": "a4CdE", "typeName": "shape"}, {"x": 580.8, "y": 889.8399999999965, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-9q", "type": "note", "parentId": "shape:ch02-9a", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "13.", "marks": [{"type": "bold"}]}, {"type": "text", "text": " REIT: 80% in real estate. InvIT: 90% in infra. Both distribute at least 90%."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 0, "fontSizeAdjustment": 1, "url": "", "scale": 1.192, "textLastEditedBy": null}, "index": "aGfeX", "typeName": "shape"}, {"x": 749.9200000000001, "y": 1791, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-r", "type": "geo", "parentId": "shape:ch02-3", "props": {"w": 594.0799999999999, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "violet", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Recent addition: Electronic Gold Receipts", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Declared securities by gazette notification on "}, {"type": "text", "text": "24 December 2021", "marks": [{"type": "highlight"}]}, {"type": "text", "text": ". An electronic receipt issued against physical gold deposited under SEBI rules."}]}]}}, "index": "aNfxI", "typeName": "shape"}, {"x": 318.4, "y": 222, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-a9", "type": "note", "parentId": "shape:ch02-a4", "props": {"color": "light-violet", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "2.", "marks": [{"type": "bold"