"type": "paragraph", "content": [{"type": "text", "text": "A 10-year bond is a 10-hour train ride. You can get off after 2 hours. The "}, {"type": "text", "text": "secondary market", "marks": [{"type": "bold"}]}, {"type": "text", "text": " is the station where a new passenger takes your seat."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 72, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "aCXDj", "typeName": "shape"}, {"x": 56, "y": 2906, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-3a", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 632, "h": 174, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "CLD", "marks": [{"type": "bold"}]}, {"type": "text", "text": ": Commodity Linked Debenture"}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Same idea as an ELD, linked to a commodity. Mostly "}, {"type": "text", "text": "gold and silver", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}}, "index": "atflj", "typeName": "shape"}, {"x": 216, "y": 60, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-4b", "type": "text", "parentId": "shape:ch02-49", "props": {"color": "black", "size": "xl", "w": 940, "font": "draw", "textAlign": "start", "autoSize": false, "scale": 1.2, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "How the market is built"}]}]}}, "index": "a2NSQ", "typeName": "shape"}, {"x": 56, "y": 735, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-5c", "type": "text", "parentId": "shape:ch02-4v", "props": {