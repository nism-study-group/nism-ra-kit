 "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "No repayment needed, because shares replace it"}]}]}, {"type": "listItem", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Downside: existing shareholders get "}, {"type": "text", "text": "diluted", "marks": [{"type": "bold"}]}]}]}]}]}}, "index": "aFzk7", "typeName": "shape"}, {"x": 216, "y": 138.8000000000029, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-1t", "type": "text", "parentId": "shape:ch02-1q", "props": {"color": "grey", "size": "m", "w": 1128, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Part 2 of 3: hybrids. Part loan, part ownership"}]}]}}, "index": "a3IBM", "typeName": "shape"}, {"x": 1084, "y": 1770.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-36", "type": "note", "parentId": "shape:ch02-1q", "props": {"color": "orange", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "EXAM TRAP", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "IDR rules: a cap on money raised in India, a "}, {"type": "text", "text": "one-year lock-in", "marks": [{"type": "highlight"}]}, {"type": "text", "text": " before converting to shares, and "}, {"type": "text", "text": "resident Indians only", "marks": [{"type": "bold"}]}, {"type": "text", "text": "."}]}]}, "size": "s", "font": "draw", "align": "start", "verticalAlign": "start", "labelColor": "black", "growY": 48, "fontSizeAdjustment": 1, "url": "", "scale": 1.3, "textLastEditedBy": null}, "index": "apuib", "typeName": "shape"}, {"x": 431.33333333333337, "y": 2175, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-2u", "type": "geo", "parentId": "shape:ch02-1q", "props": {"w": 245, "h": 78, "geo": "re