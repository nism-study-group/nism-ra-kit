lColor": "black", "fill": "solid", "size": "s", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A non-US company"}]}]}}, "index": "aZKbQ", "typeName": "shape"}, {"x": 56, "y": 1791.199999999997, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-43", "type": "text", "parentId": "shape:ch02-3c", "props": {"color": "black", "size": "m", "w": 1004, "font": "sans", "textAlign": "start", "autoSize": false, "scale": 1, "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "A commodity is a basic good where every unit is the same, so units can be swapped. "}, {"type": "text", "text": "Hard", "marks": [{"type": "bold"}]}, {"type": "text", "text": " commodities are mined or extracted: metals, crude oil. "}, {"type": "text", "text": "Soft", "marks": [{"type": "bold"}]}, {"type": "text", "text": " commodities are grown: grains, pulses."}]}, {"type": "paragraph", "content": [{"type": "text", "text": "They protect against inflation, but storage is costly. So people invest through:"}]}]}}, "index": "aPelM", "typeName": "shape"}, {"x": 1104.5, "y": 1003.1999999999971, "rotation": 0, "isLocked": false, "opacity": 1, "meta": {}, "id": "shape:ch02-3r", "type": "geo", "parentId": "shape:ch02-3c", "props": {"w": 239.5, "h": 234, "geo": "rectangle", "dash": "draw", "growY": 0, "url": "", "scale": 1, "flipX": false, "flipY": false, "color": "blue", "labelColor": "black", "fill": "solid", "size": "m", "font": "sans", "align": "start", "verticalAlign": "start", "richText": {"type": "doc", "content": [{"type": "paragraph", "content": [{"type": "text", "text": "Retail investors", "marks": [{"type": "bold"}]}]}, {"type": "paragraph", "content": [{"type": "text", "text": "Trade units like ordinary shares"}]}]}}, "index": "aF8vX", "typeName": "shape"}, {"x": 324, "y": 397, "rotation": 0, "isLocked": false, "opacit